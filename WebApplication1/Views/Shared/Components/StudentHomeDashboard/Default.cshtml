@model OnlineLearningPlatform.ViewModels.StudentHomeDashboardViewModel

@{
    string GetFallbackThumbnail(string title)
    {
        string value =
            title.ToLowerInvariant();

        if (value.Contains("sql"))
        {
            return Url.Content(
                "~/images/dashboard/sql-server.png");
        }

        if (value.Contains("git"))
        {
            return Url.Content(
                "~/images/dashboard/git-github.png");
        }

        if (value.Contains("asp.net") ||
            value.Contains(".net") ||
            value.Contains("c#"))
        {
            return Url.Content(
                "~/images/dashboard/aspnet-core.png");
        }

        return Url.Content(
            "~/images/dashboard/javascript-advanced.png");
    }

    string GetLevelText(string level)
    {
        return level switch
        {
            "Beginner" => "Cơ bản",
            "Intermediate" => "Trung cấp",
            "Advanced" => "Nâng cao",
            _ => level
        };
    }
}

<section class="role-dashboard role-dashboard--student">

<div class="dashboard-grid">

                <header class="dashboard-heading grid-full">
                    <div>
                        <div class="dashboard-eyebrow">
                            Học viên
                        </div>

                        <h1 class="dashboard-title">
                            Tổng quan học tập
                        </h1>

                        <p class="dashboard-subtitle">
                            Theo dõi tiến độ và tiếp tục các khóa học
                            bạn đang tham gia trên EduLearn.
                        </p>
                    </div>
                </header>

                <div class="metric-cluster metric-cluster--4 grid-full">

                    <a asp-controller="Courses"
                       asp-action="MyCourses"
                       class="metric-card">
                        <span class="metric-icon blue">KH</span>
                        <span>
                            <span class="metric-value d-block">
                                @Model.RegisteredCourseCount
                            </span>
                            <span class="metric-label d-block">
                                Khóa đã đăng ký
                            </span>
                        </span>
                    </a>

                    <a asp-controller="Courses"
                       asp-action="MyCourses"
                       class="metric-card">
                        <span class="metric-icon green">▶</span>
                        <span>
                            <span class="metric-value d-block">
                                @Model.InProgressCourseCount
                            </span>
                            <span class="metric-label d-block">
                                Đang học
                            </span>
                        </span>
                    </a>

                    <a asp-controller="Courses"
                       asp-action="MyCourses"
                       class="metric-card">
                        <span class="metric-icon purple">✓</span>
                        <span>
                            <span class="metric-value d-block">
                                @Model.CompletedCourseCount
                            </span>
                            <span class="metric-label d-block">
                                Đã hoàn thành
                            </span>
                        </span>
                    </a>



                    <a asp-controller="Wishlist"
                       asp-action="Index"
                       class="metric-card">
                        <span class="metric-icon orange">♥</span>
                        <span>
                            <span class="metric-value d-block">
                                @Model.WishlistCount
                            </span>
                            <span class="metric-label d-block">
                                Khóa học yêu thích
                            </span>
                        </span>
                    </a>

                </div>

                <section class="dashboard-panel grid-left">

                    <div class="panel-head">

                        <h2 class="panel-title">
                            <span class="panel-title-icon">
                                KH
                            </span>
                            Khóa học của tôi
                        </h2>

                        <a asp-controller="Courses"
                           asp-action="MyCourses"
                           class="panel-link">
                            Xem tất cả →
                        </a>

                    </div>

                    <div class="student-tabs">
                        <span>
                            Tất cả (@Model.RegisteredCourseCount)
                        </span>
                        <span>
                            Đang học (@Model.InProgressCourseCount)
                        </span>
                        <span>
                            Đã hoàn thành (@Model.CompletedCourseCount)
                        </span>
                    </div>

                    @if (Model.RecentCourses.Any())
                    {
                        <div class="student-course-list">

                            @foreach (var course in Model.RecentCourses)
                            {
                                decimal progress =
                                    Math.Clamp(
                                        course.Progress,
                                        0m,
                                        100m);

                                string thumbnail =
                                    !string.IsNullOrWhiteSpace(
                                        course.ThumbnailUrl)
                                        ? course.ThumbnailUrl
                                        : GetFallbackThumbnail(
                                            course.Title);

                                <article class="student-course-row">

                                    <div class="course-thumb">
                                        <img src="@thumbnail"
                                             alt="@course.Title" />
                                    </div>

                                    <div>
                                        <div class="course-title">
                                            @course.Title
                                        </div>

                                        <span class="course-category">
                                            @course.CategoryName
                                        </span>

                                        <div class="course-progress">
                                            <div class="course-progress-track">
                                                <div class="course-progress-fill"
                                                     style="width:@progress.ToString("0")%">
                                                </div>
                                            </div>

                                            <span class="course-progress-value">
                                                @progress.ToString("0")%
                                            </span>
                                        </div>
                                    </div>

                                    <a asp-controller="Courses"
                                       asp-action="Learn"
                                       asp-route-courseId="@course.CourseId"
                                       class="course-action">
                                        Tiếp tục học
                                    </a>

                                </article>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="dashboard-empty">
                            Bạn chưa đăng ký khóa học nào.
                        </div>
                    }

                </section>

                <aside class="right-stack grid-right">

                    <section class="dashboard-panel">

                        <div class="panel-head">
                            <h2 class="panel-title">
                                <span class="panel-title-icon">
                                    ⚡
                                </span>
                                Truy cập nhanh
                            </h2>
                        </div>

                        <div class="quick-list">

                            <a asp-controller="Wishlist"
                               asp-action="Index"
                               class="quick-link">
                                <span class="quick-icon red">♥</span>
                                <span>
                                    <span class="quick-title d-block">
                                        Khóa học yêu thích
                                    </span>
                                    <span class="quick-subtitle d-block">
                                        Xem các khóa học đã lưu
                                    </span>
                                </span>
                                <span class="quick-arrow">›</span>
                            </a>

                            <a asp-controller="LessonQuestions"
                               asp-action="MyQuestions"
                               class="quick-link">
                                <span class="quick-icon">Q</span>
                                <span>
                                    <span class="quick-title d-block">
                                        Câu hỏi của tôi
                                    </span>
                                    <span class="quick-subtitle d-block">
                                        @Model.OpenQuestionCount câu đang chờ
                                    </span>
                                </span>
                                <span class="quick-arrow">›</span>
                            </a>

                            <a asp-controller="Notifications"
                               asp-action="Index"
                               class="quick-link">
                                <span class="quick-icon red">TB</span>
                                <span>
                                    <span class="quick-title d-block">
                                        Thông báo
                                    </span>
                                    <span class="quick-subtitle d-block">
                                        Theo dõi cập nhật mới
                                    </span>
                                </span>
                                <span class="quick-arrow">›</span>
                            </a>

                            <a asp-controller="Profile"
                               asp-action="Index"
                               class="quick-link">
                                <span class="quick-icon">HS</span>
                                <span>
                                    <span class="quick-title d-block">
                                        Hồ sơ cá nhân
                                    </span>
                                    <span class="quick-subtitle d-block">
                                        Cập nhật thông tin tài khoản
                                    </span>
                                </span>
                                <span class="quick-arrow">›</span>
                            </a>

                        </div>

                    </section>

                    @if (Model.ExploreCourses.Any())
                    {
                        <section class="dashboard-panel">

                            <div class="panel-head">
                                <h2 class="panel-title">
                                    <span class="panel-title-icon">
                                        ✦
                                    </span>
                                    Khóa học đề xuất
                                </h2>

                                <a asp-controller="Courses"
                                   asp-action="Index"
                                   class="panel-link">
                                    Xem thêm →
                                </a>
                            </div>

                            <div class="recommend-list">

                                @foreach (var course in Model.ExploreCourses)
                                {
                                    string thumbnail =
                                        !string.IsNullOrWhiteSpace(
                                            course.ThumbnailUrl)
                                            ? course.ThumbnailUrl
                                            : GetFallbackThumbnail(
                                                course.Title);

                                    <a asp-controller="Courses"
                                       asp-action="Details"
                                       asp-route-slug="@course.Slug"
                                       class="recommend-item">

                                        <div class="course-thumb">
                                            <img src="@thumbnail"
                                                 alt="@course.Title" />
                                        </div>

                                        <div>
                                            <div class="recommend-title">
                                                @course.Title
                                            </div>

                                            <div class="recommend-meta">
                                                @GetLevelText(course.Level)
                                                · @course.EnrollmentCount học viên
                                            </div>
                                        </div>

                                    </a>
                                }

                            </div>

                        </section>
                    }

                </aside>

            </div>

</section>
