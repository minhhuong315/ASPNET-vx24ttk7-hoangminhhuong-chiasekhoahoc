    .studentdash-quick-item:hover
    .studentdash-quick-arrow {
        color:
            var(--sd-primary);
    }


    /* =========================================================
       EMPTY
    ========================================================= */

    .studentdash-empty {
        padding:
            34px
            18px;

        color:
            var(--sd-muted);

        font-size: 14px;
        line-height: 1.55;

        text-align: center;
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @@media (max-width: 1180px) {

        .studentdash-stats {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }


        .studentdash-bottom-grid {
            grid-template-columns:
                minmax(0, 1.45fr)
                minmax(280px, .85fr);
        }
    }


    @@media (max-width: 900px) {

        .studentdash-bottom-grid {
            grid-template-columns: 1fr;
        }


        .studentdash-continue-card {
            grid-template-columns:
                88px
                minmax(0, 1fr)
                auto;
        }


        .studentdash-continue-thumb {
            width: 88px;
            height: 88px;
        }
    }


    @@media (max-width: 768px) {

        .studentdash-root {
            padding:
                22px
                0
                44px;
        }


        .studentdash-container {
            padding-inline: 0;
        }


        .studentdash-continue-card {
            grid-template-columns:
                80px
                minmax(0, 1fr);

            padding:
                16px
                18px;
        }


        .studentdash-continue-thumb {
            width: 80px;
            height: 80px;
        }


        .studentdash-primary-button {
            grid-column:
                1
                /
                -1;

            width: 100%;
        }


        .studentdash-course-row {
            grid-template-columns:
                76px
                minmax(0, 1fr)
                122px;
        }


        .studentdash-course-thumb {
            width: 76px;
            height: 76px;
        }


        .studentdash-course-action {
            width: 118px;

            margin-right: 2px;
        }
    }


    @@media (max-width: 620px) {

        .studentdash-container {
            padding-inline: 0;
        }


        .studentdash-stats {
            grid-template-columns: 1fr;
        }


        .studentdash-continue-card {
            grid-template-columns: 1fr;
        }


        .studentdash-continue-thumb {
            width: 100%;
            height: 160px;
        }


        .studentdash-tabs {
            gap: 18px;

            padding-inline: 16px;
        }


        .studentdash-course-list {
            padding-inline: 16px;
        }


        .studentdash-course-row {
            padding:
                12px
                0;

            grid-template-columns:
                72px
                minmax(0, 1fr);

            gap: 12px;
        }


        .studentdash-course-thumb {
            width: 72px;
            height: 72px;
        }


        .studentdash-course-action {
            grid-column:
                1
                /
                -1;

            width: 100%;

            margin-right: 0;
        }


        .studentdash-recommend-grid {
            grid-template-columns: 1fr;
        }


        .studentdash-recommend-grid.single
        .studentdash-recommend-card {
            grid-template-columns: 1fr;
        }


        .studentdash-recommend-grid.single
        .studentdash-recommend-thumb {
            height: auto;
            aspect-ratio: 16 / 8.5;

            border-right: 0;
        }


        .studentdash-panel-head {
            min-height: 56px;

            padding:
                10px
                16px;

            flex-wrap: wrap;
        }
    }


    @@media (max-width: 390px) {

        .studentdash-container {
            padding-inline: 0;
        }


        .studentdash-stat {
            min-height: 92px;
        }
    }

</style>


<section class="studentdash-root">

    <div class="studentdash-container">


        <!-- =================================================
             HEADER
        ================================================== -->

        <header class="studentdash-header">

            <div class="studentdash-eyebrow">
                Học viên
            </div>


            <h1 class="studentdash-title">
                Tổng quan học tập
            </h1>


            <p class="studentdash-description">
                Tiếp tục các khóa học đang tham gia,
                theo dõi tiến độ và khám phá nội dung mới trên EduLearn.
            </p>

        </header>


        <!-- =================================================
             STATS
        ================================================== -->

        <div class="studentdash-stats">


            <a asp-controller="Courses"
               asp-action="MyCourses"
               class="studentdash-stat">

                <span class="studentdash-stat-icon blue">

                    <svg class="studentdash-svg"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                        <path d="M4 4v15.5"></path>
                        <path d="M6.5 2H20v15H6.5A2.5 2.5 0 0 0 4 19.5"></path>

                    </svg>

                </span>


                <span class="studentdash-stat-label">
                    Khóa đã đăng ký
                </span>

                <span class="studentdash-stat-number">
                    @Model.RegisteredCourseCount
                </span>

            </a>


            <a asp-controller="Courses"
               asp-action="MyCourses"
               class="studentdash-stat">

                <span class="studentdash-stat-icon green">

                    <svg class="studentdash-svg"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <circle cx="12"
                                cy="12"
                                r="9">
                        </circle>

                        <path d="m10 8 6 4-6 4z"></path>

                    </svg>

                </span>


                <span class="studentdash-stat-label">
                    Đang học
                </span>

                <span class="studentdash-stat-number">
                    @Model.InProgressCourseCount
                </span>

            </a>


            <a asp-controller="Courses"
               asp-action="MyCourses"
               class="studentdash-stat">

                <span class="studentdash-stat-icon purple">

                    <svg class="studentdash-svg"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <circle cx="12"
                                cy="12"
                                r="9">
                        </circle>

                        <path d="m8 12 2.5 2.5L16 9"></path>

                    </svg>

                </span>


                <span class="studentdash-stat-label">
                    Khóa đã hoàn thành
                </span>

                <span class="studentdash-stat-number">
                    @Model.CompletedCourseCount
                </span>

            </a>


            <a asp-controller="Courses"
               asp-action="StudyHistory"
               class="studentdash-stat">

                <span class="studentdash-stat-icon orange">

                    <svg class="studentdash-svg"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M4 6h16"></path>
                        <path d="M4 12h10"></path>
                        <path d="M4 18h8"></path>
                        <path d="m16 17 2 2 4-4"></path>

                    </svg>

                </span>


                <span class="studentdash-stat-label">
                    Bài học hoàn thành
                </span>

                <span class="studentdash-stat-number">
                    @Model.CompletedLessonCount
                </span>

            </a>


        </div>


        <!-- =================================================
             CONTINUE LEARNING
        ================================================== -->

        @if (continueCourse != null)
        {
            decimal continueProgress =
                Math.Clamp(
                    continueCourse.Progress,
                    0m,
                    100m);

            string? continueThumbnail =
                GetDashboardCourseThumbnail(
                    continueCourse.Title,
                    continueCourse.ThumbnailUrl);


            <section class="studentdash-continue-wrap">

                <div class="studentdash-panel studentdash-continue-panel">


                    <div class="studentdash-panel-head">

                        <h2 class="studentdash-panel-title">
                            Tiếp tục học
                        </h2>

                    </div>


                    <div class="studentdash-continue-card">


                        <div class="studentdash-continue-thumb">

                            @if (!string.IsNullOrWhiteSpace(
                                continueThumbnail))
                            {
                                <img src="@continueThumbnail"
                                     alt="@continueCourse.Title"
                                     class="studentdash-image"
                                     onerror="this.hidden=true;this.nextElementSibling.hidden=false;" />

                                <div class="studentdash-placeholder"
                                     hidden
                                     aria-hidden="true">

                                    <svg class="studentdash-svg"
                                         viewBox="0 0 24 24">

                                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                        <path d="M4 4v15.5"></path>
                                        <path d="M6.5 2H20v15H6.5A2.5 2.5 0 0 0 4 19.5"></path>

                                    </svg>

                                </div>
                            }
                            else
                            {
                                <div class="studentdash-placeholder"
                                     aria-hidden="true">

                                    <svg class="studentdash-svg"
                                         viewBox="0 0 24 24">

                                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                        <path d="M4 4v15.5"></path>
                                        <path d="M6.5 2H20v15H6.5A2.5 2.5 0 0 0 4 19.5"></path>

                                    </svg>

                                </div>
                            }

                        </div>


                        <div class="studentdash-continue-content">

                            <div class="studentdash-continue-title">
                                @continueCourse.Title
                            </div>

                            <div class="studentdash-continue-meta">
                                @continueCourse.CategoryName
                            </div>


                            <div class="studentdash-progress-head">

                                <span>
                                    Tiến độ khóa học
                                </span>

                                <span class="studentdash-progress-percent">
                                    @continueProgress.ToString("0")%
                                </span>

                            </div>


                            <div class="studentdash-progress-track">

                                <div class="studentdash-progress-fill"
                                     style="width:@continueProgress.ToString("0")%;">
                                </div>

                            </div>

                        </div>


                        <a asp-controller="Courses"
                           asp-action="Learn"
                           asp-route-courseId="@continueCourse.CourseId"
                           class="studentdash-primary-button">
                            Tiếp tục học
                        </a>


                    </div>

                </div>

            </section>
        }


        <!-- =================================================
             MY COURSES
        ================================================== -->

        <section class="studentdash-panel studentdash-courses-panel">


            <div class="studentdash-panel-head">

                <h2 class="studentdash-panel-title">
                    Khóa học của tôi
                </h2>


                <a asp-controller="Courses"
                   asp-action="MyCourses"
                   class="studentdash-panel-link">
                    Xem tất cả →
                </a>

            </div>


            <div class="studentdash-tabs"
                 role="tablist"
                 aria-label="Lọc khóa học của tôi">

                <button type="button"
                        class="studentdash-tab active"
                        data-course-filter="all"
                        role="tab"
                        aria-selected="true">
                    Tất cả (@Model.RegisteredCourseCount)
                </button>

                <button type="button"
                        class="studentdash-tab"
                        data-course-filter="in-progress"
                        role="tab"
                        aria-selected="false">
                    Đang học (@Model.InProgressCourseCount)
                </button>

                <button type="button"
                        class="studentdash-tab"
                        data-course-filter="completed"
                        role="tab"
                        aria-selected="false">
                    Đã hoàn thành (@Model.CompletedCourseCount)
                </button>

            </div>


            @if (Model.RecentCourses.Any())
            {
                <div class="studentdash-course-list">


                    @foreach (var course in Model.RecentCourses)
                    {
                        decimal progress =
                            Math.Clamp(
                                course.Progress,
                                0m,
                                100m);

                        string? thumbnail =
                            GetDashboardCourseThumbnail(
                                course.Title,
                                course.ThumbnailUrl);

                        string actionText =
                            progress >= 100m
                                ? "Xem lại khóa học"
                                : progress > 0m
                                    ? "Tiếp tục học"
                                    : "Bắt đầu học";

                        string progressStateText =
                            progress >= 100m
                                ? "Đã hoàn thành"
                                : progress > 0m
                                    ? "Đang học"
                                    : "Chưa bắt đầu";

                        string progressStateClass =
                            progress >= 100m
                                ? "completed"
                                : progress > 0m
                                    ? "in-progress"
                                    : "";


                        <article class="studentdash-course-row"
                                 data-course-state="@(progress >= 100m ? "completed" : progress > 0m ? "in-progress" : "not-started")">


                            <div class="studentdash-course-thumb">

                                @if (!string.IsNullOrWhiteSpace(
                                    thumbnail))
                                {
                                    <img src="@thumbnail"
                                         alt="@course.Title"
                                         class="studentdash-image"
                                         loading="lazy"
                                         onerror="this.hidden=true;this.nextElementSibling.hidden=false;" />

                                    <div class="studentdash-placeholder"
                                         hidden
                                         aria-hidden="true">

                                        <svg class="studentdash-svg"
                                             viewBox="0 0 24 24">

                                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                            <path d="M4 4v15.5"></path>
                                            <path d="M6.5 2H20v15H6.5A2.5 2.5 0 0 0 4 19.5"></path>

                                        </svg>

                                    </div>
                                }
                                else
                                {
                                    <div class="studentdash-placeholder"
                                         aria-hidden="true">

                                        <svg class="studentdash-svg"
                                             viewBox="0 0 24 24">

                                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                            <path d="M4 4v15.5"></path>
                                            <path d="M6.5 2H20v15H6.5A2.5 2.5 0 0 0 4 19.5"></path>

                                        </svg>

                                    </div>
                                }

                            </div>


                            <div class="studentdash-course-content">

                                <div class="studentdash-course-title">
                                    @course.Title
                                </div>

                                <div class="studentdash-course-meta-line">

                                    <span class="studentdash-course-category">
                                        @course.CategoryName
                                    </span>

                                    <span class="studentdash-course-state @progressStateClass">
                                        @progressStateText
                                    </span>

                                </div>


                                <div class="studentdash-course-progress">

                                    <div class="studentdash-course-progress-track">

                                        <div class="studentdash-course-progress-fill"
                                             style="width:@progress.ToString("0")%;">
                                        </div>

                                    </div>


                                    <span class="studentdash-course-progress-value">
                                        @progress.ToString("0")%
                                    </span>

                                </div>

                            </div>


                            <a asp-controller="Courses"
                               asp-action="Learn"
                               asp-route-courseId="@course.CourseId"
                               class="studentdash-course-action">
                                @actionText
                            </a>


                        </article>
                    }


                </div>

                <div class="studentdash-empty studentdash-filter-empty"
                     hidden>
                    Không có khóa học phù hợp với bộ lọc này.
                </div>
            }
            else
            {
                <div class="studentdash-empty">

                    Bạn chưa đăng ký khóa học nào.
                    Hãy khám phá các khóa học trên EduLearn để bắt đầu học tập.

                </div>
            }


        </section>


        <!-- =================================================
             RECOMMENDATIONS + QUICK ACCESS
        ================================================== -->

        <div class="studentdash-bottom-grid">


            <section class="studentdash-panel">


                <div class="studentdash-panel-head">

                    <h2 class="studentdash-panel-title">
                        Khóa học đề xuất
                    </h2>


                    <a asp-controller="Courses"
                       asp-action="Index"
                       class="studentdash-panel-link">
                        Khám phá tất cả →
                    </a>

                </div>


                @if (Model.ExploreCourses.Any())
                {
                    <div class="studentdash-recommend-grid @(recommendationCount == 1 ? "single" : "")">


                        @foreach (var course in Model.ExploreCourses)
                        {
                            string? thumbnail =
                            GetDashboardCourseThumbnail(
                                course.Title,
                                course.ThumbnailUrl);


                            <a asp-controller="Courses"
                               asp-action="Details"
                               asp-route-slug="@course.Slug"
                               class="studentdash-recommend-card">


                                <div class="studentdash-recommend-thumb">

                                    @if (!string.IsNullOrWhiteSpace(
                                        thumbnail))
                                    {
                                        <img src="@thumbnail"
                                             alt="@course.Title"
                                             class="studentdash-image"
                                             onerror="this.hidden=true;this.nextElementSibling.hidden=false;" />

                                        <div class="studentdash-placeholder"
                                             hidden
                                             aria-hidden="true">

                                            <svg class="studentdash-svg"
                                                 viewBox="0 0 24 24">

                                                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                                <path d="M4 4v15.5"></path>
                                                <path d="M6.5 2H20v15H6.5A2.5 2.5 0 0 0 4 19.5"></path>

                                            </svg>

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="studentdash-placeholder"
                                             aria-hidden="true">

                                            <svg class="studentdash-svg"
                                                 viewBox="0 0 24 24">

                                                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                                <path d="M4 4v15.5"></path>
                                                <path d="M6.5 2H20v15H6.5A2.5 2.5 0 0 0 4 19.5"></path>

                                            </svg>

                                        </div>
                                    }

                                </div>


                                <div class="studentdash-recommend-body">

                                    <div class="studentdash-recommend-title">
                                        @course.Title
                                    </div>


                                    <div class="studentdash-recommend-meta">

                                        @course.CategoryName
                                        · @GetLevelText(course.Level)
                                        · @course.EnrollmentCount học viên

                                    </div>

                                </div>


                            </a>
                        }


                    </div>
                }
                else
                {
                    <div class="studentdash-empty">
                        Hiện chưa có khóa học mới để đề xuất.
                    </div>
                }


            </section>


            <aside class="studentdash-panel">


                <div class="studentdash-panel-head">

                    <h2 class="studentdash-panel-title">
                        Truy cập nhanh
                    </h2>

                </div>


                <div class="studentdash-quick-list">


                    <a asp-controller="Courses"
                       asp-action="StudyHistory"
                       class="studentdash-quick-item">


                        <span class="studentdash-quick-icon">

                            <svg class="studentdash-svg"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <path d="M3 3v18h18"></path>
                                <path d="m7 15 4-4 3 3 5-6"></path>

                            </svg>

                        </span>


                        <span>

                            <span class="studentdash-quick-title d-block">
                                Lịch sử học tập
                            </span>

                            <span class="studentdash-quick-note d-block">
                                Xem hoạt động và tiến độ gần đây
                            </span>

                        </span>


                        <span class="studentdash-quick-arrow">
                            ›
                        </span>


                    </a>


                    <a asp-controller="Wishlist"
                       asp-action="Index"
                       class="studentdash-quick-item">


                        <span class="studentdash-quick-icon">

                            <svg class="studentdash-svg"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"></path>

                            </svg>

                        </span>


                        <span>

                            <span class="studentdash-quick-title d-block">
                                Khóa học yêu thích
                            </span>

                            <span class="studentdash-quick-note d-block">
                                @Model.WishlistCount khóa học đã lưu
                            </span>

                        </span>


                        <span class="studentdash-quick-arrow">
                            ›
                        </span>


                    </a>


                    <a asp-controller="LessonQuestions"
                       asp-action="MyQuestions"
                       class="studentdash-quick-item">


                        <span class="studentdash-quick-icon">

                            <svg class="studentdash-svg"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <circle cx="12"
                                        cy="12"
                                        r="9">
                                </circle>

                                <path d="M9.8 9a2.5 2.5 0 1 1 3.8 2.1c-.9.6-1.6 1-1.6 2.2"></path>
                                <path d="M12 17h.01"></path>

                            </svg>

                        </span>


                        <span>

                            <span class="studentdash-quick-title d-block">
                                Câu hỏi của tôi
                            </span>

                            <span class="studentdash-quick-note d-block">
                                @Model.OpenQuestionCount câu đang chờ
                            </span>

                        </span>


                        <span class="studentdash-quick-arrow">
                            ›
                        </span>


                    </a>


                    <a asp-controller="Notifications"
                       asp-action="Index"
                       class="studentdash-quick-item">


                        <span class="studentdash-quick-icon">

                            <svg class="studentdash-svg"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                                <path d="M10 21h4"></path>

                            </svg>

                        </span>


                        <span>

                            <span class="studentdash-quick-title d-block">
                                Thông báo
                            </span>

                            <span class="studentdash-quick-note d-block">
                                Theo dõi phản hồi và cập nhật mới
                            </span>

                        </span>


                        <span class="studentdash-quick-arrow">
                            ›
                        </span>


                    </a>


                </div>


            </aside>


        </div>


    </div>


<script>
    (() => {
        const root =
            document.querySelector(
                ".studentdash-root");

        if (!root) {
            return;
        }


        const tabs =
            Array.from(
                root.querySelectorAll(
                    "[data-course-filter]"));

        const rows =
            Array.from(
                root.querySelectorAll(
                    ".studentdash-course-row"));

        const emptyState =
            root.querySelector(
                ".studentdash-filter-empty");


        if (tabs.length === 0 ||
            rows.length === 0) {
            return;
        }


        const applyFilter =
            (filter) => {

                let visibleCount = 0;


                rows.forEach(
                    (row) => {

                        const state =
                            row.dataset.courseState;

                        const visible =
                            filter === "all" ||
                            state === filter;


                        row.hidden =
                            !visible;


                        if (visible) {
                            visibleCount++;
                        }
                    });


                tabs.forEach(
                    (tab) => {

                        const active =
                            tab.dataset.courseFilter ===
                            filter;


                        tab.classList.toggle(
                            "active",
                            active);


                        tab.setAttribute(
                            "aria-selected",
                            active
                                ? "true"
                                : "false");
                    });


                if (emptyState) {
                    emptyState.hidden =
                        visibleCount > 0;
                }
            };


        tabs.forEach(
            (tab) => {

                tab.addEventListener(
                    "click",
                    () => {

                        applyFilter(
                            tab.dataset.courseFilter ??
                            "all");
                    });
            });
    })();
</script>

</section>
