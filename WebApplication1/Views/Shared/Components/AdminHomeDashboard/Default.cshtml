@model OnlineLearningPlatform.ViewModels.AdminHomeDashboardViewModel

@{
    string GetFallbackThumbnail(string title)
    {
        string value =
            title.ToLowerInvariant();

        if (value.Contains("sql"))
        {
            return Url.Content(
                "~/images/dashboard/sql-server.png");
        }

        if (value.Contains("git"))
        {
            return Url.Content(
                "~/images/dashboard/git-github.png");
        }

        if (value.Contains("asp.net") ||
            value.Contains(".net"))
        {
            return Url.Content(
                "~/images/dashboard/aspnet-core.png");
        }

        if (value.Contains("javascript") &&
            value.Contains("nâng cao"))
        {
            return Url.Content(
                "~/images/dashboard/javascript-advanced.png");
        }

        if (value.Contains("javascript"))
        {
            return Url.Content(
                "~/images/dashboard/javascript-basic.png");
        }

        return Url.Content(
            "~/images/dashboard/aspnet-core.png");
    }

    int chartMax =
        Model.EnrollmentTrend.Any()
            ? Math.Max(
                1,
                Model.EnrollmentTrend.Max(x =>
                    x.Count))
            : 1;

    double chartLeft = 20d;
    double chartRight = 680d;
    double chartBottom = 165d;
    double chartTop = 25d;

    var pointValues =
        Model.EnrollmentTrend
            .Select(
                (item, index) =>
                {
                    double x =
                        Model.EnrollmentTrend.Count <= 1
                            ? chartLeft
                            : chartLeft +
                              (
                                  (
                                      chartRight -
                                      chartLeft
                                  ) *
                                  index /
                                  (
                                      Model.EnrollmentTrend.Count -
                                      1
                                  )
                              );

                    double y =
                        chartBottom -
                        (
                            (
                                chartBottom -
                                chartTop
                            ) *
                            item.Count /
                            chartMax
                        );

                    return new
                    {
                        X = x,
                        Y = y,
                        Item = item
                    };
                })
            .ToList();

    string linePoints =
        string.Join(
            " ",
            pointValues.Select(p =>
                $"{p.X.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}," +
                $"{p.Y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}"));

    string areaPoints =
        $"{chartLeft.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}," +
        $"{chartBottom.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} " +
        linePoints +
        $" {chartRight.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}," +
        $"{chartBottom.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}";

    int roleTotal =
        Math.Max(
            1,
            Model.StudentCount +
            Model.InstructorCount +
            Model.AdminCount);

    double studentPercent =
        Model.StudentCount *
        100d /
        roleTotal;

    double instructorPercent =
        Model.InstructorCount *
        100d /
        roleTotal;

    double adminPercent =
        Model.AdminCount *
        100d /
        roleTotal;

    double studentEnd =
        studentPercent;

    double instructorEnd =
        studentPercent +
        instructorPercent;

    string studentEndCss =
        studentEnd.ToString(
            "0.##",
            System.Globalization.CultureInfo.InvariantCulture);

    string instructorEndCss =
        instructorEnd.ToString(
            "0.##",
            System.Globalization.CultureInfo.InvariantCulture);

    string donutStyle =
        "background: conic-gradient(" +
        $"#126BFF 0% {studentEndCss}%, " +
        $"#18A76F {studentEndCss}% {instructorEndCss}%, " +
        $"#7C4DFF {instructorEndCss}% 100%);";
}

<section class="role-dashboard role-dashboard--admin">

<div class="dashboard-grid">

                <header class="dashboard-heading grid-full">
                    <div>
                        <div class="dashboard-eyebrow">
                            Quản trị hệ thống
                        </div>

                        <h1 class="dashboard-title">
                            Tổng quan hệ thống
                        </h1>

                        <p class="dashboard-subtitle">
                            Theo dõi người dùng, khóa học
                            và hoạt động chính trên nền tảng EduLearn.
                        </p>
                    </div>
                </header>

                <div class="metric-cluster metric-cluster--6 grid-full">

                    <a asp-controller="AdminUsers"
                       asp-action="Index"
                       class="metric-card">
                        <span class="metric-icon blue">ND</span>
                        <span>
                            <span class="metric-value d-block">
                                @Model.TotalUsers
                            </span>
                            <span class="metric-label d-block">
                                Tổng người dùng
                            </span>
                        </span>
                    </a>

                    <a asp-controller="AdminUsers"
                       asp-action="Index"
                       asp-route-role="Student"
                       class="metric-card">
                        <span class="metric-icon green">HV</span>
                        <span>
                            <span class="metric-value d-block">
                                @Model.StudentCount
                            </span>
                            <span class="metric-label d-block">
                                Học viên
                            </span>
                        </span>
                    </a>

                    <a asp-controller="AdminUsers"
                       asp-action="Index"
                       asp-route-role="Instructor"
                       class="metric-card">
                        <span class="metric-icon purple">GV</span>
                        <span>
                            <span class="metric-value d-block">
                                @Model.InstructorCount
                            </span>
                            <span class="metric-label d-block">
                                Giảng viên
                            </span>
                        </span>
                    </a>

                    <a asp-controller="AdminCourses"
                       asp-action="Index"
                       class="metric-card">
                        <span class="metric-icon blue">KH</span>
                        <span>
                            <span class="metric-value d-block">
                                @Model.TotalCourses
                            </span>
                            <span class="metric-label d-block">
                                Tổng khóa học
                            </span>
                        </span>
                    </a>



                    <a asp-controller="AdminCourses"
                       asp-action="Index"
                       asp-route-status="published"
                       class="metric-card">
                        <span class="metric-icon green">✓</span>
                        <span>
                            <span class="metric-value d-block">
                                @Model.PublishedCourses
                            </span>
                            <span class="metric-label d-block">
                                Đã xuất bản
                            </span>
                        </span>
                    </a>

                    <a asp-controller="AdminCourses"
                       asp-action="Index"
                       class="metric-card">
                        <span class="metric-icon orange">ĐK</span>
                        <span>
                            <span class="metric-value d-block">
                                @Model.TotalEnrollments
                            </span>
                            <span class="metric-label d-block">
                                Lượt đăng ký
                            </span>
                        </span>
                    </a>

                </div>

                <section class="dashboard-panel grid-left">

                    <div class="panel-head">

                        <h2 class="panel-title">
                            <span class="panel-title-icon">
                                PT
                            </span>
                            Lượt đăng ký 7 ngày gần đây
                        </h2>

                    </div>

                    <div class="chart-box">

                        <svg class="line-chart"
                             viewBox="0 0 700 190"
                             preserveAspectRatio="none"
                             aria-label="Biểu đồ lượt đăng ký 7 ngày gần đây">

                            <defs>
                                <linearGradient id="chartGradient"
                                                x1="0"
                                                x2="0"
                                                y1="0"
                                                y2="1">
                                    <stop offset="0%"
                                          stop-color="#5aa1ff"
                                          stop-opacity=".30" />
                                    <stop offset="100%"
                                          stop-color="#5aa1ff"
                                          stop-opacity=".03" />
                                </linearGradient>
                            </defs>

                            <line x1="20"
                                  y1="25"
                                  x2="680"
                                  y2="25"
                                  class="chart-grid-line" />

                            <line x1="20"
                                  y1="72"
                                  x2="680"
                                  y2="72"
                                  class="chart-grid-line" />

                            <line x1="20"
                                  y1="118"
                                  x2="680"
                                  y2="118"
                                  class="chart-grid-line" />

                            <line x1="20"
                                  y1="165"
                                  x2="680"
                                  y2="165"
                                  class="chart-grid-line" />

                            @if (pointValues.Any())
                            {
                                <polygon points="@areaPoints"
                                         class="chart-area">
                                </polygon>

                                <polyline points="@linePoints"
                                          class="chart-line">
                                </polyline>

                                @foreach (var point in pointValues)
                                {
                                    <circle cx="@point.X.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                            cy="@point.Y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                            r="4.5"
                                            class="chart-dot">
                                    </circle>
                                }
                            }

                        </svg>

                        <div class="chart-axis-labels">

                            @foreach (var item in Model.EnrollmentTrend)
                            {
                                <span>
                                    @item.Label
                                </span>
                            }

                        </div>

                    </div>

                </section>

                <section class="dashboard-panel grid-right">

                    <div class="panel-head">
                        <h2 class="panel-title">
                            <span class="panel-title-icon">
                                %
                            </span>
                            Cơ cấu người dùng
                        </h2>
                    </div>

                    <div class="user-composition">

                        <div class="donut"
                             style="@donutStyle">

                            <div class="donut-center">
                                <span class="donut-total">
                                    @(Model.StudentCount +
                                      Model.InstructorCount +
                                      Model.AdminCount)
                                </span>
                                <span class="donut-label">
                                    người dùng
                                </span>
                            </div>

                        </div>

                        <div class="legend-list">

                            <div class="legend-row">
                                <span class="legend-dot"
                                      style="background:#126BFF;">
                                </span>
                                <span>Học viên</span>
                                <span class="legend-count">
                                    @Model.StudentCount
                                </span>
                                <span class="legend-percent">
                                    @studentPercent.ToString("0.0")%
                                </span>
                            </div>

                            <div class="legend-row">
                                <span class="legend-dot"
                                      style="background:#18A76F;">
                                </span>
                                <span>Giảng viên</span>
                                <span class="legend-count">
                                    @Model.InstructorCount
                                </span>
                                <span class="legend-percent">
                                    @instructorPercent.ToString("0.0")%
                                </span>
                            </div>

                            <div class="legend-row">
                                <span class="legend-dot"
                                      style="background:#7C4DFF;">
                                </span>
                                <span>Quản trị</span>
                                <span class="legend-count">
                                    @Model.AdminCount
                                </span>
                                <span class="legend-percent">
                                    @adminPercent.ToString("0.0")%
                                </span>
                            </div>

                        </div>

                    </div>

                </section>

                <section class="dashboard-panel grid-left">

                    <div class="panel-head">

                        <h2 class="panel-title">
                            <span class="panel-title-icon">
                                KH
                            </span>
                            Khóa học cập nhật gần đây
                        </h2>

                        <a asp-controller="AdminCourses"
                           asp-action="Index"
                           class="panel-link">
                            Quản lý tất cả →
                        </a>

                    </div>

                    @if (Model.RecentCourses.Any())
                    {
                        <div class="table-wrap">

                            <table class="dashboard-table admin-table">

                                <thead>
                                    <tr>
                                        <th>Khóa học</th>
                                        <th>Giảng viên</th>
                                        <th>Học viên</th>
                                        <th>Trạng thái</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var course in Model.RecentCourses)
                                    {
                                        string thumbnail =
                                            !string.IsNullOrWhiteSpace(
                                                course.ThumbnailUrl)
                                                ? course.ThumbnailUrl
                                                : GetFallbackThumbnail(
                                                    course.Title);

                                        <tr>

                                            <td>
                                                <div class="table-course-cell">

                                                    <div class="course-thumb">
                                                        <img src="@thumbnail"
                                                             alt="@course.Title" />
                                                    </div>

                                                    <div>
                                                        <div class="table-course-name">
                                                            @course.Title
                                                        </div>
                                                        <div class="table-course-meta">
                                                            @course.CategoryName
                                                        </div>
                                                    </div>

                                                </div>
                                            </td>

                                            <td>
                                                @course.InstructorName
                                            </td>

                                            <td>
                                                @course.EnrollmentCount
                                            </td>

                                            <td>
                                                <span class="status-pill @(course.IsPublished ? "" : "draft")">
                                                    @(course.IsPublished
                                                        ? "Đã xuất bản"
                                                        : "Bản nháp")
                                                </span>
                                            </td>

                                            <td>
                                                <a asp-controller="AdminCourses"
                                                   asp-action="Index"
                                                   class="table-action">
                                                    Quản lý →
                                                </a>
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="dashboard-empty">
                            Hệ thống chưa có khóa học.
                        </div>
                    }

                </section>

                <section class="dashboard-panel grid-right">

                    <div class="panel-head">
                        <h2 class="panel-title">
                            <span class="panel-title-icon">
                                ND
                            </span>
                            Tình trạng nội dung
                        </h2>
                    </div>

                    <div class="system-list">

                        <div class="system-row">
                            <span class="system-label">
                                Khóa đã xuất bản
                            </span>
                            <span class="system-value">
                                @Model.PublishedCourses
                            </span>
                        </div>

                        <div class="system-row">
                            <span class="system-label">
                                Khóa bản nháp
                            </span>
                            <span class="system-value">
                                @Model.DraftCourses
                            </span>
                        </div>

                        <div class="system-row">
                            <span class="system-label">
                                Danh mục hoạt động
                            </span>
                            <span class="system-value">
                                @Model.ActiveCategories
                            </span>
                        </div>

                        <div class="system-row">
                            <span class="system-label">
                                Câu hỏi chưa trả lời
                            </span>
                            <span class="system-value">
                                @Model.PendingQuestions
                            </span>
                        </div>

                    </div>

                    <a asp-controller="AdminCategories"
                       asp-action="Index"
                       class="system-button">
                        Quản lý danh mục →
                    </a>

                </section>

            </div>

</section>
