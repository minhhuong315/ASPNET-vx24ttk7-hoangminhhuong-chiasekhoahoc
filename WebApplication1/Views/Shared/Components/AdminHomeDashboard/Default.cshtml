</style>


<section class="admin-home-v2">

    <div class="admin-home-container">


        <div class="dashboard-heading">

            <div class="dashboard-eyebrow">
                Quản trị viên
            </div>


            <h1 class="dashboard-title">
                Tổng quan hệ thống
            </h1>


            <p class="dashboard-description">
                Theo dõi người dùng, khóa học
                và hoạt động chính trên toàn bộ nền tảng EduLearn.
            </p>

        </div>


        <div class="admin-stats">


            <a asp-controller="AdminUsers"
               asp-action="Index"
               class="admin-stat">

                <div class="stat-top">

                    <span class="stat-label">
                        Tổng người dùng
                    </span>

                    <span class="stat-icon blue">

                        <svg class="ui-icon"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>

                        </svg>

                    </span>

                </div>

                <div class="stat-number">
                    @Model.TotalUsers
                </div>

            </a>


            <a asp-controller="AdminUsers"
               asp-action="Index"
               asp-route-role="Student"
               class="admin-stat">

                <div class="stat-top">

                    <span class="stat-label">
                        Học viên
                    </span>

                    <span class="stat-icon green">

                        <svg class="ui-icon"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="m3 10 9-5 9 5-9 5-9-5Z"></path>
                            <path d="M7 12v5c3 2 7 2 10 0v-5"></path>
                            <path d="M21 10v6"></path>

                        </svg>

                    </span>

                </div>

                <div class="stat-number">
                    @Model.StudentCount
                </div>

            </a>


            <a asp-controller="AdminUsers"
               asp-action="Index"
               asp-route-role="Instructor"
               class="admin-stat">

                <div class="stat-top">

                    <span class="stat-label">
                        Giảng viên
                    </span>

                    <span class="stat-icon purple">

                        <svg class="ui-icon"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <circle cx="12" cy="7" r="4"></circle>
                            <path d="M5.5 21a6.5 6.5 0 0 1 13 0"></path>
                            <path d="M19 8h3"></path>
                            <path d="M20.5 6.5v3"></path>

                        </svg>

                    </span>

                </div>

                <div class="stat-number">
                    @Model.InstructorCount
                </div>

            </a>


            <a asp-controller="AdminCourses"
               asp-action="Index"
               class="admin-stat">

                <div class="stat-top">

                    <span class="stat-label">
                        Tổng khóa học
                    </span>

                    <span class="stat-icon blue">

                        <svg class="ui-icon"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                            <path d="M4 4v15.5"></path>
                            <path d="M6.5 2H20v15H6.5A2.5 2.5 0 0 0 4 19.5"></path>

                        </svg>

                    </span>

                </div>

                <div class="stat-number">
                    @Model.TotalCourses
                </div>

            </a>


            <a asp-controller="AdminCourses"
               asp-action="Index"
               asp-route-status="published"
               class="admin-stat">

                <div class="stat-top">

                    <span class="stat-label">
                        Đã xuất bản
                    </span>

                    <span class="stat-icon green">

                        <svg class="ui-icon"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="m8 12 2.5 2.5L16 9"></path>

                        </svg>

                    </span>

                </div>

                <div class="stat-number">
                    @Model.PublishedCourses
                </div>

            </a>


            <a asp-controller="AdminCourses"
               asp-action="Index"
               class="admin-stat">

                <div class="stat-top">

                    <span class="stat-label">
                        Lượt đăng ký
                    </span>

                    <span class="stat-icon orange">

                        <svg class="ui-icon"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="8.5" cy="7" r="4"></circle>
                            <path d="M19 8v6"></path>
                            <path d="M22 11h-6"></path>

                        </svg>

                    </span>

                </div>

                <div class="stat-number">
                    @Model.TotalEnrollments
                </div>

            </a>


        </div>


        <div class="admin-grid">


            <section class="panel">

                <div class="panel-header">

                    <h2 class="panel-title">
                        Quản lý nhanh
                    </h2>


                    <a asp-controller="AdminUsers"
                       asp-action="Create"
                       class="panel-link">
                        Tạo người dùng →
                    </a>

                </div>


                <div class="quick-grid">


                    <a asp-controller="AdminUsers"
                       asp-action="Index"
                       class="quick-card">

                        <div class="quick-card-head">

                            <div class="quick-icon">

                                <svg class="ui-icon"
                                     viewBox="0 0 24 24"
                                     aria-hidden="true">

                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>

                                </svg>

                            </div>

                            <div class="quick-title">
                                Người dùng
                            </div>

                        </div>

                        <div class="quick-note">
                            Tài khoản, vai trò
                            và trạng thái truy cập.
                        </div>

                    </a>


                    <a asp-controller="AdminCourses"
                       asp-action="Index"
                       class="quick-card">

                        <div class="quick-card-head">

                            <div class="quick-icon">

                                <svg class="ui-icon"
                                     viewBox="0 0 24 24"
                                     aria-hidden="true">

                                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                    <path d="M4 4v15.5"></path>
                                    <path d="M6.5 2H20v15H6.5A2.5 2.5 0 0 0 4 19.5"></path>

                                </svg>

                            </div>

                            <div class="quick-title">
                                Khóa học
                            </div>

                        </div>

                        <div class="quick-note">
                            Xuất bản, nổi bật
                            và quản lý nội dung.
                        </div>

                    </a>


                    <a asp-controller="AdminCategories"
                       asp-action="Index"
                       class="quick-card">

                        <div class="quick-card-head">

                            <div class="quick-icon">

                                <svg class="ui-icon"
                                     viewBox="0 0 24 24"
                                     aria-hidden="true">

                                    <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                                    <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                                    <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                                    <rect x="14" y="14" width="7" height="7" rx="1"></rect>

                                </svg>

                            </div>

                            <div class="quick-title">
                                Danh mục
                            </div>

                        </div>

                        <div class="quick-note">
                            Cấu trúc lĩnh vực
                            và thứ tự hiển thị.
                        </div>

                    </a>


                    <a asp-controller="LessonQuestions"
                       asp-action="Index"
                       class="quick-card">

                        <div class="quick-card-head">

                            <div class="quick-icon">

                                <svg class="ui-icon"
                                     viewBox="0 0 24 24"
                                     aria-hidden="true">

                                    <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
                                    <path d="M9.5 9a2.5 2.5 0 1 1 3.8 2.1c-.8.5-1.3.9-1.3 1.9"></path>
                                    <path d="M12 16h.01"></path>

                                </svg>

                            </div>

                            <div class="quick-title">
                                Hỏi đáp
                            </div>

                        </div>

                        <div class="quick-note">
                            Kiểm tra các câu hỏi
                            đang chờ xử lý.
                        </div>

                    </a>


                </div>

            </section>


            <section class="panel status-panel">

                <div class="panel-header">

                    <h2 class="panel-title">
                        Tình trạng nội dung
                    </h2>


                    <a asp-controller="AdminDashboard"
                       asp-action="Index"
                       class="panel-link">
                        Dashboard chi tiết →
                    </a>

                </div>


                <div class="status-list">


                    <div class="status-row">

                        <span class="status-icon draft">

                            <svg class="ui-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <path d="M4 4h16v16H4z"></path>
                                <path d="M8 9h8"></path>
                                <path d="M8 13h5"></path>

                            </svg>

                        </span>

                        <span class="status-label">
                            Khóa học bản nháp
                        </span>

                        <span class="status-value @(Model.DraftCourses > 0 ? "warning" : "")">
                            @Model.DraftCourses
                        </span>

                    </div>


                    <div class="status-row">

                        <span class="status-icon category">

                            <svg class="ui-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                                <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                                <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                                <rect x="14" y="14" width="7" height="7" rx="1"></rect>

                            </svg>

                        </span>

                        <span class="status-label">
                            Danh mục hoạt động
                        </span>

                        <span class="status-value">
                            @Model.ActiveCategories
                        </span>

                    </div>


                    <div class="status-row">

                        <span class="status-icon question">

                            <svg class="ui-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="M9.8 9a2.5 2.5 0 1 1 3.8 2.1c-.9.6-1.6 1-1.6 2.2"></path>
                                <path d="M12 17h.01"></path>

                            </svg>

                        </span>

                        <span class="status-label">
                            Câu hỏi chưa trả lời
                        </span>

                        <span class="status-value @(Model.PendingQuestions > 0 ? "danger" : "")">
                            @Model.PendingQuestions
                        </span>

                    </div>


                </div>

            </section>


        </div>


        <section class="panel">


            <div class="panel-header">

                <h2 class="panel-title">
                    Khóa học cập nhật gần đây
                </h2>


                <a asp-controller="AdminCourses"
                   asp-action="Index"
                   class="panel-link">
                    Quản lý khóa học →
                </a>

            </div>


            @if (Model.RecentCourses.Any())
            {
                <div class="table-wrap">


                    <table class="course-table">


                        <thead>

                            <tr>
                                <th>Khóa học</th>
                                <th>Giảng viên</th>
                                <th>Danh mục</th>
                                <th>Học viên</th>
                                <th>Trạng thái</th>
                                <th>Cập nhật</th>
                                <th></th>
                            </tr>

                        </thead>


                        <tbody>


                            @foreach (var course in Model.RecentCourses)
                            {
                                <tr>


                                    <td>

                                        <div class="course-cell">


                                            <div class="course-thumb">

                                                @{
                                                    string? dashboardThumbnail =
                                                        GetDashboardCourseThumbnail(
                                                            course.Title,
                                                            course.ThumbnailUrl);
                                                }

                                                @if (!string.IsNullOrWhiteSpace(
                                                    dashboardThumbnail))
                                                {
                                                    <img src="@dashboardThumbnail"
                                                         alt="@course.Title"
                                                         onerror="this.hidden=true;this.nextElementSibling.hidden=false;" />

                                                    <div class="course-thumb-placeholder"
                                                         hidden
                                                         aria-hidden="true">

                                                        <svg class="ui-icon"
                                                             viewBox="0 0 24 24">

                                                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                                            <path d="M4 4v15.5"></path>
                                                            <path d="M6.5 2H20v15H6.5A2.5 2.5 0 0 0 4 19.5"></path>

                                                        </svg>

                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="course-thumb-placeholder"
                                                         aria-hidden="true">

                                                        <svg class="ui-icon"
                                                             viewBox="0 0 24 24">

                                                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                                            <path d="M4 4v15.5"></path>
                                                            <path d="M6.5 2H20v15H6.5A2.5 2.5 0 0 0 4 19.5"></path>

                                                        </svg>

                                                    </div>
                                                }

                                            </div>


                                            <div class="course-name">
                                                @course.Title
                                            </div>


                                        </div>

                                    </td>


                                    <td>
                                        @course.InstructorName
                                    </td>


                                    <td>
                                        @course.CategoryName
                                    </td>


                                    <td>
                                        @course.EnrollmentCount
                                    </td>


                                    <td>

                                        <span class="status-badge @(course.IsPublished ? "" : "draft")">

                                            @(course.IsPublished
                                                ? "Đã xuất bản"
                                                : "Bản nháp")

                                        </span>

                                    </td>


                                    <td>

                                        @(course.UpdatedAt
                                            .ToLocalTime()
                                            .ToString("dd/MM/yyyy"))

                                    </td>


                                    <td>

                                        <a asp-controller="AdminCourses"
                                           asp-action="Index"
                                           class="manage-link">
                                            Quản lý →
                                        </a>

                                    </td>


                                </tr>
                            }


                        </tbody>


                    </table>


                </div>
            }
            else
            {
                <div class="empty">
                    Hệ thống chưa có khóa học.
                </div>
            }


        </section>


    </div>

</section>
