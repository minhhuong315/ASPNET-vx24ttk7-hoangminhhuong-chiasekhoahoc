@model OnlineLearningPlatform.ViewModels.NotificationBellViewModel

@functions {

    string GetTimeText(DateTime createdAt)
    {
        var localTime =
            createdAt.ToLocalTime();

        var difference =
            DateTime.Now - localTime;


        if (difference.TotalMinutes < 1)
        {
            return "Vừa xong";
        }


        if (difference.TotalMinutes < 60)
        {
            return
                $"{Math.Max(1, (int)difference.TotalMinutes)} phút trước";
        }


        if (difference.TotalHours < 24)
        {
            return
                $"{Math.Max(1, (int)difference.TotalHours)} giờ trước";
        }


        if (difference.TotalDays < 7)
        {
            return
                $"{Math.Max(1, (int)difference.TotalDays)} ngày trước";
        }


        return localTime.ToString(
            "dd/MM/yyyy HH:mm");
    }
}

<style>

    /* =========================================
       WRAPPER
    ========================================= */

    .notification-shell {
        position: relative;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        white-space: normal;
    }


    /* =========================================
       NÚT CHUÔNG
    ========================================= */

    .notification-trigger {
        position: relative;

        width: 42px;
        height: 42px;

        margin: 0;
        padding: 0;

        border: none;
        border-radius: 10px;

        background: transparent;
        color: #0d6efd;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        cursor: pointer;

        transition:
            background .18s ease;
    }


    .notification-trigger:hover {
        background: #f2f7ff;
    }


    .notification-bell-icon {
        width: 22px;
        height: 22px;

        display: block;
    }


    /* =========================================
       BADGE SỐ CHƯA ĐỌC
    ========================================= */

    .notification-count {
        position: absolute;

        top: 1px;
        right: 0;

        min-width: 17px;
        height: 17px;

        padding: 0 4px;

        border: 2px solid #ffffff;
        border-radius: 20px;

        background: #ef4444;
        color: #ffffff;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 9px;
        font-weight: 800;

        line-height: 1;
    }


    /* =========================================
       DROPDOWN
    ========================================= */

    .notification-dropdown {
        position: absolute;

        top: calc(100% + 11px);
        right: -8px;

        z-index: 1500;

        width: 390px;
        max-width: calc(100vw - 24px);

        overflow: hidden;

        border: 1px solid #e4e9f0;
        border-radius: 14px;

        background: #ffffff;

        box-shadow:
            0 18px 45px
            rgba(31, 42, 64, .16);

        opacity: 0;

        visibility: hidden;

        pointer-events: none;

        transform:
            translateY(7px);

        transition:
            opacity .16s ease,
            visibility .16s ease,
            transform .16s ease;

        white-space: normal;
    }


    .notification-shell.open
    .notification-dropdown {
        opacity: 1;

        visibility: visible;

        pointer-events: auto;

        transform:
            translateY(0);
    }


    .notification-dropdown::before {
        content: "";

        position: absolute;

        top: -7px;
        right: 21px;

        width: 14px;
        height: 14px;

        border-top:
            1px solid #e4e9f0;

        border-left:
            1px solid #e4e9f0;

        background: #ffffff;

        transform:
            rotate(45deg);
    }


    /* =========================================
       HEADER
    ========================================= */

    .notification-header {
        padding: 17px 18px 14px;

        border-bottom:
            1px solid #edf0f4;

        white-space: normal;
    }


    .notification-title {
        margin-bottom: 3px;

        color: #172033;

        font-size: 15px;
        font-weight: 800;

        white-space: normal;
    }


    .notification-subtitle {
        color: #8b95a5;

        font-size: 11px;

        white-space: normal;
    }


    /* =========================================
       LIST
    ========================================= */

    .notification-list {
        max-height: 370px;

        overflow-y: auto;

        white-space: normal;
    }


    /* =========================================
       ITEM
    ========================================= */

    .notification-item {
        position: relative;

        display: grid;

        grid-template-columns:
            34px
            minmax(0, 1fr);

        gap: 12px;

        padding: 15px 18px;

        border-bottom:
            1px solid #f0f2f5;

        color: inherit;

        text-decoration: none;

        transition:
            background .15s ease;

        white-space: normal;
    }


    .notification-item:last-child {
        border-bottom: none;
    }


    .notification-item:hover {
        background: #f7faff;
    }


    .notification-item.unread {
        background: #edf4ff;
    }


    .notification-item.unread:hover {
        background: #e6f0ff;
    }


    /* =========================================
       ICON
    ========================================= */

    .notification-icon {
        width: 34px;
        height: 34px;

        border-radius: 10px;

        background: #edf4ff;
        color: #0d6efd;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 13px;
        font-weight: 800;

        flex-shrink: 0;
    }


    /* =========================================
       CONTENT
    ========================================= */

    .notification-content {
        min-width: 0;

        white-space: normal;
    }


    .notification-item-title {
        margin-bottom: 3px;

        color: #273142;

        font-size: 12px;
        font-weight: 800;

        line-height: 1.45;

        white-space: normal;

        overflow-wrap: anywhere;
    }


    .notification-message {
        min-width: 0;

        color: #667085;

        font-size: 11px;
        line-height: 1.55;

        white-space: normal;

        overflow-wrap: anywhere;

        word-break: normal;
    }


    .notification-time {
        margin-top: 5px;

        color: #98a2b3;

        font-size: 10px;

        white-space: normal;
    }


    /* =========================================
       CHẤM XANH CHƯA ĐỌC
    ========================================= */

    .notification-unread-dot {
        position: absolute;

        top: 19px;
        right: 15px;

        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: #0d6efd;
    }


    /* =========================================
       EMPTY
    ========================================= */

    .notification-empty {
        padding: 34px 20px;

        color: #8a94a3;

        font-size: 12px;

        text-align: center;

        white-space: normal;
    }


    /* =========================================
       FOOTER
    ========================================= */

    .notification-footer {
        padding: 13px 15px;

        border-top:
            1px solid #edf0f4;

        background: #ffffff;

        text-align: center;

        white-space: normal;
    }


    .notification-footer-link {
        color: #0d6efd;

        font-size: 11px;
        font-weight: 800;

        text-decoration: none;
    }


    .notification-footer-link:hover {
        color: #0b5ed7;
    }


    /* =========================================
       MOBILE
    ========================================= */

    @@media (max-width: 600px) {

        .notification-dropdown {
            position: fixed;

            top: 76px;
            right: 12px;

            width:
                min(
                    390px,
                    calc(100vw - 24px)
                );
        }

    }

</style>


<div class="notification-shell"
     data-notification-shell>


    <!-- =====================================
         CHUÔNG
    ====================================== -->

    <button type="button"
            class="notification-trigger"
            data-notification-trigger
            aria-label="Thông báo"
            aria-expanded="false">


        <svg class="notification-bell-icon"
             viewBox="0 0 24 24"
             fill="none"
             xmlns="http://www.w3.org/2000/svg">

            <path d="M18 8A6 6 0 0 0 6 8C6 15 3 15 3 17H21C21 15 18 15 18 8Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round" />

            <path d="M10 21H14"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round" />

        </svg>


        @if (Model.UnreadCount > 0)
        {
            <span class="notification-count">

                @(Model.UnreadCount > 99
                    ? "99+"
                    : Model.UnreadCount.ToString())

            </span>
        }


    </button>



    <!-- =====================================
         DROPDOWN
    ====================================== -->

    <div class="notification-dropdown"
         data-notification-dropdown>


        <!-- HEADER -->

        <div class="notification-header">


            <div class="notification-title">

                Thông báo

            </div>


            <div class="notification-subtitle">


                @if (Model.UnreadCount > 0)
                {
                    <span>

                        @Model.UnreadCount thông báo chưa đọc

                    </span>
                }
                else
                {
                    <span>

                        Bạn không có thông báo chưa đọc

                    </span>
                }


            </div>


        </div>



        <!-- LIST -->

        <div class="notification-list">


            @if (Model.Notifications != null &&
                 Model.Notifications.Any())
            {
                foreach (var notification
                    in Model.Notifications)
                {
                    string itemClass =
                        notification.IsRead
                            ? "notification-item"
                            : "notification-item unread";


                    string iconText =
                        notification.Type ==
                        "QuestionAnswered"
                            ? "✓"
                            : notification.Type ==
                              "NewQuestion"
                                ? "?"
                                : "i";


                    /*
                     * QUAN TRỌNG:
                     *
                     * Không redirect thẳng
                     * notification.RelatedUrl nữa.
                     *
                     * Phải đi qua
                     * Notifications/Open
                     * để:
                     *
                     * - đánh dấu đã đọc
                     * - giảm badge
                     * - xử lý notification cũ
                     * - chuyển đúng câu hỏi
                     */
                    <a asp-controller="Notifications"
                       asp-action="Open"
                       asp-route-id="@notification.Id"
                       class="@itemClass">


                        <div class="notification-icon">

                            @iconText

                        </div>


                        <div class="notification-content">


                            <div class="notification-item-title">

                                @notification.Title

                            </div>


                            <div class="notification-message">

                                @notification.Message

                            </div>


                            <div class="notification-time">

                                @GetTimeText(
                                    notification.CreatedAt)

                            </div>


                        </div>


                        @if (!notification.IsRead)
                        {
                            <span class="notification-unread-dot">
                            </span>
                        }


                    </a>
                }
            }
            else
            {
                <div class="notification-empty">

                    Chưa có thông báo nào.

                </div>
            }


        </div>



        <!-- FOOTER -->

        <div class="notification-footer">


            <a asp-controller="Notifications"
               asp-action="Index"
               class="notification-footer-link">

                Xem tất cả thông báo

            </a>


        </div>


    </div>


</div>



<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const shells =
                document.querySelectorAll(
                    "[data-notification-shell]"
                );


            shells.forEach(
                function (shell) {

                    const trigger =
                        shell.querySelector(
                            "[data-notification-trigger]"
                        );


                    const dropdown =
                        shell.querySelector(
                            "[data-notification-dropdown]"
                        );


                    if (!trigger ||
                        !dropdown) {
                        return;
                    }


                    /*
                     * CLICK CHUÔNG
                     */
                    trigger.addEventListener(
                        "click",
                        function (event) {

                            event.stopPropagation();


                            /*
                             * Đóng account dropdown
                             * nếu đang mở.
                             */
                            document
                                .querySelectorAll(
                                    "[data-dropdown].open"
                                )
                                .forEach(
                                    function (otherDropdown) {

                                        otherDropdown
                                            .classList
                                            .remove(
                                                "open"
                                            );

                                    }
                                );


                            const isOpen =
                                shell.classList.toggle(
                                    "open"
                                );


                            trigger.setAttribute(
                                "aria-expanded",
                                isOpen
                                    ? "true"
                                    : "false"
                            );

                        }
                    );


                    /*
                     * CLICK BÊN TRONG DROPDOWN
                     *
                     * Link vẫn hoạt động,
                     * nhưng document click
                     * không đóng trước.
                     */
                    dropdown.addEventListener(
                        "click",
                        function (event) {

                            event.stopPropagation();

                        }
                    );


                    /*
                     * CLICK RA NGOÀI
                     */
                    document.addEventListener(
                        "click",
                        function () {

                            shell.classList.remove(
                                "open"
                            );


                            trigger.setAttribute(
                                "aria-expanded",
                                "false"
                            );

                        }
                    );

                }
            );

        }
    );

</script>