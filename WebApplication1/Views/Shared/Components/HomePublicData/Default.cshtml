@model OnlineLearningPlatform.ViewModels.HomePublicDataViewModel

@{
    string ratingText = Model.AverageRating > 0 ? $"{Model.AverageRating:0.0}/5" : "—";
    string LevelText(string level) => level switch { "Beginner" => "Cơ bản", "Intermediate" => "Trung cấp", "Advanced" => "Nâng cao", _ => level };
    string LevelClass(string level) => level switch { "Intermediate" => "edg-level--intermediate", "Advanced" => "edg-level--advanced", _ => "edg-level--beginner" };
    string ThumbnailForSlug(string slug) => Url.Content($"~/images/course-thumbnails/by-slug/{slug}.png");
    string placeholderThumbnail = Url.Content("~/images/course-thumbnails/by-slug/course-placeholder.svg");
}

<section class="edg-stats-section">
    <div class="edg-container">
        <div class="edg-stats">
            <div class="edg-stat-card">
                <span class="edg-stat-icon edg-stat-icon--blue" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 5.5h6.2c1.1 0 1.9.3 2.3 1 .5-.7 1.3-1 2.3-1h6.2v13h-6.2c-1 0-1.8.3-2.3 1-.4-.7-1.2-1-2.3-1H3.5z"/><path d="M12 6.5v13"/></svg></span>
                <span><strong class="edg-stat-value">@Model.PublishedCourseCount</strong><span class="edg-stat-label">Khóa học đã xuất bản</span></span>
            </div>
            <div class="edg-stat-card">
                <span class="edg-stat-icon edg-stat-icon--green" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.4"/><path d="M3.8 19c.3-3.5 2.2-5.5 5.2-5.5s5 2 5.2 5.5"/><path d="M14.2 14.6c.8-.7 1.8-1.1 3-1.1 2.3 0 3.7 1.7 4 4.5"/></svg></span>
                <span><strong class="edg-stat-value">@Model.InstructorCount</strong><span class="edg-stat-label">Giảng viên đang hoạt động</span></span>
            </div>
            <div class="edg-stat-card">
                <span class="edg-stat-icon edg-stat-icon--violet" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.2"/><path d="M5 19c.3-4 2.8-6.2 7-6.2S18.7 15 19 19"/></svg></span>
                <span><strong class="edg-stat-value">@Model.StudentCount</strong><span class="edg-stat-label">Học viên đang hoạt động</span></span>
            </div>
            <div class="edg-stat-card">
                <span class="edg-stat-icon edg-stat-icon--orange" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 2.5 5.2 5.7.8-4.1 4 1 5.7-5.1-2.7-5.1 2.7 1-5.7-4.1-4 5.7-.8z"/></svg></span>
                <span><strong class="edg-stat-value">@ratingText</strong><span class="edg-stat-label">Đánh giá trung bình</span></span>
            </div>
        </div>
    </div>
</section>

<section class="edg-section edg-section--soft">
    <div class="edg-container">
        <div class="edg-section-heading">
            <div><span class="edg-section-kicker">Danh mục</span><h2 class="edg-section-title">Khám phá theo lĩnh vực</h2><p class="edg-section-description">Chọn lĩnh vực Công nghệ thông tin phù hợp với mục tiêu học tập của bạn.</p></div>
            <a asp-controller="Courses" asp-action="Index" class="edg-section-link">Xem tất cả khóa học <span aria-hidden="true">→</span></a>
        </div>
        @if (Model.Categories.Any())
        {
            <div class="edg-category-grid">
                @foreach (var category in Model.Categories)
                {
                    <a asp-controller="Courses" asp-action="Index" asp-route-categoryId="@category.Id" class="edg-category-card">
                        <span class="edg-category-icon" aria-hidden="true">@category.Icon</span>
                        <span class="edg-category-name">@category.Name</span>
                        <span class="edg-category-count">@category.PublishedCourseCount khóa học</span>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="edg-empty-state">Hiện chưa có danh mục đang hoạt động.</div>
        }
    </div>
</section>

<section class="edg-section" id="featured-courses">
    <div class="edg-container">
        <div class="edg-section-heading">
            <div><span class="edg-section-kicker">Đề xuất học tập</span><h2 class="edg-section-title">Khóa học nổi bật</h2><p class="edg-section-description">Các khóa học đã xuất bản được sắp xếp theo trạng thái nổi bật và mức độ quan tâm hiện có.</p></div>
            <a asp-controller="Courses" asp-action="Index" class="edg-section-link">Xem tất cả khóa học <span aria-hidden="true">→</span></a>
        </div>
        @if (Model.FeaturedCourses.Any())
        {
            <div class="edg-course-grid">
                @foreach (var course in Model.FeaturedCourses)
                {
                    string thumbnail = ThumbnailForSlug(course.Slug);
                    <article class="edg-course-card">
                        <a asp-controller="Courses" asp-action="Details" asp-route-slug="@course.Slug" class="edg-course-media">
                            <img src="@thumbnail" alt="" loading="lazy" onerror="this.onerror=null;this.src='@placeholderThumbnail';" />
                            @if (course.IsFeatured) { <span class="edg-featured-badge">Nổi bật</span> }
                        </a>
                        <div class="edg-course-body">
                            <div class="edg-course-meta"><span class="edg-course-category">@course.CategoryName</span><span class="edg-course-level @LevelClass(course.Level)">@LevelText(course.Level)</span></div>
                            <h3 class="edg-course-title"><a asp-controller="Courses" asp-action="Details" asp-route-slug="@course.Slug">@course.Title</a></h3>
                            <div class="edg-course-instructor"><span class="edg-course-avatar" aria-hidden="true">GV</span><span>@course.InstructorName</span></div>
                            <div class="edg-course-footer"><span class="edg-course-students">@course.EnrollmentCount học viên</span><a asp-controller="Courses" asp-action="Details" asp-route-slug="@course.Slug" class="edg-course-link">Xem chi tiết <span aria-hidden="true">→</span></a></div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="edg-empty-state">Hiện chưa có khóa học đã xuất bản.</div>
        }
    </div>
</section>
