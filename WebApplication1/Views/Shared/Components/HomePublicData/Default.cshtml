@using OnlineLearningPlatform.Helpers
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment CourseImageHost
@model OnlineLearningPlatform.ViewModels.HomePublicDataViewModel

@{
    string ratingText = Model.AverageRating > 0 ? $"{Model.AverageRating:0.0}/5" : "—";
    string LevelText(string level) => level switch { "Beginner" => "Cơ bản", "Intermediate" => "Trung cấp", "Advanced" => "Nâng cao", _ => level };
    string LevelClass(string level) => level switch { "Intermediate" => "edg-level--intermediate", "Advanced" => "edg-level--advanced", _ => "edg-level--beginner" };

    string CategoryIconKey(
        string name,
        string icon)
    {
        string value =
            $"{name} {icon}"
                .Trim()
                .ToLowerInvariant();

        if (value.Contains("trí tuệ") ||
            value.Contains("artificial intelligence") ||
            value.Contains(" ai"))
        {
            return "ai";
        }

        if (value.Contains("asp.net") ||
            value.Contains(".net"))
        {
            return "dotnet";
        }

        if (value.Contains("cơ sở dữ liệu") ||
            value.Contains("database") ||
            value.Contains("sql") ||
            value.Contains(" db"))
        {
            return "database";
        }

        if (value.Contains("python") ||
            value.Contains(" py"))
        {
            return "python";
        }

        if (value.Contains("frontend") ||
            value.Contains("javascript") ||
            value.Contains(" js"))
        {
            return "frontend";
        }

        if (value.Contains("ui/ux") ||
            value.Contains("ui ux") ||
            value.Contains("thiết kế"))
        {
            return "design";
        }

        if (value.Contains("git") ||
            value.Contains("devops"))
        {
            return "git";
        }

        if (value.Contains("lập trình web") ||
            value.Contains(" web"))
        {
            return "web";
        }

        if (value.Contains("ngôn ngữ") ||
            value.Contains("c#") ||
            value.Contains("code"))
        {
            return "code";
        }

        return "general";
    }
}

<section class="edg-stats-section">
    <div class="edg-container">
        <div class="edg-stats">
            <div class="edg-stat-card">
                <span class="edg-stat-icon edg-stat-icon--blue" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 5.5h6.2c1.1 0 1.9.3 2.3 1 .5-.7 1.3-1 2.3-1h6.2v13h-6.2c-1 0-1.8.3-2.3 1-.4-.7-1.2-1-2.3-1H3.5z"/><path d="M12 6.5v13"/></svg></span>
                <span><strong class="edg-stat-value">@Model.PublishedCourseCount</strong><span class="edg-stat-label">Khóa học đã xuất bản</span></span>
            </div>
            <div class="edg-stat-card">
                <span class="edg-stat-icon edg-stat-icon--green" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.4"/><path d="M3.8 19c.3-3.5 2.2-5.5 5.2-5.5s5 2 5.2 5.5"/><path d="M14.2 14.6c.8-.7 1.8-1.1 3-1.1 2.3 0 3.7 1.7 4 4.5"/></svg></span>
                <span><strong class="edg-stat-value">@Model.InstructorCount</strong><span class="edg-stat-label">Giảng viên đang hoạt động</span></span>
            </div>
            <div class="edg-stat-card">
                <span class="edg-stat-icon edg-stat-icon--violet" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.2"/><path d="M5 19c.3-4 2.8-6.2 7-6.2S18.7 15 19 19"/></svg></span>
                <span><strong class="edg-stat-value">@Model.StudentCount</strong><span class="edg-stat-label">Học viên đang hoạt động</span></span>
            </div>
            <div class="edg-stat-card">
                <span class="edg-stat-icon edg-stat-icon--orange" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 2.5 5.2 5.7.8-4.1 4 1 5.7-5.1-2.7-5.1 2.7 1-5.7-4.1-4 5.7-.8z"/></svg></span>
                <span><strong class="edg-stat-value">@ratingText</strong><span class="edg-stat-label">Đánh giá trung bình</span></span>
            </div>
        </div>
    </div>
</section>

<section class="edg-section edg-section--soft edg-category-section">

    <div class="edg-container">

        <div class="edg-section-heading">

            <div>

                <span class="edg-section-kicker">
                    Danh mục
                </span>

                <h2 class="edg-section-title">
                    Khám phá theo lĩnh vực
                </h2>

                <p class="edg-section-description">
                    Chọn lĩnh vực Công nghệ thông tin phù hợp với
                    mục tiêu học tập của bạn.
                </p>

            </div>

            <a asp-controller="Courses"
               asp-action="Index"
               class="edg-section-link">
                Xem tất cả khóa học
                <span aria-hidden="true">→</span>
            </a>

        </div>


        @if (Model.Categories.Any())
        {
            <div class="edg-category-grid">

                @foreach (var category in Model.Categories)
                {
                    string iconKey =
                        CategoryIconKey(
                            category.Name,
                            category.Icon);

                    <a asp-controller="Courses"
                       asp-action="Index"
                       asp-route-categoryId="@category.Id"
                       class="edg-category-card">

                        <span class="edg-category-icon edg-category-icon--@iconKey"
                              aria-hidden="true">

                            @if (iconKey == "ai")
                            {
                                <svg viewBox="0 0 24 24"
                                     focusable="false">
                                    <path d="M9.5 4.2A3.1 3.1 0 0 0 6.4 7.3v.2A3.4 3.4 0 0 0 4 10.7a3.4 3.4 0 0 0 2.4 3.2v.4a3.1 3.1 0 0 0 5.6 1.9V7.3a3.1 3.1 0 0 0-2.5-3.1Z" />
                                    <path d="M14.5 4.2a3.1 3.1 0 0 1 3.1 3.1v.2a3.4 3.4 0 0 1 2.4 3.2 3.4 3.4 0 0 1-2.4 3.2v.4a3.1 3.1 0 0 1-5.6 1.9V7.3a3.1 3.1 0 0 1 2.5-3.1Z" />
                                    <path d="M7.5 9.5H10v2M16.5 8.5H14v3M8 15h2v-2M16 15h-2v-2" />
                                    <circle cx="7.5" cy="9.5" r=".65" />
                                    <circle cx="16.5" cy="8.5" r=".65" />
                                    <circle cx="8" cy="15" r=".65" />
                                    <circle cx="16" cy="15" r=".65" />
                                </svg>
                            }
                            else if (iconKey == "dotnet")
                            {
                                <svg viewBox="0 0 24 24"
                                     focusable="false">
                                    <rect x="3" y="4" width="18" height="16" rx="3" />
                                    <path d="m9 9-3 3 3 3M15 9l3 3-3 3M13 7l-2 10" />
                                </svg>
                            }
                            else if (iconKey == "database")
                            {
                                <svg viewBox="0 0 24 24"
                                     focusable="false">
                                    <ellipse cx="12" cy="5.5" rx="7.5" ry="3" />
                                    <path d="M4.5 5.5v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-6" />
                                    <path d="M4.5 11.5v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-6" />
                                </svg>
                            }
                            else if (iconKey == "python")
                            {
                                <svg viewBox="0 0 24 24"
                                     focusable="false">
                                    <path d="M8.5 3.5h6a3 3 0 0 1 3 3V10h-8a3 3 0 0 0-3 3v2.5h-1a3 3 0 0 1-3-3v-4a3 3 0 0 1 3-3h3Z" />
                                    <path d="M15.5 20.5h-6a3 3 0 0 1-3-3V14h8a3 3 0 0 0 3-3V8.5h1a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3h-3Z" />
                                    <circle cx="12.5" cy="6.5" r=".8" />
                                    <circle cx="11.5" cy="17.5" r=".8" />
                                </svg>
                            }
                            else if (iconKey == "frontend")
                            {
                                <svg viewBox="0 0 24 24"
                                     focusable="false">
                                    <rect x="3" y="4" width="18" height="16" rx="3" />
                                    <path d="M3 8h18M8.5 12l-2 2 2 2M15.5 12l2 2-2 2M13 11l-2 6" />
                                </svg>
                            }
                            else if (iconKey == "design")
                            {
                                <svg viewBox="0 0 24 24"
                                     focusable="false">
                                    <path d="M12 3a9 9 0 1 0 0 18h1.2a2 2 0 0 0 1.7-3c-.7-1.1.1-2.5 1.4-2.5H18a3 3 0 0 0 3-3C21 7.3 17 3 12 3Z" />
                                    <circle cx="7.5" cy="10" r="1" />
                                    <circle cx="10" cy="6.8" r="1" />
                                    <circle cx="15" cy="7.2" r="1" />
                                    <circle cx="17" cy="11" r="1" />
                                </svg>
                            }
                            else if (iconKey == "git")
                            {
                                <svg viewBox="0 0 24 24"
                                     focusable="false">
                                    <circle cx="6" cy="5" r="2" />
                                    <circle cx="6" cy="19" r="2" />
                                    <circle cx="18" cy="12" r="2" />
                                    <path d="M6 7v10M8 7.5c5 .4 5.5 4.5 8 4.5" />
                                </svg>
                            }
                            else if (iconKey == "web")
                            {
                                <svg viewBox="0 0 24 24"
                                     focusable="false">
                                    <circle cx="12" cy="12" r="9" />
                                    <path d="M3.5 12h17M12 3c2.5 2.4 4 5.4 4 9s-1.5 6.6-4 9c-2.5-2.4-4-5.4-4-9s1.5-6.6 4-9Z" />
                                </svg>
                            }
                            else if (iconKey == "code")
                            {
                                <svg viewBox="0 0 24 24"
                                     focusable="false">
                                    <path d="m8.5 7-5 5 5 5M15.5 7l5 5-5 5M14 4l-4 16" />
                                </svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24"
                                     focusable="false">
                                    <rect x="4" y="4" width="6" height="6" rx="1.5" />
                                    <rect x="14" y="4" width="6" height="6" rx="1.5" />
                                    <rect x="4" y="14" width="6" height="6" rx="1.5" />
                                    <rect x="14" y="14" width="6" height="6" rx="1.5" />
                                </svg>
                            }

                        </span>


                        <span class="edg-category-name">
                            @category.Name
                        </span>

                        <span class="edg-category-count">
                            @category.PublishedCourseCount khóa học
                        </span>

                    </a>
                }

            </div>
        }
        else
        {
            <div class="edg-empty-state">
                Hiện chưa có danh mục đang hoạt động.
            </div>
        }

    </div>

</section>

<section class="edg-section edg-featured-section"
         id="featured-courses">

    <div class="edg-container">

        <div class="edg-section-heading">

            <div>

                <span class="edg-section-kicker">
                    Đề xuất học tập
                </span>

                <h2 class="edg-section-title">
                    Khóa học nổi bật
                </h2>

                <p class="edg-section-description">
                    Các khóa học đã xuất bản được sắp xếp theo
                    trạng thái nổi bật và mức độ quan tâm hiện có.
                </p>

            </div>

            <a asp-controller="Courses"
               asp-action="Index"
               class="edg-section-link">
                Xem tất cả khóa học
                <span aria-hidden="true">→</span>
            </a>

        </div>


        @if (Model.FeaturedCourses.Any())
        {
            <div class="edg-course-grid">

                @foreach (var course in Model.FeaturedCourses)
                {
                    var thumbnail = CourseThumbnailResolver.Resolve(
                        Url, CourseImageHost, course.ThumbnailUrl, course.Slug);

                    <article class="edg-course-card">

                        <a asp-controller="Courses"
                           asp-action="Details"
                           asp-route-slug="@course.Slug"
                           class="edg-course-media"
                           aria-label="Xem khóa học @course.Title">

                            <img src="@thumbnail.Source"
                                 alt="@course.Title"
                                 loading="lazy"
                                 data-ed-thumb-fallback="@thumbnail.Fallback"
                                 data-ed-thumb-placeholder="@thumbnail.Placeholder"
                                 onerror="@CourseThumbnailResolver.OnErrorHandler" />

                            @if (course.IsFeatured)
                            {
                                <span class="edg-featured-badge">
                                    Nổi bật
                                </span>
                            }

                        </a>


                        <div class="edg-course-body">

                            <div class="edg-course-meta">

                                <span class="edg-course-category"
                                      title="@course.CategoryName">
                                    @course.CategoryName
                                </span>

                                <span class="edg-course-level @LevelClass(course.Level)">
                                    @LevelText(course.Level)
                                </span>

                            </div>


                            <div class="edg-course-title"
                                 role="heading"
                                 aria-level="3">

                                <a asp-controller="Courses"
                                   asp-action="Details"
                                   asp-route-slug="@course.Slug">
                                    @course.Title
                                </a>

                            </div>


                            <div class="edg-course-footer">

                                <a asp-controller="Courses"
                                   asp-action="Details"
                                   asp-route-slug="@course.Slug"
                                   class="edg-course-link">
                                    Xem chi tiết
                                    <span aria-hidden="true">→</span>
                                </a>

                            </div>

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="edg-empty-state">
                Hiện chưa có khóa học đã xuất bản.
            </div>
        }

    </div>

</section>
