@using OnlineLearningPlatform.Helpers
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment CourseImageHost
@model OnlineLearningPlatform.ViewModels.InstructorHomeDashboardViewModel

<style>
    /* Chỉ trang Home khi render InstructorHomeDashboard. Không sửa shell của các role khác. */
    body.role-workspace-page:has(.instructor-home) {
        --ed-page-bg: #F5F7FB;
    }

    body.role-workspace-page .home-page:has(> .instructor-home) {
        background: transparent;
    }

    /* =========================================================
       INSTRUCTOR DASHBOARD V2
       - Layout riêng, không phụ thuộc dashboard-grid chung
       - Căn giữa theo cách Admin Dashboard đang dùng
       - Scope toàn bộ dưới .instructor-home
    ========================================================= */

    .instructor-home {
        width: 100%;
        min-height: 0;
        padding: 0;
        background: transparent;
        color: #475569;
        font-family: Inter, sans-serif;
    }

    .instructor-home-container {
        width: 100%;
        max-width: var(--ed-ds-wide);
        margin: 0 auto;
        padding: 0;
        box-sizing: border-box;
    }


    /* =========================================================
       HEADER
    ========================================================= */

    .instructor-home .instructor-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 22px;
    }

    .instructor-home .instructor-heading-copy {
        min-width: 0;
    }

    .instructor-home .instructor-eyebrow {
        margin-bottom: 6px;
        color: #2563eb;
        font-size: var(--ed-type-label);
        font-weight: var(--ed-weight-label);
        letter-spacing: .02em;
        text-transform: uppercase;
    }

    .instructor-home .instructor-title {
        margin: 0;
        color: var(--ed-ds-heading);
        font-size: var(--ed-type-page-title) !important; /* global typography h1 dùng !important */
        font-weight: var(--ed-weight-page);
        line-height: var(--ed-lh-heading);
        letter-spacing: -0.025em;
    }

    .instructor-home .instructor-description {
        max-width: 720px;
        margin: 8px 0 0;
        color: #64748b;
        font-size: var(--ed-type-body);
        font-weight: var(--ed-weight-body);
        line-height: var(--ed-lh-body);
    }

    .instructor-home .create-course-button {
        min-height: 44px;
        margin-top: 2px;
        padding: 0 18px;
        border-radius: 10px;
        background: #2563EB;
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: var(--ed-type-button);
        font-weight: var(--ed-weight-button);
        line-height: 1.2;
        text-decoration: none;
        white-space: nowrap;
        transition:
            background .18s ease,
            transform .18s ease;
    }

    .instructor-home .create-course-button:hover {
        background: #1D4ED8;
        color: #ffffff;
        transform: translateY(-1px);
    }


    /* =========================================================
       STATS
    ========================================================= */

    .instructor-home .instructor-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 18px;
    }

    .instructor-home .instructor-stat {
        min-width: 0;
        min-height: 108px;
        padding: 16px;
        border: 1px solid #e2e8f0;
        border-radius: 13px;
        background: #ffffff;
        color: inherit;
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr);
        gap: 13px;
        align-items: center;
        text-decoration: none;
        box-shadow: none;
        transition:
            border-color .18s ease,
            box-shadow .18s ease,
            transform .18s ease;
    }

    .instructor-home .instructor-stat:hover {
        color: inherit;
        border-color: #cbd8e9;
        box-shadow:
            0 9px 24px
            rgba(36, 68, 112, .07);
        transform: translateY(-1px);
    }

    .instructor-home .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .instructor-home .ui-icon {
        width: 21px;
        height: 21px;
        display: block;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.9;
        stroke-linecap: round;
        stroke-linejoin: round;
        flex-shrink: 0;
    }

    .instructor-home .stat-copy {
        display: flex;
        flex-direction: column;
        min-width: 0;
        gap: 4px;
    }

    .instructor-home .stat-icon.blue {
        background: #EFF6FF;
        color: #2563EB;
    }

    .instructor-home .stat-icon.green {
        background: #eaf9f2;
        color: #18a76f;
    }

    .instructor-home .stat-icon.orange {
        background: #fff3df;
        color: #f59e0b;
    }

    .instructor-home .stat-icon.purple {
        background: #f1ebff;
        color: #7c4dff;
    }

    .instructor-home .stat-value {
        color: var(--ed-ds-heading);
        font-size: var(--ed-type-stat);
        font-weight: var(--ed-weight-stat);
        line-height: 1.15;
        order: 2;
    }

    .instructor-home .stat-label {
        margin-top: 0;
        color: #64748B;
        font-size: var(--ed-type-label);
        font-weight: var(--ed-weight-label);
        line-height: var(--ed-lh-meta);
        order: 1;
    }


    /* =========================================================
       MAIN CONTENT
    ========================================================= */

    .instructor-home .instructor-content-grid {
        display: grid;
        grid-template-columns:
            minmax(0, 1.9fr)
            minmax(280px, 1fr);
        gap: 18px;
        align-items: start;
    }

    .instructor-home .instructor-panel {
        min-width: 0;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 15px;
        background: #ffffff;
        box-shadow:
            0 7px 24px
            rgba(36, 68, 112, .04);
    }

    .instructor-home .panel-header {
        min-height: 64px;
        padding: 0 18px;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

    .instructor-home .panel-heading {
        margin: 0;
        color: var(--ed-ds-heading);
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: var(--ed-type-section-title) !important; /* global typography h2 */
        font-weight: var(--ed-weight-section);
        line-height: var(--ed-lh-heading);
    }

    .instructor-home .panel-heading-icon {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        border-radius: 11px;
        background: #eaf3ff;
        color: #2563EB;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .instructor-home .panel-link {
        color: var(--ed-ds-primary);
        font-size: var(--ed-type-button);
        font-weight: var(--ed-weight-button);
        text-decoration: none;
        white-space: nowrap;
    }

    .instructor-home .panel-link:hover {
        color: #075ee8;
    }


    /* =========================================================
       COURSE TABLE
    ========================================================= */

    .instructor-home .course-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .instructor-home .course-table {
        width: 100%;
        min-width: 730px;
        border-collapse: collapse;
        table-layout: fixed;
    }

    .instructor-home .course-table th,
    .instructor-home .course-table td {
        padding: 13px 14px;
        border-bottom: 1px solid #edf2f7;
        vertical-align: middle;
    }

    .instructor-home .course-table tr:last-child td {
        border-bottom: none;
    }

    .instructor-home .course-table th {
        background: #fbfcfe;
        color: #64748b;
        font-size: var(--ed-type-table);
        font-weight: var(--ed-weight-table);
        line-height: var(--ed-lh-table);
        text-align: left;
    }

    .instructor-home .course-table td {
        color: #334155;
        font-size: var(--ed-type-table);
        font-weight: var(--ed-weight-table);
        line-height: var(--ed-lh-table);
    }

    @@media (min-width: 1101px) {
    .instructor-home .course-table th:nth-child(1),
    .instructor-home .course-table td:nth-child(1) {
        width: 48%;
    }

    .instructor-home .course-table th:nth-child(2),
    .instructor-home .course-table td:nth-child(2) {
        width: 10%;
        text-align: center;
    }

    .instructor-home .course-table th:nth-child(3),
    .instructor-home .course-table td:nth-child(3) {
        width: 10%;
        text-align: center;
    }

    .instructor-home .course-table th:nth-child(4),
    .instructor-home .course-table td:nth-child(4) {
        width: 18%;
        text-align: center;
    }

    .instructor-home .course-table th:nth-child(5),
    .instructor-home .course-table td:nth-child(5) {
        width: 14%;
        text-align: right;
    }

    }

    .instructor-home .course-cell {
        min-width: 0;
        display: grid;
        grid-template-columns:
            74px
            minmax(0, 1fr);
        gap: 12px;
        align-items: center;
    }

    .instructor-home .course-thumb {
        width: 74px;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 9px;
        background:
            linear-gradient(
                135deg,
                #0f4fbb,
                #6d58e7
            );
    }

    .instructor-home .course-thumb img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
    }


    .instructor-home .course-thumb-fallback {
        width: 100%;
        height: 100%;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #EFF6FF;
        color: #2563EB;

        font-size: var(--ed-type-meta);
        font-weight: var(--ed-weight-meta);
    }

    .instructor-home .course-info {
        min-width: 0;
    }

    .instructor-home .instructor-course-name {
        overflow: hidden;
        color: var(--ed-ds-heading);
        font-size: var(--ed-type-card-title);
        font-weight: var(--ed-weight-card);
        line-height: var(--ed-lh-heading);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow-wrap: anywhere;
    }

    .instructor-home .instructor-course-category {
        margin-top: 3px;
        color: #64748b;
        font-size: var(--ed-type-meta);
        font-weight: var(--ed-weight-meta);
        line-height: var(--ed-lh-meta);
    }

    .instructor-home .course-status {
        display: inline-flex;
        padding: 5px 8px;
        border-radius: 999px;
        background: #eaf9f2;
        color: #148759;
        font-size: var(--ed-type-badge);
        font-weight: var(--ed-weight-badge);
        line-height: var(--ed-lh-meta);
        white-space: nowrap;
    }

    .instructor-home .course-status.draft {
        background: #fff3df;
        color: #b97400;
    }

    .instructor-home .manage-link {
        color: var(--ed-ds-primary);
        font-size: var(--ed-type-button);
        font-weight: var(--ed-weight-button);
        text-decoration: none;
        white-space: nowrap;
    }

    .instructor-home .manage-link:hover {
        color: #075ee8;
    }


    /* =========================================================
       ATTENTION
    ========================================================= */

    .instructor-home .attention-list {
        padding: 12px;
        display: grid;
        gap: 10px;
    }

    .instructor-home .attention-copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
    }

    .instructor-home .attention-item {
        min-height: 78px;
        padding: 12px;
        border: 1px solid #e7edf5;
        border-radius: 12px;
        color: inherit;
        display: grid;
        grid-template-columns:
            44px
            minmax(0, 1fr)
            18px;
        gap: 11px;
        align-items: center;
        text-decoration: none;
        transition:
            background .16s ease,
            border-color .16s ease;
    }

    .instructor-home .attention-item:hover {
        color: inherit;
        border-color: #d6e2f2;
        background: #f8fbff;
    }

    .instructor-home .attention-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #fff0f4;
        color: #ef476f;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    /* Instructor v37: không sinh icon mask thứ hai từ dashboard-polish.css. */
    .role-dashboard--instructor.instructor-home .attention-item > .attention-icon::before {
        content: none;
    }

    .role-dashboard--instructor.instructor-home .attention-item > .attention-icon .ui-icon {
        width: 20px;
        height: 20px;
    }

    .instructor-home .attention-icon.orange {
        background: #fff3df;
        color: #f59e0b;
    }

    .instructor-home .attention-icon.blue {
        background: #eaf3ff;
        color: var(--ed-ds-primary);
    }

    .instructor-home .attention-value {
        color: var(--ed-ds-heading);
        font-size: var(--ed-type-stat);
        font-weight: var(--ed-weight-stat);
        line-height: 1.1;
    }

    .instructor-home .attention-label {
        margin-top: 4px;
        color: #334155;
        font-size: var(--ed-type-label);
        font-weight: var(--ed-weight-label);
        line-height: var(--ed-lh-meta);
    }

    .instructor-home .attention-arrow {
        color: #8da2bd;
        font-size: 18px;
        line-height: 1;
        text-align: center;
    }

    .instructor-home .dashboard-empty {
        padding: 42px 20px;
        color: #64748b;
        font-size: var(--ed-type-meta);
        font-weight: var(--ed-weight-meta);
        line-height: var(--ed-lh-meta);
        text-align: center;
    }


    /* =========================================================
       RESPONSIVE: table → one card per existing <tr>; no duplicated actions
    ========================================================= */

    @@media (max-width: 1420px) {
        .instructor-home .instructor-content-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @@media (max-width: 1180px) {
        .instructor-home .instructor-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 1100px) {
        .instructor-home .course-table-wrap {
            overflow-x: visible;
            padding: 12px;
        }

        .instructor-home .instructor-course-name {
            display: block;
            -webkit-line-clamp: unset;
            overflow: visible;
        }

        .instructor-home .course-table,
        .instructor-home .course-table tbody {
            display: block;
            width: 100%;
            min-width: 0;
        }

        .instructor-home .course-table thead {
            display: none;
        }

        .instructor-home .course-table tbody {
            display: grid;
            gap: 12px;
        }

        .instructor-home .course-table tbody tr {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px 14px;
            padding: 14px;
            border: 1px solid #E2E8F0;
            border-radius: 12px;
            background: #FFFFFF;
            min-width: 0;
        }

        .instructor-home .course-table tbody td,
        .instructor-home .course-table tbody tr:last-child td {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
            min-width: 0;
            width: auto;
            padding: 0;
            border: 0;
            text-align: left;
        }

        .instructor-home .course-table tbody td:first-child {
            grid-column: 1 / -1;
        }

        .instructor-home .course-table tbody td:nth-child(4),
        .instructor-home .course-table tbody td:nth-child(5) {
            grid-column: 1 / -1;
        }

        .instructor-home .course-table tbody td[data-label]::before {
            content: attr(data-label);
            color: #64748B;
            font-size: 12px;
            font-weight: 500;
            line-height: 1.35;
        }

        .instructor-home .course-table tbody td:nth-child(5) {
            margin-top: 2px;
        }

        .instructor-home .manage-link {
            width: 100%;
            min-height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #BFDBFE;
            border-radius: 9px;
            background: #EFF6FF;
            color: #2563EB;
        }
    }

    @@media (max-width: 375px) {
        .instructor-home .instructor-stats {
            grid-template-columns: 1fr;
        }
    }

</style>


<section class="role-dashboard role-dashboard--instructor instructor-home ed-dash">

    <div class="instructor-home-container ed-container ed-container--wide">


        <header class="instructor-heading">

            <div class="instructor-heading-copy">

                <div class="instructor-eyebrow">
                    Giảng viên
                </div>

                <h1 class="instructor-title">
                    Hoạt động giảng dạy
                </h1>

                <p class="instructor-description">
                    Quản lý khóa học, theo dõi học viên
                    và nắm bắt tình hình giảng dạy trên EduLearn.
                </p>

            </div>


            <a asp-controller="InstructorCourses"
               asp-action="Create"
               class="create-course-button">
                + Tạo khóa học mới
            </a>

        </header>


        <div class="instructor-stats">

            <a asp-controller="InstructorCourses" asp-action="Index" class="instructor-stat ed-stat">
                <span class="stat-icon ed-stat-icon blue" aria-hidden="true">
                    <svg class="ui-icon" viewBox="0 0 24 24">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                        <path d="M4 4v15.5"></path>
                        <path d="M6.5 2H20v15H6.5A2.5 2.5 0 0 0 4 19.5"></path>
                    </svg>
                </span>
                <span class="stat-copy">
                    <span class="stat-label ed-stat-label">Khóa học</span>
                    <span class="stat-value ed-stat-value">@Model.TotalCourses</span>
                </span>
            </a>

            <a asp-controller="InstructorStudents" asp-action="Index" class="instructor-stat ed-stat">
                <span class="stat-icon ed-stat-icon green" aria-hidden="true">
                    <svg class="ui-icon" viewBox="0 0 24 24">
                        <circle cx="9" cy="8" r="3"></circle>
                        <path d="M3 20v-2a6 6 0 0 1 12 0v2"></path>
                        <path d="M17 5a3 3 0 0 1 0 6"></path>
                        <path d="M18 14a5 5 0 0 1 3 5v1"></path>
                    </svg>
                </span>
                <span class="stat-copy">
                    <span class="stat-label ed-stat-label">Học viên</span>
                    <span class="stat-value ed-stat-value">@Model.UniqueStudents</span>
                </span>
            </a>

            <a asp-controller="InstructorAnalytics" asp-action="Index" class="instructor-stat ed-stat">
                <span class="stat-icon ed-stat-icon orange" aria-hidden="true">
                    <svg class="ui-icon" viewBox="0 0 24 24">
                        <path d="M7 3h7l4 4v14H7z"></path>
                        <path d="M14 3v5h5M10 13h5M10 17h5"></path>
                    </svg>
                </span>
                <span class="stat-copy">
                    <span class="stat-label ed-stat-label">Bài học</span>
                    <span class="stat-value ed-stat-value">@Model.TotalLessons</span>
                </span>
            </a>

            <a asp-controller="InstructorAnalytics" asp-action="Index" class="instructor-stat ed-stat">
                <span class="stat-icon ed-stat-icon purple" aria-hidden="true">
                    <svg class="ui-icon" viewBox="0 0 24 24">
                        <path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1L12 2Z"></path>
                    </svg>
                </span>
                <span class="stat-copy">
                    <span class="stat-label ed-stat-label">Đánh giá trung bình</span>
                    <span class="stat-value ed-stat-value">@(Model.AverageRating > 0
                            ? Model.AverageRating.ToString("0.0")
                            : "—")</span>
                </span>
            </a>
        </div>

        <div class="instructor-content-grid">


            <section class="instructor-panel ed-panel">

                <div class="panel-header">

                    <h2 class="panel-heading">

                        <span class="panel-heading-icon" aria-hidden="true">
                            <svg class="ui-icon" viewBox="0 0 24 24">
                                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                <path d="M4 4v15.5"></path>
                                <path d="M6.5 2H20v15H6.5A2.5 2.5 0 0 0 4 19.5"></path>
                            </svg>
                        </span>

                        Khóa học của tôi

                    </h2>


                    <a asp-controller="InstructorCourses"
                       asp-action="Index"
                       class="panel-link">
                        Xem tất cả →
                    </a>

                </div>


                @if (Model.RecentCourses.Any())
                {
                    <div class="course-table-wrap">

                        <table class="course-table">

                            <thead>
                                <tr>
                                    <th>Khóa học</th>
                                    <th>Học viên</th>
                                    <th>Bài học</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>


                            <tbody>

                                @foreach (var course in Model.RecentCourses)
                                {
                                    var thumbnail = CourseThumbnailResolver.Resolve(Url, CourseImageHost, course.ThumbnailUrl, course.Slug);

                                    <tr>

                                        <td>

                                            <div class="course-cell">

                                                <div class="course-thumb">

                                                    <img src="@thumbnail.Source"
                                                             alt="@course.Title"
                                                             data-ed-thumb-fallback="@thumbnail.Fallback" data-ed-thumb-placeholder="@thumbnail.Placeholder" onerror="@CourseThumbnailResolver.OnErrorHandler" />

                                                </div>


                                                <div class="course-info">

                                                    <div class="instructor-course-name">
                                                        @course.Title
                                                    </div>

                                                    <div class="instructor-course-category">
                                                        @course.CategoryName
                                                    </div>

                                                </div>

                                            </div>

                                        </td>


                                        <td data-label="Học viên">
                                            @course.EnrollmentCount
                                        </td>


                                        <td data-label="Bài học">
                                            @course.LessonCount
                                        </td>


                                        <td data-label="Trạng thái">

                                            <span class="course-status @(course.IsPublished ? "" : "draft")">

                                                @(course.IsPublished
                                                    ? "Đang xuất bản"
                                                    : "Bản nháp")

                                            </span>

                                        </td>


                                        <td>

                                            <a asp-controller="InstructorCourses"
                                               asp-action="Manage"
                                               asp-route-id="@course.CourseId"
                                               class="manage-link">
                                                Quản lý →
                                            </a>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="dashboard-empty">
                        Bạn chưa có khóa học nào.
                    </div>
                }

            </section>


            <aside class="instructor-panel ed-panel">

                <div class="panel-header">

                    <h2 class="panel-heading">

                        <span class="panel-heading-icon" aria-hidden="true">
                            <svg class="ui-icon" viewBox="0 0 24 24">
                                <path d="M12 3 3 13h8l-1 8 11-12h-8l1-6Z"></path>
                            </svg>
                        </span>

                        Cần xử lý

                    </h2>

                </div>


                <div class="attention-list">


                    <a asp-controller="LessonQuestions"
                       asp-action="Index"
                       class="attention-item">

                        <span class="attention-icon" aria-hidden="true">
                            <svg class="ui-icon" viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 2-2.5 2.25-2.5 4"></path>
                                <path d="M12 17h.01"></path>
                            </svg>
                        </span>


                        <span class="attention-copy">

                            <span class="attention-value d-block">
                                @Model.PendingQuestions
                            </span>

                            <span class="attention-label d-block">
                                Câu hỏi chưa trả lời
                            </span>

                        </span>


                        <span class="attention-arrow">
                            ›
                        </span>

                    </a>


                    <a asp-controller="InstructorCourses"
                       asp-action="Index"
                       asp-route-status="draft"
                       class="attention-item">

                        <span class="attention-icon orange" aria-hidden="true">
                            <svg class="ui-icon" viewBox="0 0 24 24">
                                <path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"></path>
                            </svg>
                        </span>


                        <span class="attention-copy">

                            <span class="attention-value d-block">
                                @Model.DraftCourses
                            </span>

                            <span class="attention-label d-block">
                                Khóa học bản nháp
                            </span>

                        </span>


                        <span class="attention-arrow">
                            ›
                        </span>

                    </a>


                    <a asp-controller="InstructorAnalytics"
                       asp-action="Index"
                       class="attention-item">

                        <span class="attention-icon blue" aria-hidden="true">
                            <svg class="ui-icon" viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="m8 12 2.5 2.5L16 9"></path>
                            </svg>
                        </span>


                        <span class="attention-copy">

                            <span class="attention-value d-block">
                                @Model.PublishedCourses
                            </span>

                            <span class="attention-label d-block">
                                Khóa đang xuất bản
                            </span>

                        </span>


                        <span class="attention-arrow">
                            ›
                        </span>

                    </a>


                </div>

            </aside>


        </div>

    </div>

</section>

