@model OnlineLearningPlatform.ViewModels.InstructorHomeDashboardViewModel

@{
    string? GetDashboardCourseThumbnail(
        string title,
        string? rawUrl)
    {
        string value =
            (title ?? string.Empty)
                .Trim()
                .ToLowerInvariant();


        string? mappedThumbnail =
            null;


        if (value.Contains("git") &&
            value.Contains("github"))
        {
            mappedThumbnail =
                "~/images/course-thumbnails/git-github.png";
        }
        else if (value.Contains(
            "sql server"))
        {
            mappedThumbnail =
                "~/images/course-thumbnails/sql-server.png";
        }
        else if (value.Contains(
            "asp.net") ||
            value.Contains(
                "aspnet"))
        {
            mappedThumbnail =
                "~/images/course-thumbnails/aspnet-core.png";
        }
        else if (value.Contains(
            "c#") ||
            value.Contains(
                "csharp"))
        {
            mappedThumbnail =
                "~/images/course-thumbnails/csharp-co-ban.png";
        }
        else if (value.Contains(
            "javascript") &&
            (
                value.Contains(
                    "nâng cao") ||
                value.Contains(
                    "es6")
            ))
        {
            mappedThumbnail =
                "~/images/course-thumbnails/javascript-nang-cao-es6.png";
        }
        else if (value.Contains(
            "javascript"))
        {
            mappedThumbnail =
                "~/images/course-thumbnails/javascript-co-ban.png";
        }


        if (!string.IsNullOrWhiteSpace(
            mappedThumbnail))
        {
            return Url.Content(
                mappedThumbnail);
        }


        return ResolveDashboardThumbnailUrl(
            rawUrl);
    }


    string? ResolveDashboardThumbnailUrl(
        string? rawUrl)
    {
        if (string.IsNullOrWhiteSpace(
            rawUrl))
        {
            return null;
        }


        string value =
            rawUrl
                .Trim()
                .Replace(
                    "\\",
                    "/");


        if (value.StartsWith(
            "http://",
            StringComparison.OrdinalIgnoreCase) ||
            value.StartsWith(
                "https://",
                StringComparison.OrdinalIgnoreCase) ||
            value.StartsWith(
                "//",
                StringComparison.Ordinal) ||
            value.StartsWith(
                "data:",
                StringComparison.OrdinalIgnoreCase) ||
            value.StartsWith(
                "blob:",
                StringComparison.OrdinalIgnoreCase))
        {
            return value;
        }


        if (value.StartsWith(
            "~/",
            StringComparison.Ordinal))
        {
            return Url.Content(
                value);
        }


        if (value.StartsWith(
            "wwwroot/",
            StringComparison.OrdinalIgnoreCase))
        {
            value =
                value.Substring(
                    "wwwroot/".Length);
        }


        if (value.StartsWith(
            "/",
            StringComparison.Ordinal))
        {
            return value;
        }


        return Url.Content(
            "~/" +
            value.TrimStart('/'));
    }

}

<style>

    /* =========================================================
       INSTRUCTOR DASHBOARD V2
       - Layout riêng, không phụ thuộc dashboard-grid chung
       - Căn giữa theo cách Admin Dashboard đang dùng
       - Scope toàn bộ dưới .instructor-home
