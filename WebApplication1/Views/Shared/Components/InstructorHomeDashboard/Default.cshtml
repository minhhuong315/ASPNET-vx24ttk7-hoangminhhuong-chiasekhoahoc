@model OnlineLearningPlatform.ViewModels.InstructorHomeDashboardViewModel

@{
    string GetFallbackThumbnail(string title)
    {
        string value =
            title.ToLowerInvariant();

        if (value.Contains("sql"))
        {
            return Url.Content(
                "~/images/dashboard/sql-server.png");
        }

        if (value.Contains("git"))
        {
            return Url.Content(
                "~/images/dashboard/git-github.png");
        }

        if (value.Contains("asp.net") ||
            value.Contains(".net"))
        {
            return Url.Content(
                "~/images/dashboard/aspnet-core.png");
        }

        if (value.Contains("javascript") &&
            value.Contains("nâng cao"))
        {
            return Url.Content(
                "~/images/dashboard/javascript-advanced.png");
        }

        if (value.Contains("javascript"))
        {
            return Url.Content(
                "~/images/dashboard/javascript-basic.png");
        }

        return Url.Content(
            "~/images/dashboard/aspnet-core.png");
    }
}

<section class="role-dashboard role-dashboard--instructor">

<div class="dashboard-grid">

                <header class="dashboard-heading grid-full">

                    <div>
                        <div class="dashboard-eyebrow">
                            Giảng viên
                        </div>

                        <h1 class="dashboard-title">
                            Hoạt động giảng dạy
                        </h1>

                        <p class="dashboard-subtitle">
                            Quản lý khóa học, theo dõi học viên
                            và nắm bắt tình hình giảng dạy trên EduLearn.
                        </p>
                    </div>

                    <a asp-controller="InstructorCourses"
                       asp-action="Create"
                       class="dashboard-heading-action">
                        + Tạo khóa học mới
                    </a>

                </header>

                <div class="metric-cluster metric-cluster--4 grid-full">

                    <a asp-controller="InstructorCourses"
                       asp-action="Index"
                       class="metric-card">
                        <span class="metric-icon blue">KH</span>
                        <span>
                            <span class="metric-value d-block">
                                @Model.TotalCourses
                            </span>
                            <span class="metric-label d-block">
                                Khóa học
                            </span>
                        </span>
                    </a>

                    <a asp-controller="InstructorStudents"
                       asp-action="Index"
                       class="metric-card">
                        <span class="metric-icon green">HV</span>
                        <span>
                            <span class="metric-value d-block">
                                @Model.UniqueStudents
                            </span>
                            <span class="metric-label d-block">
                                Học viên
                            </span>
                        </span>
                    </a>

                    <a asp-controller="InstructorAnalytics"
                       asp-action="Index"
                       class="metric-card">
                        <span class="metric-icon orange">BH</span>
                        <span>
                            <span class="metric-value d-block">
                                @Model.TotalLessons
                            </span>
                            <span class="metric-label d-block">
                                Bài học
                            </span>
                        </span>
                    </a>



                    <a asp-controller="InstructorAnalytics"
                       asp-action="Index"
                       class="metric-card">
                        <span class="metric-icon purple">★</span>
                        <span>
                            <span class="metric-value d-block">
                                @(Model.AverageRating > 0
                                    ? Model.AverageRating.ToString("0.0")
                                    : "—")
                            </span>
                            <span class="metric-label d-block">
                                Đánh giá trung bình
                            </span>
                        </span>
                    </a>

                </div>

                <section class="dashboard-panel grid-left">

                    <div class="panel-head">

                        <h2 class="panel-title">
                            <span class="panel-title-icon">
                                KH
                            </span>
                            Khóa học của tôi
                        </h2>

                        <a asp-controller="InstructorCourses"
                           asp-action="Index"
                           class="panel-link">
                            Xem tất cả →
                        </a>

                    </div>

                    @if (Model.RecentCourses.Any())
                    {
                        <div class="table-wrap">

                            <table class="dashboard-table instructor-table">

                                <thead>
                                    <tr>
                                        <th>Khóa học</th>
                                        <th>Học viên</th>
                                        <th>Bài học</th>
                                        <th>Trạng thái</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var course in Model.RecentCourses)
                                    {
                                        string thumbnail =
                                            !string.IsNullOrWhiteSpace(
                                                course.ThumbnailUrl)
                                                ? course.ThumbnailUrl
                                                : GetFallbackThumbnail(
                                                    course.Title);

                                        <tr>

                                            <td>
                                                <div class="table-course-cell">

                                                    <div class="course-thumb">
                                                        <img src="@thumbnail"
                                                             alt="@course.Title" />
                                                    </div>

                                                    <div>
                                                        <div class="table-course-name">
                                                            @course.Title
                                                        </div>
                                                        <div class="table-course-meta">
                                                            @course.CategoryName
                                                        </div>
                                                    </div>

                                                </div>
                                            </td>

                                            <td>
                                                @course.EnrollmentCount
                                            </td>

                                            <td>
                                                @course.LessonCount
                                            </td>

                                            <td>
                                                <span class="status-pill @(course.IsPublished ? "" : "draft")">
                                                    @(course.IsPublished
                                                        ? "Đang xuất bản"
                                                        : "Bản nháp")
                                                </span>
                                            </td>

                                            <td>
                                                <a asp-controller="InstructorCourses"
                                                   asp-action="Manage"
                                                   asp-route-id="@course.CourseId"
                                                   class="table-action">
                                                    Quản lý →
                                                </a>
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="dashboard-empty">
                            Bạn chưa có khóa học nào.
                        </div>
                    }

                </section>

                <aside class="right-stack grid-right">

                    <section class="dashboard-panel">

                        <div class="panel-head">
                            <h2 class="panel-title">
                                <span class="panel-title-icon">
                                    ⚡
                                </span>
                                Cần xử lý
                            </h2>
                        </div>

                        <div class="attention-list">

                            <a asp-controller="LessonQuestions"
                               asp-action="Index"
                               class="attention-item">

                                <span class="attention-icon">
                                    Q
                                </span>

                                <span>
                                    <span class="attention-value d-block">
                                        @Model.PendingQuestions
                                    </span>
                                    <span class="attention-label d-block">
                                        Câu hỏi chưa trả lời
                                    </span>
                                </span>

                                <span class="attention-arrow">
                                    ›
                                </span>

                            </a>

                            <a asp-controller="InstructorCourses"
                               asp-action="Index"
                               asp-route-status="draft"
                               class="attention-item">

                                <span class="attention-icon orange">
                                    BN
                                </span>

                                <span>
                                    <span class="attention-value d-block">
                                        @Model.DraftCourses
                                    </span>
                                    <span class="attention-label d-block">
                                        Khóa học bản nháp
                                    </span>
                                </span>

                                <span class="attention-arrow">
                                    ›
                                </span>

                            </a>

                            <a asp-controller="InstructorAnalytics"
                               asp-action="Index"
                               class="attention-item">

                                <span class="attention-icon blue">
                                    PT
                                </span>

                                <span>
                                    <span class="attention-value d-block">
                                        @Model.PublishedCourses
                                    </span>
                                    <span class="attention-label d-block">
                                        Khóa đang xuất bản
                                    </span>
                                </span>

                                <span class="attention-arrow">
                                    ›
                                </span>

                            </a>

                        </div>

                    </section>

                </aside>

            </div>

</section>
