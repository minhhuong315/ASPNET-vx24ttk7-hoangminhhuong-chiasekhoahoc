                                        class="account-menu-item danger">

                                    <span class="account-menu-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#account-icon-logout" /></svg>
                                    </span>

                                    <span>
                                        Đăng xuất
                                    </span>

                                </button>

                            </form>


                        </div>


                    </div>

                }
                else
                {

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="auth-link login-link">

                        Đăng nhập

                    </a>


                    <a asp-controller="Account"
                       asp-action="Register"
                       class="auth-link register-link">

                        Đăng ký

