    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>


    <script src="~/js/site.js"
            asp-append-version="true">
    </script>



    <!-- =========================================
         DROPDOWN SCRIPT
    ========================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const dropdowns =
                    document.querySelectorAll(
                        "[data-dropdown]"
                    );


                const guestMenuToggle =
                    document.querySelector(
                        "[data-guest-menu-toggle]"
                    );


                const guestNav =
                    document.getElementById(
                        "guestPrimaryNav"
                    );


                const guestMenuMedia =
                    window.matchMedia(
                        "(max-width: 850px)"
                    );


                function closeGuestSubmenus() {

                    if (!guestNav) {
                        return;
                    }


                    guestNav
                        .querySelectorAll(
                            "[data-dropdown].open"
                        )
                        .forEach(
                            function (dropdown) {

                                dropdown.classList.remove(
                                    "open"
                                );


                                const trigger =
                                    dropdown.querySelector(
                                        "[data-dropdown-trigger]"
                                    );


                                if (trigger) {

                                    trigger.setAttribute(
                                        "aria-expanded",
                                        "false"
                                    );

                                }

                            }
                        );

                }


                function closeGuestMenu(
                    restoreFocus
                ) {

                    if (!guestMenuToggle ||
                        !guestNav) {
                        return;
                    }


                    guestNav.classList.remove(
                        "is-mobile-open"
                    );


                    guestMenuToggle.setAttribute(
                        "aria-expanded",
                        "false"
                    );


                    guestMenuToggle.setAttribute(
                        "aria-label",
                        "Mở menu"
                    );


                    closeGuestSubmenus();


                    if (restoreFocus) {
                        guestMenuToggle.focus();
                    }

                }


                if (guestMenuToggle &&
                    guestNav) {

                    guestMenuToggle.addEventListener(
                        "click",
                        function (event) {

                            event.stopPropagation();


                            const isOpen =
                                guestNav.classList.contains(
                                    "is-mobile-open"
                                );


                            if (isOpen) {

                                closeGuestMenu(
                                    false
                                );

                            }
                            else {

                                guestNav.classList.add(
                                    "is-mobile-open"
                                );


                                guestMenuToggle.setAttribute(
                                    "aria-expanded",
                                    "true"
                                );


                                guestMenuToggle.setAttribute(
                                    "aria-label",
                                    "Đóng menu"
                                );

                            }

                        }
                    );


                    guestNav.addEventListener(
                        "click",
                        function (event) {

                            const link =
                                event.target.closest(
                                    "a"
                                );


                            if (link &&
                                guestMenuMedia.matches) {

                                closeGuestMenu(
                                    false
                                );

                            }

                        }
                    );


                    document.addEventListener(
                        "keydown",
                        function (event) {

                            if (event.key === "Escape" &&
                                guestNav.classList.contains(
                                    "is-mobile-open"
                                )) {

                                closeGuestMenu(
                                    true
                                );

                            }

                        }
                    );


                    const syncGuestMenu =
                        function () {

                            if (!guestMenuMedia.matches) {

                                closeGuestMenu(
                                    false
                                );

                            }

                        };


                    if (typeof guestMenuMedia
                        .addEventListener ===
                        "function") {

                        guestMenuMedia
                            .addEventListener(
                                "change",
                                syncGuestMenu
                            );

                    }
                    else {

                        guestMenuMedia.addListener(
                            syncGuestMenu
                        );

                    }

                }


                dropdowns.forEach(
                    function (dropdown) {

                        const trigger =
                            dropdown.querySelector(
                                "[data-dropdown-trigger]"
                            );


                        if (!trigger) {
                            return;
                        }


                        trigger.addEventListener(
                            "click",
                            function (event) {

                                event.stopPropagation();


                                const wasOpen =
                                    dropdown.classList.contains(
                                        "open"
                                    );


                                dropdowns.forEach(
                                    function (otherDropdown) {

                                        otherDropdown.classList.remove(
                                            "open"
                                        );


                                        const otherTrigger =
                                            otherDropdown.querySelector(
                                                "[data-dropdown-trigger]"
                                            );


                                        if (otherTrigger) {

                                            otherTrigger.setAttribute(
                                                "aria-expanded",
                                                "false"
                                            );

                                        }

                                    }
                                );


                                if (!wasOpen) {

                                    dropdown.classList.add(
                                        "open"
                                    );


                                    trigger.setAttribute(
                                        "aria-expanded",
                                        "true"
                                    );

                                }

                            }
                        );

                    }
                );


                // Escape closes the account menu and restores keyboard focus.
                document.addEventListener("keydown", function (event) {
                    if (event.key !== "Escape") return;
                    const openAccount = document.querySelector(".account-dropdown.open");
                    if (!openAccount) return;
                    openAccount.classList.remove("open");
                    const trigger = openAccount.querySelector("[data-dropdown-trigger]");
                    if (trigger) {
                        trigger.setAttribute("aria-expanded", "false");
                        trigger.focus();
                    }
                });

                document.addEventListener(
                    "click",
                    function () {

                        dropdowns.forEach(
                            function (dropdown) {

                                dropdown.classList.remove(
                                    "open"
                                );


                                const trigger =
                                    dropdown.querySelector(
                                        "[data-dropdown-trigger]"
                                    );


                                if (trigger) {

                                    trigger.setAttribute(
                                        "aria-expanded",
                                        "false"
                                    );

                                }

                            }
                        );

                    }
                );


                document
                    .querySelectorAll(
                        ".edulearn-dropdown-menu, .account-dropdown-menu"
                    )
                    .forEach(
                        function (menu) {

                            menu.addEventListener(
                                "click",
                                function (event) {

                                    event.stopPropagation();

                                }
                            );

                        }
                    );

            }
        );

    </script>


    @if (isRoleWorkspacePage)
    {
        <script src="~/js/dashboard-sidebar.js"
                asp-append-version="true">
        </script>
    }


    @await RenderSectionAsync(
        "Scripts",
        required: false)


</body>

