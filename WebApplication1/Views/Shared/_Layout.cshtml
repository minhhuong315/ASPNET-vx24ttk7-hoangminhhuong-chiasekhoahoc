@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();

    bool isHomePage =
        currentController == "Home" &&
        currentAction == "Index";

    bool isCoursesPage =
        currentController == "Courses" &&
        (currentAction == "Index" ||
         currentAction == "Details");

    bool isMyCoursesPage =
        currentController == "Courses" &&
        currentAction == "MyCourses";
}

<!DOCTYPE html>

<html lang="vi">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EduLearn</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>

        html,
        body {
            min-height: 100%;
        }

        body {
            margin: 0;
            background: #ffffff;
            color: #172033;
        }

        .edulearn-navbar {
            background: #ffffff;
            border-bottom: 1px solid #e9edf3;
            position: relative;
            z-index: 1000;
        }

        .edulearn-nav-container {
            max-width: 1180px;
            min-height: 88px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            align-items: center;
            gap: 34px;
        }

        .edulearn-logo {
            color: #0d6efd;
            font-size: 25px;
            font-weight: 800;
            text-decoration: none;
            white-space: nowrap;
        }

        .edulearn-logo:hover {
            color: #0d6efd;
        }

        .edulearn-nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
            flex: 1;
        }

        .edulearn-nav-link {
            color: #273142;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
            transition: color 0.2s ease;
        }

        .edulearn-nav-link:hover {
            color: #0d6efd;
        }

        /* MENU ĐANG ĐƯỢC CHỌN */

        .edulearn-nav-link.active {
            color: #0d6efd;
            font-weight: 700;
        }

        .account-area {
            display: flex;
            align-items: center;
            gap: 10px;
            white-space: nowrap;
        }

        .account-chip {
            min-height: 44px;
            padding: 5px 13px 5px 6px;
            display: flex;
            align-items: center;
            gap: 9px;
            border: 1px solid #e3e7ed;
            border-radius: 25px;
            background: #ffffff;
            color: #273142;
            font-size: 13px;
            font-weight: 600;
        }

        .account-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #edf4ff;
            color: #0d6efd;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            text-transform: uppercase;
        }

        .logout-form {
            margin: 0;
        }

        .logout-button {
            min-height: 44px;
            padding: 0 16px;
            border: 1px solid #d9dee7;
            border-radius: 9px;
            background: #ffffff;
            color: #5b6472;
            font-size: 13px;
            font-weight: 600;
        }

        .logout-button:hover {
            border-color: #dc3545;
            color: #dc3545;
            background: #fff8f8;
        }

        .auth-link {
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
            padding: 10px 16px;
            border-radius: 9px;
        }

        .login-link {
            color: #0d6efd;
            background: #ffffff;
            border: 1px solid #bdd5ff;
        }

        .register-link {
            color: #ffffff;
            background: #0d6efd;
            border: 1px solid #0d6efd;
        }

        .edulearn-footer {
            border-top: 1px solid #e7ebf0;
            background: #ffffff;
        }

        .footer-container {
            max-width: 1180px;
            margin: 0 auto;
            min-height: 78px;
            padding: 0 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            color: #6c7687;
            font-size: 13px;
        }

        .footer-brand {
            color: #0d6efd;
            font-weight: 800;
        }

        @@media (max-width: 1050px) {

            .edulearn-nav-container {
                gap: 20px;
            }

            .edulearn-nav-links {
                gap: 17px;
            }

            .edulearn-nav-link {
                font-size: 13px;
            }

        }

        @@media (max-width: 850px) {

            .edulearn-nav-container {
                padding-top: 15px;
                padding-bottom: 15px;
                flex-wrap: wrap;
            }

            .edulearn-nav-links {
                order: 3;
                width: 100%;
                overflow-x: auto;
                padding-bottom: 3px;
            }

            .account-area {
                margin-left: auto;
            }

        }

        @@media (max-width: 600px) {

            .account-chip span:last-child {
                display: none;
            }

            .edulearn-logo {
                font-size: 22px;
            }

            .footer-container {
                padding-top: 20px;
                padding-bottom: 20px;
                flex-direction: column;
                align-items: flex-start;
            }

        }

    </style>

</head>

<body>

    <header class="edulearn-navbar">

        <div class="edulearn-nav-container">

            <a asp-controller="Home"
               asp-action="Index"
               class="edulearn-logo">
                EduLearn
            </a>


            <nav class="edulearn-nav-links">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="edulearn-nav-link @(isHomePage ? "active" : "")">
                    Trang chủ
                </a>


                <a asp-controller="Courses"
                   asp-action="Index"
                   class="edulearn-nav-link @(isCoursesPage ? "active" : "")">
                    Khóa học
                </a>


                @if (User.Identity?.IsAuthenticated == true &&
                     User.IsInRole("Student"))
                {
                    <a asp-controller="Courses"
                       asp-action="MyCourses"
                       class="edulearn-nav-link @(isMyCoursesPage ? "active" : "")">
                        Khóa học của tôi
                    </a>
                }


                <a href="#"
                   class="edulearn-nav-link">
                    Giảng viên
                </a>


                <a href="#"
                   class="edulearn-nav-link">
                    Về EduLearn
                </a>

            </nav>


            <div class="account-area">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    var userName =
                        User.Identity?.Name ?? "User";

                    var firstLetter =
                        !string.IsNullOrWhiteSpace(userName)
                            ? userName.Substring(0, 1)
                            : "U";


                    <div class="account-chip">

                        <span class="account-avatar">
                            @firstLetter
                        </span>

                        <span>
                            @userName
                        </span>

                    </div>


                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="logout-form">

                        <button type="submit"
                                class="logout-button">
                            Đăng xuất
                        </button>

                    </form>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="auth-link login-link">
                        Đăng nhập
                    </a>

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="auth-link register-link">
                        Đăng ký
                    </a>
                }

            </div>

        </div>

    </header>


    <main>
        @RenderBody()
    </main>


    <footer class="edulearn-footer">

        <div class="footer-container">

            <div>
                © 2026
                <span class="footer-brand">
                    EduLearn
                </span>
                - Chia sẻ tri thức, kiến tạo tương lai
            </div>

            <div>
                Nền tảng khóa học Công nghệ thông tin
            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>
</html>