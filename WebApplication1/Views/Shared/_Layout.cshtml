@inject Microsoft.AspNetCore.Identity.UserManager<OnlineLearningPlatform.Models.ApplicationUser> UserManager

@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();


    bool isHomePage =
        currentController == "Home" &&
        currentAction == "Index";


    bool isCoursesPage =
        currentController == "Courses";


    bool isMyCoursesPage =
        currentController == "Courses" &&
        currentAction == "MyCourses";


    bool isQuestionsPage =
        currentController == "LessonQuestions";


    bool isInstructorCoursesPage =
        currentController == "InstructorCourses";


    bool isInstructorStudentsPage =
        currentController == "InstructorStudents";


    bool isInstructorAnalyticsPage =
        currentController == "InstructorAnalytics";


    bool isInstructorsPage =
        currentController == "Explore" &&
        currentAction == "Instructors";


    bool isAboutPage =
        currentController == "Explore" &&
        currentAction == "About";


    bool isProfilePage =
        currentController == "Profile";


    bool isWishlistPage =
        currentController == "Wishlist";


    bool isAdminDashboardPage =
        currentController == "AdminDashboard";


    bool isAdminUsersPage =
        currentController == "AdminUsers";


    bool isAdminCoursesPage =
        currentController == "AdminCourses";


    bool isAdminCategoriesPage =
        currentController == "AdminCategories";


    bool isAuthenticated =
        User.Identity?.IsAuthenticated == true;


    bool isStudent =
        isAuthenticated &&
        User.IsInRole("Student");


    bool isInstructor =
        isAuthenticated &&
        User.IsInRole("Instructor");


    bool isAdmin =
        isAuthenticated &&
        User.IsInRole("Admin");


    bool isRoleHomeDashboard =
        isAuthenticated &&
        isHomePage;


    bool isNotificationsPage =
        currentController == "Notifications";


    bool isStudentWorkspacePage =
        isStudent &&
        (
            isHomePage ||
            isWishlistPage ||
            isProfilePage ||
            isQuestionsPage ||
            isNotificationsPage ||
            (
                currentController == "Courses" &&
                (
                    currentAction == "MyCourses" ||
                    currentAction == "Learn"
                )
            )
        );


    bool isInstructorWorkspacePage =
        isInstructor &&
        (
            isHomePage ||
            isInstructorCoursesPage ||
            isInstructorStudentsPage ||
            isInstructorAnalyticsPage ||
            isQuestionsPage ||
            isNotificationsPage ||
            isProfilePage
        );


    bool isAdminWorkspacePage =
        isAdmin &&
        (
            isHomePage ||
            isAdminDashboardPage ||
            isAdminUsersPage ||
            isAdminCoursesPage ||
            isAdminCategoriesPage ||
            isQuestionsPage ||
            isNotificationsPage ||
            isProfilePage
        );


    bool isRoleWorkspacePage =
        isStudentWorkspacePage ||
        isInstructorWorkspacePage ||
        isAdminWorkspacePage;


    // =========================================
    // CẤP ĐỘ ĐANG CHỌN
    // =========================================

    string selectedLevel =
        Context.Request.Query["level"]
            .ToString()
            .Trim()
            .ToLowerInvariant();


    // =========================================
    // USER HIỆN TẠI
    // =========================================

    OnlineLearningPlatform.Models.ApplicationUser? currentUser =
        null;


    if (isAuthenticated)
    {
        currentUser =
            await UserManager.GetUserAsync(User);
    }


    string displayName =
        !string.IsNullOrWhiteSpace(
            currentUser?.FullName)
            ? currentUser.FullName
            : User.Identity?.Name
                ?? "User";


    string? firstLetter =
        OnlineLearningPlatform.Helpers.UserAvatarPresentation
            .GetLastWordInitial(currentUser?.FullName);

    string? avatarUrl =
        OnlineLearningPlatform.Helpers.UserAvatarPresentation
            .ResolveImageUrl(Url, currentUser?.Avatar);


    string roleLabel =
        isInstructor
            ? "Giảng viên"
            : isAdmin
                ? "Quản trị viên"
                : "Học viên";
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EduLearn</title>


    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
<style>

        html,
        body {
            min-height: 100%;
        }


        body {
            margin: 0;

            background: #ffffff;
            color: #172033;
        }


        /* =========================================
           NAVBAR
        ========================================= */

        .edulearn-navbar {
            position: relative;

            z-index: 1000;

            background: #ffffff;

            border-bottom: 1px solid #e9edf3;
        }


        .edulearn-nav-container {
            width: min(
                1280px,
                calc(100% - 32px)
            );

            max-width: none;

            min-height: 82px;

            margin: 0 auto;

            padding: 0;

            display: flex;
            align-items: center;

            gap: 32px;
        }


        /* =========================================
           LOGO
        ========================================= */

        .edulearn-logo {
            color: #0d6efd;

            font-size: 25px;
            font-weight: 800;

            text-decoration: none;

            white-space: nowrap;
        }


        .edulearn-logo:hover {
            color: #0d6efd;
        }


        /* =========================================
           MAIN NAV
        ========================================= */

        .edulearn-nav-links {
            display: flex;
            align-items: center;

            gap: 27px;

            flex: 1;
        }


        .edulearn-nav-link {
            min-height: 42px;

            padding: 0;

            border: none;

            background: transparent;
            color: #273142;

            display: inline-flex;
            align-items: center;

            gap: 6px;

            font-family: inherit;

            font-size: 14px;
            font-weight: 600;

            line-height: 1;

            text-decoration: none;

            white-space: nowrap;

            cursor: pointer;

            transition: color .2s ease;
        }


        .edulearn-nav-link:hover {
            color: #0d6efd;
        }


        .edulearn-nav-link.active {
            color: #0d6efd;

            font-weight: 700;
        }


        .nav-chevron {
            width: 14px;
            height: 14px;

            transition: transform .2s ease;
        }


        /* =========================================
           DROPDOWN
        ========================================= */

        .edulearn-dropdown {
            position: relative;

            display: flex;
            align-items: center;
        }


        /*
         * CẦU NỐI VÔ HÌNH
         *
         * Giữ trạng thái hover khi rê chuột
         * từ nút xuống menu.
         */
        .edulearn-dropdown::after {
            content: "";

            position: absolute;

            top: 100%;
            left: -12px;
            right: -12px;

            height: 16px;

            background: transparent;
        }


        .edulearn-dropdown-menu {
            position: absolute;

            top: calc(100% + 9px);
            left: -20px;

            z-index: 1200;

            min-width: 245px;

            padding: 9px;

            border: 1px solid #e4e9f0;
            border-radius: 12px;

            background: #ffffff;

            box-shadow:
                0 16px 38px
                rgba(34, 48, 73, .14);

            opacity: 0;

            visibility: hidden;

            pointer-events: none;

            transform: translateY(6px);

            transition:
                opacity .16s ease,
                transform .16s ease,
                visibility .16s ease;
        }


        .edulearn-dropdown-menu::before {
            content: "";

            position: absolute;

            top: -8px;
            left: 31px;

            width: 16px;
            height: 16px;

            background: #ffffff;

            border-left: 1px solid #e4e9f0;
            border-top: 1px solid #e4e9f0;

            transform: rotate(45deg);
        }


        .edulearn-dropdown:hover
        > .edulearn-dropdown-menu,
        .edulearn-dropdown.open
        > .edulearn-dropdown-menu {
            opacity: 1;

            visibility: visible;

            pointer-events: auto;

            transform: translateY(0);
        }


        .edulearn-dropdown:hover
        > .dropdown-trigger
        .nav-chevron,
        .edulearn-dropdown.open
        > .dropdown-trigger
        .nav-chevron {
            transform: rotate(180deg);
        }


        /* =========================================
           DROPDOWN ITEM
        ========================================= */

        .dropdown-menu-item {
            position: relative;

            min-height: 44px;

            padding: 0 13px;

            border-radius: 8px;

            color: #4f5969;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 12px;

            font-size: 13px;
            font-weight: 600;

            text-decoration: none;

            transition:
                background .15s ease,
                color .15s ease;
        }


        .dropdown-menu-item:hover {
            background: #f2f7ff;

            color: #0d6efd;
        }


        .dropdown-menu-item.active {
            background: #edf4ff;

            color: #0d6efd;

            font-weight: 700;
        }


        .dropdown-menu-divider {
            height: 1px;

            margin: 7px 6px;

            background: #edf0f4;
        }


        /* =========================================
           LEVEL DOT
        ========================================= */

        .level-menu-left {
            display: flex;
            align-items: center;

            gap: 9px;
        }


        .level-dot {
            width: 8px;
            height: 8px;

            flex: 0 0 8px;

            border-radius: 50%;
        }


        .level-dot.beginner {
            background: #0d6efd;
        }


        .level-dot.intermediate {
            background: #7451d8;
        }


        .level-dot.advanced {
            background: #0b8f82;
        }


        .dropdown-level {
            color: #a0a8b5;

            font-size: 10px;
            font-weight: 600;
        }


        .dropdown-menu-item.active
        .dropdown-level {
            color: currentColor;

            opacity: .7;
        }


        /* =========================================
           RIGHT AREA
        ========================================= */

        .account-area {
            margin-left: auto;

            display: flex;
            align-items: center;

            gap: 11px;

            white-space: nowrap;
        }


        /* =========================================
           NOTIFICATION
        ========================================= */

        .notification-area {
            width: 44px;
            height: 44px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;
        }


        /* =========================================
           ACCOUNT DROPDOWN
        ========================================= */

        .account-dropdown {
            position: relative;
        }

        /* Caret anchored to the trigger, rather than the wider menu. */
        .account-dropdown::before {
            content: "";
            position: absolute;
            top: calc(100% + 2px);
            right: calc(50% - 8px);
            width: 16px;
            height: 16px;
            background: #ffffff;
            border-top: 1px solid #e2e8f0;
            border-left: 1px solid #e2e8f0;
            transform: rotate(45deg);
            opacity: 0;
            pointer-events: none;
            z-index: 1251;
        }

        .account-dropdown.open::before {
            opacity: 1;
        }


        /*
         * CẦU NỐI CHO MENU TÀI KHOẢN
         */
        .account-dropdown::after {
            content: "";

            position: absolute;

            top: 100%;
            left: -10px;
            right: -10px;

            height: 16px;

            background: transparent;
        }


        .account-dropdown-button {
            min-height: 50px;

            max-width: 240px;

            padding: 5px 12px 5px 6px;

            border: 1px solid #dfe5ed;
            border-radius: 10px;

            background: #ffffff;
            color: #273142;

            display: flex;
            align-items: center;

            gap: 10px;

            font-family: inherit;

            font-size: 13px;
            font-weight: 600;

            cursor: pointer;

            transition:
                border-color .2s ease,
                background .2s ease;
        }


        .account-dropdown-button:hover {
            border-color: #bfd4f7;

            background: #fbfdff;
        }


        .account-avatar {
            position: relative;
            width: 32px;
            height: 32px;
            flex: 0 0 32px;
            overflow: hidden;
            border-radius: 50%;
            background: #edf4ff;
            color: #2563eb;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .account-avatar--menu {
            width: 36px;
            height: 36px;
            flex-basis: 36px;
        }

        .account-avatar__image {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .account-avatar__fallback-icon {
            width: 19px;
            height: 19px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.75;
            stroke-linecap: round;
            stroke-linejoin: round;
        }


        .account-copy {
            min-width: 0;

            display: flex;
            flex-direction: column;
            align-items: flex-start;

            line-height: 1.15;
        }


        .account-name {
            max-width: 170px;

            overflow: hidden;

            text-overflow: ellipsis;

            white-space: nowrap;
        }


        .account-role-inline {
            margin-top: 3px;

            color: #8a95a6;

            font-size: 10px;
            font-weight: 500;
        }


        .dashboard-sidebar-toggle {
            width: 42px;
            height: 42px;

            flex: 0 0 42px;

            padding: 0;

            border: 0;
            border-radius: 10px;

            background: transparent;
            color: #172033;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            cursor: pointer;

            transition:
                background .18s ease,
                color .18s ease;
        }


        .dashboard-sidebar-toggle:hover {
            background: #eef5ff;
            color: #126bff;
        }


        .dashboard-sidebar-toggle-lines {
            width: 21px;
            height: 16px;

            position: relative;

            display: block;
        }


        .dashboard-sidebar-toggle-lines::before,
        .dashboard-sidebar-toggle-lines::after,
        .dashboard-sidebar-toggle-lines span {
            content: "";

            position: absolute;
            left: 0;

            width: 21px;
            height: 2px;

            border-radius: 20px;

            background: currentColor;

            transition:
                width .18s ease;
        }


        .dashboard-sidebar-toggle-lines::before {
            top: 0;
        }


        .dashboard-sidebar-toggle-lines span {
            top: 7px;
        }


        .dashboard-sidebar-toggle-lines::after {
            bottom: 0;
        }


        .dashboard-sidebar-toggle.is-collapsed
        .dashboard-sidebar-toggle-lines::before,
        .dashboard-sidebar-toggle.is-collapsed
        .dashboard-sidebar-toggle-lines::after {
            width: 15px;
        }


        .dashboard-header-search {
            min-width: 260px;
            max-width: 600px;

            flex: 1;

            margin-left: 22px;
        }


        .dashboard-header-search-form {
            width: 100%;

            position: relative;
        }


        .dashboard-header-search-input {
            width: 100%;
            height: 44px;

            padding: 0 18px 0 42px;

            border: 1px solid #e1e8f2;
            border-radius: 11px;

            outline: none;

            background: #f6f9fd;
            color: #273142;

            font-family: inherit;
            font-size: 12px;

            transition:
                border-color .2s ease,
                box-shadow .2s ease,
                background .2s ease;
        }


        .dashboard-header-search-input:focus {
            border-color: #a8c8fb;

            background: #ffffff;

            box-shadow: 0 0 0 3px rgba(18, 107, 255, .08);
        }


        .dashboard-header-search-icon {
            position: absolute;

            left: 15px;
            top: 50%;

            transform: translateY(-50%);

            color: #6f7d90;

            font-size: 15px;
            pointer-events: none;
        }


        .account-chevron {
            width: 14px;
            height: 14px;

            margin-left: 2px;

            color: #8791a1;

            transition: transform .2s ease;
        }


        .account-dropdown.open
        .account-chevron {
            transform: rotate(180deg);
        }


        .account-dropdown-menu {
            box-sizing: border-box;
            position: absolute;

            top: calc(100% + 9px);
            right: 0;

            z-index: 1250;

            width: min(270px, calc(100vw - 24px));

            padding: 10px;

            border: 1px solid #e2e8f0;
            border-radius: 13px;

            background: #ffffff;

            box-shadow: 0 12px 28px rgba(15, 23, 42, .10);

            opacity: 0;

            visibility: hidden;

            pointer-events: none;

            transform: translateY(6px);

            transition:
                opacity .16s ease,
                transform .16s ease,
                visibility .16s ease;
        }


        .account-dropdown.open
        > .account-dropdown-menu {
            opacity: 1;

            visibility: visible;

            pointer-events: auto;

            transform: translateY(0);
        }


        /* =========================================
           ACCOUNT HEADER
        ========================================= */

        .account-menu-header {
            padding: 11px 12px 12px;
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .account-menu-identity {
            flex: 1;
            min-width: 0;
        }


        .account-menu-name {
            margin-bottom: 3px;

            color: #273142;

            font-size: 13px;
            font-weight: 800;

            overflow: hidden;

            text-overflow: ellipsis;

            white-space: nowrap;
        }


        .account-menu-role {
            color: #8b95a5;

            font-size: 11px;
            font-weight: 600;
        }


        /* =========================================
           ACCOUNT ITEM
        ========================================= */

        .account-menu-item {
            box-sizing: border-box;
            width: 100%;

            min-height: 42px;

            padding: 0 12px;

            border: none;
            border-radius: 8px;

            background: transparent;
            color: #4e596b;

            display: flex;
            align-items: center;

            gap: 11px;

            font-family: inherit;

            font-size: 13px;
            font-weight: 600;

            text-align: left;

            text-decoration: none;

            cursor: pointer;

            transition:
                background .15s ease,
                color .15s ease;
        }


        .account-menu-item:hover {
            background: #f3f7fd;

            color: #0d6efd;
        }


        .account-menu-item.active {
            background: #edf4ff;

            color: #0d6efd;
        }


        .account-menu-item.danger {
            color: #dc3545;
        }


        .account-menu-item.danger:hover {
            background: #fff4f5;

            color: #c92a3a;
        }


        .account-menu-icon {
            width: 18px;
            height: 18px;
            flex: 0 0 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: currentColor;
        }

        .account-menu-icon svg {
            display: block;
            width: 18px;
            height: 18px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .account-menu-symbols {
            position: absolute;
            width: 0;
            height: 0;
            overflow: hidden;
            pointer-events: none;
        }


        .account-menu-form {
            margin: 0;
        }


        /* =========================================
           AUTH
        ========================================= */

        .auth-link {
            height: 44px;

            padding: 0 16px;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            border-radius: 10px;

            font-size: 13px;
            font-weight: 700;

            text-decoration: none;
        }


        .login-link {
            color: #0d6efd;

            background: #ffffff;

            border: 1px solid #bdd5ff;
        }


        .register-link {
            color: #ffffff;

            background: #0d6efd;

            border: 1px solid #0d6efd;
        }


        /* =========================================
           WORKSPACE HEADER
           Cột trái của header nối liền với sidebar.
        ========================================= */

        .role-workspace-page {
            --workspace-sidebar-width: 220px;
            --workspace-sidebar-collapsed-width: 72px;
        }


        .role-workspace-page .edulearn-navbar {
            position: sticky !important;
            top: 0;
            left: 0;
            right: 0;

            width: 100%;

            z-index: 1700;

            background: #ffffff;
        }


        .role-workspace-page .edulearn-nav-container {
            width: 100% !important;
            max-width: none !important;
            min-height: 82px;

            margin: 0 !important;
            padding: 0 !important;

            display: grid;
            grid-template-columns:
                var(--workspace-sidebar-width)
                minmax(320px, 1fr)
                auto;

            gap: 0 !important;

            align-items: center;

            transition:
                grid-template-columns .2s ease;
        }


        .role-workspace-page .workspace-brand-zone {
            align-self: stretch;

            padding: 0 18px;

            border-right: 1px solid #e2e9f2;

            display: flex;
            align-items: center;

            gap: 16px;

            background: #ffffff;
        }


        .role-workspace-page .workspace-brand-zone
        .dashboard-sidebar-toggle {
            flex: 0 0 42px;
        }


        .role-workspace-page .workspace-logo {
            min-width: 0;

            overflow: hidden;

            transition:
                opacity .15s ease,
                width .2s ease;
        }


        .role-workspace-page .dashboard-header-search {
            width: min(100%, 760px);
            max-width: 760px;

            margin: 0 !important;
            padding-left: 24px;

            justify-self: start;
        }


        .role-workspace-page .account-area {
            margin: 0 !important;
            padding: 0 24px;

            justify-self: end;
        }


        .role-workspace-page.workspace-sidebar-collapsed
        .edulearn-nav-container {
            grid-template-columns:
                var(--workspace-sidebar-width)
                minmax(320px, 1fr)
                auto;
        }



        .role-workspace-page.workspace-sidebar-collapsed
        .workspace-brand-zone {
            padding: 0 18px;
            justify-content: flex-start;
        }



        /* =========================================
           FOOTER
        ========================================= */

        .edulearn-footer {
            border-top: 1px solid #e7ebf0;

            background: #ffffff;
        }


        .footer-container {
            width: min(
                1280px,
                calc(100% - 32px)
            );

            max-width: none;

            min-height: 78px;

            margin: 0 auto;

            padding: 0;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 25px;

            color: #6c7687;

            font-size: 13px;
        }


        .footer-brand {
            color: #0d6efd;

            font-weight: 800;
        }


        /* =========================================
           RESPONSIVE
        ========================================= */

        @@media (max-width: 1050px) {

            .edulearn-nav-container {
                gap: 20px;
            }


            .edulearn-nav-links {
                gap: 17px;
            }


            .edulearn-nav-link {
                font-size: 13px;
            }
        }


        @@media (max-width: 850px) {



            .edulearn-nav-container {
                width: min(
                    100% - 24px,
                    1280px
                );

                padding-top: 14px;
                padding-bottom: 14px;

                flex-wrap: wrap;
            }


            .edulearn-nav-links {
                order: 3;

                width: 100%;

                overflow-x: auto;

                padding-bottom: 3px;
            }


            .dashboard-header-search {
                order: 3;

                width: 100%;
                max-width: none;
                min-width: 0;

                margin-left: 0;
            }


            .account-area {
                margin-left: auto;
            }


            .edulearn-dropdown-menu {
                left: 0;
            }
        }


        @@media (max-width: 600px) {

            .edulearn-logo {
                font-size: 22px;
            }


            .account-copy {
                display: none;
            }


            .account-dropdown-button {
                width: 44px;

                padding: 5px;

                justify-content: center;
            }


            .account-chevron {
                display: none;
            }


            .account-dropdown-menu {
                position: fixed;

                top: 76px;
                right: 12px;

                width: min(
                    290px,
                    calc(100vw - 24px)
                );
            }


            .footer-container {
                padding-top: 20px;
                padding-bottom: 20px;

                flex-direction: column;
                align-items: flex-start;
            }
        }



        /* =========================================
           GUEST MOBILE NAVIGATION
           Shared Guest only - authenticated workspace untouched.
        ========================================= */

        .guest-menu-toggle,
        .guest-mobile-auth {
            display: none;
        }


        @@media (max-width: 850px) {

            body.guest-page .edulearn-nav-container {
                position: relative;

                width: min(
                    100% - 24px,
                    1280px
                );

                min-height: 64px;

                padding-top: 0;
                padding-bottom: 0;

                flex-wrap: nowrap;

                gap: 12px;
            }


            body.guest-page .edulearn-logo {
                flex: 0 1 auto;
                min-width: 0;
            }


            body.guest-page .account-area {
                display: none;
            }


            body.guest-page .guest-menu-toggle {
                width: 42px;
                height: 42px;

                margin-left: auto;
                padding: 0;

                border: 1px solid #E2E8F0;
                border-radius: 9px;

                flex: 0 0 42px;

                display: inline-flex;
                align-items: center;
                justify-content: center;
                flex-direction: column;

                gap: 4px;

                background: #FFFFFF;
                color: #334155;

                cursor: pointer;
            }


            body.guest-page .guest-menu-toggle span {
                width: 18px;
                height: 2px;

                border-radius: 999px;

                display: block;

                background: currentColor;
            }


            body.guest-page .edulearn-nav-links {
                position: absolute;

                z-index: 1400;

                top: calc(100% + 1px);
                right: 0;
                left: 0;

                order: initial;

                width: 100%;
                max-height: calc(100vh - 82px);

                padding: 10px;

                border: 1px solid #E2E8F0;
                border-radius: 0 0 12px 12px;

                display: none;
                flex-direction: column;
                align-items: stretch;

                gap: 4px;

                overflow-x: visible;
                overflow-y: auto;

                background: #FFFFFF;

                box-shadow:
                    0 14px 28px
                    rgba(15, 23, 42, .10);
            }


            body.guest-page
            .edulearn-nav-links.is-mobile-open {
                display: flex;
            }


            body.guest-page .edulearn-nav-link {
                width: 100%;

                min-height: 46px;

                padding: 0 12px;

                border-radius: 8px;

                justify-content: space-between;

                color: #334155;

                font-size: 14px;
                font-weight: 500;
                line-height: 1.2;
            }


            body.guest-page
            .edulearn-nav-link:hover {
                background: #F8FAFC;

                color: #2563EB;
            }


            body.guest-page
            .edulearn-nav-link.active {
                background: #EFF6FF;

                color: #2563EB;

                font-weight: 600;
            }


            body.guest-page .edulearn-dropdown {
                width: 100%;

                display: block;
            }


            body.guest-page
            .edulearn-dropdown::after {
                display: none;
            }


            /*
             * QUAN TRỌNG:
             * Submenu đóng phải display:none.
             * opacity/visibility một mình không loại phần tử khỏi flow.
             */
            body.guest-page
            .edulearn-dropdown-menu {
                position: static;

                width: 100%;
                min-width: 0;

                margin: 0;
                padding: 0;

                border: 0;
                border-radius: 8px;

                display: none;

                opacity: 1;
                visibility: visible;
                pointer-events: auto;

                transform: none;

                background: #F8FAFC;

                box-shadow: none;
            }


            body.guest-page
            .edulearn-dropdown-menu::before {
                display: none;
            }


            body.guest-page
            .edulearn-dropdown.open
            > .edulearn-dropdown-menu {
                margin-top: 4px;
                padding: 6px;

                display: block;
            }


            body.guest-page
            .dropdown-menu-item {
                min-height: 42px;

                padding: 0 10px;

                border-radius: 7px;

                gap: 8px;

                color: #475569;

                font-size: 13px;
                font-weight: 500;
            }


            body.guest-page
            .dropdown-menu-item:hover {
                background: #EFF6FF;

                color: #2563EB;
            }


            body.guest-page
            .dropdown-menu-item.active {
                background: #EAF2FF;

                color: #2563EB;

                font-weight: 600;
            }


            body.guest-page
            .dropdown-menu-divider {
                margin: 4px 4px;

                background: #E2E8F0;
            }


            body.guest-page
            .dropdown-level {
                font-size: 10px;
            }


            body.guest-page
            .guest-mobile-auth {
                margin-top: 6px;
                padding-top: 10px;

                border-top: 1px solid #E2E8F0;

                display: grid;
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));

                gap: 8px;
            }


            body.guest-page
            .guest-mobile-auth .auth-link {
                width: 100%;
                height: 43px;

                padding: 0 10px;

                border-radius: 9px;

                font-size: 13px;
                font-weight: 600;
            }
        }


        @@media (max-width: 360px) {

            body.guest-page
            .guest-mobile-auth {
                grid-template-columns: 1fr;
            }
        }


        /* =========================================
           WORKSPACE HEADER RESPONSIVE
        ========================================= */

        @@media (max-width: 1080px) {

            .role-workspace-page .edulearn-nav-container {
                grid-template-columns:
                    auto
                    minmax(180px, 1fr)
                    auto;
            }

            .role-workspace-page .workspace-brand-zone {
                padding: 0 12px;

                border-right: none;
            }

            .role-workspace-page .dashboard-header-search {
                width: 100%;
                max-width: none;

                padding-left: 8px;
            }

            .role-workspace-page .account-area {
                padding: 0 12px;
            }
        }


        @@media (max-width: 680px) {

            .role-workspace-page .workspace-logo {
                display: none;
            }

            .role-workspace-page .workspace-brand-zone {
                padding: 0 8px;
            }

            .role-workspace-page .edulearn-nav-container {
                grid-template-columns:
                    58px
                    minmax(140px, 1fr)
                    auto;
            }

            .role-workspace-page .account-copy {
                display: none;
            }
        }

    </style>



    @if (isRoleWorkspacePage)
    {
        <link rel="stylesheet"
              href="~/css/workspace-shell.css"
              asp-append-version="true" />
    }

    @if (isRoleHomeDashboard)
    {
        <link rel="stylesheet"
              href="~/css/dashboard-role.css"
              asp-append-version="true" />
    }

    <link rel="stylesheet"
          href="~/css/edulearn-typography.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/dashboard-polish.css"
          asp-append-version="true" />

</head>


<body class="@(isRoleWorkspacePage ? "role-workspace-page" : !isAuthenticated ? "guest-page" : "")">


    <!-- =========================================
         NAVBAR
    ========================================= -->

    <header class="edulearn-navbar">


        <div class="edulearn-nav-container">


            @if (isRoleWorkspacePage)
            {
                <div class="workspace-brand-zone">

                    <button type="button"
                            class="dashboard-sidebar-toggle"
                            data-dashboard-sidebar-toggle
                            aria-label="Thu gọn menu tác vụ"
                            aria-expanded="true"
                            title="Thu gọn menu tác vụ">

                        <span class="dashboard-sidebar-toggle-lines">
                            <span></span>
                        </span>

                    </button>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="edulearn-logo workspace-logo">
                        EduLearn
                    </a>

                </div>
            }
            else
            {
                <a asp-controller="Home"
                   asp-action="Index"
                   class="edulearn-logo">
                    EduLearn
                </a>
            }



            <!-- =================================
                 MENU
            ================================== -->

            @if (isRoleWorkspacePage)
            {
                <div class="dashboard-header-search">

                    <form asp-controller="Courses"
                          asp-action="Index"
                          method="get"
                          class="dashboard-header-search-form">

                        <span class="dashboard-header-search-icon">
                            ⌕
                        </span>

                        <input type="search"
                               name="search"
                               class="dashboard-header-search-input"
                               placeholder="Tìm kiếm khóa học..." />

                    </form>

                </div>
            }
            else
            {

            <nav id="guestPrimaryNav"
                 class="edulearn-nav-links"
                 aria-label="Điều hướng chính">


                <a asp-controller="Home"
                   asp-action="Index"
                   class="edulearn-nav-link @(isHomePage ? "active" : "")">

                    Trang chủ

                </a>



                <!-- =================================
                     KHÓA HỌC
                ================================== -->

                <div class="edulearn-dropdown"
                     data-dropdown>


                    <button type="button"
                            class="edulearn-nav-link dropdown-trigger @(isCoursesPage ? "active" : "")"
                            data-dropdown-trigger
                            aria-expanded="false">

                        Khóa học


                        <svg class="nav-chevron"
                             viewBox="0 0 20 20"
                             fill="none"
                             xmlns="http://www.w3.org/2000/svg">

                            <path d="M5 7.5L10 12.5L15 7.5"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />

                        </svg>

                    </button>



                    <div class="edulearn-dropdown-menu">


                        <a asp-controller="Courses"
                           asp-action="Index"
                           class="dropdown-menu-item @(
                               isCoursesPage &&
                               currentAction == "Index" &&
                               string.IsNullOrWhiteSpace(selectedLevel)
                                   ? "active"
                                   : "")">

                            <span>
                                Tất cả khóa học
                            </span>

                        </a>


                        <div class="dropdown-menu-divider">
                        </div>



                        <a asp-controller="Courses"
                           asp-action="Index"
                           asp-route-level="beginner"
                           class="dropdown-menu-item @(selectedLevel == "beginner" ? "active" : "")">

                            <span class="level-menu-left">

                                <span class="level-dot beginner">
                                </span>

                                <span>
                                    Cơ bản
                                </span>

                            </span>

                            <span class="dropdown-level">
                                Bắt đầu
                            </span>

                        </a>



                        <a asp-controller="Courses"
                           asp-action="Index"
                           asp-route-level="intermediate"
                           class="dropdown-menu-item @(selectedLevel == "intermediate" ? "active" : "")">

                            <span class="level-menu-left">

                                <span class="level-dot intermediate">
                                </span>

                                <span>
                                    Trung cấp
                                </span>

                            </span>

                            <span class="dropdown-level">
                                Phát triển
                            </span>

                        </a>



                        <a asp-controller="Courses"
                           asp-action="Index"
                           asp-route-level="advanced"
                           class="dropdown-menu-item @(selectedLevel == "advanced" ? "active" : "")">

                            <span class="level-menu-left">

                                <span class="level-dot advanced">
                                </span>

                                <span>
                                    Nâng cao
                                </span>

                            </span>

                            <span class="dropdown-level">
                                Chuyên sâu
                            </span>

                        </a>


                    </div>


                </div>



                <a asp-controller="Explore"
                   asp-action="Instructors"
                   class="edulearn-nav-link @(isInstructorsPage ? "active" : "")">

                    Giảng viên

                </a>



                <a asp-controller="Explore"
                   asp-action="About"
                   class="edulearn-nav-link @(isAboutPage ? "active" : "")">

                    Về EduLearn

                </a>


                @if (!isAuthenticated)
                {
                    <div class="guest-mobile-auth"
                         aria-label="Tài khoản">

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="auth-link login-link">
                            Đăng nhập
                        </a>

                        <a asp-controller="Account"
                           asp-action="Register"
                           class="auth-link register-link">
                            Đăng ký
                        </a>

                    </div>
                }


            </nav>
            }




            @if (!isAuthenticated)
            {
                <button type="button"
                        class="guest-menu-toggle"
                        data-guest-menu-toggle
                        aria-label="Mở menu"
                        aria-controls="guestPrimaryNav"
                        aria-expanded="false">

                    <span></span>
                    <span></span>
                    <span></span>

                </button>
            }


            <!-- =================================
                 RIGHT AREA
            ================================== -->

            <div class="account-area">


                @if (isAuthenticated)
                {

                    <!-- NOTIFICATION -->

                    <div class="notification-area">

                        @await Component.InvokeAsync(
                            "NotificationBell")

                    </div>



                    <!-- ACCOUNT DROPDOWN -->

                    <div class="account-dropdown"
                         data-dropdown>
                        <!-- Shared Lucide-style outline icons, defined once for all three roles. -->
                        <svg class="account-menu-symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                            <symbol id="account-icon-book" viewBox="0 0 24 24"><path d="M12 7v14M3 18V5a2 2 0 0 1 2-2h3a4 4 0 0 1 4 4 4 4 0 0 1 4-4h3a2 2 0 0 1 2 2v13h-5a4 4 0 0 0-4 3 4 4 0 0 0-4-3H3Z"/></symbol>
                            <symbol id="account-icon-heart" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></symbol>
                            <symbol id="account-icon-help" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 2-2.5 2-2.5 4M12 17h.01"/></symbol>
                            <symbol id="account-icon-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M16 3.4a4 4 0 0 1 0 7.6M22 21v-2a4 4 0 0 0-3-3.9"/><circle cx="9" cy="7" r="4"/></symbol>
                            <symbol id="account-icon-chart" viewBox="0 0 24 24"><path d="M3 3v18h18M7 16v-5M12 16V7M17 16V5"/></symbol>
                            <symbol id="account-icon-message" viewBox="0 0 24 24"><path d="M20 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-4-.9L3 20l.9-4.5a8.5 8.5 0 1 1 16.1-4Z"/></symbol>
                            <symbol id="account-icon-dashboard" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></symbol>
                            <symbol id="account-icon-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></symbol>
                            <symbol id="account-icon-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></symbol>
                            <symbol id="account-icon-logout" viewBox="0 0 24 24"><path d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5M16 7l5 5-5 5M21 12H9"/></symbol>
                        </svg>



                        <button type="button"
                                class="account-dropdown-button"
                                data-dropdown-trigger
                                aria-expanded="false"
                                aria-haspopup="true"
                                aria-controls="accountDropdownMenu"
                                aria-label="Mở menu tài khoản">


                            <span class="account-avatar">
                                @if (!string.IsNullOrWhiteSpace(firstLetter))
                                {
                                    @firstLetter
                                }
                                else
                                {
                                    <svg class="account-avatar__fallback-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#account-icon-user" /></svg>
                                }
                                @if (!string.IsNullOrWhiteSpace(avatarUrl))
                                {
                                    <img class="account-avatar__image" src="@avatarUrl" alt="" onerror="this.remove()" />
                                }
                            </span>


                            <span class="account-copy">

                                <span class="account-name">

                                    @displayName

                                </span>

                                <span class="account-role-inline">

                                    @roleLabel

                                </span>

                            </span>


                            <svg class="account-chevron"
                                 viewBox="0 0 20 20"
                                 fill="none"
                                 xmlns="http://www.w3.org/2000/svg">

                                <path d="M5 7.5L10 12.5L15 7.5"
                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />

                            </svg>


                        </button>



                        <div class="account-dropdown-menu" id="accountDropdownMenu">

                            <div class="account-menu-header">
                                <span class="account-avatar account-avatar--menu">
                                    @if (!string.IsNullOrWhiteSpace(firstLetter))
                                    {
                                        @firstLetter
                                    }
                                    else
                                    {
                                        <svg class="account-avatar__fallback-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#account-icon-user" /></svg>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(avatarUrl))
                                    {
                                        <img class="account-avatar__image" src="@avatarUrl" alt="" onerror="this.remove()" />
                                    }
                                </span>
                                <div class="account-menu-identity">

                                <div class="account-menu-name">

                                    @displayName

                                </div>


                                <div class="account-menu-role">

                                    @roleLabel

                                </div>
                                </div>

                            </div>


                            <div class="dropdown-menu-divider">
                            </div>



                            @if (isStudent)
                            {

                                <a asp-controller="Courses"
                                   asp-action="MyCourses"
                                   class="account-menu-item @(isMyCoursesPage ? "active" : "")">

                                    <span class="account-menu-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#account-icon-book" /></svg>
                                    </span>

                                    <span>
                                        Khóa học của tôi
                                    </span>

                                </a>

                                <a asp-controller="Wishlist"
                                   asp-action="Index"
                                   class="account-menu-item @(isWishlistPage ? "active" : "")">

                                    <span class="account-menu-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#account-icon-heart" /></svg>
                                    </span>

                                    <span>
                                        Danh sách yêu thích
                                    </span>

                                </a>




                                <a asp-controller="LessonQuestions"
                                   asp-action="MyQuestions"
                                   class="account-menu-item @(isQuestionsPage ? "active" : "")">

                                    <span class="account-menu-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#account-icon-help" /></svg>
                                    </span>

                                    <span>
                                        Câu hỏi của tôi
                                    </span>

                                </a>

                            }



                            @if (isInstructor)
                            {

                                <a asp-controller="InstructorCourses"
                                   asp-action="Index"
                                   class="account-menu-item @(isInstructorCoursesPage ? "active" : "")">

                                    <span class="account-menu-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#account-icon-book" /></svg>
                                    </span>

                                    <span>
                                        Khóa học phụ trách
                                    </span>

                                </a>


                                <a asp-controller="InstructorStudents"
                                   asp-action="Index"
                                   class="account-menu-item @(isInstructorStudentsPage ? "active" : "")">

                                    <span class="account-menu-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#account-icon-users" /></svg>
                                    </span>

                                    <span>
                                        Học viên khóa học
                                    </span>

                                </a>


                                <a asp-controller="InstructorAnalytics"
                                   asp-action="Index"
                                   class="account-menu-item @(isInstructorAnalyticsPage ? "active" : "")">

                                    <span class="account-menu-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#account-icon-chart" /></svg>
                                    </span>

                                    <span>
                                        Phân tích khóa học
                                    </span>

                                </a>


                                <a asp-controller="LessonQuestions"
                                   asp-action="Index"
                                   class="account-menu-item @(isQuestionsPage ? "active" : "")">

                                    <span class="account-menu-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#account-icon-message" /></svg>
                                    </span>

                                    <span>
                                        Hỏi đáp học viên
                                    </span>

                                </a>

                            }



                            @if (isAdmin)
                            {

                                <a asp-controller="AdminDashboard"
                                   asp-action="Index"
                                   class="account-menu-item @(isAdminDashboardPage ? "active" : "")">

                                    <span class="account-menu-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#account-icon-dashboard" /></svg>
                                    </span>

                                    <span>
                                        Bảng điều khiển
                                    </span>

                                </a>


                                <a asp-controller="AdminCourses"
                                   asp-action="Index"
                                   class="account-menu-item @(isAdminCoursesPage ? "active" : "")">

                                    <span class="account-menu-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#account-icon-book" /></svg>
                                    </span>

                                    <span>
                                        Quản lý khóa học
                                    </span>

                                </a>


                                <a asp-controller="AdminCategories"
                                   asp-action="Index"
                                   class="account-menu-item @(isAdminCategoriesPage ? "active" : "")">

                                    <span class="account-menu-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#account-icon-grid" /></svg>
                                    </span>

                                    <span>
                                        Quản lý danh mục
                                    </span>

                                </a>


                                <a asp-controller="AdminUsers"
                                   asp-action="Index"
                                   class="account-menu-item @(isAdminUsersPage ? "active" : "")">

                                    <span class="account-menu-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#account-icon-users" /></svg>
                                    </span>

                                    <span>
                                        Quản lý người dùng
                                    </span>

                                </a>


                                <a asp-controller="LessonQuestions"
                                   asp-action="Index"
                                   class="account-menu-item @(isQuestionsPage ? "active" : "")">

                                    <span class="account-menu-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#account-icon-message" /></svg>
                                    </span>

                                    <span>
                                        Quản lý hỏi đáp
                                    </span>

                                </a>

                            }



                            <a asp-controller="Profile"
                               asp-action="Index"
                               class="account-menu-item @(isProfilePage ? "active" : "")">

                                <span class="account-menu-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#account-icon-user" /></svg>
                                    </span>

                                <span>
                                    Quản lý tài khoản
                                </span>

                            </a>



                            <div class="dropdown-menu-divider">
                            </div>



