@inject Microsoft.AspNetCore.Identity.UserManager<OnlineLearningPlatform.Models.ApplicationUser> UserManager

@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();


    bool isHomePage =
        currentController == "Home" &&
        currentAction == "Index";


    bool isCoursesPage =
        currentController == "Courses";


    bool isMyCoursesPage =
        currentController == "Courses" &&
        currentAction == "MyCourses";


    bool isQuestionsPage =
        currentController == "LessonQuestions";


    bool isInstructorCoursesPage =
        currentController == "InstructorCourses";


    bool isInstructorStudentsPage =
        currentController == "InstructorStudents";


    bool isInstructorAnalyticsPage =
        currentController == "InstructorAnalytics";


    bool isInstructorsPage =
        currentController == "Explore" &&
        currentAction == "Instructors";


    bool isAboutPage =
        currentController == "Explore" &&
        currentAction == "About";


    bool isProfilePage =
        currentController == "Profile";


    bool isWishlistPage =
        currentController == "Wishlist";


    bool isAdminDashboardPage =
        currentController == "AdminDashboard";


    bool isAdminUsersPage =
        currentController == "AdminUsers";


    bool isAdminCoursesPage =
        currentController == "AdminCourses";


    bool isAdminCategoriesPage =
        currentController == "AdminCategories";


    bool isAuthenticated =
        User.Identity?.IsAuthenticated == true;


    bool isStudent =
        isAuthenticated &&
        User.IsInRole("Student");


    bool isInstructor =
        isAuthenticated &&
        User.IsInRole("Instructor");


    bool isAdmin =
        isAuthenticated &&
        User.IsInRole("Admin");


    bool isRoleHomeDashboard =
        isAuthenticated &&
        isHomePage;


    bool isNotificationsPage =
        currentController == "Notifications";


    bool isStudentWorkspacePage =
        isStudent &&
        (
            isHomePage ||
            isWishlistPage ||
            isProfilePage ||
            isQuestionsPage ||
            isNotificationsPage ||
            (
                currentController == "Courses" &&
                (
                    currentAction == "MyCourses" ||
                    currentAction == "Learn"
                )
            )
        );


    bool isInstructorWorkspacePage =
        isInstructor &&
        (
            isHomePage ||
            isInstructorCoursesPage ||
            isInstructorStudentsPage ||
            isInstructorAnalyticsPage ||
            isQuestionsPage ||
            isNotificationsPage ||
            isProfilePage
        );


    bool isAdminWorkspacePage =
        isAdmin &&
        (
            isHomePage ||
            isAdminDashboardPage ||
            isAdminUsersPage ||
            isAdminCoursesPage ||
            isAdminCategoriesPage ||
            isQuestionsPage ||
            isNotificationsPage ||
            isProfilePage
        );


    bool isRoleWorkspacePage =
        isStudentWorkspacePage ||
        isInstructorWorkspacePage ||
        isAdminWorkspacePage;


    // =========================================
    // CẤP ĐỘ ĐANG CHỌN
    // =========================================

    string selectedLevel =
        Context.Request.Query["level"]
            .ToString()
            .Trim()
            .ToLowerInvariant();


    // =========================================
    // USER HIỆN TẠI
    // =========================================

    OnlineLearningPlatform.Models.ApplicationUser? currentUser =
        null;


    if (isAuthenticated)
    {
        currentUser =
            await UserManager.GetUserAsync(User);
    }


    string displayName =
        !string.IsNullOrWhiteSpace(
            currentUser?.FullName)
            ? currentUser.FullName
            : User.Identity?.Name
                ?? "User";


    string firstLetter =
        !string.IsNullOrWhiteSpace(
            displayName)
            ? displayName
                .Substring(0, 1)
                .ToUpper()
            : "U";


    string roleLabel =
        isInstructor
            ? "Giảng viên"
            : isAdmin
                ? "Quản trị viên"
                : "Học viên";
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EduLearn</title>


    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
<style>

        html,
        body {
            min-height: 100%;
        }


        body {
            margin: 0;

            background: #ffffff;
            color: #172033;
        }


        /* =========================================
           NAVBAR
        ========================================= */

        .edulearn-navbar {
            position: relative;

            z-index: 1000;

            background: #ffffff;

            border-bottom: 1px solid #e9edf3;
        }


        .edulearn-nav-container {
            width: min(
                1280px,
                calc(100% - 32px)
            );

            max-width: none;

            min-height: 82px;

            margin: 0 auto;

            padding: 0;

            display: flex;
            align-items: center;

            gap: 32px;
        }


        /* =========================================
           LOGO
        ========================================= */

        .edulearn-logo {
            color: #0d6efd;

            font-size: 25px;
            font-weight: 800;

            text-decoration: none;

            white-space: nowrap;
        }


        .edulearn-logo:hover {
            color: #0d6efd;
        }


        /* =========================================
           MAIN NAV
        ========================================= */

        .edulearn-nav-links {
            display: flex;
            align-items: center;

            gap: 27px;

            flex: 1;
        }


        .edulearn-nav-link {
            min-height: 42px;

            padding: 0;

            border: none;

            background: transparent;
            color: #273142;

            display: inline-flex;
            align-items: center;

            gap: 6px;

            font-family: inherit;

            font-size: 14px;
            font-weight: 600;

            line-height: 1;

            text-decoration: none;

            white-space: nowrap;

            cursor: pointer;

            transition: color .2s ease;
        }


        .edulearn-nav-link:hover {
            color: #0d6efd;
        }


        .edulearn-nav-link.active {
            color: #0d6efd;

            font-weight: 700;
        }


        .nav-chevron {
            width: 14px;
            height: 14px;

            transition: transform .2s ease;
        }


        /* =========================================
           DROPDOWN
        ========================================= */

        .edulearn-dropdown {
            position: relative;

            display: flex;
            align-items: center;
        }


        /*
         * CẦU NỐI VÔ HÌNH
         *
         * Giữ trạng thái hover khi rê chuột
         * từ nút xuống menu.
         */
        .edulearn-dropdown::after {
            content: "";

            position: absolute;

            top: 100%;
            left: -12px;
            right: -12px;

            height: 16px;

            background: transparent;
        }


        .edulearn-dropdown-menu {
            position: absolute;

            top: calc(100% + 9px);
            left: -20px;

            z-index: 1200;

            min-width: 245px;

            padding: 9px;

            border: 1px solid #e4e9f0;
            border-radius: 12px;

            background: #ffffff;

            box-shadow:
                0 16px 38px
                rgba(34, 48, 73, .14);

            opacity: 0;

            visibility: hidden;

            pointer-events: none;

            transform: translateY(6px);

            transition:
                opacity .16s ease,
                transform .16s ease,
                visibility .16s ease;
        }


        .edulearn-dropdown-menu::before {
            content: "";

            position: absolute;

            top: -8px;
            left: 31px;

            width: 16px;
            height: 16px;

            background: #ffffff;

            border-left: 1px solid #e4e9f0;
            border-top: 1px solid #e4e9f0;

            transform: rotate(45deg);
        }


        .edulearn-dropdown:hover
        > .edulearn-dropdown-menu,
        .edulearn-dropdown.open
        > .edulearn-dropdown-menu {
            opacity: 1;

            visibility: visible;

            pointer-events: auto;

            transform: translateY(0);
        }


        .edulearn-dropdown:hover
        > .dropdown-trigger
        .nav-chevron,
        .edulearn-dropdown.open
        > .dropdown-trigger
        .nav-chevron {
            transform: rotate(180deg);
        }


        /* =========================================
           DROPDOWN ITEM
        ========================================= */

        .dropdown-menu-item {
            position: relative;

            min-height: 44px;

            padding: 0 13px;

            border-radius: 8px;

            color: #4f5969;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 12px;

            font-size: 13px;
            font-weight: 600;

            text-decoration: none;

            transition:
                background .15s ease,
                color .15s ease;
        }


        .dropdown-menu-item:hover {
            background: #f2f7ff;

            color: #0d6efd;
        }


        .dropdown-menu-item.active {
            background: #edf4ff;

            color: #0d6efd;

            font-weight: 700;
        }


        .dropdown-menu-divider {
            height: 1px;

            margin: 7px 6px;

            background: #edf0f4;
        }


        /* =========================================
           LEVEL DOT
        ========================================= */

        .level-menu-left {
            display: flex;
            align-items: center;

            gap: 9px;
        }


        .level-dot {
            width: 8px;
            height: 8px;

            flex: 0 0 8px;

            border-radius: 50%;
        }


        .level-dot.beginner {
            background: #0d6efd;
        }


        .level-dot.intermediate {
            background: #7451d8;
        }


        .level-dot.advanced {
            background: #0b8f82;
        }


        .dropdown-level {
            color: #a0a8b5;

            font-size: 10px;
            font-weight: 600;
        }


        .dropdown-menu-item.active
        .dropdown-level {
            color: currentColor;

            opacity: .7;
        }


        /* =========================================
           RIGHT AREA
        ========================================= */

        .account-area {
            margin-left: auto;

            display: flex;
            align-items: center;

            gap: 11px;

            white-space: nowrap;
        }


        /* =========================================
           NOTIFICATION
        ========================================= */

        .notification-area {
            width: 44px;
            height: 44px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;
        }


        /* =========================================
           ACCOUNT DROPDOWN
        ========================================= */

        .account-dropdown {
            position: relative;
        }


        /*
         * CẦU NỐI CHO MENU TÀI KHOẢN
         */
        .account-dropdown::after {
            content: "";

            position: absolute;

            top: 100%;
            left: -10px;
            right: -10px;

            height: 16px;

            background: transparent;
        }


        .account-dropdown-button {
            min-height: 50px;

            max-width: 240px;

            padding: 5px 12px 5px 6px;

            border: 1px solid #dfe5ed;
            border-radius: 10px;

            background: #ffffff;
            color: #273142;

            display: flex;
            align-items: center;

            gap: 10px;

            font-family: inherit;

            font-size: 13px;
            font-weight: 600;

            cursor: pointer;

            transition:
                border-color .2s ease,
                background .2s ease;
        }


        .account-dropdown-button:hover {
            border-color: #bfd4f7;

            background: #fbfdff;
        }


        .account-avatar {
            width: 32px;
            height: 32px;

            flex: 0 0 32px;

            border-radius: 50%;

            background: #edf4ff;
            color: #0d6efd;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 12px;
            font-weight: 800;

            text-transform: uppercase;
        }


        .account-copy {
            min-width: 0;

            display: flex;
            flex-direction: column;
            align-items: flex-start;

            line-height: 1.15;
        }


        .account-name {
            max-width: 170px;

            overflow: hidden;

            text-overflow: ellipsis;

            white-space: nowrap;
        }


        .account-role-inline {
            margin-top: 3px;

            color: #8a95a6;

            font-size: 10px;
            font-weight: 500;
        }


        .dashboard-sidebar-toggle {
            width: 42px;
            height: 42px;

            flex: 0 0 42px;

            padding: 0;

            border: 0;
            border-radius: 10px;

            background: transparent;
            color: #172033;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            cursor: pointer;

            transition:
                background .18s ease,
                color .18s ease;
        }


        .dashboard-sidebar-toggle:hover {
            background: #eef5ff;
            color: #126bff;
        }


        .dashboard-sidebar-toggle-lines {
            width: 21px;
            height: 16px;

            position: relative;

            display: block;
        }


        .dashboard-sidebar-toggle-lines::before,
        .dashboard-sidebar-toggle-lines::after,
        .dashboard-sidebar-toggle-lines span {
            content: "";

            position: absolute;
            left: 0;

            width: 21px;
            height: 2px;

            border-radius: 20px;

            background: currentColor;

            transition:
                width .18s ease;
        }


        .dashboard-sidebar-toggle-lines::before {
            top: 0;
        }


        .dashboard-sidebar-toggle-lines span {
            top: 7px;
        }


        .dashboard-sidebar-toggle-lines::after {
            bottom: 0;
        }


        .dashboard-sidebar-toggle.is-collapsed
        .dashboard-sidebar-toggle-lines::before,
        .dashboard-sidebar-toggle.is-collapsed
        .dashboard-sidebar-toggle-lines::after {
            width: 15px;
        }


        .dashboard-header-search {
            min-width: 260px;
            max-width: 600px;

            flex: 1;

            margin-left: 22px;
        }


        .dashboard-header-search-form {
            width: 100%;

            position: relative;
        }


        .dashboard-header-search-input {
            width: 100%;
            height: 44px;

            padding: 0 18px 0 42px;

            border: 1px solid #e1e8f2;
            border-radius: 11px;

            outline: none;

            background: #f6f9fd;
            color: #273142;

            font-family: inherit;
            font-size: 12px;

            transition:
                border-color .2s ease,
                box-shadow .2s ease,
                background .2s ease;
        }


        .dashboard-header-search-input:focus {
            border-color: #a8c8fb;

            background: #ffffff;

            box-shadow: 0 0 0 3px rgba(18, 107, 255, .08);
        }


        .dashboard-header-search-icon {
            position: absolute;

            left: 15px;
            top: 50%;

            transform: translateY(-50%);

            color: #6f7d90;

            font-size: 15px;
            pointer-events: none;
        }


        .account-chevron {
            width: 14px;
            height: 14px;

            margin-left: 2px;

            color: #8791a1;

            transition: transform .2s ease;
        }


        .account-dropdown:hover
        .account-chevron,
        .account-dropdown.open
        .account-chevron {
            transform: rotate(180deg);
        }


        .account-dropdown-menu {
            position: absolute;

            top: calc(100% + 9px);
            right: 0;

            z-index: 1250;

            width: 270px;

            padding: 10px;

            border: 1px solid #e4e9f0;
            border-radius: 13px;

            background: #ffffff;

            box-shadow:
                0 18px 45px
                rgba(34, 48, 73, .15);

            opacity: 0;

            visibility: hidden;

            pointer-events: none;

            transform: translateY(6px);

            transition:
                opacity .16s ease,
                transform .16s ease,
                visibility .16s ease;
        }


        .account-dropdown-menu::before {
            content: "";

            position: absolute;

            top: -8px;
            right: 28px;

            width: 16px;
            height: 16px;

            background: #ffffff;

            border-left: 1px solid #e4e9f0;
            border-top: 1px solid #e4e9f0;

            transform: rotate(45deg);
        }


        .account-dropdown:hover
        > .account-dropdown-menu,
        .account-dropdown.open
        > .account-dropdown-menu {
            opacity: 1;

            visibility: visible;

            pointer-events: auto;

            transform: translateY(0);
        }


        /* =========================================
           ACCOUNT HEADER
        ========================================= */

        .account-menu-header {
            padding: 11px 12px 12px;
        }


        .account-menu-name {
            margin-bottom: 3px;

            color: #273142;

            font-size: 13px;
            font-weight: 800;

            overflow: hidden;

            text-overflow: ellipsis;

            white-space: nowrap;
        }


        .account-menu-role {
            color: #8b95a5;

            font-size: 11px;
            font-weight: 600;
        }


        /* =========================================
           ACCOUNT ITEM
        ========================================= */

        .account-menu-item {
            width: 100%;

            min-height: 42px;

            padding: 0 12px;

            border: none;
            border-radius: 8px;

            background: transparent;
            color: #4e596b;

            display: flex;
            align-items: center;

            gap: 11px;

            font-family: inherit;

            font-size: 13px;
            font-weight: 600;

            text-align: left;

            text-decoration: none;

            cursor: pointer;

            transition:
                background .15s ease,
                color .15s ease;
        }


        .account-menu-item:hover {
            background: #f3f7fd;

            color: #0d6efd;
        }


        .account-menu-item.active {
            background: #edf4ff;

            color: #0d6efd;
        }


        .account-menu-item.danger {
            color: #dc3545;
        }


        .account-menu-item.danger:hover {
            background: #fff4f5;

            color: #c92a3a;
        }


        .account-menu-icon {
            width: 18px;
            height: 18px;

            flex: 0 0 18px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: currentColor;
        }


        .account-menu-form {
            margin: 0;
        }


        /* =========================================
           AUTH
        ========================================= */

        .auth-link {
            height: 44px;

            padding: 0 16px;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            border-radius: 10px;

            font-size: 13px;
            font-weight: 700;

            text-decoration: none;
        }


        .login-link {
            color: #0d6efd;

            background: #ffffff;

            border: 1px solid #bdd5ff;
        }


        .register-link {
            color: #ffffff;

            background: #0d6efd;

            border: 1px solid #0d6efd;
        }


        /* =========================================
           WORKSPACE HEADER
           Cột trái của header nối liền với sidebar.
        ========================================= */

        .role-workspace-page {
            --workspace-sidebar-width: 220px;
            --workspace-sidebar-collapsed-width: 72px;
        }


        .role-workspace-page .edulearn-navbar {
            position: sticky !important;
            top: 0;
            left: 0;
            right: 0;

            width: 100%;

            z-index: 1700;

            background: #ffffff;
        }


        .role-workspace-page .edulearn-nav-container {
            width: 100% !important;
            max-width: none !important;
            min-height: 82px;

            margin: 0 !important;
            padding: 0 !important;

            display: grid;
            grid-template-columns:
                var(--workspace-sidebar-width)
                minmax(320px, 1fr)
                auto;

            gap: 0 !important;

            align-items: center;

            transition:
                grid-template-columns .2s ease;
        }


        .role-workspace-page .workspace-brand-zone {
            align-self: stretch;

            padding: 0 18px;

            border-right: 1px solid #e2e9f2;

            display: flex;
            align-items: center;

            gap: 16px;

            background: #ffffff;
        }


        .role-workspace-page .workspace-brand-zone
        .dashboard-sidebar-toggle {
            flex: 0 0 42px;
        }


        .role-workspace-page .workspace-logo {
            min-width: 0;

            overflow: hidden;

            transition:
                opacity .15s ease,
                width .2s ease;
        }


        .role-workspace-page .dashboard-header-search {
            width: min(100%, 760px);
            max-width: 760px;

            margin: 0 !important;
            padding-left: 24px;

            justify-self: start;
        }


        .role-workspace-page .account-area {
            margin: 0 !important;
            padding: 0 24px;

            justify-self: end;
        }


        .role-workspace-page.workspace-sidebar-collapsed
        .edulearn-nav-container {
            grid-template-columns:
                var(--workspace-sidebar-width)
                minmax(320px, 1fr)
                auto;
        }



        .role-workspace-page.workspace-sidebar-collapsed
        .workspace-brand-zone {
            padding: 0 18px;
            justify-content: flex-start;
        }



        /* =========================================
           FOOTER
        ========================================= */

        .edulearn-footer {
            border-top: 1px solid #e7ebf0;

            background: #ffffff;
        }


        .footer-container {
            width: min(
                1280px,
                calc(100% - 32px)
            );

            max-width: none;

            min-height: 78px;

            margin: 0 auto;

            padding: 0;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 25px;

            color: #6c7687;

            font-size: 13px;
        }


        .footer-brand {
            color: #0d6efd;

            font-weight: 800;
        }


        /* =========================================
           RESPONSIVE
        ========================================= */

        @@media (max-width: 1050px) {

            .edulearn-nav-container {
                gap: 20px;
            }


            .edulearn-nav-links {
                gap: 17px;
            }


            .edulearn-nav-link {
                font-size: 13px;
            }
        }


        @@media (max-width: 850px) {



            .edulearn-nav-container {
                width: min(
                    100% - 24px,
                    1280px
                );

                padding-top: 14px;
                padding-bottom: 14px;

                flex-wrap: wrap;
            }


            .edulearn-nav-links {
                order: 3;

                width: 100%;

                overflow-x: auto;

                padding-bottom: 3px;
            }


            .dashboard-header-search {
                order: 3;

                width: 100%;
                max-width: none;
                min-width: 0;

                margin-left: 0;
            }


            .account-area {
                margin-left: auto;
            }


            .edulearn-dropdown-menu {
                left: 0;
            }
        }


        @@media (max-width: 600px) {

            .edulearn-logo {
                font-size: 22px;
            }


            .account-copy {
                display: none;
            }


            .account-dropdown-button {
                width: 44px;

                padding: 5px;

                justify-content: center;
            }


            .account-chevron {
                display: none;
            }


            .account-dropdown-menu {
                position: fixed;

                top: 76px;
                right: 12px;

                width: min(
                    290px,
                    calc(100vw - 24px)
                );
            }


            .footer-container {
                padding-top: 20px;
                padding-bottom: 20px;

                flex-direction: column;
                align-items: flex-start;
            }
        }


        /* =========================================
           WORKSPACE HEADER RESPONSIVE
        ========================================= */

        @@media (max-width: 1080px) {

            .role-workspace-page .edulearn-nav-container {
                grid-template-columns:
                    auto
                    minmax(180px, 1fr)
                    auto;
            }

            .role-workspace-page .workspace-brand-zone {
                padding: 0 12px;

                border-right: none;
            }

            .role-workspace-page .dashboard-header-search {
                width: 100%;
                max-width: none;

                padding-left: 8px;
            }

            .role-workspace-page .account-area {
                padding: 0 12px;
            }
        }


        @@media (max-width: 680px) {

            .role-workspace-page .workspace-logo {
                display: none;
            }

            .role-workspace-page .workspace-brand-zone {
                padding: 0 8px;
            }

            .role-workspace-page .edulearn-nav-container {
                grid-template-columns:
                    58px
                    minmax(140px, 1fr)
                    auto;
            }

            .role-workspace-page .account-copy {
                display: none;
