@model IEnumerable<OnlineLearningPlatform.Models.Notification>

@{
    ViewData["Title"] = "Thông báo";

    var notifications =
        Model.ToList();

    var unreadCount =
        notifications.Count(n =>
            !n.IsRead);
}

<style>

    .notifications-page {
        min-height: 80vh;

        padding: 48px 0 75px;

        background: #f8fafc;
    }


    .notifications-container {
        max-width: 900px;

        margin: 0 auto;

        padding: 0 20px;
    }


    .notifications-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 24px;
    }


    .notifications-eyebrow {
        margin-bottom: 6px;

        color: #0d6efd;

        font-size: 12px;
        font-weight: 800;

        text-transform: uppercase;
    }


    .notifications-title {
        margin: 0;

        color: #172033;

        font-size: 32px;
        font-weight: 800;
    }


    .notifications-description {
        margin: 7px 0 0;

        color: #7a8494;
    }


    .mark-read-form {
        margin: 0;
    }


    .mark-read-button {
        min-height: 40px;

        padding: 0 14px;

        border: 1px solid #c9daf5;
        border-radius: 9px;

        background: #ffffff;
        color: #0d6efd;

        font-size: 12px;
        font-weight: 700;

        cursor: pointer;
    }


    .notification-page-list {
        overflow: hidden;

        border: 1px solid #e4e9f0;
        border-radius: 15px;

        background: #ffffff;
    }


    .notification-page-item {
        position: relative;

        display: grid;

        grid-template-columns:
            42px
            1fr;

        gap: 14px;

        padding: 19px 20px;

        border-bottom: 1px solid #edf0f4;

        color: inherit;

        text-decoration: none;
    }


    .notification-page-item:last-child {
        border-bottom: none;
    }


    .notification-page-item:hover {
        background: #f8fbff;
    }


    .notification-page-item.unread {
        background: #f1f6ff;
    }


    .notification-page-icon {
        width: 42px;
        height: 42px;

        border-radius: 11px;

        background: #edf4ff;
        color: #0d6efd;

        display: flex;
        align-items: center;
        justify-content: center;

        font-weight: 800;
    }


    .notification-page-title {
        margin-bottom: 4px;

        color: #273142;

        font-size: 13px;
        font-weight: 800;
    }


    .notification-page-message {
        color: #697386;

        font-size: 12px;
        line-height: 1.6;
    }


    .notification-page-time {
        margin-top: 5px;

        color: #98a2b3;

        font-size: 10px;
    }


    .notification-page-dot {
        position: absolute;

        top: 21px;
        right: 20px;

        width: 8px;
        height: 8px;

        border-radius: 50%;

        background: #0d6efd;
    }


    .notification-empty {
        padding: 60px 25px;

        border: 1px solid #e4e9f0;
        border-radius: 15px;

        background: #ffffff;

        color: #8992a3;

        text-align: center;
    }


    @@media (max-width: 650px) {

        .notifications-header {
            align-items: flex-start;

            flex-direction: column;
        }

    }

</style>


<div class="notifications-page">

    <div class="notifications-container">


        <div class="notifications-header">

            <div>

                <div class="notifications-eyebrow">
                    Tài khoản
                </div>


                <h1 class="notifications-title">
                    Thông báo
                </h1>


                <p class="notifications-description">

                    Theo dõi các hoạt động mới
                    liên quan đến tài khoản của bạn.

                </p>

            </div>


            @if (unreadCount > 0)
            {
                <form asp-controller="Notifications"
                      asp-action="MarkAllAsRead"
                      method="post"
                      class="mark-read-form">

                    @Html.AntiForgeryToken()


                    <button type="submit"
                            class="mark-read-button">

                        Đánh dấu tất cả đã đọc

                    </button>

                </form>
            }

        </div>



        @if (notifications.Any())
        {
            <div class="notification-page-list">


                @foreach (var notification
                    in notifications)
                {
                    string itemClass =
                        notification.IsRead
                            ? "notification-page-item"
                            : "notification-page-item unread";


                    <a asp-controller="Notifications"
                       asp-action="Open"
                       asp-route-id="@notification.Id"
                       class="@itemClass">


                        <div class="notification-page-icon">

                            @(notification.Type ==
                              "QuestionAnswered"
                                ? "✓"
                                : notification.Type ==
                                  "NewQuestion"
                                    ? "?"
                                    : "i")

                        </div>


                        <div>

                            <div class="notification-page-title">

                                @notification.Title

                            </div>


                            <div class="notification-page-message">

                                @notification.Message

                            </div>


                            <div class="notification-page-time">

                                @(notification.CreatedAt
                                    .ToLocalTime()
                                    .ToString(
                                        "dd/MM/yyyy HH:mm"))

                            </div>

                        </div>


                        @if (!notification.IsRead)
                        {
                            <span class="notification-page-dot">
                            </span>
                        }


                    </a>
                }


            </div>
        }
        else
        {
            <div class="notification-empty">

                Bạn chưa có thông báo nào.

            </div>
        }


    </div>

</div>