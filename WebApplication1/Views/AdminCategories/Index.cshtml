@model OnlineLearningPlatform.ViewModels.AdminCategoriesPageViewModel

@{
    ViewData["Title"] = "Quản lý danh mục";
}

<style>
    .admin-categories-page {
        min-height: 80vh;
        padding: 46px 0 78px;
        background: #f8fafc;
    }

    .admin-categories-container {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 23px;
    }

    .page-eyebrow {
        margin-bottom: 6px;
        color: #0d6efd;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .page-title {
        margin: 0 0 7px;
        color: #172033;
        font-size: 31px;
        font-weight: 800;
    }

    .page-description {
        margin: 0;
        color: #7d8798;
        font-size: 12px;
        line-height: 1.7;
    }

    .create-link {
        min-height: 41px;
        padding: 0 15px;
        border-radius: 8px;
        background: #0d6efd;
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
    }

    .message {
        margin-bottom: 16px;
        padding: 12px 14px;
        border-radius: 9px;
        font-size: 11px;
        font-weight: 700;
    }

        .message.success {
            border: 1px solid #bce4c9;
            background: #effaf3;
            color: #16723a;
        }

        .message.error {
            border: 1px solid #ffd2d6;
            background: #fff4f5;
            color: #b42332;
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .stat-card {
        padding: 17px;
        border: 1px solid #e1e7ee;
        border-radius: 12px;
        background: #ffffff;
    }

    .stat-label {
        color: #8a94a5;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .stat-value {
        margin-top: 6px;
        color: #273142;
        font-size: 23px;
        font-weight: 800;
    }

    .filter-card {
        margin-bottom: 18px;
        padding: 15px;
        border: 1px solid #e1e7ee;
        border-radius: 12px;
        background: #ffffff;
    }

    .filter-form {
        display: grid;
        grid-template-columns: minmax(260px, 1fr) 210px auto auto;
        gap: 9px;
        align-items: end;
    }

    .filter-group label {
        display: block;
        margin-bottom: 5px;
        color: #667085;
        font-size: 9px;
        font-weight: 800;
    }

    .filter-control {
        width: 100%;
        min-height: 40px;
        padding: 0 11px;
        border: 1px solid #dce2ea;
        border-radius: 8px;
        background: #ffffff;
        color: #344054;
        font: inherit;
        font-size: 10px;
        outline: none;
    }

    .filter-button,
    .clear-button {
        min-height: 40px;
        padding: 0 14px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
    }

    .filter-button {
        border: 1px solid #0d6efd;
        background: #0d6efd;
        color: #ffffff;
        font-family: inherit;
        cursor: pointer;
    }

    .clear-button {
        border: 1px solid #dce2ea;
        background: #ffffff;
        color: #667085;
    }

    .categories-card {
        overflow: hidden;
        border: 1px solid #e1e7ee;
        border-radius: 14px;
        background: #ffffff;
    }

    .card-header {
        padding: 17px 19px;
        border-bottom: 1px solid #edf0f4;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .card-title {
        margin: 0;
        color: #344054;
        font-size: 14px;
        font-weight: 800;
    }

    .card-count {
        color: #98a2b3;
        font-size: 9px;
        font-weight: 700;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .categories-table {
        width: 100%;
        min-width: 980px;
        border-collapse: collapse;
    }

        .categories-table th {
            padding: 11px 13px;
            border-bottom: 1px solid #edf0f4;
            background: #fbfcfd;
            color: #7d8798;
            font-size: 9px;
            font-weight: 800;
            text-align: left;
            text-transform: uppercase;
        }

        .categories-table td {
            padding: 13px;
            border-bottom: 1px solid #f0f2f5;
            color: #475467;
            font-size: 10px;
            vertical-align: middle;
        }

        .categories-table tr:last-child td {
            border-bottom: none;
        }

    .category-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .category-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        border-radius: 10px;
        background: #edf4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
    }

    .category-name {
        color: #344054;
        font-size: 11px;
        font-weight: 800;
    }

    .category-slug {
        margin-top: 2px;
        color: #98a2b3;
        font-size: 9px;
    }

    .status-badge {
        display: inline-flex;
        padding: 5px 8px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 800;
    }

        .status-badge.active {
            background: #edf8f1;
            color: #198754;
        }

        .status-badge.inactive {
            background: #f3f4f6;
            color: #697386;
        }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .action-form {
        margin: 0;
    }

    .action-link,
    .action-button {
        min-height: 33px;
        padding: 0 10px;
        border-radius: 7px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: inherit;
        font-size: 9px;
        font-weight: 800;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
    }

    .edit-link {
        border: 1px solid #cfe0fb;
        background: #f5f9ff;
        color: #0d6efd;
    }

    .status-button {
        border: 1px solid #e0e3e8;
        background: #f8f9fb;
        color: #667085;
    }

    .delete-button {
        border: 1px solid #f0c7cc;
        background: #fffafa;
        color: #c92a3a;
    }

    .empty-state {
        padding: 48px 20px;
        color: #8992a3;
        font-size: 10px;
        text-align: center;
    }

    @@media (max-width: 850px) {
        .page-header {
            align-items: stretch;
            flex-direction: column;
        }

        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .filter-form {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 560px) {
        .stats-grid,
        .filter-form {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="admin-categories-page">
    <div class="admin-categories-container">

        <div class="page-header">

            <div>
                <div class="page-eyebrow">
                    Quản trị hệ thống
                </div>

                <h1 class="page-title">
                    Quản lý danh mục
                </h1>

                <p class="page-description">
                    Quản lý các lĩnh vực khóa học,
                    thứ tự hiển thị và trạng thái sử dụng.
                </p>
            </div>

            <a asp-controller="AdminCategories"
               asp-action="Create"
               class="create-link">
                + Thêm danh mục
            </a>

        </div>


        @if (TempData["AdminCategoriesSuccess"] != null)
        {
            <div class="message success">
                @TempData["AdminCategoriesSuccess"]
            </div>
        }

        @if (TempData["AdminCategoriesError"] != null)
        {
            <div class="message error">
                @TempData["AdminCategoriesError"]
            </div>
        }


        <div class="stats-grid">

            <div class="stat-card">
                <div class="stat-label">Tổng danh mục</div>
                <div class="stat-value">@Model.TotalCategories</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Đang hoạt động</div>
                <div class="stat-value">@Model.ActiveCategories</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Tạm ẩn</div>
                <div class="stat-value">@Model.InactiveCategories</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Tổng khóa học</div>
                <div class="stat-value">@Model.TotalCourses</div>
            </div>

        </div>


        <div class="filter-card">

            <form asp-controller="AdminCategories"
                  asp-action="Index"
                  method="get"
                  class="filter-form">

                <div class="filter-group">
                    <label>Tìm kiếm</label>

                    <input type="text"
                           name="search"
                           value="@Model.Search"
                           class="filter-control"
                           placeholder="Tên danh mục hoặc slug..." />
                </div>

                <div class="filter-group">
                    <label>Trạng thái</label>

                    <select name="status"
                            class="filter-control">

                        <option value="">
                            Tất cả trạng thái
                        </option>

                        @if (Model.Status == "active")
                        {
                            <option value="active" selected>
                                Đang hoạt động
                            </option>
                        }
                        else
                        {
                            <option value="active">
                                Đang hoạt động
                            </option>
                        }

                        @if (Model.Status == "inactive")
                        {
                            <option value="inactive" selected>
                                Tạm ẩn
                            </option>
                        }
                        else
                        {
                            <option value="inactive">
                                Tạm ẩn
                            </option>
                        }

                    </select>
                </div>

                <button type="submit"
                        class="filter-button">
                    Lọc
                </button>

                <a asp-controller="AdminCategories"
                   asp-action="Index"
                   class="clear-button">
                    Xóa lọc
                </a>

            </form>

        </div>


        <section class="categories-card">

            <div class="card-header">
                <h2 class="card-title">
                    Danh sách danh mục
                </h2>

                <div class="card-count">
                    @Model.Categories.Count kết quả
                </div>
            </div>


            @if (Model.Categories.Any())
            {
                <div class="table-wrap">

                    <table class="categories-table">

                        <thead>
                            <tr>
                                <th>Danh mục</th>
                                <th>Mô tả</th>
                                <th>Thứ tự</th>
                                <th>Khóa học</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var category in Model.Categories)
                            {
                                <tr>

                                    <td>
                                        <div class="category-cell">

                                            <div class="category-icon">
                                                @(string.IsNullOrWhiteSpace(
                                                    category.Icon)
                                                    ? "DM"
                                                    : category.Icon)
                                            </div>

                                            <div>
                                                <div class="category-name">
                                                    @category.Name
                                                </div>

                                                <div class="category-slug">
                                                    @category.Slug
                                                </div>
                                            </div>

                                        </div>
                                    </td>


                                    <td>
                                        @(string.IsNullOrWhiteSpace(
                                            category.Description)
                                            ? "Chưa có mô tả"
                                            : category.Description)
                                    </td>


                                    <td>
                                        @category.DisplayOrder
                                    </td>


                                    <td>
                                        @category.CourseCount
                                    </td>


                                    <td>
                                        <span class="status-badge @(category.IsActive ? "active" : "inactive")">
                                            @(category.IsActive
                                                ? "Đang hoạt động"
                                                : "Tạm ẩn")
                                        </span>
                                    </td>


                                    <td>

                                        <div class="actions">

                                            <a asp-controller="AdminCategories"
                                               asp-action="Edit"
                                               asp-route-id="@category.Id"
                                               class="action-link edit-link">
                                                Sửa
                                            </a>


                                            <form asp-controller="AdminCategories"
                                                  asp-action="ToggleStatus"
                                                  method="post"
                                                  class="action-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@category.Id" />

                                                <input type="hidden"
                                                       name="returnSearch"
                                                       value="@Model.Search" />

                                                <input type="hidden"
                                                       name="returnStatus"
                                                       value="@Model.Status" />

                                                <button type="submit"
                                                        class="action-button status-button">

                                                    @(category.IsActive
                                                        ? "Tạm ẩn"
                                                        : "Kích hoạt")

                                                </button>

                                            </form>


                                            <form asp-controller="AdminCategories"
                                                  asp-action="Delete"
                                                  method="post"
                                                  class="action-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@category.Id" />

                                                <input type="hidden"
                                                       name="returnSearch"
                                                       value="@Model.Search" />

                                                <input type="hidden"
                                                       name="returnStatus"
                                                       value="@Model.Status" />

                                                <button type="submit"
                                                        class="action-button delete-button"
                                                        onclick="return confirm('Xóa danh mục này? Danh mục đang có khóa học sẽ không thể xóa.');">
                                                    Xóa
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">
                    Không tìm thấy danh mục phù hợp.
                </div>
            }

        </section>

    </div>
</div>
