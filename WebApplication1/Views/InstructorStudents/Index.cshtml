@model OnlineLearningPlatform.ViewModels.InstructorStudentsPageViewModel

@{
    ViewData["Title"] = "Học viên khóa học";
}

<style>

    .students-page {
        min-height: 80vh;
        padding: 48px 0 78px;
        background: #f8fafc;
    }

    .students-container {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .page-eyebrow {
        margin-bottom: 6px;
        color: #0d6efd;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .page-title {
        margin: 0 0 7px;
        color: #172033;
        font-size: 31px;
        font-weight: 800;
    }

    .page-description {
        margin: 0;
        color: #7d8798;
        font-size: 12px;
        line-height: 1.7;
    }

    .course-filter {
        min-width: 310px;
    }

    .course-filter-label {
        display: block;
        margin-bottom: 6px;
        color: #667085;
        font-size: 10px;
        font-weight: 700;
    }

    .course-select {
        width: 100%;
        min-height: 42px;
        padding: 0 11px;
        border: 1px solid #dce2ea;
        border-radius: 9px;
        background: #ffffff;
        color: #344054;
        font: inherit;
        font-size: 11px;
        outline: none;
    }

    .course-summary {
        margin-bottom: 18px;
        padding: 16px 18px;
        border: 1px solid #e1e7ee;
        border-radius: 12px;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .course-name {
        color: #273142;
        font-size: 14px;
        font-weight: 800;
    }

    .course-meta {
        margin-top: 4px;
        color: #8a94a5;
        font-size: 10px;
    }

    .status-badge {
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 800;
        white-space: nowrap;
    }

    .status-badge.published {
        background: #edf8f1;
        color: #198754;
    }

    .status-badge.draft {
        background: #f3f4f6;
        color: #697386;
    }

    .stats-grid {
        display: grid;
        grid-template-columns:
            repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 20px;
    }

    .stat-card {
        padding: 17px;
        border: 1px solid #e1e7ee;
        border-radius: 12px;
        background: #ffffff;
    }

    .stat-label {
        color: #8b95a5;
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .stat-value {
        margin-top: 6px;
        color: #273142;
        font-size: 23px;
        font-weight: 800;
    }

    .students-card {
        overflow: hidden;
        border: 1px solid #e1e7ee;
        border-radius: 14px;
        background: #ffffff;
    }

    .card-header {
        padding: 17px 20px;
        border-bottom: 1px solid #edf0f4;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .card-title {
        margin: 0;
        color: #344054;
        font-size: 14px;
        font-weight: 800;
    }

    .card-count {
        color: #8b95a5;
        font-size: 10px;
        font-weight: 700;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .students-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 900px;
    }

    .students-table th {
        padding: 12px 15px;
        border-bottom: 1px solid #edf0f4;
        background: #fbfcfd;
        color: #7d8798;
        font-size: 9px;
        font-weight: 800;
        text-align: left;
        text-transform: uppercase;
    }

    .students-table td {
        padding: 14px 15px;
        border-bottom: 1px solid #f0f2f5;
        color: #475467;
        font-size: 10px;
        vertical-align: middle;
    }

    .students-table tr:last-child td {
        border-bottom: none;
    }

    .student-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .student-avatar {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        border-radius: 10px;
        background: #edf4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .student-name {
        color: #344054;
        font-size: 11px;
        font-weight: 800;
    }

    .student-email {
        margin-top: 2px;
        color: #98a2b3;
        font-size: 9px;
    }

    .progress-block {
        min-width: 155px;
    }

    .progress-top {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 5px;
    }

    .progress-lessons {
        color: #7d8798;
        font-size: 9px;
    }

    .progress-percent {
        color: #344054;
        font-size: 9px;
        font-weight: 800;
    }

    .progress-track {
        height: 6px;
        border-radius: 10px;
        background: #edf0f4;
        overflow: hidden;
    }

    .progress-value {
        height: 100%;
        border-radius: 10px;
        background: #0d6efd;
    }

    .learning-status {
        display: inline-flex;
        padding: 5px 8px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 800;
    }

    .learning-status.completed {
        background: #edf8f1;
        color: #198754;
    }

    .learning-status.learning {
        background: #eef4ff;
        color: #0d6efd;
    }

    .learning-status.not-started {
        background: #f3f4f6;
        color: #697386;
    }

    .empty-state {
        padding: 52px 20px;
        color: #8992a3;
        font-size: 11px;
        line-height: 1.7;
        text-align: center;
    }

    .empty-title {
        margin-bottom: 6px;
        color: #475467;
        font-size: 14px;
        font-weight: 800;
    }

    @@media (max-width: 900px) {

        .page-header {
            align-items: stretch;
            flex-direction: column;
        }

        .course-filter {
            min-width: 0;
            width: 100%;
        }

        .stats-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 560px) {

        .stats-grid {
            grid-template-columns: 1fr;
        }
    }

</style>


<div class="students-page">

    <div class="students-container">


        <div class="page-header">

            <div>

                <div class="page-eyebrow">
                    Giảng viên
                </div>

                <h1 class="page-title">
                    Học viên khóa học
                </h1>

                <p class="page-description">

                    Theo dõi danh sách học viên
                    và tiến độ học tập
                    của các khóa học bạn phụ trách.

                </p>

            </div>


            @if (Model.Courses.Any())
            {
                <form asp-controller="InstructorStudents"
                      asp-action="Index"
                      method="get"
                      class="course-filter">

                    <label class="course-filter-label">
                        Chọn khóa học
                    </label>

                    <select name="courseId"
                            class="course-select"
                            onchange="this.form.submit()">

                        @foreach (var course in Model.Courses)
                        {
                            if (Model.SelectedCourseId ==
                                course.Id)
                            {
                                <option value="@course.Id"
                                        selected>

                                    @course.Title
                                    @(course.IsPublished
                                        ? ""
                                        : " · Bản nháp")

                                </option>
                            }
                            else
                            {
                                <option value="@course.Id">

                                    @course.Title
                                    @(course.IsPublished
                                        ? ""
                                        : " · Bản nháp")

                                </option>
                            }
                        }

                    </select>

                </form>
            }

        </div>


        @if (!Model.Courses.Any())
        {
            <div class="students-card">

                <div class="empty-state">

                    <div class="empty-title">
                        Chưa có khóa học
                    </div>

                    Bạn cần tạo khóa học trước
                    khi theo dõi học viên.

                </div>

            </div>
        }
        else
        {

            <div class="course-summary">

                <div>

                    <div class="course-name">
                        @Model.SelectedCourseTitle
                    </div>

                    <div class="course-meta">

                        @Model.TotalLessons bài học
                        · @Model.TotalStudents học viên

                    </div>

                </div>


                <span class="status-badge @(Model.SelectedCourseIsPublished ? "published" : "draft")">

                    @(Model.SelectedCourseIsPublished
                        ? "Đã xuất bản"
                        : "Bản nháp")

                </span>

            </div>


            <div class="stats-grid">

                <div class="stat-card">

                    <div class="stat-label">
                        Tổng học viên
                    </div>

                    <div class="stat-value">
                        @Model.TotalStudents
                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-label">
                        Đang học
                    </div>

                    <div class="stat-value">
                        @Model.LearningStudents
                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-label">
                        Hoàn thành
                    </div>

                    <div class="stat-value">
                        @Model.CompletedStudents
                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-label">
                        Tiến độ trung bình
                    </div>

                    <div class="stat-value">
                        @Model.AverageProgress.ToString("0.#")%
                    </div>

                </div>

            </div>


            <section class="students-card">


                <div class="card-header">

                    <h2 class="card-title">
                        Danh sách học viên
                    </h2>

                    <div class="card-count">
                        @Model.TotalStudents học viên
                    </div>

                </div>


                @if (Model.Students.Any())
                {
                    <div class="table-wrap">

                        <table class="students-table">

                            <thead>

                                <tr>

                                    <th>Học viên</th>
                                    <th>Ngày đăng ký</th>
                                    <th>Hoạt động gần nhất</th>
                                    <th>Tiến độ</th>
                                    <th>Trạng thái</th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var student in Model.Students)
                                {
                                    string firstLetter =
                                        !string.IsNullOrWhiteSpace(
                                            student.FullName)
                                            ? student.FullName
                                                .Substring(0, 1)
                                                .ToUpper()
                                            : "H";


                                    string statusClass =
                                        student.Status switch
                                        {
                                            "Completed" =>
                                                "completed",

                                            "Learning" =>
                                                "learning",

                                            _ =>
                                                "not-started"
                                        };


                                    string statusText =
                                        student.Status switch
                                        {
                                            "Completed" =>
                                                "Đã hoàn thành",

                                            "Learning" =>
                                                "Đang học",

                                            _ =>
                                                "Chưa bắt đầu"
                                        };


                                    <tr>


                                        <td>

                                            <div class="student-cell">

                                                <div class="student-avatar">
                                                    @firstLetter
                                                </div>

                                                <div>

                                                    <div class="student-name">
                                                        @student.FullName
                                                    </div>

                                                    <div class="student-email">
                                                        @student.Email
                                                    </div>

                                                </div>

                                            </div>

                                        </td>


                                        <td>

                                            @(student.EnrolledAt
                                                .ToLocalTime()
                                                .ToString("dd/MM/yyyy"))

                                        </td>


                                        <td>

                                            @if (student.LastAccessedAt.HasValue)
                                            {
                                                @(student.LastAccessedAt.Value
                                                    .ToLocalTime()
                                                    .ToString("dd/MM/yyyy HH:mm"))
                                            }
                                            else
                                            {
                                                <span>
                                                    Chưa có hoạt động
                                                </span>
                                            }

                                        </td>


                                        <td>

                                            <div class="progress-block">

                                                <div class="progress-top">

                                                    <span class="progress-lessons">

                                                        @student.CompletedLessons
                                                        / @student.TotalLessons
                                                        bài

                                                    </span>

                                                    <span class="progress-percent">

                                                        @(student.Progress
                                                            .ToString("0.#"))%

                                                    </span>

                                                </div>

                                                <div class="progress-track">

                                                    <div class="progress-value"
                                                         style="width: @(student.Progress.ToString(System.Globalization.CultureInfo.InvariantCulture))%;">
                                                    </div>

                                                </div>

                                            </div>

                                        </td>


                                        <td>

                                            <span class="learning-status @statusClass">
                                                @statusText
                                            </span>

                                        </td>


                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="empty-state">

                        <div class="empty-title">
                            Chưa có học viên đăng ký
                        </div>

                        Khóa học này hiện chưa có
                        học viên nào tham gia.

                    </div>
                }


            </section>

        }


    </div>

</div>
