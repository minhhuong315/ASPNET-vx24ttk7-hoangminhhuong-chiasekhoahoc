@model OnlineLearningPlatform.ViewModels.AccountProfileViewModel

@{
    ViewData["Title"] = "Quản lý tài khoản";

    string roleText =
        Model.Role switch
        {
            "Student" => "Học viên",
            "Instructor" => "Giảng viên",
            "Admin" => "Quản trị viên",
            _ => Model.Role
        };

    string firstLetter =
        !string.IsNullOrWhiteSpace(Model.FullName)
            ? Model.FullName.Substring(0, 1).ToUpper()
            : "U";
}

<style>

    .profile-page {
        min-height: 80vh;
        padding: 45px 0 75px;
        background: #f8fafc;
    }

    .profile-container {
        max-width: 1050px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .profile-heading {
        margin-bottom: 24px;
    }

    .page-eyebrow {
        margin-bottom: 6px;
        color: #0d6efd;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .page-title {
        margin: 0 0 7px;
        color: #172033;
        font-size: 31px;
        font-weight: 800;
    }

    .page-description {
        margin: 0;
        color: #7c8798;
        font-size: 13px;
    }

    .message {
        margin-bottom: 18px;
        padding: 13px 15px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 700;
    }

    .message.success {
        border: 1px solid #bce4c9;
        background: #effaf3;
        color: #16723a;
    }

    .message.error {
        border: 1px solid #ffd2d6;
        background: #fff4f5;
        color: #b42332;
    }

    .profile-grid {
        display: grid;
        grid-template-columns:
            minmax(0, 1.55fr)
            minmax(280px, .85fr);
        gap: 20px;
        align-items: start;
    }

    .profile-card {
        overflow: hidden;
        border: 1px solid #e2e7ee;
        border-radius: 15px;
        background: #ffffff;
    }

    .card-header {
        padding: 19px 22px;
        border-bottom: 1px solid #edf0f4;
    }

    .card-title {
        margin: 0 0 4px;
        color: #273142;
        font-size: 16px;
        font-weight: 800;
    }

    .card-description {
        margin: 0;
        color: #929baa;
        font-size: 10px;
    }

    .card-body {
        padding: 22px;
    }

    .profile-summary {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 22px;
        padding-bottom: 20px;
        border-bottom: 1px solid #edf0f4;
    }

    .profile-avatar {
        width: 54px;
        height: 54px;
        flex: 0 0 54px;
        border-radius: 15px;
        background: #edf4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        font-weight: 800;
    }

    .profile-name {
        color: #273142;
        font-size: 15px;
        font-weight: 800;
    }

    .profile-role {
        margin-top: 3px;
        color: #8b95a5;
        font-size: 10px;
        font-weight: 700;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        margin-bottom: 7px;
        color: #465164;
        font-size: 11px;
        font-weight: 700;
    }

    .form-control-edulearn {
        width: 100%;
        min-height: 44px;
        padding: 10px 12px;
        border: 1px solid #dce2ea;
        border-radius: 9px;
        background: #ffffff;
        color: #273142;
        font: inherit;
        font-size: 12px;
        outline: none;
    }

    .form-control-edulearn:focus {
        border-color: #8db9fa;
        box-shadow:
            0 0 0 3px
            rgba(13, 110, 253, .08);
    }

    .form-control-edulearn.readonly {
        background: #f7f9fb;
        color: #808a9a;
    }

    textarea.form-control-edulearn {
        min-height: 130px;
        resize: vertical;
    }

    .field-validation-error {
        display: block;
        margin-top: 5px;
        color: #dc3545;
        font-size: 10px;
        font-weight: 600;
    }

    .validation-summary-errors {
        margin-bottom: 17px;
        padding: 12px 14px;
        border: 1px solid #ffd2d6;
        border-radius: 9px;
        background: #fff5f6;
        color: #b42332;
        font-size: 11px;
    }

    .validation-summary-errors ul {
        margin: 0;
        padding-left: 18px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
    }

    .save-button {
        min-height: 41px;
        padding: 0 17px;
        border: 1px solid #0d6efd;
        border-radius: 9px;
        background: #0d6efd;
        color: #ffffff;
        font-family: inherit;
        font-size: 11px;
        font-weight: 800;
        cursor: pointer;
    }

    .save-button:hover {
        background: #0b5ed7;
    }

    .account-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        padding: 12px 0;
        border-bottom: 1px solid #edf0f4;
    }

    .account-row:first-child {
        padding-top: 0;
    }

    .account-row:last-of-type {
        border-bottom: none;
    }

    .account-label {
        color: #8b95a5;
        font-size: 10px;
        font-weight: 600;
    }

    .account-value {
        max-width: 190px;
        color: #344054;
        font-size: 10px;
        font-weight: 700;
        text-align: right;
        overflow-wrap: anywhere;
    }

    .status-ok {
        color: #198754;
    }

    .password-box {
        margin-top: 18px;
        padding-top: 18px;
        border-top: 1px solid #edf0f4;
    }

    .password-title {
        margin-bottom: 6px;
        color: #344054;
        font-size: 12px;
        font-weight: 800;
    }

    .password-text {
        margin: 0 0 12px;
        color: #8992a3;
        font-size: 10px;
        line-height: 1.6;
    }

    .password-link {
        min-height: 38px;
        padding: 0 13px;
        border: 1px solid #d7e3f6;
        border-radius: 8px;
        background: #f7faff;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
        text-decoration: none;
    }

    @@media (max-width: 780px) {

        .profile-grid {
            grid-template-columns: 1fr;
        }
    }

</style>


<div class="profile-page">

    <div class="profile-container">


        <div class="profile-heading">

            <div class="page-eyebrow">
                Tài khoản EduLearn
            </div>

            <h1 class="page-title">
                Thông tin cá nhân
            </h1>

            <p class="page-description">

                Cập nhật thông tin hiển thị
                và quản lý bảo mật tài khoản của bạn.

            </p>

        </div>


        @if (TempData["ProfileSuccess"] != null)
        {
            <div class="message success">
                @TempData["ProfileSuccess"]
            </div>
        }


        @if (TempData["ProfileError"] != null)
        {
            <div class="message error">
                @TempData["ProfileError"]
            </div>
        }


        <div class="profile-grid">


            <section class="profile-card">


                <div class="card-header">

                    <h2 class="card-title">
                        Hồ sơ cá nhân
                    </h2>

                    <p class="card-description">
                        Các thông tin bạn có thể cập nhật.
                    </p>

                </div>


                <div class="card-body">


                    <div class="profile-summary">

                        <div class="profile-avatar">
                            @firstLetter
                        </div>

                        <div>

                            <div class="profile-name">
                                @Model.FullName
                            </div>

                            <div class="profile-role">
                                @roleText
                            </div>

                        </div>

                    </div>


                    <form asp-controller="Profile"
                          asp-action="Update"
                          method="post">

                        @Html.AntiForgeryToken()


                        <div asp-validation-summary="ModelOnly">
                        </div>


                        <div class="form-group">

                            <label asp-for="FullName"
                                   class="form-label">
                                Họ và tên
                            </label>

                            <input asp-for="FullName"
                                   class="form-control-edulearn" />

                            <span asp-validation-for="FullName">
                            </span>

                        </div>


                        <div class="form-group">

                            <label class="form-label">
                                Email
                            </label>

                            <input value="@Model.Email"
                                   class="form-control-edulearn readonly"
                                   readonly />

                        </div>


                        <div class="form-group">

                            <label asp-for="PhoneNumber"
                                   class="form-label">
                                Số điện thoại
                            </label>

                            <input asp-for="PhoneNumber"
                                   class="form-control-edulearn"
                                   placeholder="Nhập số điện thoại..." />

                            <span asp-validation-for="PhoneNumber">
                            </span>

                        </div>


                        <div class="form-group">

                            <label asp-for="Bio"
                                   class="form-label">
                                Giới thiệu bản thân
                            </label>

                            <textarea asp-for="Bio"
                                      class="form-control-edulearn"
                                      placeholder="Viết một vài dòng giới thiệu..."></textarea>

                            <span asp-validation-for="Bio">
                            </span>

                        </div>


                        <div class="form-actions">

                            <button type="submit"
                                    class="save-button">

                                Cập nhật thông tin

                            </button>

                        </div>


                    </form>


                </div>


            </section>



            <aside class="profile-card">


                <div class="card-header">

                    <h2 class="card-title">
                        Thông tin tài khoản
                    </h2>

                    <p class="card-description">
                        Thông tin hệ thống và bảo mật.
                    </p>

                </div>


                <div class="card-body">


                    <div class="account-row">

                        <div class="account-label">
                            Tên đăng nhập
                        </div>

                        <div class="account-value">
                            @Model.UserName
                        </div>

                    </div>


                    <div class="account-row">

                        <div class="account-label">
                            Vai trò
                        </div>

                        <div class="account-value">
                            @roleText
                        </div>

                    </div>


                    <div class="account-row">

                        <div class="account-label">
                            Ngày tạo
                        </div>

                        <div class="account-value">
                            @(Model.CreatedAt
                                .ToLocalTime()
                                .ToString("dd/MM/yyyy"))
                        </div>

                    </div>


                    <div class="account-row">

                        <div class="account-label">
                            Cập nhật lần cuối
                        </div>

                        <div class="account-value">
                            @(Model.UpdatedAt
                                .ToLocalTime()
                                .ToString("dd/MM/yyyy HH:mm"))
                        </div>

                    </div>


                    <div class="account-row">

                        <div class="account-label">
                            Email
                        </div>

                        <div class="account-value @(Model.EmailConfirmed ? "status-ok" : "")">

                            @(Model.EmailConfirmed
                                ? "Đã xác thực"
                                : "Chưa xác thực")

                        </div>

                    </div>


                    <div class="account-row">

                        <div class="account-label">
                            Trạng thái
                        </div>

                        <div class="account-value @(Model.IsActive ? "status-ok" : "")">

                            @(Model.IsActive
                                ? "Đang hoạt động"
                                : "Tạm khóa")

                        </div>

                    </div>


                    <div class="password-box">

                        <div class="password-title">
                            Mật khẩu
                        </div>

                        <p class="password-text">

                            Thay đổi mật khẩu định kỳ
                            để tăng bảo mật cho tài khoản.

                        </p>

                        <a asp-controller="Profile"
                           asp-action="ChangePassword"
                           class="password-link">

                            Đổi mật khẩu →

                        </a>

                    </div>


                </div>


            </aside>


        </div>


    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
