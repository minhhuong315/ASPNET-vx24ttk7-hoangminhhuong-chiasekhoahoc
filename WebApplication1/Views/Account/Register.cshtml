@model OnlineLearningPlatform.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký";
}

<link rel="stylesheet" href="~/css/auth-pages.css" asp-append-version="true" />

<div class="register-page el-auth">
    <div class="register-wrapper">

        <!-- Phần giới thiệu EduLearn -->
        <div class="register-brand">
            <div class="brand-logo">EduLearn</div>

            <div class="brand-slogan">
                Chia sẻ tri thức,<br />
                kiến tạo tương lai
            </div>

            <p class="brand-description">
                Nền tảng học trực tuyến chuyên về Công nghệ thông tin,
                giúp bạn tiếp cận kiến thức thực tế và phát triển kỹ năng
                mỗi ngày.
            </p>

            <div class="tech-box">
                <div class="tech-title">
                    Khám phá các lĩnh vực công nghệ
                </div>

                <div class="tech-list">
                    <span class="tech-item">ASP.NET Core</span>
                    <span class="tech-item">C#</span>
                    <span class="tech-item">JavaScript</span>
                    <span class="tech-item">Python</span>
                    <span class="tech-item">SQL Server</span>
                    <span class="tech-item">Git & GitHub</span>
                </div>
            </div>
        </div>

        <!-- Form đăng ký -->
        <div class="register-form">
            <h2>Tạo tài khoản</h2>

            <p class="register-subtitle">
                Bắt đầu hành trình học tập cùng EduLearn.
            </p>

            <form asp-controller="Account"
                  asp-action="Register"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="auth-validation"></div>

                <div class="mb-3">
                    <label asp-for="FullName"
                           class="form-label"></label>

                    <input asp-for="FullName"
                           class="form-control"
                           placeholder="Nhập họ và tên"
                           autocomplete="name" />

                    <span asp-validation-for="FullName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email"
                           class="form-label"></label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Nhập địa chỉ email"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password"
                           class="form-label"></label>

                    <input asp-for="Password"
                           class="form-control"
                           placeholder="Nhập mật khẩu"
                           autocomplete="new-password" />

                    <span asp-validation-for="Password"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword"
                           class="form-label"></label>

                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           placeholder="Nhập lại mật khẩu"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary btn-register w-100">
                    Đăng ký
                </button>
            </form>

            <div class="login-text">
                Đã có tài khoản?
                <a asp-controller="Account"
                   asp-action="Login"
                   class="text-decoration-none fw-semibold">
                    Đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}