@model OnlineLearningPlatform.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<link rel="stylesheet" href="~/css/auth-pages.css" asp-append-version="true" />

<div class="reset-page el-auth">
    <div class="reset-card">

        <div class="page-eyebrow">
            Bảo mật tài khoản
        </div>

        <h1 class="page-title">
            Đặt lại mật khẩu
        </h1>

        <p class="page-description">
            Tạo mật khẩu mới cho tài khoản EduLearn của bạn.
        </p>

        <div class="password-note">
            Mật khẩu phải đáp ứng chính sách ASP.NET Core Identity
            đang được cấu hình cho hệ thống.
        </div>

        <form asp-controller="Account"
              asp-action="ResetPassword"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Email"
                   type="hidden" />

            <input asp-for="Token"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="auth-validation">
            </div>

            <div class="form-group">

                <label asp-for="NewPassword"
                       class="form-label">
                    Mật khẩu mới
                </label>

                <input asp-for="NewPassword"
                       class="form-control"
                       autocomplete="new-password" />

                <span asp-validation-for="NewPassword">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="ConfirmPassword"
                       class="form-label">
                    Xác nhận mật khẩu mới
                </label>

                <input asp-for="ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password" />

                <span asp-validation-for="ConfirmPassword">
                </span>

            </div>

            <button type="submit"
                    class="submit-button">
                Cập nhật mật khẩu
            </button>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
