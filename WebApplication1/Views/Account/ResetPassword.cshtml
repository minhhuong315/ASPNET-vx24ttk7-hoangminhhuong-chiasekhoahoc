@model OnlineLearningPlatform.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<style>
    .reset-page {
        min-height: 78vh;
        padding: 55px 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f7f9fc;
    }

    .reset-card {
        width: 100%;
        max-width: 590px;
        padding: 34px;
        border: 1px solid #e2e7ee;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 12px 35px rgba(0, 0, 0, .06);
    }

    .page-eyebrow {
        margin-bottom: 6px;
        color: #0d6efd;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .page-title {
        margin: 0 0 8px;
        color: #172033;
        font-size: 28px;
        font-weight: 800;
    }

    .page-description {
        margin: 0 0 22px;
        color: #778195;
        font-size: 13px;
        line-height: 1.7;
    }

    .password-note {
        margin-bottom: 20px;
        padding: 11px 13px;
        border-radius: 9px;
        background: #f5f8fc;
        color: #778195;
        font-size: 11px;
        line-height: 1.65;
    }

    .form-group {
        margin-bottom: 17px;
    }

    .form-label {
        display: block;
        margin-bottom: 7px;
        color: #465164;
        font-size: 12px;
        font-weight: 700;
    }

    .form-control {
        min-height: 46px;
        border-radius: 9px;
    }

    .field-validation-error {
        display: block;
        margin-top: 5px;
        color: #dc3545;
        font-size: 11px;
    }

    .submit-button {
        width: 100%;
        min-height: 44px;
        margin-top: 5px;
        border: none;
        border-radius: 9px;
        background: #0d6efd;
        color: #ffffff;
        font-weight: 700;
    }
</style>

<div class="reset-page">
    <div class="reset-card">

        <div class="page-eyebrow">
            Bảo mật tài khoản
        </div>

        <h1 class="page-title">
            Đặt lại mật khẩu
        </h1>

        <p class="page-description">
            Tạo mật khẩu mới cho tài khoản EduLearn của bạn.
        </p>

        <div class="password-note">
            Mật khẩu phải đáp ứng chính sách ASP.NET Core Identity
            đang được cấu hình cho hệ thống.
        </div>

        <form asp-controller="Account"
              asp-action="ResetPassword"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Email"
                   type="hidden" />

            <input asp-for="Token"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="form-group">

                <label asp-for="NewPassword"
                       class="form-label">
                    Mật khẩu mới
                </label>

                <input asp-for="NewPassword"
                       class="form-control"
                       autocomplete="new-password" />

                <span asp-validation-for="NewPassword">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="ConfirmPassword"
                       class="form-label">
                    Xác nhận mật khẩu mới
                </label>

                <input asp-for="ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password" />

                <span asp-validation-for="ConfirmPassword">
                </span>

            </div>

            <button type="submit"
                    class="submit-button">
                Cập nhật mật khẩu
            </button>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
