@model OnlineLearningPlatform.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<link rel="stylesheet" href="~/css/auth-pages.css" asp-append-version="true" />

<div class="login-page el-auth">
    <div class="login-wrapper">

        <div class="login-brand">

            <div class="brand-logo">
                EduLearn
            </div>

            <div class="brand-slogan">
                Chia sẻ tri thức,<br />
                kiến tạo tương lai
            </div>

            <p class="brand-description">
                Đăng nhập để tiếp tục hành trình học tập
                và khám phá các khóa học Công nghệ thông tin.
            </p>

            <div class="platform-box">

                <div class="platform-item">
                    ✓ Theo dõi tiến độ học tập
                </div>

                <div class="platform-item">
                    ✓ Quản lý khóa học của bạn
                </div>

                <div class="platform-item">
                    ✓ Lưu khóa học yêu thích
                </div>

                <div class="platform-item">
                    ✓ Học mọi lúc, mọi nơi
                </div>

            </div>

        </div>

        <div class="login-form">

            <h2>Chào mừng trở lại!</h2>

            <p class="login-subtitle">
                Đăng nhập vào tài khoản EduLearn của bạn.
            </p>

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                <input type="hidden"
                       name="returnUrl"
                       value="@ViewData["ReturnUrl"]" />

                <div asp-validation-summary="ModelOnly"
                     class="login-validation auth-validation"></div>

                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label"></label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Nhập địa chỉ email"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="Password"
                           class="form-label"></label>

                    <input asp-for="Password"
                           class="form-control"
                           placeholder="Nhập mật khẩu"
                           autocomplete="current-password" />

                    <span asp-validation-for="Password"
                          class="text-danger"></span>

                </div>

                <div class="password-tools">

                    <div class="form-check">

                        <input asp-for="RememberMe"
                               class="form-check-input" />

                        <label asp-for="RememberMe"
                               class="form-check-label"></label>

                    </div>

                    <a asp-controller="Account"
                       asp-action="ForgotPassword"
                       class="forgot-link">
                        Quên mật khẩu?
                    </a>

                </div>

                <button type="submit"
                        class="btn btn-primary btn-login w-100">
                    Đăng nhập
                </button>

            </form>

            <div class="register-text">
                Chưa có tài khoản?

                <a asp-controller="Account"
                   asp-action="Register"
                   class="text-decoration-none fw-semibold">
                    Đăng ký ngay
                </a>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}