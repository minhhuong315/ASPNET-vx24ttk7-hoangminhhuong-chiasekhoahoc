@{
    ViewData["Title"] = "Kiểm tra email";
}

<style>
    .result-page {
        min-height: 78vh;
        padding: 55px 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f7f9fc;
    }

    .result-card {
        width: 100%;
        max-width: 580px;
        padding: 38px;
        border: 1px solid #e2e7ee;
        border-radius: 16px;
        background: #ffffff;
        text-align: center;
        box-shadow: 0 12px 35px rgba(0, 0, 0, .06);
    }

    .result-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto 18px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #edf4ff;
        color: #0d6efd;
    }

    .result-icon svg {
        width: 28px;
        height: 28px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .result-title {
        margin: 0 0 10px;
        color: #172033;
        font-size: 30px;
        font-weight: 800;
    }

    .result-text {
        margin: 0 0 24px;
        color: #778195;
        font-size: 14px;
        line-height: 1.75;
    }

    .login-link {
        min-height: 44px;
        padding: 0 18px;
        border: 1px solid #dce2ea;
        border-radius: 10px;
        background: #ffffff;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
    }
</style>

<div class="result-page">

    <div class="result-card">

        <div class="result-icon"
             aria-hidden="true">

            <svg viewBox="0 0 24 24">
                <rect x="3"
                      y="5"
                      width="18"
                      height="14"
                      rx="2"></rect>

                <path d="m3 7 9 6 9-6"></path>
            </svg>

        </div>

        <h1 class="result-title">
            Kiểm tra email của bạn
        </h1>

        <p class="result-text">
            Nếu email tồn tại và tài khoản đang hoạt động,
            EduLearn đã gửi liên kết đặt lại mật khẩu.
            Hãy kiểm tra cả Hộp thư đến và Thư rác.
        </p>

        <a asp-controller="Account"
           asp-action="Login"
           class="login-link">
            Quay lại đăng nhập
        </a>

    </div>

</div>
