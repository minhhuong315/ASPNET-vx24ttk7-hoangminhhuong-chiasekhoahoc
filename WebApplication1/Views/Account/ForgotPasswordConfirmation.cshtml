@{
    ViewData["Title"] = "Kiểm tra email";
}

<link rel="stylesheet" href="~/css/auth-pages.css" asp-append-version="true" />

<div class="result-page el-auth">

    <div class="result-card">

        <div class="result-icon"
             aria-hidden="true">

            <svg viewBox="0 0 24 24">
                <rect x="3"
                      y="5"
                      width="18"
                      height="14"
                      rx="2"></rect>

                <path d="m3 7 9 6 9-6"></path>
            </svg>

        </div>

        <h1 class="result-title">
            Kiểm tra email của bạn
        </h1>

        <p class="result-text">
            Nếu email tồn tại và tài khoản đang hoạt động,
            EduLearn đã gửi liên kết đặt lại mật khẩu.
            Hãy kiểm tra cả Hộp thư đến và Thư rác.
        </p>

        <a asp-controller="Account"
           asp-action="Login"
           class="login-link">
            Quay lại đăng nhập
        </a>

    </div>

</div>
