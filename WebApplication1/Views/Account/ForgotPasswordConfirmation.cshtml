@{
    ViewData["Title"] = "Khôi phục mật khẩu";

    string? developmentResetUrl =
        TempData["DevelopmentResetUrl"]
            as string;
}

<style>
    .result-page {
        min-height: 78vh;
        padding: 55px 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f7f9fc;
    }

    .result-card {
        width: 100%;
        max-width: 580px;
        padding: 36px;
        border: 1px solid #e2e7ee;
        border-radius: 16px;
        background: #ffffff;
        text-align: center;
        box-shadow: 0 12px 35px rgba(0, 0, 0, .06);
    }

    .result-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 17px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #edf4ff;
        color: #0d6efd;
        font-size: 24px;
        font-weight: 800;
    }

    .result-title {
        margin: 0 0 9px;
        color: #172033;
        font-size: 27px;
        font-weight: 800;
    }

    .result-text {
        margin: 0 0 22px;
        color: #778195;
        font-size: 13px;
        line-height: 1.75;
    }

    .demo-box {
        margin-bottom: 22px;
        padding: 16px;
        border: 1px solid #d5e4ff;
        border-radius: 11px;
        background: #f6f9ff;
    }

    .demo-title {
        margin-bottom: 7px;
        color: #344054;
        font-size: 12px;
        font-weight: 800;
    }

    .demo-text {
        margin: 0 0 13px;
        color: #778195;
        font-size: 11px;
        line-height: 1.65;
    }

    .reset-link,
    .login-link {
        min-height: 42px;
        padding: 0 16px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }

    .reset-link {
        background: #0d6efd;
        color: #ffffff;
    }

    .login-link {
        border: 1px solid #dce2ea;
        background: #ffffff;
        color: #667085;
    }
</style>

<div class="result-page">
    <div class="result-card">

        <div class="result-icon">
            ↻
        </div>

        <h1 class="result-title">
            Yêu cầu đã được xử lý
        </h1>

        <p class="result-text">
            Nếu email tồn tại và tài khoản đang hoạt động,
            EduLearn đã tạo yêu cầu đặt lại mật khẩu.
        </p>

        @if (!string.IsNullOrWhiteSpace(
            developmentResetUrl))
        {
            <div class="demo-box">

                <div class="demo-title">
                    Chế độ Development
                </div>

                <p class="demo-text">
                    Khi demo trên máy local,
                    bạn có thể mở trực tiếp liên kết
                    đặt lại mật khẩu bên dưới.
                </p>

                <a href="@developmentResetUrl"
                   class="reset-link">
                    Mở liên kết đặt lại mật khẩu →
                </a>

            </div>
        }

        <a asp-controller="Account"
           asp-action="Login"
           class="login-link">
            Quay lại đăng nhập
        </a>

    </div>
</div>
