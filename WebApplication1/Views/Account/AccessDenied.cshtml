@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<link rel="stylesheet" href="~/css/auth-pages.css" asp-append-version="true" />

<div class="error-page el-auth">
    <div class="error-card">

        <div class="error-code">
            403 · ACCESS DENIED
        </div>

        <h1 class="error-title">
            Bạn không có quyền truy cập
        </h1>

        <p class="error-text">
            Tài khoản hiện tại không được phép sử dụng
            chức năng này. Hãy quay về trang chủ hoặc
            truy cập khu vực phù hợp với vai trò của bạn.
        </p>

        <div class="error-actions">

            <a asp-controller="Home"
               asp-action="Index"
               class="error-button primary">
                Về trang chủ
            </a>

            <a asp-controller="Courses"
               asp-action="Index"
               class="error-button secondary">
                Xem khóa học
            </a>

        </div>

    </div>
</div>
