@{
    ViewData["Title"] = "Đổi mật khẩu thành công";
}

<style>
    .result-page {
        min-height: 78vh;
        padding: 55px 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f7f9fc;
    }

    .result-card {
        width: 100%;
        max-width: 540px;
        padding: 36px;
        border: 1px solid #e2e7ee;
        border-radius: 16px;
        background: #ffffff;
        text-align: center;
        box-shadow: 0 12px 35px rgba(0, 0, 0, .06);
    }

    .result-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 17px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #edf8f1;
        color: #198754;
        font-size: 24px;
        font-weight: 800;
    }

    .result-title {
        margin: 0 0 9px;
        color: #172033;
        font-size: 27px;
        font-weight: 800;
    }

    .result-text {
        margin: 0 0 22px;
        color: #778195;
        font-size: 13px;
        line-height: 1.75;
    }

    .login-link {
        min-height: 42px;
        padding: 0 16px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #0d6efd;
        color: #ffffff;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }
</style>

<div class="result-page">
    <div class="result-card">

        <div class="result-icon">
            ✓
        </div>

        <h1 class="result-title">
            Mật khẩu đã được cập nhật
        </h1>

        <p class="result-text">
            Bạn có thể đăng nhập EduLearn bằng mật khẩu mới.
        </p>

        <a asp-controller="Account"
           asp-action="Login"
           class="login-link">
            Đăng nhập
        </a>

    </div>
</div>
