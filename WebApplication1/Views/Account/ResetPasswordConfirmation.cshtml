@{
    ViewData["Title"] = "Đổi mật khẩu thành công";
}

<link rel="stylesheet" href="~/css/auth-pages.css" asp-append-version="true" />

<div class="result-page el-auth">
    <div class="result-card">

        <div class="result-icon">
            ✓
        </div>

        <h1 class="result-title">
            Mật khẩu đã được cập nhật
        </h1>

        <p class="result-text">
            Bạn có thể đăng nhập EduLearn bằng mật khẩu mới.
        </p>

        <a asp-controller="Account"
           asp-action="Login"
           class="login-link">
            Đăng nhập
        </a>

    </div>
</div>
