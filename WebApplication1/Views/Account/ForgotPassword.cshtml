@model OnlineLearningPlatform.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
}

<link rel="stylesheet" href="~/css/auth-pages.css" asp-append-version="true" />

<div class="recovery-page el-auth">

    <div class="recovery-card">

        <div class="page-eyebrow">
            Bảo mật tài khoản
        </div>

        <h1 class="page-title">
            Quên mật khẩu?
        </h1>

        <p class="page-description">
            Nhập email đã đăng ký.
            EduLearn sẽ gửi liên kết đặt lại mật khẩu đến email của bạn.
        </p>

        <div class="email-note">
            Vì lý do bảo mật, hệ thống sẽ không thông báo
            email có tồn tại trong EduLearn hay không.
        </div>

        <form asp-controller="Account"
              asp-action="ForgotPassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="auth-validation">
            </div>

            <div>

                <label asp-for="Email"
                       class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="Nhập địa chỉ email"
                       autocomplete="email" />

                <span asp-validation-for="Email">
                </span>

            </div>

            <button type="submit"
                    class="submit-button">
                Gửi liên kết đặt lại mật khẩu
            </button>

        </form>

        <a asp-controller="Account"
           asp-action="Login"
           class="back-link">
            ← Quay lại đăng nhập
        </a>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
