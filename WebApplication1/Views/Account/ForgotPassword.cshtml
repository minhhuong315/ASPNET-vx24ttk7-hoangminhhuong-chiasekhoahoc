@model OnlineLearningPlatform.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
}

<style>
    .recovery-page {
        min-height: 78vh;
        padding: 55px 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f7f9fc;
    }

    .recovery-card {
        width: 100%;
        max-width: 560px;
        padding: 34px;
        border: 1px solid #e2e7ee;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 12px 35px rgba(0, 0, 0, .06);
    }

    .page-eyebrow {
        margin-bottom: 6px;
        color: #0d6efd;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .page-title {
        margin: 0 0 10px;
        color: #172033;
        font-size: 32px;
        font-weight: 800;
    }

    .page-description {
        margin: 0 0 22px;
        color: #778195;
        font-size: 14px;
        line-height: 1.7;
    }

    .email-note {
        margin-bottom: 22px;
        padding: 13px 14px;
        border-radius: 10px;
        background: #edf4ff;
        color: #41628d;
        font-size: 13px;
        line-height: 1.6;
    }

    .form-label {
        display: block;
        margin-bottom: 7px;
        color: #465164;
        font-size: 14px;
        font-weight: 700;
    }

    .form-control {
        min-height: 48px;
        border-radius: 10px;
        font-size: 14px;
    }

    .field-validation-error {
        display: block;
        margin-top: 6px;
        color: #dc3545;
        font-size: 12px;
    }

    .submit-button {
        width: 100%;
        min-height: 46px;
        margin-top: 18px;
        border: none;
        border-radius: 10px;
        background: #0d6efd;
        color: #ffffff;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
    }

    .submit-button:hover {
        background: #0b5ed7;
    }

    .back-link {
        display: inline-block;
        margin-top: 18px;
        color: #697386;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }
</style>

<div class="recovery-page">

    <div class="recovery-card">

        <div class="page-eyebrow">
            Bảo mật tài khoản
        </div>

        <h1 class="page-title">
            Quên mật khẩu?
        </h1>

        <p class="page-description">
            Nhập email đã đăng ký.
            EduLearn sẽ gửi liên kết đặt lại mật khẩu đến email của bạn.
        </p>

        <div class="email-note">
            Vì lý do bảo mật, hệ thống sẽ không thông báo
            email có tồn tại trong EduLearn hay không.
        </div>

        <form asp-controller="Account"
              asp-action="ForgotPassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div>

                <label asp-for="Email"
                       class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="Nhập địa chỉ email"
                       autocomplete="email" />

                <span asp-validation-for="Email">
                </span>

            </div>

            <button type="submit"
                    class="submit-button">
                Gửi liên kết đặt lại mật khẩu
            </button>

        </form>

        <a asp-controller="Account"
           asp-action="Login"
           class="back-link">
            ← Quay lại đăng nhập
        </a>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
