@model OnlineLearningPlatform.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
}

<style>
    .recovery-page {
        min-height: 78vh;
        padding: 55px 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f7f9fc;
    }

    .recovery-card {
        width: 100%;
        max-width: 560px;
        padding: 34px;
        border: 1px solid #e2e7ee;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 12px 35px rgba(0, 0, 0, .06);
    }

    .page-eyebrow {
        margin-bottom: 6px;
        color: #0d6efd;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .page-title {
        margin: 0 0 8px;
        color: #172033;
        font-size: 28px;
        font-weight: 800;
    }

    .page-description {
        margin: 0 0 20px;
        color: #778195;
        font-size: 13px;
        line-height: 1.7;
    }

    .demo-note {
        margin-bottom: 22px;
        padding: 11px 13px;
        border-radius: 9px;
        background: #fff8e8;
        color: #8a6200;
        font-size: 11px;
        line-height: 1.65;
    }

    .form-label {
        display: block;
        margin-bottom: 7px;
        color: #465164;
        font-size: 12px;
        font-weight: 700;
    }

    .form-control {
        min-height: 46px;
        border-radius: 9px;
    }

    .field-validation-error {
        display: block;
        margin-top: 5px;
        color: #dc3545;
        font-size: 11px;
    }

    .submit-button {
        width: 100%;
        min-height: 44px;
        margin-top: 18px;
        border: none;
        border-radius: 9px;
        background: #0d6efd;
        color: #ffffff;
        font-weight: 700;
    }

    .back-link {
        display: inline-block;
        margin-top: 18px;
        color: #697386;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
    }
</style>

<div class="recovery-page">
    <div class="recovery-card">

        <div class="page-eyebrow">
            Bảo mật tài khoản
        </div>

        <h1 class="page-title">
            Quên mật khẩu?
        </h1>

        <p class="page-description">
            Nhập email đã đăng ký để tạo
            liên kết đặt lại mật khẩu.
        </p>

        <div class="demo-note">
            Chế độ demo local:
            liên kết khôi phục sẽ được hiển thị trực tiếp
            ở bước tiếp theo thay vì gửi qua email.
        </div>

        <form asp-controller="Account"
              asp-action="ForgotPassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div>
                <label asp-for="Email"
                       class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="Nhập địa chỉ email"
                       autocomplete="email" />

                <span asp-validation-for="Email">
                </span>
            </div>

            <button type="submit"
                    class="submit-button">
                Tạo liên kết khôi phục
            </button>

        </form>

        <a asp-controller="Account"
           asp-action="Login"
           class="back-link">
            ← Quay lại đăng nhập
        </a>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
