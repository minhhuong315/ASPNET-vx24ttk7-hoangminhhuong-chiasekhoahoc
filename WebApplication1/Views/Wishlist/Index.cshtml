@using OnlineLearningPlatform.Helpers
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment CourseImageHost
@model IEnumerable<OnlineLearningPlatform.Models.Wishlist>

@{
    ViewData["Title"] = "Danh sách yêu thích";

    var items =
        Model?.ToList()
        ?? new List<OnlineLearningPlatform.Models.Wishlist>();
}



<style>
    .wishlist-page {
        min-height: 0;
        padding: 0;
        background: transparent;
    }

    .wishlist-container {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0;
    }

    .wishlist-heading {
        margin-bottom: 25px;
    }

    .page-eyebrow {
        margin-bottom: 6px;
        color: #0d6efd;
        font-size: var(--ed-type-label);
        font-weight: var(--ed-weight-label);
        text-transform: uppercase;
    }

    .page-title {
        margin: 0 0 8px;
        color: #172033;
        font-size: var(--ed-type-page-title);
        font-weight: var(--ed-weight-page);
    }

    .page-description {
        margin: 0;
        color: #7d8798;
        font-size: var(--ed-type-body);
        line-height: var(--ed-lh-body);
    }

    .message {
        margin-bottom: 18px;
        padding: 13px 15px;
        border-radius: 10px;
        font-size: var(--ed-type-body);
        font-weight: var(--ed-weight-body);
    }

    .message.success {
        border: 1px solid #bce4c9;
        background: #effaf3;
        color: #16723a;
    }

    .message.info {
        border: 1px solid #cfe0fb;
        background: #f3f8ff;
        color: #315b98;
    }

    .wishlist-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .wishlist-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        border: 1px solid #e1e7ee;
        border-radius: 15px;
        background: #ffffff;
    }

    .course-thumbnail {
        position: relative;
        aspect-ratio: 16 / 9;
        min-height: 145px;
        overflow: hidden;
        padding: 18px;
        background: linear-gradient(135deg, #0d6efd, #5a96f8);
        color: #ffffff;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .course-thumbnail-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .course-thumbnail.has-image .course-category {
        position: relative;
        z-index: 1;
        align-self: flex-start;
        padding: 4px 8px;
        border-radius: 8px;
        background: rgba(15, 23, 42, .70);
        opacity: 1;
    }

    .course-category {
        font-size: var(--ed-type-meta);
        font-weight: var(--ed-weight-meta);
        opacity: .9;
    }

    .course-icon {
        font-size: 30px;
        font-weight: 800;
    }

    .course-body {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        padding: 18px;
    }

    .course-level {
        display: inline-flex;
        margin-bottom: 9px;
        padding: 4px 8px;
        border-radius: 20px;
        background: #eef4ff;
        color: #0d6efd;
        font-size: var(--ed-type-label);
        font-weight: var(--ed-weight-label);
    }

    .course-title {
        min-height: 42px;
        margin-bottom: 6px;
        color: #273142;
        font-size: var(--ed-type-card-title);
        font-weight: var(--ed-weight-card);
        line-height: var(--ed-lh-heading);
    }

    .course-instructor {
        margin-bottom: 15px;
        color: #8b95a5;
        font-size: var(--ed-type-body);
    }

    .course-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 13px;
    }

    .course-price {
        color: #172033;
        font-size: var(--ed-type-meta);
        font-weight: var(--ed-weight-meta);
    }

    .course-added {
        color: #98a2b3;
        font-size: var(--ed-type-meta);
    }

    .course-actions {
        display: grid;
        margin-top: auto;
        padding-top: 12px;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 8px;
    }

    .details-link,
    .remove-button {
        min-height: 38px;
        padding: 0 12px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: var(--ed-type-button);
        font-weight: var(--ed-weight-button);
        text-decoration: none;
    }

    .details-link {
        border: 1px solid #0d6efd;
        background: #0d6efd;
        color: #ffffff;
    }

    .remove-form {
        margin: 0;
    }

    .remove-button {
        height: 38px;
        border: 1px solid #f0c7cc;
        background: #fffafa;
        color: #c92a3a;
        font-family: inherit;
        cursor: pointer;
    }

    .empty-state {
        padding: 55px 25px;
        border: 1px dashed #d7dee8;
        border-radius: 15px;
        background: #ffffff;
        text-align: center;
    }

    .empty-title {
        margin-bottom: 7px;
        color: #475467;
        font-size: var(--ed-type-card-title);
        font-weight: var(--ed-weight-card);
    }

    .empty-text {
        margin: 0 0 17px;
        color: #8992a3;
        font-size: var(--ed-type-meta);
    }

    .browse-link {
        min-height: 40px;
        padding: 0 15px;
        border-radius: 8px;
        background: #0d6efd;
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: var(--ed-type-button);
        font-weight: var(--ed-weight-button);
        text-decoration: none;
    }

    @@media (max-width: 900px) {
        .wishlist-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 620px) {
        .wishlist-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="wishlist-page ed-page">
    <div class="wishlist-container ed-container">

        <div class="wishlist-heading">
            <div class="page-eyebrow">Học viên</div>
            <h1 class="page-title">Danh sách yêu thích</h1>
            <p class="page-description">
                Lưu lại những khóa học bạn quan tâm
                để có thể quay lại xem sau.
            </p>
        </div>

        @if (TempData["WishlistSuccess"] != null)
        {
            <div class="message success">
                @TempData["WishlistSuccess"]
            </div>
        }

        @if (TempData["WishlistInfo"] != null)
        {
            <div class="message info">
                @TempData["WishlistInfo"]
            </div>
        }

        @if (items.Any())
        {
            <div class="wishlist-grid">

                @foreach (var item in items)
                {
                    var course = item.Course;

                    string levelText =
                        course.Level switch
                        {
                            "Beginner" => "Cơ bản",
                            "Intermediate" => "Trung cấp",
                            "Advanced" => "Nâng cao",
                            _ => course.Level
                        };

                    var thumbnail = CourseThumbnailResolver.Resolve(Url, CourseImageHost, course.ThumbnailUrl, course.Slug);

                    <article class="wishlist-card">

                        <div class="course-thumbnail has-image">
                            <img class="course-thumbnail-image" src="@thumbnail.Source" alt="@course.Title"
                                 loading="lazy" data-ed-thumb-fallback="@thumbnail.Fallback"
                                 data-ed-thumb-placeholder="@thumbnail.Placeholder"
                                 onerror="@CourseThumbnailResolver.OnErrorHandler" />
                            <div class="course-category">
                                @course.Category.Name
                            </div>

                        </div>

                        <div class="course-body">

                            <div class="course-level">
                                @levelText
                            </div>

                            <div class="course-title">
                                @course.Title
                            </div>

                            <div class="course-instructor">
                                @(string.IsNullOrWhiteSpace(
                                    course.Instructor.FullName)
                                    ? "Giảng viên EduLearn"
                                    : course.Instructor.FullName)
                            </div>

                            <div class="course-footer">

                                <div class="course-price">
                                    @if (course.DiscountPrice.HasValue &&
                                         course.DiscountPrice.Value > 0)
                                    {
                                        @($"{course.DiscountPrice.Value:N0} đ")
                                    }
                                    else
                                    {
                                        @($"{course.Price:N0} đ")
                                    }
                                </div>

                                <div class="course-added">
                                    Đã lưu @(item.AddedAt
                                        .ToLocalTime()
                                        .ToString("dd/MM/yyyy"))
                                </div>

                            </div>

                            <div class="course-actions">

                                <a asp-controller="Courses"
                                   asp-action="Details"
                                   asp-route-slug="@course.Slug"
                                   class="details-link">
                                    Xem chi tiết
                                </a>

                                <form asp-controller="Wishlist"
                                      asp-action="Remove"
                                      method="post"
                                      class="remove-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="courseId"
                                           value="@course.Id" />

                                    <button type="submit"
                                            class="remove-button"
                                            onclick="return confirm('Xóa khóa học này khỏi danh sách yêu thích?');">
                                        Xóa
                                    </button>

                                </form>

                            </div>

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="empty-state">

                <div class="empty-title">
                    Chưa có khóa học yêu thích
                </div>

                <p class="empty-text">
                    Khi thấy khóa học phù hợp,
                    bạn có thể lưu lại để xem sau.
                </p>

                <a asp-controller="Courses"
                   asp-action="Index"
                   class="browse-link">
                    Khám phá khóa học
                </a>

            </div>
        }

    </div>
</div>
