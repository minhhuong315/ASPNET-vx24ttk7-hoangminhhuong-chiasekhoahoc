@model OnlineLearningPlatform.ViewModels.AdminCoursesPageViewModel

@{
    ViewData["Title"] = "Quản lý khóa học";
}

<style>
    .admin-courses-page {
        min-height: 80vh;
        padding: 46px 0 78px;
        background: #f8fafc;
    }

    .admin-courses-container {
        max-width: 1220px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .page-header {
        margin-bottom: 23px;
    }

    .page-eyebrow {
        margin-bottom: 6px;
        color: #0d6efd;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .page-title {
        margin: 0 0 7px;
        color: #172033;
        font-size: 31px;
        font-weight: 800;
    }

    .page-description {
        margin: 0;
        color: #7d8798;
        font-size: 12px;
        line-height: 1.7;
    }

    .message {
        margin-bottom: 16px;
        padding: 12px 14px;
        border-radius: 9px;
        font-size: 11px;
        font-weight: 700;
    }

    .message.success {
        border: 1px solid #bce4c9;
        background: #effaf3;
        color: #16723a;
    }

    .message.error {
        border: 1px solid #ffd2d6;
        background: #fff4f5;
        color: #b42332;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .stat-card,
    .filter-card,
    .courses-card {
        border: 1px solid #e1e7ee;
        background: #ffffff;
    }

    .stat-card {
        padding: 17px;
        border-radius: 12px;
    }

    .stat-label {
        color: #8a94a5;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .stat-value {
        margin-top: 6px;
        color: #273142;
        font-size: 23px;
        font-weight: 800;
    }

    .filter-card {
        margin-bottom: 18px;
        padding: 15px;
        border-radius: 12px;
    }

    .filter-form {
        display: grid;
        grid-template-columns: minmax(250px, 1fr) 190px 220px auto auto;
        gap: 9px;
        align-items: end;
    }

    .filter-group label {
        display: block;
        margin-bottom: 5px;
        color: #667085;
        font-size: 9px;
        font-weight: 800;
    }

    .filter-control {
        width: 100%;
        min-height: 40px;
        padding: 0 11px;
        border: 1px solid #dce2ea;
        border-radius: 8px;
        background: #ffffff;
        color: #344054;
        font: inherit;
        font-size: 10px;
        outline: none;
    }

    .filter-button,
    .clear-button {
        min-height: 40px;
        padding: 0 14px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
    }

    .filter-button {
        border: 1px solid #0d6efd;
        background: #0d6efd;
        color: #ffffff;
        font-family: inherit;
        cursor: pointer;
    }

    .clear-button {
        border: 1px solid #dce2ea;
        background: #ffffff;
        color: #667085;
    }

    .courses-card {
        overflow: hidden;
        border-radius: 14px;
    }

    .card-header {
        padding: 17px 19px;
        border-bottom: 1px solid #edf0f4;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .card-title {
        margin: 0;
        color: #344054;
        font-size: 14px;
        font-weight: 800;
    }

    .card-count {
        color: #98a2b3;
        font-size: 9px;
        font-weight: 700;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .courses-table {
        width: 100%;
        min-width: 1180px;
        border-collapse: collapse;
    }

    .courses-table th {
        padding: 11px 12px;
        border-bottom: 1px solid #edf0f4;
        background: #fbfcfd;
        color: #7d8798;
        font-size: 9px;
        font-weight: 800;
        text-align: left;
        text-transform: uppercase;
    }

    .courses-table td {
        padding: 13px 12px;
        border-bottom: 1px solid #f0f2f5;
        color: #475467;
        font-size: 10px;
        vertical-align: middle;
    }

    .courses-table tr:last-child td {
        border-bottom: none;
    }

    .course-title {
        max-width: 270px;
        color: #344054;
        font-size: 11px;
        font-weight: 800;
        line-height: 1.45;
    }

    .course-meta {
        margin-top: 3px;
        color: #98a2b3;
        font-size: 9px;
    }

    .status-badge,
    .featured-badge {
        display: inline-flex;
        padding: 5px 8px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 800;
    }

    .status-badge.published {
        background: #edf8f1;
        color: #198754;
    }

    .status-badge.draft {
        background: #f3f4f6;
        color: #697386;
    }

    .featured-badge {
        margin-top: 5px;
        background: #fff7e6;
        color: #b76e00;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        min-width: 245px;
    }

    .action-form {
        margin: 0;
    }

    .action-link,
    .action-button {
        min-height: 32px;
        padding: 0 9px;
        border-radius: 7px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: inherit;
        font-size: 9px;
        font-weight: 800;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
    }

    .action-link {
        border: 1px solid #cfe0fb;
        background: #f5f9ff;
        color: #0d6efd;
    }

    .publish-button {
        border: 1px solid #bce4c9;
        background: #f4fbf6;
        color: #198754;
    }

    .draft-button {
        border: 1px solid #e0e3e8;
        background: #f7f8fa;
        color: #667085;
    }

    .featured-button {
        border: 1px solid #f0d49a;
        background: #fffaf0;
        color: #a96800;
    }

    .delete-button {
        border: 1px solid #f0c7cc;
        background: #fffafa;
        color: #c92a3a;
    }

    .empty-state {
        padding: 48px 20px;
        color: #8992a3;
        font-size: 10px;
        text-align: center;
    }

    @@media (max-width: 980px) {
        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .filter-form {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 560px) {
        .stats-grid,
        .filter-form {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="admin-courses-page">
    <div class="admin-courses-container">

        <div class="page-header">
            <div class="page-eyebrow">
                Quản trị hệ thống
            </div>

            <h1 class="page-title">
                Quản lý khóa học
            </h1>

            <p class="page-description">
                Theo dõi toàn bộ khóa học,
                kiểm duyệt trạng thái xuất bản
                và quản lý nội dung nổi bật trên EduLearn.
            </p>
        </div>


        @if (TempData["AdminCoursesSuccess"] != null)
        {
            <div class="message success">
                @TempData["AdminCoursesSuccess"]
            </div>
        }

        @if (TempData["AdminCoursesError"] != null)
        {
            <div class="message error">
                @TempData["AdminCoursesError"]
            </div>
        }


        <div class="stats-grid">

            <div class="stat-card">
                <div class="stat-label">Tổng khóa học</div>
                <div class="stat-value">@Model.TotalCourses</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Đã xuất bản</div>
                <div class="stat-value">@Model.PublishedCourses</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Bản nháp</div>
                <div class="stat-value">@Model.DraftCourses</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Tổng lượt đăng ký</div>
                <div class="stat-value">@Model.TotalEnrollments</div>
            </div>

        </div>


        <div class="filter-card">

            <form asp-controller="AdminCourses"
                  asp-action="Index"
                  method="get"
                  class="filter-form">

                <div class="filter-group">
                    <label>Tìm kiếm</label>

                    <input type="text"
                           name="search"
                           value="@Model.Search"
                           class="filter-control"
                           placeholder="Tên khóa học hoặc giảng viên..." />
                </div>


                <div class="filter-group">
                    <label>Trạng thái</label>

                    <select name="status"
                            class="filter-control">

                        <option value="">
                            Tất cả trạng thái
                        </option>

                        @if (Model.Status == "published")
                        {
                            <option value="published" selected>
                                Đã xuất bản
                            </option>
                        }
                        else
                        {
                            <option value="published">
                                Đã xuất bản
                            </option>
                        }

                        @if (Model.Status == "draft")
                        {
                            <option value="draft" selected>
                                Bản nháp
                            </option>
                        }
                        else
                        {
                            <option value="draft">
                                Bản nháp
                            </option>
                        }

                    </select>
                </div>


                <div class="filter-group">
                    <label>Danh mục</label>

                    <select name="categoryId"
                            class="filter-control">

                        <option value="">
                            Tất cả danh mục
                        </option>

                        @foreach (var category in Model.Categories)
                        {
                            if (Model.CategoryId == category.Id)
                            {
                                <option value="@category.Id"
                                        selected>
                                    @category.Name
                                </option>
                            }
                            else
                            {
                                <option value="@category.Id">
                                    @category.Name
                                </option>
                            }
                        }

                    </select>
                </div>


                <button type="submit"
                        class="filter-button">
                    Lọc
                </button>

                <a asp-controller="AdminCourses"
                   asp-action="Index"
                   class="clear-button">
                    Xóa lọc
                </a>

            </form>

        </div>


        <section class="courses-card">

            <div class="card-header">
                <h2 class="card-title">
                    Danh sách khóa học
                </h2>

                <div class="card-count">
                    @Model.Courses.Count kết quả
                </div>
            </div>


            @if (Model.Courses.Any())
            {
                <div class="table-wrap">

                    <table class="courses-table">

                        <thead>
                            <tr>
                                <th>Khóa học</th>
                                <th>Giảng viên</th>
                                <th>Giá</th>
                                <th>Nội dung</th>
                                <th>Học viên</th>
                                <th>Đánh giá</th>
                                <th>Trạng thái</th>
                                <th>Cập nhật</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>


                        <tbody>

                            @foreach (var course in Model.Courses)
                            {
                                decimal displayPrice =
                                    course.DiscountPrice.HasValue &&
                                    course.DiscountPrice.Value > 0
                                        ? course.DiscountPrice.Value
                                        : course.Price;


                                <tr>

                                    <td>
                                        <div class="course-title">
                                            @course.Title
                                        </div>

                                        <div class="course-meta">
                                            @course.CategoryName
                                        </div>
                                    </td>


                                    <td>
                                        @course.InstructorName
                                    </td>


                                    <td>
                                        @($"{displayPrice:N0} đ")
                                    </td>


                                    <td>
                                        @course.ModuleCount chương
                                        · @course.LessonCount bài
                                    </td>


                                    <td>
                                        @course.EnrollmentCount
                                    </td>


                                    <td>
                                        @course.ReviewCount
                                    </td>


                                    <td>

                                        <span class="status-badge @(course.IsPublished ? "published" : "draft")">
                                            @(course.IsPublished
                                                ? "Đã xuất bản"
                                                : "Bản nháp")
                                        </span>

                                        @if (course.IsFeatured)
                                        {
                                            <div>
                                                <span class="featured-badge">
                                                    Nổi bật
                                                </span>
                                            </div>
                                        }

                                    </td>


                                    <td>
                                        @(course.UpdatedAt
                                            .ToLocalTime()
                                            .ToString("dd/MM/yyyy"))
                                    </td>


                                    <td>

                                        <div class="actions">


                                            @if (course.IsPublished)
                                            {
                                                <a asp-controller="Courses"
                                                   asp-action="Details"
                                                   asp-route-slug="@course.Slug"
                                                   class="action-link">
                                                    Xem
                                                </a>
                                            }


                                            <form asp-controller="AdminCourses"
                                                  asp-action="TogglePublish"
                                                  method="post"
                                                  class="action-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@course.Id" />

                                                <input type="hidden"
                                                       name="returnSearch"
                                                       value="@Model.Search" />

                                                <input type="hidden"
                                                       name="returnStatus"
                                                       value="@Model.Status" />

                                                <input type="hidden"
                                                       name="returnCategoryId"
                                                       value="@Model.CategoryId" />

                                                <button type="submit"
                                                        class="action-button @(course.IsPublished ? "draft-button" : "publish-button")"
                                                        onclick="return confirm('@(course.IsPublished ? "Chuyển khóa học này về bản nháp?" : "Xuất bản khóa học này?")');">

                                                    @(course.IsPublished
                                                        ? "Về nháp"
                                                        : "Xuất bản")

                                                </button>

                                            </form>


                                            <form asp-controller="AdminCourses"
                                                  asp-action="ToggleFeatured"
                                                  method="post"
                                                  class="action-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@course.Id" />

                                                <input type="hidden"
                                                       name="returnSearch"
                                                       value="@Model.Search" />

                                                <input type="hidden"
                                                       name="returnStatus"
                                                       value="@Model.Status" />

                                                <input type="hidden"
                                                       name="returnCategoryId"
                                                       value="@Model.CategoryId" />

                                                <button type="submit"
                                                        class="action-button featured-button">

                                                    @(course.IsFeatured
                                                        ? "Bỏ nổi bật"
                                                        : "Nổi bật")

                                                </button>

                                            </form>


                                            <form asp-controller="AdminCourses"
                                                  asp-action="Delete"
                                                  method="post"
                                                  class="action-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@course.Id" />

                                                <input type="hidden"
                                                       name="returnSearch"
                                                       value="@Model.Search" />

                                                <input type="hidden"
                                                       name="returnStatus"
                                                       value="@Model.Status" />

                                                <input type="hidden"
                                                       name="returnCategoryId"
                                                       value="@Model.CategoryId" />

                                                <button type="submit"
                                                        class="action-button delete-button"
                                                        onclick="return confirm('Xóa khóa học này? Chỉ khóa bản nháp chưa phát sinh dữ liệu học viên mới có thể xóa.');">

                                                    Xóa

                                                </button>

                                            </form>


                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">
                    Không tìm thấy khóa học phù hợp.
                </div>
            }

        </section>

    </div>
</div>
