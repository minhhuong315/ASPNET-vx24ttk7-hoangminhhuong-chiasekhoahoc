@{
    ViewData["Title"] = "Về EduLearn";
}

<link rel="stylesheet"
      href="~/css/guest-about.css"
      asp-append-version="true" />


<div class="about-page">


    <section class="about-hero">

        <div class="about-container">

            <div class="about-hero-content">


                <div class="about-eyebrow">
                    Về EduLearn
                </div>


                <div class="about-title"
                     role="heading"
                     aria-level="1">

                    Chia sẻ tri thức,
                    <span>kiến tạo tương lai</span>

                </div>


                <p class="about-description">

                    EduLearn là website chia sẻ khóa học trực tuyến
                    tập trung vào lĩnh vực Công nghệ thông tin,
                    kết nối người học với nội dung học tập
                    được tổ chức theo khóa học, module và bài học.

                </p>


            </div>

        </div>

    </section>


    <section class="about-section">

        <div class="about-container">


            <div class="section-title"
                 role="heading"
                 aria-level="2">
                Mục tiêu của EduLearn
            </div>


            <p class="section-description">

                Xây dựng một không gian học trực tuyến
                dễ sử dụng, nơi học viên có thể khám phá khóa học,
                theo dõi tiến độ và trao đổi với giảng viên;
                đồng thời cung cấp công cụ để giảng viên
                tổ chức và cập nhật nội dung giảng dạy.

            </p>


            <div class="value-grid">


                <article class="value-card">

                    <div class="value-icon value-icon--blue"
                         aria-hidden="true">

                        <svg viewBox="0 0 24 24">
                            <path d="M4 5.5h7.2c1.1 0 2 .4 2.8 1.2.8-.8 1.7-1.2 2.8-1.2H20v13h-3.2c-1.2 0-2.1.3-2.8 1-.7-.7-1.6-1-2.8-1H4z" />
                            <path d="M14 6.7v12.8" />
                        </svg>

                    </div>

                    <div class="value-title">
                        Học tập có cấu trúc
                    </div>

                    <p class="value-description">

                        Nội dung được tổ chức theo
                        khóa học, module và bài học
                        để người học dễ theo dõi.

                    </p>

                </article>


                <article class="value-card">

                    <div class="value-icon value-icon--green"
                         aria-hidden="true">

                        <svg viewBox="0 0 24 24">
                            <path d="M4 18V9" />
                            <path d="M10 18V5" />
                            <path d="M16 18v-7" />
                            <path d="M3 20h18" />
                            <path d="m5 8 4-3 4 2 5-4" />
                        </svg>

                    </div>

                    <div class="value-title">
                        Theo dõi tiến độ
                    </div>

                    <p class="value-description">

                        Hệ thống ghi nhận quá trình học
                        và giúp học viên tiếp tục
                        từ đúng vị trí đã dừng.

                    </p>

                </article>


                <article class="value-card">

                    <div class="value-icon value-icon--purple"
                         aria-hidden="true">

                        <svg viewBox="0 0 24 24">
                            <path d="M7 16.5H5.5A2.5 2.5 0 0 1 3 14V7.5A2.5 2.5 0 0 1 5.5 5h8A2.5 2.5 0 0 1 16 7.5V14a2.5 2.5 0 0 1-2.5 2.5H10l-3 2z" />
                            <path d="M16 9h2.5A2.5 2.5 0 0 1 21 11.5V16a2.5 2.5 0 0 1-2.5 2.5H17l-2.2 1.5" />
                        </svg>

                    </div>

                    <div class="value-title">
                        Kết nối giảng viên
                    </div>

                    <p class="value-description">

                        Hỏi đáp theo bài học
                        giúp học viên gửi câu hỏi
                        và nhận phản hồi từ giảng viên.

                    </p>

                </article>


            </div>


        </div>

    </section>


    <section class="about-section soft">

        <div class="about-container">


            <div class="about-cta">


                <div>

                    <div class="cta-title">
                        Khám phá khóa học trên EduLearn
                    </div>

                    <p class="cta-text">

                        Tìm khóa học phù hợp với
                        trình độ và mục tiêu học tập của bạn.

                    </p>

                </div>


                <a asp-controller="Courses"
                   asp-action="Index"
                   class="cta-link">

                    Xem khóa học →

                </a>


            </div>


        </div>

    </section>


</div>
