@model OnlineLearningPlatform.ViewModels.InstructorsPageViewModel

@{
    ViewData["Title"] = "Giảng viên";
}

<script>
    document.body.classList.add("guest-instructors-page");
</script>

<link rel="stylesheet"
      href="~/css/guest-instructors.css"
      asp-append-version="true" />


<div class="instructors-page">

    <div class="instructors-container">


        <div class="instructors-hero">

            <div class="page-eyebrow">
                Đội ngũ giảng viên
            </div>

            <div class="page-title"
                 role="heading"
                 aria-level="1">
                Giảng viên trên EduLearn
            </div>

            <p class="page-description">

                Khám phá các giảng viên đang chia sẻ
                khóa học Công nghệ thông tin trên EduLearn.

            </p>

        </div>


        @if (Model.Instructors.Any())
        {
            <div class="instructor-grid">


                @foreach (var instructor in Model.Instructors)
                {


                    <article class="instructor-card">

                        <div class="instructor-top">

                            <div class="instructor-avatar"
                                 aria-hidden="true">

                                <svg viewBox="0 0 24 24">
                                    <circle cx="12"
                                            cy="8"
                                            r="3.5" />

                                    <path d="M5.5 19c.7-3.6 2.9-5.5 6.5-5.5S17.8 15.4 18.5 19" />

                                    <path d="M4.5 19.5h15" />
                                </svg>

                            </div>

                            <div class="instructor-heading">

                                <div class="instructor-name"
                                     role="heading"
                                     aria-level="2">
                                    @instructor.FullName
                                </div>

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(
                            instructor.Bio))
                        {
                            <p class="instructor-bio">
                                @instructor.Bio
                            </p>
                        }


                        <div class="instructor-course-info @(instructor.PublishedCourseCount == 0 ? "is-zero" : "")">

                            <span class="instructor-course-info__icon"
                                  aria-hidden="true">

                                <svg viewBox="0 0 24 24">
                                    <path d="M4 5.5h7.2c1.1 0 2 .4 2.8 1.2.8-.8 1.7-1.2 2.8-1.2H20v13h-3.2c-1.2 0-2.1.3-2.8 1-.7-.7-1.6-1-2.8-1H4z" />
                                    <path d="M14 6.7v12.8" />
                                </svg>

                            </span>

                            <span class="instructor-course-info__text">
                                @instructor.PublishedCourseCount khóa học
                            </span>

                        </div>

                    </article>
                }


            </div>
        }
        else
        {
            <div class="empty-state">

                Hiện chưa có giảng viên
                đang hoạt động để hiển thị.

            </div>
        }


    </div>

</div>
