@model OnlineLearningPlatform.ViewModels.InstructorsPageViewModel

@{
    ViewData["Title"] = "Giảng viên";
}

<style>

    .instructors-page {
        min-height: 78vh;
        padding: 56px 0 80px;
        background: #f8fafc;
    }

    .instructors-container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .instructors-hero {
        max-width: 720px;
        margin-bottom: 34px;
    }

    .page-eyebrow {
        margin-bottom: 8px;
        color: #0d6efd;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .page-title {
        margin: 0 0 12px;
        color: #172033;
        font-size: 36px;
        font-weight: 800;
        line-height: 1.25;
    }

    .page-description {
        margin: 0;
        color: #758094;
        font-size: 14px;
        line-height: 1.75;
    }

    .instructor-grid {
        display: grid;
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .instructor-card {
        padding: 22px;
        border: 1px solid #e2e7ee;
        border-radius: 16px;
        background: #ffffff;
    }

    .instructor-top {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 17px;
    }

    .instructor-avatar {
        width: 50px;
        height: 50px;
        flex: 0 0 50px;
        border-radius: 14px;
        background: #edf4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .instructor-name {
        color: #273142;
        font-size: 15px;
        font-weight: 800;
        line-height: 1.4;
    }

    .instructor-role {
        margin-top: 3px;
        color: #98a2b3;
        font-size: 10px;
        font-weight: 700;
    }

    .instructor-bio {
        min-height: 66px;
        margin: 0 0 18px;
        color: #6f7a8c;
        font-size: 12px;
        line-height: 1.7;
    }

    .instructor-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 9px;
    }

    .instructor-stat {
        padding: 11px;
        border-radius: 10px;
        background: #f7f9fc;
        text-align: center;
    }

    .stat-number {
        color: #273142;
        font-size: 17px;
        font-weight: 800;
    }

    .stat-label {
        margin-top: 2px;
        color: #98a2b3;
        font-size: 9px;
        font-weight: 600;
    }

    .empty-state {
        padding: 55px 25px;
        border: 1px dashed #d7dee8;
        border-radius: 16px;
        background: #ffffff;
        color: #8490a2;
        text-align: center;
        font-size: 13px;
    }

    @@media (max-width: 900px) {

        .instructor-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 620px) {

        .page-title {
            font-size: 30px;
        }

        .instructor-grid {
            grid-template-columns: 1fr;
        }
    }

</style>


<div class="instructors-page">

    <div class="instructors-container">


        <div class="instructors-hero">

            <div class="page-eyebrow">
                Đội ngũ giảng viên
            </div>

            <h1 class="page-title">
                Giảng viên trên EduLearn
            </h1>

            <p class="page-description">

                Khám phá các giảng viên đang chia sẻ
                khóa học Công nghệ thông tin trên EduLearn.

            </p>

        </div>


        @if (Model.Instructors.Any())
        {
            <div class="instructor-grid">


                @foreach (var instructor in Model.Instructors)
                {
                    var initial =
                        !string.IsNullOrWhiteSpace(
                            instructor.FullName)
                            ? instructor.FullName
                                .Substring(0, 1)
                                .ToUpper()
                            : "G";


                    <article class="instructor-card">


                        <div class="instructor-top">

                            <div class="instructor-avatar">
                                @initial
                            </div>

                            <div>

                                <div class="instructor-name">
                                    @instructor.FullName
                                </div>

                                <div class="instructor-role">
                                    Giảng viên EduLearn
                                </div>

                            </div>

                        </div>


                        <p class="instructor-bio">

                            @(string.IsNullOrWhiteSpace(
                                instructor.Bio)
                                ? "Giảng viên chia sẻ kiến thức và kinh nghiệm thông qua các khóa học trên EduLearn."
                                : instructor.Bio)

                        </p>


                        <div class="instructor-stats">

                            <div class="instructor-stat">

                                <div class="stat-number">
                                    @instructor.PublishedCourseCount
                                </div>

                                <div class="stat-label">
                                    Khóa học
                                </div>

                            </div>


                            <div class="instructor-stat">

                                <div class="stat-number">
                                    @instructor.StudentCount
                                </div>

                                <div class="stat-label">
                                    Lượt đăng ký
                                </div>

                            </div>

                        </div>


                    </article>
                }


            </div>
        }
        else
        {
            <div class="empty-state">

                Hiện chưa có giảng viên
                đang hoạt động để hiển thị.

            </div>
        }


    </div>

</div>
