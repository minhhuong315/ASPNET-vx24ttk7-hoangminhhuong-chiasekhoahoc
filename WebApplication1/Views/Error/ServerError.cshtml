@{
    ViewData["Title"] = "Lỗi hệ thống";
}

<style>
    .error-page {
        min-height: 74vh;
        padding: 60px 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
    }

    .error-card {
        width: 100%;
        max-width: 650px;
        padding: 44px 34px;
        border: 1px solid #e2e7ee;
        border-radius: 18px;
        background: #ffffff;
        text-align: center;
        box-shadow: 0 14px 38px rgba(0, 0, 0, .06);
    }

    .error-number {
        margin-bottom: 8px;
        color: #dc3545;
        font-size: 54px;
        font-weight: 900;
        line-height: 1;
    }

    .error-title {
        margin: 0 0 10px;
        color: #172033;
        font-size: 29px;
        font-weight: 800;
    }

    .error-text {
        max-width: 510px;
        margin: 0 auto 25px;
        color: #7c8798;
        font-size: 13px;
        line-height: 1.75;
    }

    .home-link {
        min-height: 42px;
        padding: 0 17px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #0d6efd;
        color: #ffffff;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }
</style>

<div class="error-page">
    <div class="error-card">

        <div class="error-number">
            500
        </div>

        <h1 class="error-title">
            Đã xảy ra lỗi hệ thống
        </h1>

        <p class="error-text">
            EduLearn gặp sự cố khi xử lý yêu cầu.
            Vui lòng thử lại sau hoặc quay về trang chủ.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="home-link">
            Về trang chủ
        </a>

    </div>
</div>
