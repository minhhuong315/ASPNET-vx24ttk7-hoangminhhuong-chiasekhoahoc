@model OnlineLearningPlatform.ViewModels.AdminUsersPageViewModel

@{
    ViewData["Title"] = "Quản lý người dùng";
}

@functions {

    string GetRoleText(string? role)
    {
        return role switch
        {
            "Student" => "Học viên",
            "Instructor" => "Giảng viên",
            "Admin" => "Quản trị viên",
            _ => "Người dùng"
        };
    }


    string GetRoleClass(string? role)
    {
        return role switch
        {
            "Student" => "student",
            "Instructor" => "instructor",
            "Admin" => "admin",
            _ => "default"
        };
    }


    string GetInitial(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "U";
        }

        return fullName
            .Trim()
            .Substring(0, 1)
            .ToUpper();
    }
}

<style>

    .admin-users-page {
        min-height: 80vh;
        padding: 44px 0 76px;
        background: #f8fafc;
    }

    .admin-users-container {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .admin-users-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .admin-users-eyebrow {
        margin-bottom: 6px;
        color: #7c3aed;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .admin-users-title {
        margin: 0 0 7px;
        color: #172033;
        font-size: 34px;
        line-height: 1.15;
        font-weight: 800;
    }

    .admin-users-description {
        margin: 0;
        color: #7c8798;
        font-size: 12px;
        line-height: 1.7;
    }

    .create-user-button {
        min-height: 42px;
        padding: 0 16px;
        border: 1px solid #7c3aed;
        border-radius: 9px;
        background: #7c3aed;
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        flex-shrink: 0;
        font-size: 11px;
        font-weight: 800;
        text-decoration: none;
        transition:
            background .18s ease,
            border-color .18s ease,
            transform .18s ease;
    }

    .create-user-button:hover {
        border-color: #6d28d9;
        background: #6d28d9;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .admin-users-message {
        margin-bottom: 16px;
        padding: 12px 14px;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 700;
    }

    .admin-users-message.success {
        border: 1px solid #bfe5cb;
        background: #eefaf2;
        color: #16723a;
    }

    .admin-users-message.info {
        border: 1px solid #c9defe;
        background: #f3f8ff;
        color: #1761b0;
    }

    .admin-users-message.error {
        border: 1px solid #f3c8cf;
        background: #fff5f6;
        color: #b42332;
    }

    .admin-users-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 13px;
        margin-bottom: 18px;
    }

    .admin-users-stat {
        padding: 17px 18px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #ffffff;
    }

    .admin-users-stat-label {
        margin-bottom: 8px;
        color: #8993a4;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .admin-users-stat-value {
        color: #263247;
        font-size: 22px;
        font-weight: 800;
    }

    .admin-users-filter-card {
        margin-bottom: 18px;
        padding: 14px;
        border: 1px solid #e2e8f0;
        border-radius: 13px;
        background: #ffffff;
    }

    .admin-users-filter-form {
        display: grid;
        grid-template-columns:
            minmax(260px, 1fr)
            180px
            180px
            auto
            auto;
        gap: 10px;
        align-items: end;
    }

    .admin-filter-group {
        min-width: 0;
    }

    .admin-filter-label {
        display: block;
        margin-bottom: 6px;
        color: #596579;
        font-size: 9px;
        font-weight: 800;
    }

    .admin-filter-control {
        width: 100%;
        min-height: 40px;
        padding: 0 11px;
        border: 1px solid #dce3ec;
        border-radius: 8px;
        background: #ffffff;
        color: #344054;
        font: inherit;
        font-size: 10px;
        outline: none;
    }

    .admin-filter-control:focus {
        border-color: #a9c5f6;
        box-shadow:
            0 0 0 3px
            rgba(13, 110, 253, .07);
    }

    .admin-filter-button,
    .admin-filter-clear {
        min-height: 40px;
        padding: 0 14px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
    }

    .admin-filter-button {
        border: 1px solid #0d6efd;
        background: #0d6efd;
        color: #ffffff;
        cursor: pointer;
    }

    .admin-filter-button:hover {
        background: #0b5ed7;
    }

    .admin-filter-clear {
        border: 1px solid #dce3ec;
        background: #ffffff;
        color: #596579;
    }

    .admin-filter-clear:hover {
        border-color: #b9c7d8;
        color: #344054;
    }

    .admin-users-card {
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #ffffff;
    }

    .admin-users-card-header {
        min-height: 66px;
        padding: 16px 18px;
        border-bottom: 1px solid #edf1f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .admin-users-card-title {
        margin: 0;
        color: #273142;
        font-size: 22px;
        font-weight: 800;
    }

    .admin-users-result-count {
        color: #98a2b3;
        font-size: 9px;
        font-weight: 700;
    }

    .admin-users-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .admin-users-table {
        width: 100%;
        min-width: 980px;
        border-collapse: collapse;
    }

    .admin-users-table th {
        padding: 11px 13px;
        border-bottom: 1px solid #edf1f5;
        background: #fbfcfe;
        color: #7c8798;
        font-size: 8px;
        font-weight: 800;
        text-align: left;
        text-transform: uppercase;
    }

    .admin-users-table td {
        padding: 12px 13px;
        border-bottom: 1px solid #f0f2f5;
        color: #475467;
        font-size: 9px;
        vertical-align: middle;
    }

    .admin-users-table tr:last-child td {
        border-bottom: none;
    }

    .admin-user-cell {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 205px;
    }

    .admin-user-avatar {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        border-radius: 10px;
        background: #edf4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
    }

    .admin-user-name {
        color: #273142;
        font-size: 10px;
        font-weight: 800;
    }

    .admin-user-you {
        color: #7c3aed;
        font-size: 8px;
        font-weight: 800;
    }

    .admin-user-email {
        margin-top: 3px;
        color: #98a2b3;
        font-size: 8px;
        overflow-wrap: anywhere;
    }

    .role-badge,
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 5px 8px;
        border-radius: 999px;
        font-size: 8px;
        font-weight: 800;
        white-space: nowrap;
    }

    .role-badge.student {
        background: #edf4ff;
        color: #0d6efd;
    }

    .role-badge.instructor {
        background: #f3edff;
        color: #7c3aed;
    }

    .role-badge.admin {
        background: #fff2e8;
        color: #c45e14;
    }

    .role-badge.default {
        background: #f2f4f7;
        color: #667085;
    }

    .status-badge.active {
        background: #edf9f2;
        color: #198754;
    }

    .status-badge.inactive {
        background: #fff1f2;
        color: #c92a3a;
    }

    .email-status {
        color: #526079;
        font-size: 9px;
    }

    .email-status.confirmed {
        color: #526079;
    }

    .role-form {
        display: flex;
        align-items: center;
        gap: 6px;
        margin: 0;
    }

    .role-select {
        min-width: 92px;
        min-height: 34px;
        padding: 0 8px;
        border: 1px solid #dce3ec;
        border-radius: 7px;
        background: #ffffff;
        color: #475467;
        font: inherit;
        font-size: 8px;
        outline: none;
    }

    .role-save-button {
        min-height: 34px;
        padding: 0 9px;
        border: 1px solid #bfd4f6;
        border-radius: 7px;
        background: #f7faff;
        color: #0d6efd;
        font-size: 8px;
        font-weight: 800;
        cursor: pointer;
        white-space: nowrap;
    }

    .role-save-button:hover {
        border-color: #8eb8f5;
        background: #edf4ff;
    }

    .protected-text {
        color: #98a2b3;
        font-size: 8px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-form {
        margin: 0;
    }

    .status-button {
        min-height: 34px;
        padding: 0 10px;
        border-radius: 7px;
        background: #ffffff;
        font-size: 8px;
        font-weight: 800;
        cursor: pointer;
        white-space: nowrap;
    }

    .status-button.lock {
        border: 1px solid #f1c6cc;
        color: #c92a3a;
    }

    .status-button.lock:hover {
        border-color: #dc3545;
        background: #fff5f6;
    }

    .status-button.unlock {
        border: 1px solid #bfe5cb;
        color: #198754;
    }

    .status-button.unlock:hover {
        border-color: #7fc99a;
        background: #f0faf4;
    }

    .admin-users-empty {
        padding: 48px 20px;
        color: #8993a4;
        font-size: 11px;
        text-align: center;
    }

    @@media (max-width: 1000px) {

        .admin-users-filter-form {
            grid-template-columns:
                minmax(240px, 1fr)
                repeat(2, 150px)
                auto
                auto;
        }

        .admin-users-stats {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 760px) {

        .admin-users-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .admin-users-filter-form {
            grid-template-columns: 1fr 1fr;
        }

        .admin-filter-group:first-child {
            grid-column: 1 / -1;
        }

        .admin-filter-button,
        .admin-filter-clear {
            width: 100%;
        }
    }

    @@media (max-width: 520px) {

        .admin-users-title {
            font-size: 29px;
        }

        .admin-users-stats,
        .admin-users-filter-form {
            grid-template-columns: 1fr;
        }

        .admin-filter-group:first-child {
            grid-column: auto;
        }

        .create-user-button {
            width: 100%;
        }
    }

</style>


<section class="admin-users-page">

    <div class="admin-users-container">


        <div class="admin-users-header">

            <div>

                <div class="admin-users-eyebrow">
                    Quản trị hệ thống
                </div>

                <h1 class="admin-users-title">
                    Quản lý người dùng
                </h1>

                <p class="admin-users-description">
                    Tìm kiếm tài khoản, quản lý trạng thái hoạt động
                    và phân quyền Học viên / Giảng viên.
                </p>

            </div>


            <a asp-controller="AdminUsers"
               asp-action="Create"
               class="create-user-button">

                <span>+</span>
                <span>Tạo người dùng</span>

            </a>

        </div>


        @if (TempData["AdminUsersSuccess"] != null)
        {
            <div class="admin-users-message success">
                @TempData["AdminUsersSuccess"]
            </div>
        }

        @if (TempData["AdminUsersInfo"] != null)
        {
            <div class="admin-users-message info">
                @TempData["AdminUsersInfo"]
            </div>
        }

        @if (TempData["AdminUsersError"] != null)
        {
            <div class="admin-users-message error">
                @TempData["AdminUsersError"]
            </div>
        }


        <div class="admin-users-stats">

            <div class="admin-users-stat">
                <div class="admin-users-stat-label">
                    Tổng tài khoản
                </div>
                <div class="admin-users-stat-value">
                    @Model.TotalUsers
                </div>
            </div>

            <div class="admin-users-stat">
                <div class="admin-users-stat-label">
                    Học viên
                </div>
                <div class="admin-users-stat-value">
                    @Model.TotalStudents
                </div>
            </div>

            <div class="admin-users-stat">
                <div class="admin-users-stat-label">
                    Giảng viên
                </div>
                <div class="admin-users-stat-value">
                    @Model.TotalInstructors
                </div>
            </div>

            <div class="admin-users-stat">
                <div class="admin-users-stat-label">
                    Đang hoạt động / Khóa
                </div>
                <div class="admin-users-stat-value">
                    @Model.ActiveUsers / @Model.InactiveUsers
                </div>
            </div>

        </div>


        <div class="admin-users-filter-card">

            <form asp-controller="AdminUsers"
                  asp-action="Index"
                  method="get"
                  class="admin-users-filter-form">

                <div class="admin-filter-group">

                    <label class="admin-filter-label"
                           for="search">
                        Tìm kiếm
                    </label>

                    <input id="search"
                           name="search"
                           value="@Model.Search"
                           class="admin-filter-control"
                           placeholder="Tên hoặc email..." />

                </div>


                <div class="admin-filter-group">

                    <label class="admin-filter-label"
                           for="role">
                        Vai trò
                    </label>

                    <select id="role"
                            name="role"
                            class="admin-filter-control">

                        <option value="">
                            Tất cả vai trò
                        </option>

                        <option value="Student"
                                selected="@(Model.Role == "Student")">
                            Học viên
                        </option>

                        <option value="Instructor"
                                selected="@(Model.Role == "Instructor")">
                            Giảng viên
                        </option>

                        <option value="Admin"
                                selected="@(Model.Role == "Admin")">
                            Quản trị viên
                        </option>

                    </select>

                </div>


                <div class="admin-filter-group">

                    <label class="admin-filter-label"
                           for="status">
                        Trạng thái
                    </label>

                    <select id="status"
                            name="status"
                            class="admin-filter-control">

                        <option value="">
                            Tất cả trạng thái
                        </option>

                        <option value="active"
                                selected="@(Model.Status == "active")">
                            Đang hoạt động
                        </option>

                        <option value="inactive"
                                selected="@(Model.Status == "inactive")">
                            Đã khóa
                        </option>

                    </select>

                </div>


                <button type="submit"
                        class="admin-filter-button">
                    Lọc
                </button>


                <a asp-controller="AdminUsers"
                   asp-action="Index"
                   class="admin-filter-clear">
                    Xóa lọc
                </a>

            </form>

        </div>


        <section class="admin-users-card">

            <div class="admin-users-card-header">

                <h2 class="admin-users-card-title">
                    Danh sách tài khoản
                </h2>

                <div class="admin-users-result-count">
                    @Model.Users.Count kết quả
                </div>

            </div>


            @if (Model.Users.Any())
            {
                <div class="admin-users-table-wrap">

                    <table class="admin-users-table">

                        <thead>
                            <tr>
                                <th>Người dùng</th>
                                <th>Vai trò</th>
                                <th>Ngày tạo</th>
                                <th>Email</th>
                                <th>Trạng thái</th>
                                <th>Phân quyền</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>


                        <tbody>

                            @foreach (var user in Model.Users)
                            {
                                bool isProtected =
                                    user.Role == "Admin" ||
                                    user.IsCurrentUser;

                                <tr>

                                    <td>

                                        <div class="admin-user-cell">

                                            <div class="admin-user-avatar">
                                                @GetInitial(user.FullName)
                                            </div>

                                            <div>

                                                <div class="admin-user-name">

                                                    @user.FullName

                                                    @if (user.IsCurrentUser)
                                                    {
                                                        <span class="admin-user-you">
                                                            · Bạn
                                                        </span>
                                                    }

                                                </div>

                                                <div class="admin-user-email">
                                                    @user.Email
                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <td>

                                        <span class="role-badge @GetRoleClass(user.Role)">
                                            @GetRoleText(user.Role)
                                        </span>

                                    </td>


                                    <td>
                                        @(user.CreatedAt
                                            .ToLocalTime()
                                            .ToString("dd/MM/yyyy"))
                                    </td>


                                    <td>

                                        <span class="email-status @(user.EmailConfirmed ? "confirmed" : "")">

                                            @(user.EmailConfirmed
                                                ? "Đã xác thực"
                                                : "Chưa xác thực")

                                        </span>

                                    </td>


                                    <td>

                                        <span class="status-badge @(user.IsActive ? "active" : "inactive")">

                                            @(user.IsActive
                                                ? "Đang hoạt động"
                                                : "Đã khóa")

                                        </span>

                                    </td>


                                    <td>

                                        @if (isProtected)
                                        {
                                            <span class="protected-text">
                                                Role được bảo vệ
                                            </span>
                                        }
                                        else
                                        {
                                            <form asp-controller="AdminUsers"
                                                  asp-action="ChangeRole"
                                                  method="post"
                                                  class="role-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@user.Id" />

                                                <input type="hidden"
                                                       name="returnSearch"
                                                       value="@Model.Search" />

                                                <input type="hidden"
                                                       name="returnRole"
                                                       value="@Model.Role" />

                                                <input type="hidden"
                                                       name="returnStatus"
                                                       value="@Model.Status" />


                                                <select name="newRole"
                                                        class="role-select">

                                                    <option value="Student"
                                                            selected="@(user.Role == "Student")">
                                                        Học viên
                                                    </option>

                                                    <option value="Instructor"
                                                            selected="@(user.Role == "Instructor")">
                                                        Giảng viên
                                                    </option>

                                                </select>


                                                <button type="submit"
                                                        class="role-save-button">
                                                    Lưu role
                                                </button>

                                            </form>
                                        }

                                    </td>


                                    <td>

                                        @if (isProtected)
                                        {
                                            <span class="protected-text">
                                                Được bảo vệ
                                            </span>
                                        }
                                        else
                                        {
                                            <form asp-controller="AdminUsers"
                                                  asp-action="ToggleStatus"
                                                  method="post"
                                                  class="status-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@user.Id" />

                                                <input type="hidden"
                                                       name="returnSearch"
                                                       value="@Model.Search" />

                                                <input type="hidden"
                                                       name="returnRole"
                                                       value="@Model.Role" />

                                                <input type="hidden"
                                                       name="returnStatus"
                                                       value="@Model.Status" />


                                                <button type="submit"
                                                        class="status-button @(user.IsActive ? "lock" : "unlock")"
                                                        onclick="return confirm('@(user.IsActive ? "Bạn chắc chắn muốn khóa tài khoản này?" : "Bạn muốn mở khóa tài khoản này?")');">

                                                    @(user.IsActive
                                                        ? "Khóa tài khoản"
                                                        : "Mở khóa")

                                                </button>

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="admin-users-empty">
                    Không tìm thấy tài khoản phù hợp với bộ lọc hiện tại.
                </div>
            }

        </section>

    </div>

</section>
