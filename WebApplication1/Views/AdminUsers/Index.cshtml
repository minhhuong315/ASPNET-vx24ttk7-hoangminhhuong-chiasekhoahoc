@model OnlineLearningPlatform.ViewModels.AdminUsersPageViewModel

@{
    ViewData["Title"] = "Quản lý người dùng";
}

<style>

    .admin-users-page {
        min-height: 80vh;
        padding: 46px 0 78px;
        background: #f8fafc;
    }

    .admin-users-container {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .page-header {
        margin-bottom: 23px;
    }

    .page-eyebrow {
        margin-bottom: 6px;
        color: #0d6efd;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .page-title {
        margin: 0 0 7px;
        color: #172033;
        font-size: 31px;
        font-weight: 800;
    }

    .page-description {
        margin: 0;
        color: #7d8798;
        font-size: 12px;
        line-height: 1.7;
    }

    .message {
        margin-bottom: 16px;
        padding: 12px 14px;
        border-radius: 9px;
        font-size: 11px;
        font-weight: 700;
    }

    .message.success {
        border: 1px solid #bce4c9;
        background: #effaf3;
        color: #16723a;
    }

    .message.error {
        border: 1px solid #ffd2d6;
        background: #fff4f5;
        color: #b42332;
    }

    .message.info {
        border: 1px solid #cfe0fb;
        background: #f3f8ff;
        color: #315b98;
    }

    .stats-grid {
        display: grid;
        grid-template-columns:
            repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .stat-card {
        padding: 17px;
        border: 1px solid #e1e7ee;
        border-radius: 12px;
        background: #ffffff;
    }

    .stat-label {
        color: #8a94a5;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .stat-value {
        margin-top: 6px;
        color: #273142;
        font-size: 23px;
        font-weight: 800;
    }

    .filter-card {
        margin-bottom: 18px;
        padding: 15px;
        border: 1px solid #e1e7ee;
        border-radius: 12px;
        background: #ffffff;
    }

    .filter-form {
        display: grid;
        grid-template-columns:
            minmax(230px, 1fr)
            190px
            180px
            auto
            auto;
        gap: 9px;
        align-items: end;
    }

    .filter-group label {
        display: block;
        margin-bottom: 5px;
        color: #667085;
        font-size: 9px;
        font-weight: 800;
    }

    .filter-control {
        width: 100%;
        min-height: 40px;
        padding: 0 11px;
        border: 1px solid #dce2ea;
        border-radius: 8px;
        background: #ffffff;
        color: #344054;
        font: inherit;
        font-size: 10px;
        outline: none;
    }

    .filter-button,
    .clear-button {
        min-height: 40px;
        padding: 0 14px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
    }

    .filter-button {
        border: 1px solid #0d6efd;
        background: #0d6efd;
        color: #ffffff;
        font-family: inherit;
        cursor: pointer;
    }

    .clear-button {
        border: 1px solid #dce2ea;
        background: #ffffff;
        color: #667085;
    }

    .users-card {
        overflow: hidden;
        border: 1px solid #e1e7ee;
        border-radius: 14px;
        background: #ffffff;
    }

    .card-header {
        padding: 17px 19px;
        border-bottom: 1px solid #edf0f4;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .card-title {
        margin: 0;
        color: #344054;
        font-size: 14px;
        font-weight: 800;
    }

    .card-count {
        color: #98a2b3;
        font-size: 9px;
        font-weight: 700;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        min-width: 1080px;
        border-collapse: collapse;
    }

    .users-table th {
        padding: 11px 13px;
        border-bottom: 1px solid #edf0f4;
        background: #fbfcfd;
        color: #7d8798;
        font-size: 9px;
        font-weight: 800;
        text-align: left;
        text-transform: uppercase;
    }

    .users-table td {
        padding: 13px;
        border-bottom: 1px solid #f0f2f5;
        color: #475467;
        font-size: 10px;
        vertical-align: middle;
    }

    .users-table tr:last-child td {
        border-bottom: none;
    }

    .user-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .user-avatar {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        border-radius: 10px;
        background: #edf4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .user-name {
        color: #344054;
        font-size: 11px;
        font-weight: 800;
    }

    .user-email {
        margin-top: 2px;
        color: #98a2b3;
        font-size: 9px;
    }

    .role-badge,
    .status-badge {
        display: inline-flex;
        padding: 5px 8px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 800;
    }

    .role-badge.admin {
        background: #fff2e8;
        color: #b65a00;
    }

    .role-badge.instructor {
        background: #f3efff;
        color: #6741d9;
    }

    .role-badge.student {
        background: #eef4ff;
        color: #0d6efd;
    }

    .status-badge.active {
        background: #edf8f1;
        color: #198754;
    }

    .status-badge.inactive {
        background: #fff1f2;
        color: #c92a3a;
    }

    .role-form {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .role-select {
        min-height: 34px;
        padding: 0 8px;
        border: 1px solid #dce2ea;
        border-radius: 7px;
        background: #ffffff;
        color: #475467;
        font: inherit;
        font-size: 9px;
    }

    .small-button {
        min-height: 34px;
        padding: 0 9px;
        border-radius: 7px;
        font-family: inherit;
        font-size: 9px;
        font-weight: 800;
        cursor: pointer;
        white-space: nowrap;
    }

    .role-button {
        border: 1px solid #cfe0fb;
        background: #f5f9ff;
        color: #0d6efd;
    }

    .lock-button {
        border: 1px solid #f0c7cc;
        background: #fffafa;
        color: #c92a3a;
    }

    .unlock-button {
        border: 1px solid #bce4c9;
        background: #f4fbf6;
        color: #198754;
    }

    .protected-text {
        color: #98a2b3;
        font-size: 9px;
        font-weight: 700;
    }

    .empty-state {
        padding: 48px 20px;
        color: #8992a3;
        font-size: 10px;
        text-align: center;
    }

    @@media (max-width: 960px) {

        .stats-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }

        .filter-form {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 560px) {

        .stats-grid,
        .filter-form {
            grid-template-columns: 1fr;
        }
    }

</style>


<div class="admin-users-page">

    <div class="admin-users-container">


        <div class="page-header">

            <div class="page-eyebrow">
                Quản trị hệ thống
            </div>

            <h1 class="page-title">
                Quản lý người dùng
            </h1>

            <p class="page-description">

                Tìm kiếm tài khoản,
                quản lý trạng thái hoạt động
                và phân quyền Học viên / Giảng viên.

            </p>

        </div>


        @if (TempData["AdminUsersSuccess"] != null)
        {
            <div class="message success">
                @TempData["AdminUsersSuccess"]
            </div>
        }

        @if (TempData["AdminUsersError"] != null)
        {
            <div class="message error">
                @TempData["AdminUsersError"]
            </div>
        }

        @if (TempData["AdminUsersInfo"] != null)
        {
            <div class="message info">
                @TempData["AdminUsersInfo"]
            </div>
        }


        <div class="stats-grid">

            <div class="stat-card">
                <div class="stat-label">
                    Tổng tài khoản
                </div>
                <div class="stat-value">
                    @Model.TotalUsers
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">
                    Học viên
                </div>
                <div class="stat-value">
                    @Model.TotalStudents
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">
                    Giảng viên
                </div>
                <div class="stat-value">
                    @Model.TotalInstructors
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">
                    Đang hoạt động / Khóa
                </div>
                <div class="stat-value">
                    @Model.ActiveUsers / @Model.InactiveUsers
                </div>
            </div>

        </div>


        <div class="filter-card">

            <form asp-controller="AdminUsers"
                  asp-action="Index"
                  method="get"
                  class="filter-form">


                <div class="filter-group">

                    <label>
                        Tìm kiếm
                    </label>

                    <input type="text"
                           name="search"
                           value="@Model.Search"
                           class="filter-control"
                           placeholder="Tên hoặc email..." />

                </div>


                <div class="filter-group">

                    <label>
                        Vai trò
                    </label>

                    <select name="role"
                            class="filter-control">

                        <option value="">
                            Tất cả vai trò
                        </option>

                        <option value="Student"
                                selected="@(Model.Role == "Student")">
                            Học viên
                        </option>

                        <option value="Instructor"
                                selected="@(Model.Role == "Instructor")">
                            Giảng viên
                        </option>

                        <option value="Admin"
                                selected="@(Model.Role == "Admin")">
                            Quản trị viên
                        </option>

                    </select>

                </div>


                <div class="filter-group">

                    <label>
                        Trạng thái
                    </label>

                    <select name="status"
                            class="filter-control">

                        <option value="">
                            Tất cả trạng thái
                        </option>

                        <option value="active"
                                selected="@(Model.Status == "active")">
                            Đang hoạt động
                        </option>

                        <option value="inactive"
                                selected="@(Model.Status == "inactive")">
                            Đã khóa
                        </option>

                    </select>

                </div>


                <button type="submit"
                        class="filter-button">
                    Lọc
                </button>


                <a asp-controller="AdminUsers"
                   asp-action="Index"
                   class="clear-button">
                    Xóa lọc
                </a>


            </form>

        </div>


        <section class="users-card">


            <div class="card-header">

                <h2 class="card-title">
                    Danh sách tài khoản
                </h2>

                <div class="card-count">
                    @Model.Users.Count kết quả
                </div>

            </div>


            @if (Model.Users.Any())
            {
                <div class="table-wrap">

                    <table class="users-table">


                        <thead>

                            <tr>
                                <th>Người dùng</th>
                                <th>Vai trò</th>
                                <th>Ngày tạo</th>
                                <th>Email</th>
                                <th>Trạng thái</th>
                                <th>Phân quyền</th>
                                <th>Thao tác</th>
                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var user in Model.Users)
                            {
                                string firstLetter =
                                    !string.IsNullOrWhiteSpace(
                                        user.FullName)
                                        ? user.FullName
                                            .Substring(0, 1)
                                            .ToUpper()
                                        : "U";


                                string roleClass =
                                    user.Role switch
                                    {
                                        "Admin" =>
                                            "admin",

                                        "Instructor" =>
                                            "instructor",

                                        _ =>
                                            "student"
                                    };


                                string roleText =
                                    user.Role switch
                                    {
                                        "Admin" =>
                                            "Quản trị viên",

                                        "Instructor" =>
                                            "Giảng viên",

                                        "Student" =>
                                            "Học viên",

                                        _ =>
                                            user.Role
                                    };


                                <tr>


                                    <td>

                                        <div class="user-cell">

                                            <div class="user-avatar">
                                                @firstLetter
                                            </div>

                                            <div>

                                                <div class="user-name">

                                                    @user.FullName

                                                    @if (user.IsCurrentUser)
                                                    {
                                                        <span class="protected-text">
                                                            · Bạn
                                                        </span>
                                                    }

                                                </div>

                                                <div class="user-email">
                                                    @user.Email
                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <td>

                                        <span class="role-badge @roleClass">
                                            @roleText
                                        </span>

                                    </td>


                                    <td>

                                        @(user.CreatedAt
                                            .ToLocalTime()
                                            .ToString("dd/MM/yyyy"))

                                    </td>


                                    <td>

                                        @(user.EmailConfirmed
                                            ? "Đã xác thực"
                                            : "Chưa xác thực")

                                    </td>


                                    <td>

                                        <span class="status-badge @(user.IsActive ? "active" : "inactive")">

                                            @(user.IsActive
                                                ? "Đang hoạt động"
                                                : "Đã khóa")

                                        </span>

                                    </td>


                                    <td>

                                        @if (user.Role == "Admin")
                                        {
                                            <span class="protected-text">
                                                Role được bảo vệ
                                            </span>
                                        }
                                        else
                                        {
                                            <form asp-controller="AdminUsers"
                                                  asp-action="ChangeRole"
                                                  method="post"
                                                  class="role-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@user.Id" />

                                                <input type="hidden"
                                                       name="returnSearch"
                                                       value="@Model.Search" />

                                                <input type="hidden"
                                                       name="returnRole"
                                                       value="@Model.Role" />

                                                <input type="hidden"
                                                       name="returnStatus"
                                                       value="@Model.Status" />


                                                <select name="newRole"
                                                        class="role-select">

                                                    <option value="Student"
                                                            selected="@(user.Role == "Student")">
                                                        Học viên
                                                    </option>

                                                    <option value="Instructor"
                                                            selected="@(user.Role == "Instructor")">
                                                        Giảng viên
                                                    </option>

                                                </select>


                                                <button type="submit"
                                                        class="small-button role-button">
                                                    Lưu role
                                                </button>

                                            </form>
                                        }

                                    </td>


                                    <td>

                                        @if (user.Role == "Admin" ||
                                             user.IsCurrentUser)
                                        {
                                            <span class="protected-text">
                                                Được bảo vệ
                                            </span>
                                        }
                                        else
                                        {
                                            <form asp-controller="AdminUsers"
                                                  asp-action="ToggleStatus"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@user.Id" />

                                                <input type="hidden"
                                                       name="returnSearch"
                                                       value="@Model.Search" />

                                                <input type="hidden"
                                                       name="returnRole"
                                                       value="@Model.Role" />

                                                <input type="hidden"
                                                       name="returnStatus"
                                                       value="@Model.Status" />


                                                @if (user.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="small-button lock-button"
                                                            onclick="return confirm('Khóa tài khoản này? Người dùng sẽ không thể đăng nhập lại cho đến khi được mở khóa.');">

                                                        Khóa tài khoản

                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="small-button unlock-button">

                                                        Mở khóa

                                                    </button>
                                                }

                                            </form>
                                        }

                                    </td>


                                </tr>
                            }

                        </tbody>


                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">
                    Không tìm thấy tài khoản phù hợp.
                </div>
            }


        </section>


    </div>

</div>
