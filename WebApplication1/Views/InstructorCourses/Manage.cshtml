@model OnlineLearningPlatform.Models.Course

@{
    ViewData["Title"] =
        "Quản lý nội dung - " +
        Model.Title;

    int totalModules =
        Model.Modules?.Count ?? 0;

    int totalLessons =
        Model.Modules?
            .Sum(m =>
                m.Lessons.Count)
        ?? 0;

    bool canPublish =
        totalModules > 0 &&
        totalLessons > 0;
}

<style>

    .manage-course-page {
        min-height: 80vh;
        padding: 42px 0 75px;
        background: #f8fafc;
    }

    .manage-container {
        max-width: 1050px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .back-link {
        display: inline-flex;
        margin-bottom: 20px;
        color: #697386;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
    }

        .back-link:hover {
            color: #0d6efd;
        }

    .message {
        margin-bottom: 18px;
        padding: 13px 15px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 700;
    }

        .message.success {
            border: 1px solid #bce4c9;
            background: #effaf3;
            color: #16723a;
        }

        .message.error {
            border: 1px solid #ffd2d6;
            background: #fff4f5;
            color: #b42332;
        }

        .message.info {
            border: 1px solid #cfe0fb;
            background: #f3f8ff;
            color: #315b98;
        }

    .manage-header {
        margin-bottom: 25px;
        padding: 24px;
        border: 1px solid #e3e8ef;
        border-radius: 16px;
        background: #ffffff;
    }

    .manage-header-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
    }

    .manage-eyebrow {
        margin-bottom: 6px;
        color: #0d6efd;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .manage-title {
        margin: 0 0 9px;
        color: #172033;
        font-size: 27px;
        font-weight: 800;
    }

    .manage-description {
        margin: 0 0 17px;
        color: #7b8595;
        font-size: 13px;
        line-height: 1.7;
    }

    .header-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
    }

    .edit-course-button {
        min-height: 38px;
        padding: 0 13px;
        border: 1px solid #dce3ec;
        border-radius: 8px;
        background: #ffffff;
        color: #596579;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
    }

        .edit-course-button:hover {
            border-color: #aac9f8;
            color: #0d6efd;
        }

    .publish-form,
    .delete-form {
        margin: 0;
    }

    .publish-button,
    .unpublish-button {
        min-height: 38px;
        padding: 0 13px;
        border-radius: 8px;
        font-family: inherit;
        font-size: 10px;
        font-weight: 800;
        cursor: pointer;
    }

    .publish-button {
        border: 1px solid #198754;
        background: #198754;
        color: #ffffff;
    }

        .publish-button:hover {
            background: #157347;
        }

        .publish-button:disabled {
            border-color: #cad2dc;
            background: #e7ebf0;
            color: #98a2b3;
            cursor: not-allowed;
        }

    .unpublish-button {
        border: 1px solid #f1c26c;
        background: #fff8e8;
        color: #a15c00;
    }

    .publish-requirement {
        margin-top: 14px;
        padding: 12px 14px;
        border: 1px solid #e4e9f0;
        border-radius: 10px;
        background: #f9fafb;
    }

    .publish-requirement-title {
        margin-bottom: 5px;
        color: #475467;
        font-size: 11px;
        font-weight: 800;
    }

    .publish-requirement-text {
        margin: 0;
        color: #8992a3;
        font-size: 10px;
    }

    .requirement-ok {
        color: #198754;
        font-weight: 700;
    }

    .requirement-missing {
        color: #c26a00;
        font-weight: 700;
    }

    .manage-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .summary-badge {
        padding: 6px 10px;
        border-radius: 20px;
        background: #f3f5f8;
        color: #657083;
        font-size: 10px;
        font-weight: 700;
    }

        .summary-badge.published {
            background: #eaf8ef;
            color: #198754;
        }

        .summary-badge.draft {
            background: #fff5e5;
            color: #b56a00;
        }

    .content-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 14px;
    }

    .content-section-title {
        margin: 0;
        color: #172033;
        font-size: 19px;
        font-weight: 800;
    }

    .content-header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .content-section-count {
        color: #8b95a5;
        font-size: 11px;
    }

    .add-module-button {
        min-height: 38px;
        padding: 0 13px;
        border-radius: 8px;
        background: #0d6efd;
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
        text-decoration: none;
    }

        .add-module-button:hover {
            background: #0b5ed7;
            color: #ffffff;
        }

    .manage-module {
        overflow: hidden;
        margin-bottom: 15px;
        border: 1px solid #e2e7ee;
        border-radius: 13px;
        background: #ffffff;
    }

    .module-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 16px 18px;
        background: #f9fbfd;
        border-bottom: 1px solid #edf0f4;
    }

    .module-left {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .module-order {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        border-radius: 9px;
        background: #edf4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 800;
    }

    .module-title {
        color: #273142;
        font-size: 13px;
        font-weight: 800;
    }

    .module-description {
        margin-top: 2px;
        color: #8a94a3;
        font-size: 10px;
    }

    .module-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
    }

    .module-count {
        color: #8992a3;
        font-size: 10px;
        font-weight: 600;
    }

    .small-action {
        min-height: 31px;
        padding: 0 10px;
        border: 1px solid #dce3ec;
        border-radius: 7px;
        background: #ffffff;
        color: #596579;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: inherit;
        font-size: 9px;
        font-weight: 800;
        text-decoration: none;
        cursor: pointer;
    }

        .small-action:hover {
            border-color: #aac9f8;
            color: #0d6efd;
        }

        .small-action.purple {
            border-color: #ded7f7;
            color: #7451d8;
        }

        .small-action.primary {
            border-color: #0d6efd;
            background: #0d6efd;
            color: #ffffff;
        }

        .small-action.danger {
            border-color: #f2c7cc;
            background: #fffafa;
            color: #c92a3a;
        }

            .small-action.danger:hover {
                border-color: #dc3545;
                background: #fff1f2;
                color: #b42332;
            }

    .lesson-list {
        padding: 5px 18px;
    }

    .lesson-row {
        display: grid;
        grid-template-columns: 36px minmax(0, 1fr) auto;
        gap: 12px;
        align-items: center;
        padding: 13px 0;
        border-bottom: 1px solid #edf0f4;
    }

        .lesson-row:last-child {
            border-bottom: none;
        }

    .lesson-order {
        width: 27px;
        height: 27px;
        border-radius: 7px;
        background: #f2f4f7;
        color: #697386;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 9px;
        font-weight: 800;
    }

    .lesson-title {
        color: #465164;
        font-size: 12px;
        font-weight: 700;
    }

    .lesson-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 4px;
        color: #98a2b3;
        font-size: 9px;
    }

    .lesson-free {
        color: #198754;
        font-weight: 700;
    }

    .lesson-right {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
    }

    .lesson-duration {
        padding: 5px 8px;
        border-radius: 20px;
        background: #f3f5f8;
        color: #778294;
        font-size: 9px;
        font-weight: 700;
        white-space: nowrap;
    }

    .empty-lessons {
        padding: 18px 0;
        color: #98a2b3;
        font-size: 11px;
        text-align: center;
    }

    .empty-module {
        padding: 35px 25px;
        border: 1px dashed #d9e0e8;
        border-radius: 12px;
        background: #ffffff;
        text-align: center;
    }

    .empty-module-title {
        margin-bottom: 7px;
        color: #475467;
        font-size: 13px;
        font-weight: 800;
    }

    .empty-module-text {
        margin-bottom: 16px;
        color: #8992a3;
        font-size: 11px;
    }

    @@media (max-width: 720px) {

        .manage-header-top,
        .content-section-header,
        .module-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .header-actions,
        .content-header-actions,
        .module-actions {
            align-items: flex-start;
            justify-content: flex-start;
        }

        .lesson-row {
            grid-template-columns: 32px 1fr;
        }

        .lesson-right {
            grid-column: 2;
            justify-content: flex-start;
        }
    }

</style>


<div class="manage-course-page">

    <div class="manage-container">


        <a asp-controller="InstructorCourses"
           asp-action="Index"
           class="back-link">

            ← Quay lại khóa học phụ trách

        </a>


        @if (TempData["InstructorCourseSuccess"] != null)
        {
            <div class="message success">
                @TempData["InstructorCourseSuccess"]
            </div>
        }


        @if (TempData["InstructorCourseError"] != null)
        {
            <div class="message error">
                @TempData["InstructorCourseError"]
            </div>
        }


        @if (TempData["InstructorCourseInfo"] != null)
        {
            <div class="message info">
                @TempData["InstructorCourseInfo"]
            </div>
        }


        <section class="manage-header">


            <div class="manage-header-top">


                <div>

                    <div class="manage-eyebrow">
                        Quản lý nội dung
                    </div>

                    <h1 class="manage-title">
                        @Model.Title
                    </h1>

                    <p class="manage-description">

                        Quản lý thông tin,
                        cấu trúc module và bài học
                        của khóa học.

                    </p>

                </div>


                <div class="header-actions">


                    <a asp-controller="InstructorCourses"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="edit-course-button">

                        Sửa thông tin

                    </a>


                    @if (Model.IsPublished)
                    {
                        <form asp-controller="InstructorCourses"
                              asp-action="Unpublish"
                              asp-route-id="@Model.Id"
                              method="post"
                              class="publish-form">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="unpublish-button"
                                    onclick="return confirm('Chuyển khóa học này về trạng thái Bản nháp?');">

                                Bỏ xuất bản

                            </button>

                        </form>
                    }
                    else
                    {
                        <form asp-controller="InstructorCourses"
                              asp-action="Publish"
                              asp-route-id="@Model.Id"
                              method="post"
                              class="publish-form">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="publish-button"
                                    disabled="@(!canPublish)">

                                Xuất bản khóa học

                            </button>

                        </form>
                    }


                </div>


            </div>


            <div class="manage-summary">


                <span class="summary-badge">
                    @Model.Category.Name
                </span>

                <span class="summary-badge">
                    @totalModules module
                </span>

                <span class="summary-badge">
                    @totalLessons bài học
                </span>

                <span class="summary-badge">
                    @Model.Duration phút
                </span>


                @if (Model.IsPublished)
                {
                    <span class="summary-badge published">
                        Đã xuất bản
                    </span>
                }
                else
                {
                    <span class="summary-badge draft">
                        Bản nháp
                    </span>
                }


            </div>


            @if (!Model.IsPublished)
            {
                <div class="publish-requirement">


                    <div class="publish-requirement-title">
                        Điều kiện xuất bản
                    </div>


                    <p class="publish-requirement-text">


                        @if (totalModules > 0)
                        {
                            <span class="requirement-ok">
                                ✓ Có module
                            </span>
                        }
                        else
                        {
                            <span class="requirement-missing">
                                ○ Cần ít nhất 1 module
                            </span>
                        }


                        &nbsp;&nbsp;


                        @if (totalLessons > 0)
                        {
                            <span class="requirement-ok">
                                ✓ Có bài học
                            </span>
                        }
                        else
                        {
                            <span class="requirement-missing">
                                ○ Cần ít nhất 1 bài học
                            </span>
                        }


                    </p>


                </div>
            }


        </section>


        <div class="content-section-header">


            <h2 class="content-section-title">
                Cấu trúc khóa học
            </h2>


            <div class="content-header-actions">


                <div class="content-section-count">

                    @totalModules module ·
                    @totalLessons bài học

                </div>


                <a asp-controller="InstructorCourses"
                   asp-action="CreateModule"
                   asp-route-courseId="@Model.Id"
                   class="add-module-button">

                    + Thêm module

                </a>


            </div>


        </div>


        @if (Model.Modules != null &&
             Model.Modules.Any())
        {
            foreach (var module in
                Model.Modules
                    .OrderBy(m =>
                        m.DisplayOrder))
            {
                <section class="manage-module">


                    <div class="module-header">


                        <div class="module-left">


                            <div class="module-order">
                                @module.DisplayOrder
                            </div>


                            <div>

                                <div class="module-title">
                                    @module.Title
                                </div>


                                @if (!string.IsNullOrWhiteSpace(
                                    module.Description))
                                {
                                    <div class="module-description">
                                        @module.Description
                                    </div>
                                }

                            </div>


                        </div>


                        <div class="module-actions">


                            <div class="module-count">
                                @module.Lessons.Count bài học
                            </div>


                            <a asp-controller="InstructorCourses"
                               asp-action="EditModule"
                               asp-route-id="@module.Id"
                               class="small-action purple">

                                Sửa module

                            </a>


                            <a asp-controller="InstructorCourses"
                               asp-action="CreateLesson"
                               asp-route-moduleId="@module.Id"
                               class="small-action primary">

                                + Thêm bài học

                            </a>


                            @if (!Model.IsPublished)
                            {
                                <form asp-controller="InstructorContentDelete"
                                      asp-action="DeleteModule"
                                      asp-route-id="@module.Id"
                                      method="post"
                                      class="delete-form">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="small-action danger"
                                            onclick="return confirm('Bạn chắc chắn muốn xóa module này? Các bài học chưa có hoạt động học tập bên trong cũng sẽ bị xóa.');">

                                        Xóa module

                                    </button>

                                </form>
                            }


                        </div>


                    </div>


                    <div class="lesson-list">


                        @if (module.Lessons.Any())
                        {
                            foreach (var lesson in
                                module.Lessons
                                    .OrderBy(l =>
                                        l.DisplayOrder))
                            {
                                <div class="lesson-row">


                                    <div class="lesson-order">
                                        @lesson.DisplayOrder
                                    </div>


                                    <div>


                                        <div class="lesson-title">
                                            @lesson.Title
                                        </div>


                                        <div class="lesson-meta">


                                            @if (!string.IsNullOrWhiteSpace(
                                                lesson.VideoUrl))
                                            {
                                                <span>
                                                    Có video
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    Chưa có video
                                                </span>
                                            }


                                            @if (lesson.IsFree)
                                            {
                                                <span>·</span>

                                                <span class="lesson-free">
                                                    Xem thử miễn phí
                                                </span>
                                            }


                                        </div>


                                    </div>


                                    <div class="lesson-right">


                                        <span class="lesson-duration">
                                            @lesson.Duration phút
                                        </span>


                                        <a asp-controller="InstructorCourses"
                                           asp-action="EditLesson"
                                           asp-route-id="@lesson.Id"
                                           class="small-action">

                                            Sửa bài học

                                        </a>


                                        @if (!Model.IsPublished)
                                        {
                                            <form asp-controller="InstructorContentDelete"
                                                  asp-action="DeleteLesson"
                                                  asp-route-id="@lesson.Id"
                                                  method="post"
                                                  class="delete-form">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="small-action danger"
                                                        onclick="return confirm('Bạn chắc chắn muốn xóa bài học này?');">

                                                    Xóa

                                                </button>

                                            </form>
                                        }


                                    </div>


                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-lessons">

                                Module này chưa có bài học.

                            </div>
                        }


                    </div>


                </section>
            }
        }
        else
        {
            <div class="empty-module">


                <div class="empty-module-title">
                    Khóa học chưa có module
                </div>


                <div class="empty-module-text">

                    Tạo module đầu tiên
                    để bắt đầu xây dựng nội dung khóa học.

                </div>


                <a asp-controller="InstructorCourses"
                   asp-action="CreateModule"
                   asp-route-courseId="@Model.Id"
                   class="add-module-button">

                    + Thêm module đầu tiên

                </a>


            </div>
        }


    </div>

</div>