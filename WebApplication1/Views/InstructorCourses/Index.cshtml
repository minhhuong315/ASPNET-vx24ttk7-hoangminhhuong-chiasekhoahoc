@model OnlineLearningPlatform.ViewModels.InstructorCoursesViewModel

@{
    ViewData["Title"] = "Khóa học đang phụ trách";

    string currentStatus =
        ViewBag.CourseStatus as string
        ?? "all";

    string currentLevel =
        ViewBag.CourseLevel as string
        ?? "all";

    string statusLabel =
        currentStatus switch
        {
            "published" =>
                "Đã xuất bản",

            "draft" =>
                "Bản nháp",

            _ =>
                "Tất cả trạng thái"
        };

    string levelLabel =
        currentLevel switch
        {
            "beginner" =>
                "Cơ bản",

            "intermediate" =>
                "Trung cấp",

            "advanced" =>
                "Nâng cao",

            _ =>
                "Tất cả trình độ"
        };

    bool hasActiveFilter =
        currentStatus != "all" ||
        currentLevel != "all";
}

@functions {

    string GetLevelText(string? level)
    {
        return level switch
        {
            "Beginner" => "Cơ bản",
            "Intermediate" => "Trung cấp",
            "Advanced" => "Nâng cao",
            _ => "Chưa xác định"
        };
    }


    string GetLevelClass(string? level)
    {
        return level switch
        {
            "Beginner" => "beginner",
            "Intermediate" => "intermediate",
            "Advanced" => "advanced",
            _ => "default"
        };
    }

}

<style>

    .instructor-courses-page {
        min-height: 80vh;
        padding: 45px 0 75px;
        background: #f8fafc;
    }

    .instructor-courses-container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 25px;
        margin-bottom: 27px;
    }

    .page-eyebrow {
        margin-bottom: 6px;
        color: #0d6efd;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .page-title {
        margin: 0;
        color: #172033;
        font-size: 32px;
        font-weight: 800;
    }

    .page-description {
        max-width: 700px;
        margin: 8px 0 0;
        color: #7a8494;
        line-height: 1.7;
    }

    .create-course-button {
        min-height: 44px;
        padding: 0 17px;
        border-radius: 9px;
        background: #0d6efd;
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
    }

    .create-course-button:hover {
        background: #0b5ed7;
        color: #ffffff;
    }

    .course-stats {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 13px;
        margin-bottom: 30px;
    }

    .course-stat {
        display: block;

        padding: 18px;
        border: 1px solid #e4e9f0;
        border-radius: 13px;
        background: #ffffff;
        color: inherit;

        text-decoration: none;
    }

    .course-stat.filter-stat {
        cursor: pointer;

        transition:
            transform .18s ease,
            border-color .18s ease,
            box-shadow .18s ease,
            background .18s ease;
    }

    .course-stat.filter-stat:hover {
        border-color: #a9c8fb;

        box-shadow:
            0 8px 22px
            rgba(13, 110, 253, .08);

        transform:
            translateY(-2px);
    }

    .course-stat.filter-stat.active {
        border-color: #0d6efd;
        background: #f5f9ff;

        box-shadow:
            0 0 0 3px
            rgba(13, 110, 253, .08);
    }

    .course-stat.filter-stat.published-filter.active {
        border-color: #5ebc82;
        background: #f3fbf6;

        box-shadow:
            0 0 0 3px
            rgba(25, 135, 84, .08);
    }

    .course-stat.filter-stat.draft-filter.active {
        border-color: #e5aa4c;
        background: #fffaf1;

        box-shadow:
            0 0 0 3px
            rgba(178, 106, 0, .08);
    }

    .stat-label {
        margin-bottom: 5px;
        color: #8992a3;
        font-size: 11px;
        font-weight: 600;
    }

    .stat-number {
        color: #172033;
        font-size: 25px;
        font-weight: 800;
    }

    .stat-number.published {
        color: #198754;
    }

    .stat-number.draft {
        color: #b26a00;
    }

    .stat-hint {
        margin-top: 7px;

        color: #98a2b3;

        font-size: 9px;
        font-weight: 700;
    }

    .course-stat.filter-stat.active .stat-hint {
        color: #0d6efd;
    }

    .course-stat.published-filter.active .stat-hint {
        color: #198754;
    }

    .course-stat.draft-filter.active .stat-hint {
        color: #b26a00;
    }


    /* =========================================
       FILTER TRÌNH ĐỘ
    ========================================= */

    .course-filter-panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;

        margin-bottom: 24px;
        padding: 16px 18px;

        border: 1px solid #e4e9f0;
        border-radius: 13px;

        background: #ffffff;
    }

    .course-filter-main {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .course-filter-title {
        margin-right: 3px;

        color: #536075;

        font-size: 11px;
        font-weight: 800;
    }

    .level-filter-link {
        min-height: 34px;
        padding: 0 12px;

        border: 1px solid #dfe5ed;
        border-radius: 18px;

        background: #ffffff;
        color: #667085;

        display: inline-flex;
        align-items: center;
        gap: 7px;

        font-size: 10px;
        font-weight: 800;

        text-decoration: none;

        transition:
            border-color .18s ease,
            background .18s ease,
            color .18s ease;
    }

    .level-filter-link:hover {
        border-color: #aac9f8;
        color: #0d6efd;
    }

    .level-filter-link.active {
        border-color: #0d6efd;
        background: #edf4ff;
        color: #0d6efd;
    }

    .level-filter-link.intermediate.active {
        border-color: #7451d8;
        background: #f2edff;
        color: #7451d8;
    }

    .level-filter-link.advanced.active {
        border-color: #087f73;
        background: #e5f8f5;
        color: #087f73;
    }

    .filter-dot {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: #98a2b3;
    }

    .filter-dot.beginner {
        background: #0d6efd;
    }

    .filter-dot.intermediate {
        background: #7451d8;
    }

    .filter-dot.advanced {
        background: #087f73;
    }

    .clear-filter-link {
        color: #7a8494;

        font-size: 10px;
        font-weight: 800;

        text-decoration: none;
        white-space: nowrap;
    }

    .clear-filter-link:hover {
        color: #0d6efd;
    }

    .course-list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 15px;
    }

    .course-list-title {
        margin: 0;
        color: #172033;
        font-size: 19px;
        font-weight: 800;
    }

    .course-list-count {
        color: #8b95a5;
        font-size: 11px;
    }

    .instructor-course-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .instructor-course-card {
        overflow: hidden;
        border: 1px solid #e3e8ef;
        border-radius: 15px;
        background: #ffffff;
        transition:
            transform .2s ease,
            box-shadow .2s ease;
    }

    .instructor-course-card:hover {
        transform: translateY(-3px);
        box-shadow:
            0 12px 30px
            rgba(32, 47, 71, .09);
    }

    .course-color {
        height: 7px;
    }

    .course-color.beginner {
        background: #0d6efd;
    }

    .course-color.intermediate {
        background: #7451d8;
    }

    .course-color.advanced {
        background: #087f73;
    }

    .course-color.default {
        background: #667085;
    }

    .course-card-body {
        padding: 20px;
    }

    .course-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 13px;
    }

    .course-category {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .course-category-icon {
        width: 37px;
        height: 37px;
        flex: 0 0 37px;
        border-radius: 10px;
        background: #edf4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
    }

    .course-category-name {
        color: #7a8494;
        font-size: 11px;
        font-weight: 600;
    }

    .course-status {
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 800;
        white-space: nowrap;
    }

    .course-status.published {
        background: #eaf8ef;
        color: #198754;
    }

    .course-status.draft {
        background: #fff5e5;
        color: #b56a00;
    }

    .course-title {
        margin: 0 0 10px;
        color: #202938;
        font-size: 17px;
        font-weight: 800;
        line-height: 1.45;
    }

    .course-badges {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 7px;
        margin-bottom: 16px;
    }

    .level-badge,
    .price-badge {
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 800;
    }

    .level-badge.beginner {
        background: #eaf2ff;
        color: #0d6efd;
    }

    .level-badge.intermediate {
        background: #f2edff;
        color: #7451d8;
    }

    .level-badge.advanced {
        background: #e5f8f5;
        color: #087f73;
    }

    .level-badge.default {
        background: #eef1f4;
        color: #667085;
    }

    .price-badge {
        background: #f3f5f8;
        color: #626d7e;
    }

    .course-meta-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        margin-bottom: 17px;
    }

    .course-meta {
        padding: 10px;
        border-radius: 9px;
        background: #f8fafc;
        text-align: center;
    }

    .meta-number {
        color: #273142;
        font-size: 14px;
        font-weight: 800;
    }

    .meta-label {
        margin-top: 2px;
        color: #929baa;
        font-size: 9px;
    }

    .course-updated {
        margin-bottom: 15px;
        color: #98a2b3;
        font-size: 10px;
    }

    .course-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding-top: 15px;
        border-top: 1px solid #edf0f4;
    }

    .course-action {
        min-height: 37px;
        padding: 0 12px;
        border: 1px solid #dce3ec;
        border-radius: 8px;
        background: #ffffff;
        color: #596579;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
        text-decoration: none;
    }

    .course-action:hover {
        border-color: #aac9f8;
        color: #0d6efd;
    }

    .course-action.primary {
        border-color: #0d6efd;
        background: #0d6efd;
        color: #ffffff;
    }

    .course-action.primary:hover {
        background: #0b5ed7;
        color: #ffffff;
    }

    .empty-courses {
        padding: 65px 25px;
        border: 1px solid #e2e7ee;
        border-radius: 15px;
        background: #ffffff;
        text-align: center;
    }

    .empty-icon {
        width: 55px;
        height: 55px;
        margin: 0 auto 13px;
        border-radius: 14px;
        background: #edf4ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .empty-title {
        margin-bottom: 5px;
        color: #344054;
        font-weight: 800;
    }

    .empty-description {
        margin-bottom: 18px;
        color: #8490a2;
        font-size: 12px;
    }

    @@media (max-width: 950px) {

        .course-stats {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 750px) {

        .course-filter-panel {
            align-items: flex-start;
            flex-direction: column;
        }

        .page-header {
            align-items: stretch;
            flex-direction: column;
        }

        .create-course-button {
            align-self: flex-start;
        }

        .instructor-course-grid {
            grid-template-columns: 1fr;
        }

        .course-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 480px) {

        .course-stats {
            grid-template-columns: 1fr;
        }

        .course-meta-grid {
            grid-template-columns: 1fr;
        }

        .course-actions {
            flex-direction: column;
        }

        .course-action {
            width: 100%;
        }
    }

</style>


<div class="instructor-courses-page">

    <div class="instructor-courses-container">


        <div class="page-header">


            <div>


                <div class="page-eyebrow">
                    Không gian giảng viên
                </div>


                <h1 class="page-title">
                    Khóa học đang phụ trách
                </h1>


                <p class="page-description">

                    Theo dõi và quản lý các khóa học
                    thuộc tài khoản giảng viên của bạn.

                </p>


            </div>


            <a asp-controller="InstructorCourses"
               asp-action="Create"
               class="create-course-button">

                + Tạo khóa học mới

            </a>


        </div>



        <div class="course-stats">


            <a asp-controller="InstructorCourses"
               asp-action="Index"
               asp-route-status="all"
               asp-route-level="@currentLevel"
               class="course-stat filter-stat @(currentStatus == "all" ? "active" : "")">

                <div class="stat-label">
                    Tổng khóa học
                </div>

                <div class="stat-number">
                    @Model.TotalCourses
                </div>

                <div class="stat-hint">
                    Xem tất cả →
                </div>

            </a>


            <a asp-controller="InstructorCourses"
               asp-action="Index"
               asp-route-status="published"
               asp-route-level="@currentLevel"
               class="course-stat filter-stat published-filter @(currentStatus == "published" ? "active" : "")">

                <div class="stat-label">
                    Đã xuất bản
                </div>

                <div class="stat-number published">
                    @Model.PublishedCourses
                </div>

                <div class="stat-hint">
                    Lọc khóa đã xuất bản →
                </div>

            </a>


            <a asp-controller="InstructorCourses"
               asp-action="Index"
               asp-route-status="draft"
               asp-route-level="@currentLevel"
               class="course-stat filter-stat draft-filter @(currentStatus == "draft" ? "active" : "")">

                <div class="stat-label">
                    Bản nháp
                </div>

                <div class="stat-number draft">
                    @Model.DraftCourses
                </div>

                <div class="stat-hint">
                    Lọc khóa bản nháp →
                </div>

            </a>


            <div class="course-stat">

                <div class="stat-label">
                    Tổng bài học
                </div>

                <div class="stat-number">
                    @Model.TotalLessons
                </div>

            </div>


            <div class="course-stat">

                <div class="stat-label">
                    Lượt đăng ký
                </div>

                <div class="stat-number">
                    @Model.TotalEnrollments
                </div>

            </div>


        </div>


        <div class="course-filter-panel">

            <div class="course-filter-main">

                <div class="course-filter-title">
                    Trình độ
                </div>


                <a asp-controller="InstructorCourses"
                   asp-action="Index"
                   asp-route-status="@currentStatus"
                   asp-route-level="all"
                   class="level-filter-link @(currentLevel == "all" ? "active" : "")">

                    <span class="filter-dot">
                    </span>

                    Tất cả

                </a>


                <a asp-controller="InstructorCourses"
                   asp-action="Index"
                   asp-route-status="@currentStatus"
                   asp-route-level="beginner"
                   class="level-filter-link @(currentLevel == "beginner" ? "active" : "")">

                    <span class="filter-dot beginner">
                    </span>

                    Cơ bản

                </a>


                <a asp-controller="InstructorCourses"
                   asp-action="Index"
                   asp-route-status="@currentStatus"
                   asp-route-level="intermediate"
                   class="level-filter-link intermediate @(currentLevel == "intermediate" ? "active" : "")">

                    <span class="filter-dot intermediate">
                    </span>

                    Trung cấp

                </a>


                <a asp-controller="InstructorCourses"
                   asp-action="Index"
                   asp-route-status="@currentStatus"
                   asp-route-level="advanced"
                   class="level-filter-link advanced @(currentLevel == "advanced" ? "active" : "")">

                    <span class="filter-dot advanced">
                    </span>

                    Nâng cao

                </a>

            </div>


            @if (hasActiveFilter)
            {
                <a asp-controller="InstructorCourses"
                   asp-action="Index"
                   class="clear-filter-link">

                    Xóa bộ lọc

                </a>
            }

        </div>


        <div class="course-list-header">

            <h2 class="course-list-title">
                Danh sách khóa học
            </h2>

            <div class="course-list-count">
                @statusLabel · @levelLabel ·
                @Model.Courses.Count khóa học
            </div>

        </div>



        @if (Model.Courses.Any())
        {
            <div class="instructor-course-grid">


                @foreach (var course in Model.Courses)
                {
                    var levelClass =
                        GetLevelClass(course.Level);

                    var levelText =
                        GetLevelText(course.Level);


                    <article class="instructor-course-card">


                        <div class="course-color @levelClass">
                        </div>


                        <div class="course-card-body">


                            <div class="course-card-top">


                                <div class="course-category">

                                    <div class="course-category-icon">
                                        @course.CategoryIcon
                                    </div>

                                    <div class="course-category-name">
                                        @course.CategoryName
                                    </div>

                                </div>


                                @if (course.IsPublished)
                                {
                                    <span class="course-status published">
                                        Đã xuất bản
                                    </span>
                                }
                                else
                                {
                                    <span class="course-status draft">
                                        Bản nháp
                                    </span>
                                }


                            </div>


                            <h3 class="course-title">
                                @course.Title
                            </h3>


                            <div class="course-badges">

                                <span class="level-badge @levelClass">
                                    @levelText
                                </span>

                                <span class="price-badge">
                                    @course.Price.ToString("N0") đ
                                </span>

                            </div>


                            <div class="course-meta-grid">


                                <div class="course-meta">
                                    <div class="meta-number">
                                        @course.ModuleCount
                                    </div>
                                    <div class="meta-label">
                                        Module
                                    </div>
                                </div>


                                <div class="course-meta">
                                    <div class="meta-number">
                                        @course.LessonCount
                                    </div>
                                    <div class="meta-label">
                                        Bài học
                                    </div>
                                </div>


                                <div class="course-meta">
                                    <div class="meta-number">
                                        @course.EnrollmentCount
                                    </div>
                                    <div class="meta-label">
                                        Học viên
                                    </div>
                                </div>


                            </div>


                            <div class="course-updated">

                                Cập nhật:
                                @(course.UpdatedAt
                                    .ToLocalTime()
                                    .ToString("dd/MM/yyyy HH:mm"))

                            </div>


                            <div class="course-actions">


                                <a asp-controller="Courses"
                                   asp-action="Details"
                                   asp-route-slug="@course.Slug"
                                   class="course-action">

                                    Xem

                                </a>


                                <a asp-controller="InstructorCourses"
                                   asp-action="Edit"
                                   asp-route-id="@course.Id"
                                   class="course-action">

                                    Sửa thông tin

                                </a>


                                <a asp-controller="InstructorCourses"
                                   asp-action="Manage"
                                   asp-route-id="@course.Id"
                                   class="course-action primary">

                                    Quản lý nội dung

                                </a>


                            </div>


                        </div>


                    </article>
                }


            </div>
        }
        else
        {
            <div class="empty-courses">


                <div class="empty-icon">
                    KH
                </div>


                <div class="empty-title">

                    @if (hasActiveFilter)
                    {
                        <span>
                            Không có khóa học phù hợp
                        </span>
                    }
                    else
                    {
                        <span>
                            Chưa có khóa học
                        </span>
                    }

                </div>


                <div class="empty-description">

                    @if (hasActiveFilter)
                    {
                        <span>
                            Không có khóa học nào khớp
                            với trạng thái và trình độ đang chọn.
                        </span>
                    }
                    else
                    {
                        <span>
                            Bắt đầu bằng cách tạo
                            khóa học đầu tiên của bạn.
                        </span>
                    }

                </div>


                @if (hasActiveFilter)
                {
                    <a asp-controller="InstructorCourses"
                       asp-action="Index"
                       class="create-course-button">

                        Xóa bộ lọc

                    </a>
                }
                else
                {
                    <a asp-controller="InstructorCourses"
                       asp-action="Create"
                       class="create-course-button">

                        + Tạo khóa học mới

                    </a>
                }


            </div>
        }


    </div>

</div>