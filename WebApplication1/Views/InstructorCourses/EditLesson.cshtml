@model OnlineLearningPlatform.ViewModels.InstructorLessonEditViewModel

@{
    ViewData["Title"] = "Sửa bài học";
}

<style>

    .lesson-form-page {
        min-height: 80vh;
        padding: 45px 0 75px;
        background: #f8fafc;
    }

    .lesson-form-container {
        max-width: 850px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .back-link {
        display: inline-flex;
        margin-bottom: 20px;
        color: #697386;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
    }

    .back-link:hover {
        color: #7451d8;
    }

    .page-eyebrow {
        margin-bottom: 6px;
        color: #7451d8;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .page-title {
        margin: 0 0 8px;
        color: #172033;
        font-size: 30px;
        font-weight: 800;
    }

    .context-box {
        margin-bottom: 24px;
        padding: 12px 14px;
        border: 1px solid #e4dcfa;
        border-radius: 10px;
        background: #f9f6ff;
        color: #667085;
        font-size: 12px;
        line-height: 1.7;
    }

    .context-box strong {
        color: #344054;
    }

    .form-card {
        overflow: hidden;
        border: 1px solid #e1e7ee;
        border-radius: 15px;
        background: #ffffff;
    }

    .form-body {
        padding: 25px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        margin-bottom: 7px;
        color: #465164;
        font-size: 12px;
        font-weight: 700;
    }

    .form-control-edulearn {
        width: 100%;
        min-height: 44px;
        padding: 10px 12px;
        border: 1px solid #dce2ea;
        border-radius: 9px;
        background: #ffffff;
        color: #273142;
        font: inherit;
        font-size: 13px;
        outline: none;
    }

    .form-control-edulearn:focus {
        border-color: #aa99ec;
        box-shadow:
            0 0 0 3px
            rgba(116, 81, 216, .08);
    }

    textarea.form-control-edulearn {
        min-height: 180px;
        resize: vertical;
    }

    .form-grid {
        display: grid;
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .checkbox-box {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 14px;
        border: 1px solid #e1e7ee;
        border-radius: 10px;
        background: #fbfcfe;
    }

    .checkbox-box input {
        margin-top: 3px;
    }

    .checkbox-title {
        color: #344054;
        font-size: 12px;
        font-weight: 800;
    }

    .checkbox-description {
        margin-top: 3px;
        color: #8992a3;
        font-size: 10px;
    }

    .field-validation-error {
        display: block;
        margin-top: 5px;
        color: #dc3545;
        font-size: 11px;
        font-weight: 600;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 19px 25px;
        border-top: 1px solid #edf0f4;
        background: #fbfcfe;
    }

    .cancel-button,
    .save-button {
        min-height: 42px;
        padding: 0 18px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }

    .cancel-button {
        border: 1px solid #dce2ea;
        background: #ffffff;
        color: #667085;
    }

    .save-button {
        border: 1px solid #7451d8;
        background: #7451d8;
        color: #ffffff;
        cursor: pointer;
    }

    .save-button:hover {
        background: #6544c4;
    }

    @@media (max-width: 650px) {

        .form-grid {
            grid-template-columns: 1fr;
        }
    }

</style>


<div class="lesson-form-page">

    <div class="lesson-form-container">


        <a asp-controller="InstructorCourses"
           asp-action="Manage"
           asp-route-id="@Model.CourseId"
           class="back-link">

            ← Quay lại quản lý nội dung

        </a>


        <div class="page-eyebrow">
            Bài học
        </div>


        <h1 class="page-title">
            Sửa bài học
        </h1>


        <div class="context-box">

            Khóa học:
            <strong>@Model.CourseTitle</strong>

            <br />

            Module:
            <strong>@Model.ModuleTitle</strong>

        </div>


        <form asp-controller="InstructorCourses"
              asp-action="EditLesson"
              method="post">


            @Html.AntiForgeryToken()


            <input asp-for="Id"
                   type="hidden" />

            <input asp-for="ModuleId"
                   type="hidden" />


            <div asp-validation-summary="ModelOnly">
            </div>


            <div class="form-card">


                <div class="form-body">


                    <div class="form-group">


                        <label asp-for="Title"
                               class="form-label">

                            Tên bài học

                        </label>


                        <input asp-for="Title"
                               class="form-control-edulearn" />


                        <span asp-validation-for="Title">
                        </span>


                    </div>



                    <div class="form-group">


                        <label asp-for="Content"
                               class="form-label">

                            Nội dung bài học

                        </label>


                        <textarea asp-for="Content"
                                  class="form-control-edulearn"></textarea>


                    </div>



                    <div class="form-grid">


                        <div class="form-group">


                            <label asp-for="VideoUrl"
                                   class="form-label">

                                URL video

                            </label>


                            <input asp-for="VideoUrl"
                                   class="form-control-edulearn" />


                            <span asp-validation-for="VideoUrl">
                            </span>


                        </div>



                        <div class="form-group">


                            <label asp-for="Duration"
                                   class="form-label">

                                Thời lượng (phút)

                            </label>


                            <input asp-for="Duration"
                                   type="number"
                                   min="0"
                                   max="1440"
                                   class="form-control-edulearn" />


                            <span asp-validation-for="Duration">
                            </span>


                        </div>



                        <div class="form-group">


                            <label asp-for="DisplayOrder"
                                   class="form-label">

                                Thứ tự hiển thị

                            </label>


                            <input asp-for="DisplayOrder"
                                   type="number"
                                   min="1"
                                   class="form-control-edulearn" />


                            <span asp-validation-for="DisplayOrder">
                            </span>


                        </div>


                    </div>



                    <div class="checkbox-box">


                        <input asp-for="IsFree"
                               type="checkbox" />


                        <div>


                            <div class="checkbox-title">

                                Cho phép xem thử miễn phí

                            </div>


                            <div class="checkbox-description">

                                Đánh dấu nếu đây là bài học
                                có thể dùng làm nội dung xem thử.

                            </div>


                        </div>


                    </div>


                </div>



                <div class="form-actions">


                    <a asp-controller="InstructorCourses"
                       asp-action="Manage"
                       asp-route-id="@Model.CourseId"
                       class="cancel-button">

                        Hủy

                    </a>


                    <button type="submit"
                            class="save-button">

                        Lưu thay đổi

                    </button>


                </div>


            </div>


        </form>


    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}