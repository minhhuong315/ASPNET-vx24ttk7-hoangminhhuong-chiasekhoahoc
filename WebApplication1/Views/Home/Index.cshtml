@{
    ViewData["Title"] = "Trang chủ";

    bool isAuthenticated =
        User.Identity?.IsAuthenticated == true;

    bool isAdmin =
        isAuthenticated &&
        User.IsInRole("Admin");

    bool isInstructor =
        isAuthenticated &&
        User.IsInRole("Instructor") &&
        !isAdmin;

    bool isStudent =
        isAuthenticated &&
        User.IsInRole("Student") &&
        !isInstructor &&
        !isAdmin;
}

<style>
    .home-page {
        background: #ffffff;
    }

    .home-container {
        max-width: 1180px;
        margin: 0 auto;
        padding-left: 20px;
        padding-right: 20px;
    }


    /* =========================================
       GUEST HERO
    ========================================= */

    .guest-hero {
        padding: 66px 0 62px;
        background:
            linear-gradient(
                135deg,
                #f7fbff 0%,
                #edf5ff 58%,
                #ffffff 100%
            );
    }

    .guest-hero-grid {
        display: grid;
        grid-template-columns:
            minmax(0, 1.05fr)
            minmax(380px, .95fr);
        gap: 54px;
        align-items: center;
    }

    .guest-badge {
        display: inline-flex;
        margin-bottom: 18px;
        padding: 8px 14px;
        border-radius: 30px;
        background: #e8f1ff;
        color: #0d6efd;
        font-size: 12px;
        font-weight: 800;
    }

    .guest-title {
        max-width: 610px;
        margin: 0 0 20px;
        color: #172033;
        font-size: 48px;
        font-weight: 800;
        line-height: 1.15;
    }

    .guest-title span {
        color: #0d6efd;
    }

    .guest-description {
        max-width: 620px;
        margin: 0 0 27px;
        color: #667085;
        font-size: 16px;
        line-height: 1.75;
    }

    .guest-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 11px;
        margin-bottom: 27px;
    }

    .guest-primary,
    .guest-secondary {
        min-height: 46px;
        padding: 0 20px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
    }

    .guest-primary {
        background: #0d6efd;
        color: #ffffff;
    }

    .guest-secondary {
        border: 1px solid #d8dee8;
        background: #ffffff;
        color: #344054;
    }

    .guest-techs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .guest-tech {
        padding: 7px 11px;
        border: 1px solid #e1e6ed;
        border-radius: 20px;
        background: #ffffff;
        color: #667085;
        font-size: 10px;
        font-weight: 700;
    }


    /* =========================================
       GUEST COURSE LEVEL CARD
    ========================================= */

    .guest-course-box {
        padding: 22px;
        border: 1px solid #e3e8ef;
        border-radius: 20px;
        background: #ffffff;
        box-shadow:
            0 18px 48px
            rgba(38, 76, 140, .10);
    }

    .guest-course-box-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 17px;
    }

    .guest-course-box-title {
        color: #273142;
        font-size: 16px;
        font-weight: 800;
    }

    .guest-course-box-note {
        padding: 5px 9px;
        border-radius: 20px;
        background: #edfdf2;
        color: #198754;
        font-size: 9px;
        font-weight: 800;
    }

    .guest-level-list {
        display: grid;
        gap: 11px;
    }

    .guest-level-card {
        display: grid;
        grid-template-columns: 62px minmax(0, 1fr) auto;
        gap: 13px;
        align-items: center;
        padding: 14px;
        border: 1px solid #e7ebf2;
        border-radius: 12px;
        background: #ffffff;
        color: inherit;
        text-decoration: none;
        transition:
            transform .18s ease,
            border-color .18s ease,
            box-shadow .18s ease;
    }

    .guest-level-card:hover {
        transform: translateY(-2px);
        border-color: #b9d4ff;
        box-shadow:
            0 8px 20px
            rgba(13, 110, 253, .07);
    }

    .guest-level-icon {
        width: 62px;
        height: 58px;
        border-radius: 11px;
        background: #e8f1ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 800;
    }

    .guest-level-icon.intermediate {
        background: #f2edff;
        color: #6f42c1;
    }

    .guest-level-icon.advanced {
        background: #e5f8f5;
        color: #087f73;
    }

    .guest-level-title {
        margin-bottom: 4px;
        color: #273142;
        font-size: 12px;
        font-weight: 800;
    }

    .guest-level-description {
        color: #8992a3;
        font-size: 9px;
        line-height: 1.5;
    }

    .guest-level-arrow {
        color: #0d6efd;
        font-size: 13px;
        font-weight: 800;
    }


    /* =========================================
       HOME PUBLIC COMPONENT SHARED STYLE
    ========================================= */

    .stats-section {
        padding: 26px 0;
        border-bottom: 1px solid #eef1f5;
        background: #ffffff;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    .stat-item {
        padding: 10px;
        border-right: 1px solid #eceff3;
        text-align: center;
    }

    .stat-item:last-child {
        border-right: none;
    }

    .stat-number {
        color: #172033;
        font-size: 25px;
        font-weight: 800;
    }

    .stat-label {
        margin-top: 3px;
        color: #7a8494;
        font-size: 12px;
    }

    .home-section {
        padding: 64px 0;
    }

    .category-section {
        background: #f8fafc;
    }

    .section-header {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 25px;
    }

    .section-title {
        margin: 0;
        color: #172033;
        font-size: 27px;
        font-weight: 800;
    }

    .section-description {
        margin: 7px 0 0;
        color: #7a8494;
        font-size: 12px;
        line-height: 1.65;
    }

    .section-link {
        color: #0d6efd;
        font-size: 11px;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
    }

    .category-card {
        padding: 20px;
        border: 1px solid #e9edf3;
        border-radius: 14px;
        background: #ffffff;
        color: inherit;
        text-decoration: none;
        transition:
            transform .18s ease,
            border-color .18s ease,
            box-shadow .18s ease;
    }

    .category-card:hover {
        transform: translateY(-3px);
        border-color: #b9d4ff;
        box-shadow:
            0 10px 24px
            rgba(50, 80, 120, .07);
    }

    .category-icon {
        width: 42px;
        height: 42px;
        margin-bottom: 14px;
        border-radius: 11px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 800;
    }

    .category-name {
        margin-bottom: 4px;
        color: #273142;
        font-size: 12px;
        font-weight: 800;
    }

    .category-count {
        color: #8992a3;
        font-size: 9px;
    }

    .course-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    .course-card {
        display: block;
        overflow: hidden;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        background: #ffffff;
        color: inherit;
        text-decoration: none;
        transition:
            transform .18s ease,
            box-shadow .18s ease;
    }

    .course-card:hover {
        color: inherit;
        transform: translateY(-4px);
        box-shadow:
            0 13px 30px
            rgba(33, 52, 84, .09);
    }

    .course-thumbnail {
        height: 150px;
        padding: 18px;
        background:
            linear-gradient(
                135deg,
                #0f55c9,
                #488dff
            );
        color: #ffffff;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .course-thumbnail.purple {
        background:
            linear-gradient(
                135deg,
                #6246cc,
                #8c79e8
            );
    }

    .course-thumbnail.teal {
        background:
            linear-gradient(
                135deg,
                #087f8c,
                #2bb4b8
            );
    }

    .course-thumbnail.dark {
        background:
            linear-gradient(
                135deg,
                #222b3c,
                #4b5872
            );
    }

    .course-tech {
        font-size: 10px;
        font-weight: 800;
        opacity: .9;
    }

    .course-tech-logo {
        font-size: 27px;
        font-weight: 800;
    }

    .course-body {
        padding: 16px;
    }

    .course-level {
        display: inline-flex;
        padding: 4px 8px;
        border-radius: 20px;
        background: #edf4ff;
        color: #0d6efd;
        font-size: 9px;
        font-weight: 800;
    }

    .course-name {
        min-height: 42px;
        margin: 10px 0 7px;
        color: #202938;
        font-size: 13px;
        font-weight: 800;
        line-height: 1.5;
    }

    .course-instructor {
        margin-bottom: 11px;
        color: #8992a3;
        font-size: 9px;
    }

    .course-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        margin-top: 12px;
        padding-top: 11px;
        border-top: 1px solid #eef0f3;
    }

    .course-detail {
        color: #0d6efd;
        font-size: 9px;
        font-weight: 800;
    }


    /* =========================================
       GUEST CTA
    ========================================= */

    .guest-cta {
        padding: 0 0 68px;
        background: #ffffff;
    }

    .guest-cta-box {
        padding: 28px 30px;
        border-radius: 18px;
        background:
            linear-gradient(
                135deg,
                #0d6efd,
                #4d8df7
            );
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    .guest-cta-title {
        margin-bottom: 6px;
        font-size: 20px;
        font-weight: 800;
    }

    .guest-cta-text {
        margin: 0;
        opacity: .9;
        font-size: 11px;
    }

    .guest-cta-button {
        min-height: 42px;
        padding: 0 16px;
        border-radius: 8px;
        background: #ffffff;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
    }


    /* =========================================
       RESPONSIVE
    ========================================= */

    @@media (max-width: 980px) {
        .guest-hero-grid {
            grid-template-columns: 1fr;
        }

        .guest-course-box {
            max-width: 700px;
        }

        .category-grid,
        .course-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 680px) {
        .guest-title {
            font-size: 38px;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .stat-item {
            border-right: none;
            border-bottom: 1px solid #eceff3;
        }

        .category-grid,
        .course-grid {
            grid-template-columns: 1fr;
        }

        .guest-level-card {
            grid-template-columns: 54px minmax(0, 1fr) auto;
        }

        .guest-level-icon {
            width: 54px;
            height: 52px;
        }

        .guest-cta-box {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>


<div class="home-page">

    @if (!isAuthenticated)
    {
        <partial name="_GuestHomeModern" />
    }
    else if (isStudent)
    {
        @await Component.InvokeAsync(
            "StudentHomeDashboard")
    }
    else if (isInstructor)
    {
        @await Component.InvokeAsync(
            "InstructorHomeDashboard")
    }
    else if (isAdmin)
    {
        @await Component.InvokeAsync(
            "AdminHomeDashboard")
    }

</div>
