        padding: 15px;

        margin-bottom: 12px;

        border: 1px solid #edf0f5;

        border-radius: 14px;

        background: #ffffff;
    }

    .preview-thumb {
        min-height: 68px;

        border-radius: 12px;

        background: #e8f1ff;

        color: #0d6efd;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 15px;
        font-weight: 800;
    }

    .preview-thumb.purple {
        background: #f4edff;

        color: #7c3aed;
    }

    .preview-thumb.green {
        background: #eaf8ef;

        color: #198754;
    }

    .preview-course-title {
        margin-bottom: 8px;

        color: #273142;

        font-size: 14px;
        font-weight: 700;
    }

    .preview-description {
        color: #7a8494;

        font-size: 12px;
        line-height: 1.6;
    }

    .progress-track {
        height: 7px;

        border-radius: 20px;

        background: #edf1f6;

        overflow: hidden;
    }

    .progress-value {
        height: 100%;

        border-radius: 20px;

        background: #0d6efd;
    }

    .preview-meta {
        display: flex;
        justify-content: space-between;

        gap: 12px;

        margin-top: 7px;

        color: #7a8494;

        font-size: 11px;
    }

    .preview-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);

        gap: 10px;

        margin-top: 20px;
    }

    .summary-card {
        padding: 15px 10px;

        border-radius: 12px;

        background: #f8fafc;

        text-align: center;
    }

    .summary-number {
        color: #0d6efd;

        font-size: 18px;
        font-weight: 800;
    }

    .summary-number.word {
        font-size: 13px;
    }

    .summary-label {
        margin-top: 3px;

        color: #7a8494;

        font-size: 11px;
    }


    /* =========================================
       INSTRUCTOR HOME
    ========================================= */

    .instructor-section {
        padding: 65px 0 80px;

        background: #ffffff;
    }

    .role-section-header {
        margin-bottom: 28px;
    }

    .role-section-title {
        margin: 0;

        color: #172033;

        font-size: 30px;
        font-weight: 800;
    }

    .role-section-description {
        margin: 8px 0 0;

        color: #7a8494;

        line-height: 1.7;
    }

    .instructor-tool-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);

        gap: 18px;
    }

    .instructor-tool-card {
        padding: 25px;

        border: 1px solid #e8edf4;

        border-radius: 16px;

        background: #ffffff;

        transition: .2s ease;
    }

    .instructor-tool-card:hover {
        transform: translateY(-3px);

        border-color: #bfd5fb;

        box-shadow:
            0 12px 30px
            rgba(38, 76, 140, .08);
    }

    .instructor-tool-icon {
        width: 46px;
        height: 46px;

        margin-bottom: 17px;

        border-radius: 12px;

        background: #edf4ff;

        color: #0d6efd;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 13px;
        font-weight: 800;
    }

    .instructor-tool-icon.purple {
        background: #f5edff;

        color: #7c3aed;
    }

    .instructor-tool-icon.green {
        background: #eaf8ef;

        color: #198754;
    }

    .instructor-tool-title {
        margin-bottom: 8px;

        color: #273142;

        font-size: 16px;
        font-weight: 800;
    }

    .instructor-tool-description {
        margin: 0;

        color: #7a8494;

        font-size: 13px;
        line-height: 1.65;
    }


    /* =========================================
       ADMIN HOME
    ========================================= */

    .admin-section {
        padding: 65px 0 80px;

        background: #ffffff;
    }


    /* =========================================
       PUBLIC STATS
    ========================================= */

    .stats-section {
        padding: 28px 0;

        border-bottom: 1px solid #eef1f5;

        background: #ffffff;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    .stat-item {
        padding: 10px;

        border-right: 1px solid #eceff3;

        text-align: center;
    }

    .stat-item:last-child {
        border-right: none;
    }

    .stat-number {
        color: #172033;

        font-size: 25px;
        font-weight: 800;
    }

    .stat-label {
        margin-top: 3px;

        color: #7a8494;

        font-size: 13px;
    }


    /* =========================================
       COMMON PUBLIC SECTIONS
    ========================================= */

    .home-section {
        padding: 70px 0;
    }

    .section-header {
        display: flex;
        align-items: end;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 28px;
    }

    .section-title {
        margin: 0;

        color: #172033;

        font-size: 30px;
        font-weight: 800;
    }

    .section-description {
        margin: 8px 0 0;

        color: #7a8494;
    }

    .section-link {
        color: #0d6efd;

        font-size: 14px;
        font-weight: 700;

        text-decoration: none;
    }


    /* =========================================
       CATEGORIES
    ========================================= */

    .category-section {
        background: #f8fafc;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);

        gap: 16px;
    }

    .category-card {
        padding: 22px;

        border: 1px solid #e9edf3;

        border-radius: 15px;

        background: #ffffff;

        text-decoration: none;

        transition: .2s ease;
    }

    .category-card:hover {
        transform: translateY(-3px);

        border-color: #b9d4ff;

        box-shadow:
            0 10px 28px
            rgba(50, 80, 120, .08);
    }

    .category-icon {
        width: 44px;
        height: 44px;

        margin-bottom: 16px;

        border-radius: 12px;

        background: #eaf2ff;

        color: #0d6efd;

        display: flex;
        align-items: center;
        justify-content: center;

        font-weight: 800;
    }

    .category-name {
        margin-bottom: 5px;

        color: #273142;

        font-weight: 700;
    }

    .category-count {
        color: #8992a3;

        font-size: 13px;
    }


    /* =========================================
       FEATURED COURSES
    ========================================= */

    .course-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);

        gap: 20px;
    }

    .course-card {
        border: 1px solid #e8ebf0;

        border-radius: 16px;

        background: #ffffff;

        overflow: hidden;

        transition: .2s ease;
    }

    .course-card:hover {
        transform: translateY(-4px);

        box-shadow:
            0 14px 34px
            rgba(33, 52, 84, .1);
    }

    .course-thumbnail {
        height: 165px;

        padding: 22px;

        display: flex;
        flex-direction: column;
        justify-content: space-between;

        background:
            linear-gradient(
                135deg,
                #0f55c9,
                #488dff
            );

        color: #ffffff;
    }

    .course-thumbnail.dark {
        background:
            linear-gradient(
                135deg,
                #222b3c,
                #4b5872
            );
    }

    .course-thumbnail.purple {
        background:
            linear-gradient(
                135deg,
                #6246cc,
                #8c79e8
            );
    }

    .course-thumbnail.teal {
        background:
            linear-gradient(
                135deg,
                #087f8c,
                #2bb4b8
            );
    }

    .course-tech {
        font-size: 12px;
        font-weight: 700;

        opacity: .9;
    }

    .course-tech-logo {
        font-size: 30px;
        font-weight: 800;
    }

    .course-body {
        padding: 18px;
    }

    .course-level {
        padding: 4px 8px;

        border-radius: 20px;

        background: #edf4ff;
        color: #0d6efd;

        font-size: 11px;
        font-weight: 700;
    }

    .course-name {
        min-height: 46px;

        margin: 12px 0 8px;

        color: #202938;

        font-size: 16px;
        font-weight: 700;
        line-height: 1.45;
    }

    .course-instructor {
        margin-bottom: 12px;

        color: #8992a3;

        font-size: 12px;
    }

    .course-rating {
        color: #f59e0b;

        font-size: 13px;
        font-weight: 700;
    }

    .course-students {
        color: #8b95a5;

        font-size: 12px;
    }

    .course-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;

        margin-top: 14px;

        padding-top: 13px;

        border-top: 1px solid #eef0f3;
    }

    .course-price {
        color: #172033;

        font-weight: 800;
    }

    .course-detail {
        color: #0d6efd;

        font-size: 13px;
        font-weight: 700;

        text-decoration: none;
    }


    /* =========================================
       BENEFITS
    ========================================= */

    .benefit-section {
        background: #f8fafc;
    }

    .benefit-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);

        gap: 18px;
    }

    .benefit-card {
        padding: 25px;

        border: 1px solid #e9edf3;

        border-radius: 15px;

        background: #ffffff;
    }

    .benefit-number {
        width: 42px;
        height: 42px;

        margin-bottom: 16px;

        border-radius: 12px;

        background: #eaf2ff;
        color: #0d6efd;

        display: flex;
        align-items: center;
        justify-content: center;

        font-weight: 800;
    }

    .benefit-title {
        margin-bottom: 8px;

        color: #273142;

        font-weight: 700;
    }

    .benefit-description {
        margin: 0;

        color: #7c8696;

        font-size: 13px;
        line-height: 1.6;
    }


    /* =========================================
       CTA
    ========================================= */

    .cta-section {
        padding: 60px 0 80px;

        background: #ffffff;
    }

    .cta-box {
        padding: 48px;

        border-radius: 22px;

        background:
            linear-gradient(
                135deg,
                #0d6efd,
                #3d88ff
            );

        color: #ffffff;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 25px;
    }

    .cta-title {
        margin-bottom: 8px;

        font-size: 29px;
        font-weight: 800;
    }

    .cta-description {
        margin: 0;

        opacity: .9;
    }

    .cta-button {
        padding: 12px 22px;

        border-radius: 10px;

        background: #ffffff;
        color: #0d6efd;

        font-weight: 700;

        text-decoration: none;

        white-space: nowrap;
    }


    /* =========================================
       RESPONSIVE
    ========================================= */

    @@media (max-width: 991px) {

        .hero-wrapper {
            grid-template-columns: 1fr;
        }

        .hero-title {
            font-size: 40px;
        }

        .category-grid,
        .course-grid,
        .benefit-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .instructor-tool-grid {
            grid-template-columns: 1fr;
        }

    }


    @@media (max-width: 600px) {

        .hero-section {
            padding-top: 50px;
        }

        .hero-title {
            font-size: 34px;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .stat-item {
            border: none;

            border-bottom: 1px solid #edf0f3;
        }

        .category-grid,
        .course-grid,
        .benefit-grid {
            grid-template-columns: 1fr;
        }

        .section-header {
            align-items: start;

            flex-direction: column;
        }

        .preview-summary {
            grid-template-columns: 1fr;
        }

        .cta-box {
            padding: 32px 25px;

            flex-direction: column;

            align-items: start;
        }

    }

</style>


