@model OnlineLearningPlatform.ViewModels.HomeIndexViewModel

@{
    ViewData["Title"] = "Trang chủ";

    bool isAuthenticated =
        User.Identity?.IsAuthenticated == true;

    bool isAdmin =
        isAuthenticated &&
        User.IsInRole("Admin");

    bool isInstructor =
        isAuthenticated &&
        User.IsInRole("Instructor") &&
        !isAdmin;

    bool isStudent =
        isAuthenticated &&
        User.IsInRole("Student") &&
        !isInstructor &&
        !isAdmin;

    bool showLearningHome =
        !isAuthenticated || isStudent;
}

@functions {
    string GetCourseBadge(string title)
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            return "IT";
        }

        if (title.Contains(
            "ASP.NET",
            StringComparison.OrdinalIgnoreCase))
        {
            return ".NET";
        }

        if (title.Contains(
            "SQL",
            StringComparison.OrdinalIgnoreCase))
        {
            return "SQL";
        }

        if (title.Contains(
            "Git",
            StringComparison.OrdinalIgnoreCase))
        {
            return "Git";
        }

        if (title.Contains(
            "C#",
            StringComparison.OrdinalIgnoreCase))
        {
            return "C#";
        }

        if (title.Contains(
            "Python",
            StringComparison.OrdinalIgnoreCase))
        {
            return "PY";
        }

        return "IT";
    }
}

