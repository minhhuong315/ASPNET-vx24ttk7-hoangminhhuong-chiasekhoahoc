@{
    ViewData["Title"] = "Trang chủ";
}

<style>
    /* =========================
       HOME
    ========================= */

    .home-page {
        background: #ffffff;
    }

    .home-container {
        max-width: 1180px;
        margin: 0 auto;
        padding-left: 20px;
        padding-right: 20px;
    }

    /* =========================
       HERO
    ========================= */

    .hero-section {
        padding: 75px 0 55px;
        background:
            linear-gradient(
                135deg,
                #f7fbff 0%,
                #eef5ff 55%,
                #ffffff 100%
            );
    }

    .hero-wrapper {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 60px;
        align-items: center;
    }

    .hero-badge {
        display: inline-block;
        padding: 8px 14px;
        border-radius: 30px;
        background: #e8f1ff;
        color: #0d6efd;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .hero-title {
        font-size: 48px;
        line-height: 1.15;
        font-weight: 800;
        color: #172033;
        margin-bottom: 20px;
    }

    .hero-title span {
        color: #0d6efd;
    }

    .hero-description {
        font-size: 17px;
        line-height: 1.75;
        color: #667085;
        max-width: 600px;
        margin-bottom: 28px;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 30px;
    }

    .hero-primary,
    .hero-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 22px;
        border-radius: 10px;
        font-weight: 700;
        text-decoration: none;
    }

    .hero-primary {
        background: #0d6efd;
        color: #ffffff;
        border: 1px solid #0d6efd;
    }

    .hero-primary:hover {
        background: #0b5ed7;
        color: #ffffff;
    }

    .hero-secondary {
        background: #ffffff;
        color: #374151;
        border: 1px solid #d9dee7;
    }

    .hero-secondary:hover {
        color: #0d6efd;
        border-color: #9fc4ff;
    }

    .hero-techs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .hero-tech {
        font-size: 13px;
        font-weight: 600;
        color: #5f6b7a;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 30px;
        padding: 7px 12px;
    }

    /* =========================
       PLATFORM PREVIEW
    ========================= */

    .platform-preview {
        background: #ffffff;
        border: 1px solid #e7ebf2;
        border-radius: 22px;
        padding: 22px;
        box-shadow: 0 20px 60px rgba(38, 76, 140, 0.12);
    }

    .preview-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }

    .preview-title {
        font-size: 16px;
        font-weight: 700;
        color: #1f2937;
    }

    .preview-status {
        color: #16a34a;
        background: #edfdf2;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .preview-course {
        display: grid;
        grid-template-columns: 75px 1fr;
        gap: 15px;
        padding: 15px;
        margin-bottom: 12px;
        border: 1px solid #edf0f5;
        border-radius: 14px;
    }

    .preview-thumb {
        height: 68px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e8f1ff;
        color: #0d6efd;
        font-size: 16px;
        font-weight: 800;
    }

    .preview-course-title {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #273142;
    }

    .progress-track {
        height: 7px;
        background: #edf1f6;
        border-radius: 20px;
        overflow: hidden;
    }

    .progress-value {
        height: 100%;
        background: #0d6efd;
        border-radius: 20px;
    }

    .preview-meta {
        display: flex;
        justify-content: space-between;
        margin-top: 7px;
        color: #7a8494;
        font-size: 11px;
        gap: 12px;
    }

    .preview-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-top: 20px;
    }

    .summary-card {
        background: #f8fafc;
        border-radius: 12px;
        padding: 15px 10px;
        text-align: center;
    }

    .summary-number {
        color: #0d6efd;
        font-weight: 800;
        font-size: 18px;
    }

    .summary-label {
        color: #7a8494;
        font-size: 11px;
        margin-top: 3px;
    }

    /* =========================
       STATS
    ========================= */

    .stats-section {
        padding: 28px 0;
        background: #ffffff;
        border-bottom: 1px solid #eef1f5;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    .stat-item {
        text-align: center;
        padding: 10px;
        border-right: 1px solid #eceff3;
    }

    .stat-item:last-child {
        border-right: none;
    }

    .stat-number {
        font-size: 25px;
        color: #172033;
        font-weight: 800;
    }

    .stat-label {
        color: #7a8494;
        font-size: 13px;
        margin-top: 3px;
    }

    /* =========================
       COMMON
    ========================= */

    .home-section {
        padding: 70px 0;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 28px;
    }

    .section-title {
        margin: 0;
        color: #172033;
        font-size: 30px;
        font-weight: 800;
    }

    .section-description {
        color: #7a8494;
        margin-top: 8px;
        margin-bottom: 0;
    }

    .section-link {
        color: #0d6efd;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
    }

    /* =========================
       CATEGORIES
    ========================= */

    .category-section {
        background: #f8fafc;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .category-card {
        background: #ffffff;
        padding: 22px;
        border-radius: 15px;
        border: 1px solid #e9edf3;
        text-decoration: none;
        transition: 0.2s ease;
    }

    .category-card:hover {
        transform: translateY(-3px);
        border-color: #b9d4ff;
        box-shadow: 0 10px 28px rgba(50, 80, 120, 0.08);
    }

    .category-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        margin-bottom: 16px;
    }

    .category-name {
        color: #273142;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .category-count {
        color: #8992a3;
        font-size: 13px;
    }

    /* =========================
       COURSES
    ========================= */

    .course-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .course-card {
        background: #ffffff;
        border: 1px solid #e8ebf0;
        border-radius: 16px;
        overflow: hidden;
        transition: 0.2s ease;
    }

    .course-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 34px rgba(33, 52, 84, 0.1);
    }

    .course-thumbnail {
        height: 165px;
        padding: 22px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: linear-gradient(135deg, #0f55c9, #488dff);
        color: #ffffff;
    }

    .course-thumbnail.dark {
        background: linear-gradient(135deg, #222b3c, #4b5872);
    }

    .course-thumbnail.purple {
        background: linear-gradient(135deg, #6246cc, #8c79e8);
    }

    .course-thumbnail.teal {
        background: linear-gradient(135deg, #087f8c, #2bb4b8);
    }

    .course-tech {
        font-size: 12px;
        font-weight: 700;
        opacity: 0.9;
    }

    .course-tech-logo {
        font-size: 30px;
        font-weight: 800;
    }

    .course-body {
        padding: 18px;
    }

    .course-level {
        color: #0d6efd;
        background: #edf4ff;
        padding: 4px 8px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .course-name {
        color: #202938;
        font-size: 16px;
        font-weight: 700;
        line-height: 1.45;
        min-height: 46px;
        margin: 12px 0 8px;
    }

    .course-instructor {
        color: #8992a3;
        font-size: 12px;
        margin-bottom: 12px;
    }

    .course-rating {
        color: #f59e0b;
        font-size: 13px;
        font-weight: 700;
    }

    .course-students {
        color: #8b95a5;
        font-size: 12px;
    }

    .course-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 14px;
        padding-top: 13px;
        border-top: 1px solid #eef0f3;
    }

    .course-price {
        font-weight: 800;
        color: #172033;
    }

    .course-detail {
        color: #0d6efd;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

    /* =========================
       BENEFITS
    ========================= */

    .benefit-section {
        background: #f8fafc;
    }

    .benefit-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    .benefit-card {
        background: #ffffff;
        border-radius: 15px;
        border: 1px solid #e9edf3;
        padding: 25px;
    }

    .benefit-number {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        margin-bottom: 16px;
    }

    .benefit-title {
        font-weight: 700;
        color: #273142;
        margin-bottom: 8px;
    }

    .benefit-description {
        color: #7c8696;
        font-size: 13px;
        line-height: 1.6;
        margin: 0;
    }

    /* =========================
       CTA
    ========================= */

    .cta-section {
        padding: 60px 0 80px;
        background: #ffffff;
    }

    .cta-box {
        background: linear-gradient(135deg, #0d6efd, #3d88ff);
        border-radius: 22px;
        padding: 48px;
        color: #ffffff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
    }

    .cta-title {
        font-size: 29px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .cta-description {
        opacity: 0.9;
        margin: 0;
    }

    .cta-button {
        background: #ffffff;
        color: #0d6efd;
        border-radius: 10px;
        padding: 12px 22px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }

    /* =========================
       RESPONSIVE
    ========================= */

    @@media (max-width: 991px) {

        .hero-wrapper {
            grid-template-columns: 1fr;
        }

        .hero-title {
            font-size: 40px;
        }

        .category-grid,
        .course-grid,
        .benefit-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {

        .hero-section {
            padding-top: 50px;
        }

        .hero-title {
            font-size: 34px;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .stat-item {
            border: none;
            border-bottom: 1px solid #edf0f3;
        }

        .category-grid,
        .course-grid,
        .benefit-grid {
            grid-template-columns: 1fr;
        }

        .section-header {
            align-items: start;
            flex-direction: column;
        }

        .cta-box {
            padding: 32px 25px;
            flex-direction: column;
            align-items: start;
        }
    }
</style>


<div class="home-page">

    <!-- =========================
         HERO
    ========================== -->

    <section class="hero-section">
        <div class="home-container">

            <div class="hero-wrapper">

                <!-- BÊN TRÁI -->
                <div>

                    <div class="hero-badge">
                        Nền tảng học Công nghệ thông tin
                    </div>

                    <h1 class="hero-title">
                        Chia sẻ tri thức,<br />
                        <span>kiến tạo tương lai</span>
                    </h1>

                    <p class="hero-description">
                        EduLearn giúp bạn tiếp cận các khóa học Công nghệ thông tin
                        theo hướng thực tế, dễ học và có thể theo dõi tiến độ
                        trong suốt quá trình học tập.
                    </p>

                    <div class="hero-actions">

                        <a href="#featured-courses"
                           class="hero-primary">
                            Khám phá khóa học
                        </a>

                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <a asp-controller="Account"
                               asp-action="Register"
                               class="hero-secondary">
                                Bắt đầu học ngay
                            </a>
                        }
                        else
                        {
                            <a href="#featured-courses"
                               class="hero-secondary">
                                Tiếp tục học tập
                            </a>
                        }

                    </div>

                    <div class="hero-techs">
                        <span class="hero-tech">ASP.NET Core</span>
                        <span class="hero-tech">C#</span>
                        <span class="hero-tech">JavaScript</span>
                        <span class="hero-tech">Python</span>
                        <span class="hero-tech">SQL Server</span>
                        <span class="hero-tech">Git & GitHub</span>
                    </div>

                </div>


                <!-- BÊN PHẢI -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- ĐÃ ĐĂNG NHẬP -->
                    <div class="platform-preview">

                        <div class="preview-top">
                            <div class="preview-title">
                                Khóa học của tôi
                            </div>

                            <div class="preview-status">
                                Đang học
                            </div>
                        </div>

                        <div class="preview-course">

                            <div class="preview-thumb">
                                .NET
                            </div>

                            <div>
                                <div class="preview-course-title">
                                    Lập trình ASP.NET Core
                                </div>

                                <div class="progress-track">
                                    <div class="progress-value"
                                         style="width: 72%;">
                                    </div>
                                </div>

                                <div class="preview-meta">
                                    <span>Tiến độ</span>
                                    <span>72%</span>
                                </div>
                            </div>

                        </div>

                        <div class="preview-course">

                            <div class="preview-thumb">
                                SQL
                            </div>

                            <div>
                                <div class="preview-course-title">
                                    SQL Server thực chiến
                                </div>

                                <div class="progress-track">
                                    <div class="progress-value"
                                         style="width: 45%;">
                                    </div>
                                </div>

                                <div class="preview-meta">
                                    <span>Tiến độ</span>
                                    <span>45%</span>
                                </div>
                            </div>

                        </div>

                        <div class="preview-summary">

                            <div class="summary-card">
                                <div class="summary-number">5</div>
                                <div class="summary-label">
                                    Khóa học
                                </div>
                            </div>

                            <div class="summary-card">
                                <div class="summary-number">18</div>
                                <div class="summary-label">
                                    Bài đã học
                                </div>
                            </div>

                            <div class="summary-card">
                                <div class="summary-number">65%</div>
                                <div class="summary-label">
                                    Tiến độ
                                </div>
                            </div>

                        </div>

                    </div>
                }
                else
                {
                    <!-- CHƯA ĐĂNG NHẬP -->
                    <div class="platform-preview">

                        <div class="preview-top">
                            <div class="preview-title">
                                Khám phá lộ trình học CNTT
                            </div>

                            <div class="preview-status">
                                Bắt đầu
                            </div>
                        </div>

                        <div class="preview-course">

                            <div class="preview-thumb">
                                01
                            </div>

                            <div>
                                <div class="preview-course-title">
                                    Nền tảng lập trình
                                </div>

                                <div class="preview-meta">
                                    <span>C#, Python, JavaScript</span>
                                    <span>Cơ bản</span>
                                </div>
                            </div>

                        </div>

                        <div class="preview-course">

                            <div class="preview-thumb">
                                02
                            </div>

                            <div>
                                <div class="preview-course-title">
                                    Phát triển Web
                                </div>

                                <div class="preview-meta">
                                    <span>ASP.NET Core, HTML, CSS</span>
                                    <span>Thực hành</span>
                                </div>
                            </div>

                        </div>

                        <div class="preview-course">

                            <div class="preview-thumb">
                                03
                            </div>

                            <div>
                                <div class="preview-course-title">
                                    Cơ sở dữ liệu & Git
                                </div>

                                <div class="preview-meta">
                                    <span>SQL Server, GitHub</span>
                                    <span>Ứng dụng</span>
                                </div>
                            </div>

                        </div>

                        <div class="preview-summary">

                            <div class="summary-card">
                                <div class="summary-number">8+</div>
                                <div class="summary-label">
                                    Lĩnh vực
                                </div>
                            </div>

                            <div class="summary-card">
                                <div class="summary-number">100+</div>
                                <div class="summary-label">
                                    Khóa học
                                </div>
                            </div>

                            <div class="summary-card">
                                <div class="summary-number">24/7</div>
                                <div class="summary-label">
                                    Học trực tuyến
                                </div>
                            </div>

                        </div>

                    </div>
                }

            </div>
        </div>
    </section>


    <!-- =========================
         STATISTICS
    ========================== -->

    <section class="stats-section">

        <div class="home-container">

            <div class="stats-grid">

                <div class="stat-item">
                    <div class="stat-number">100+</div>
                    <div class="stat-label">Khóa học CNTT</div>
                </div>

                <div class="stat-item">
                    <div class="stat-number">1.000+</div>
                    <div class="stat-label">Học viên</div>
                </div>

                <div class="stat-item">
                    <div class="stat-number">20+</div>
                    <div class="stat-label">Giảng viên</div>
                </div>

                <div class="stat-item">
                    <div class="stat-number">4.8/5</div>
                    <div class="stat-label">Đánh giá trung bình</div>
                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         CATEGORIES
    ========================== -->

    <section class="home-section category-section">

        <div class="home-container">

            <div class="section-header">

                <div>
                    <h2 class="section-title">
                        Khám phá theo lĩnh vực
                    </h2>

                    <p class="section-description">
                        Lựa chọn lĩnh vực Công nghệ thông tin phù hợp với mục tiêu của bạn.
                    </p>
                </div>

            </div>


            <div class="category-grid">

                <a href="#" class="category-card">
                    <div class="category-icon">.NET</div>
                    <div class="category-name">ASP.NET Core</div>
                    <div class="category-count">18 khóa học</div>
                </a>

                <a href="#" class="category-card">
                    <div class="category-icon">WEB</div>
                    <div class="category-name">Lập trình Web</div>
                    <div class="category-count">24 khóa học</div>
                </a>

                <a href="#" class="category-card">
                    <div class="category-icon">DB</div>
                    <div class="category-name">Cơ sở dữ liệu</div>
                    <div class="category-count">15 khóa học</div>
                </a>

                <a href="#" class="category-card">
                    <div class="category-icon">PY</div>
                    <div class="category-name">Python</div>
                    <div class="category-count">20 khóa học</div>
                </a>

                <a href="#" class="category-card">
                    <div class="category-icon">JS</div>
                    <div class="category-name">Frontend</div>
                    <div class="category-count">17 khóa học</div>
                </a>

                <a href="#" class="category-card">
                    <div class="category-icon">UI</div>
                    <div class="category-name">UI/UX</div>
                    <div class="category-count">10 khóa học</div>
                </a>

                <a href="#" class="category-card">
                    <div class="category-icon">Git</div>
                    <div class="category-name">Git & DevOps</div>
                    <div class="category-count">12 khóa học</div>
                </a>

                <a href="#" class="category-card">
                    <div class="category-icon">C#</div>
                    <div class="category-name">Ngôn ngữ lập trình</div>
                    <div class="category-count">25 khóa học</div>
                </a>

            </div>

        </div>

    </section>


    <!-- =========================
         FEATURED COURSES
    ========================== -->

    <section class="home-section"
             id="featured-courses">

        <div class="home-container">

            <div class="section-header">

                <div>
                    <h2 class="section-title">
                        Khóa học nổi bật
                    </h2>

                    <p class="section-description">
                        Một số khóa học Công nghệ thông tin được quan tâm trên EduLearn.
                    </p>
                </div>

                <a href="#"
                   class="section-link">
                    Xem tất cả →
                </a>

            </div>


            <div class="course-grid">

                <!-- COURSE 1 -->
                <div class="course-card">

                    <div class="course-thumbnail">

                        <div class="course-tech">
                            ASP.NET CORE
                        </div>

                        <div class="course-tech-logo">
                            .NET
                        </div>

                    </div>

