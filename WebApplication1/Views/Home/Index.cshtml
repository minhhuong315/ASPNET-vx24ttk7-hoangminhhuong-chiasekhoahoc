                        </div>

                    </a>

                </div>

            </div>

        </section>



        <!-- =========================================
             BENEFITS
        ========================================== -->

        <section class="home-section benefit-section">

            <div class="home-container">

                <div class="section-header">

                    <div>

                        <h2 class="section-title">
                            Tại sao chọn EduLearn?
                        </h2>

                        <p class="section-description">

                            Học tập thuận tiện hơn với một nền tảng
                            được thiết kế dành cho người học
                            Công nghệ thông tin.

                        </p>

                    </div>

                </div>


                <div class="benefit-grid">

                    <div class="benefit-card">

                        <div class="benefit-number">
                            01
                        </div>

                        <div class="benefit-title">
                            Học theo tiến độ cá nhân
                        </div>

                        <p class="benefit-description">

                            Theo dõi từng bài học
                            và tiếp tục đúng vị trí
                            bạn đã dừng lại.

                        </p>

                    </div>


                    <div class="benefit-card">

                        <div class="benefit-number">
                            02
                        </div>

                        <div class="benefit-title">
                            Nội dung thực tế
                        </div>

                        <p class="benefit-description">

                            Các khóa học tập trung
                            vào kiến thức và kỹ năng
                            có thể áp dụng trong thực hành.

                        </p>

                    </div>


                    <div class="benefit-card">

                        <div class="benefit-number">
                            03
                        </div>

                        <div class="benefit-title">
                            Quản lý tiến độ
                        </div>

                        <p class="benefit-description">

                            Hệ thống ghi nhận bài học
                            hoàn thành và tổng hợp tiến độ
                            cho từng khóa học.

                        </p>

                    </div>


                    <div class="benefit-card">

                        <div class="benefit-number">
                            04
                        </div>

                        <div class="benefit-title">
                            Học mọi lúc, mọi nơi
                        </div>

                        <p class="benefit-description">

                            Giao diện responsive giúp bạn
                            truy cập EduLearn trên máy tính
                            hoặc thiết bị di động.

                        </p>

                    </div>

                </div>

            </div>

        </section>



        <!-- =========================================
             CTA GUEST
        ========================================== -->

        @if (!isAuthenticated)
        {
            <section class="cta-section">

                <div class="home-container">

                    <div class="cta-box">

                        <div>

                            <div class="cta-title">

                                Bắt đầu hành trình học tập
                                cùng EduLearn

                            </div>

                            <p class="cta-description">

                                Tạo tài khoản miễn phí
                                và khám phá các khóa học
                                Công nghệ thông tin phù hợp với bạn.

                            </p>

                        </div>

                        <a asp-controller="Account"
                           asp-action="Register"
                           class="cta-button">

                            Đăng ký ngay

                        </a>

                    </div>

                </div>

            </section>
        }

    }

</div>