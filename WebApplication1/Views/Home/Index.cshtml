@{
    ViewData["Title"] = "Trang chủ";

    bool isAuthenticated =
        User.Identity?.IsAuthenticated == true;

    bool isAdmin =
        isAuthenticated &&
        User.IsInRole("Admin");

    bool isInstructor =
        isAuthenticated &&
        User.IsInRole("Instructor") &&
        !isAdmin;

    bool isStudent =
        isAuthenticated &&
        User.IsInRole("Student") &&
        !isInstructor &&
        !isAdmin;

    bool showLearningHome =
        !isAuthenticated || isStudent;
}

<style>

    /* =========================================
       HOME
    ========================================= */

    .home-page {
        background: #ffffff;
    }

    .home-container {
        max-width: 1180px;
        margin: 0 auto;
        padding-left: 20px;
        padding-right: 20px;
    }


    /* =========================================
       HERO
    ========================================= */

    .hero-section {
        padding: 72px 0 58px;

        background:
            linear-gradient(
                135deg,
                #f7fbff 0%,
                #eef5ff 55%,
                #ffffff 100%
            );
    }

    .hero-wrapper {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 58px;
        align-items: center;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;

        padding: 8px 14px;

        border-radius: 30px;

        background: #e8f1ff;
        color: #0d6efd;

        font-size: 13px;
        font-weight: 700;

        margin-bottom: 18px;
    }

    .hero-title {
        margin: 0 0 20px;

        color: #172033;

        font-size: 48px;
        line-height: 1.15;

        font-weight: 800;
    }

    .hero-title span {
        color: #0d6efd;
    }

    .hero-description {
        max-width: 600px;

        margin: 0 0 28px;

        color: #667085;

        font-size: 17px;
        line-height: 1.75;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;

        gap: 12px;

        margin-bottom: 30px;
    }

    .hero-primary,
    .hero-secondary {
        min-height: 48px;

        padding: 0 22px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;

        font-weight: 700;

        text-decoration: none;

        transition: .2s ease;
    }

    .hero-primary {
        border: 1px solid #0d6efd;

        background: #0d6efd;

        color: #ffffff;
    }

    .hero-primary:hover {
        background: #0b5ed7;

        color: #ffffff;
    }

    .hero-secondary {
        border: 1px solid #d9dee7;

        background: #ffffff;

        color: #374151;
    }

    .hero-secondary:hover {
        border-color: #9fc4ff;

        color: #0d6efd;
    }

    .hero-techs {
        display: flex;
        flex-wrap: wrap;

        gap: 8px;
    }

    .hero-tech {
        padding: 7px 12px;

        border: 1px solid #e5e7eb;

        border-radius: 30px;

        background: #ffffff;

        color: #5f6b7a;

        font-size: 13px;
        font-weight: 600;
    }


    /* =========================================
       PREVIEW CARD
    ========================================= */

    .platform-preview {
        padding: 22px;

        border: 1px solid #e7ebf2;

        border-radius: 22px;

        background: #ffffff;

        box-shadow:
            0 20px 60px
            rgba(38, 76, 140, .12);
    }

    .preview-top {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 15px;

        margin-bottom: 22px;
    }

    .preview-title {
        color: #1f2937;

        font-size: 17px;
        font-weight: 800;
    }

    .preview-status {
        padding: 5px 10px;

        border-radius: 20px;

        background: #edfdf2;

        color: #16a34a;

        font-size: 12px;
        font-weight: 700;

        white-space: nowrap;
    }

    .preview-status.blue {
        background: #edf4ff;

        color: #0d6efd;
    }

    .preview-status.purple {
        background: #f5edff;

        color: #7c3aed;
    }

    .preview-course {
        display: grid;
        grid-template-columns: 75px 1fr;

