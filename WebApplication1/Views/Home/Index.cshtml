                                <div class="preview-title">
                                    Khóa học của tôi
                                </div>


                                @if (Model.RegisteredCourseCount > 0)
                                {
                                    <div class="preview-status">
                                        Đang học
                                    </div>
                                }
                                else
                                {
                                    <div class="preview-status blue">
                                        Chưa có khóa học
                                    </div>
                                }

                            </div>


                            @if (Model.StudentCourses.Any())
                            {
                                @foreach (var course in Model.StudentCourses)
                                {
                                    string? courseUrl;

                                    if (course.ContinueLessonId.HasValue)
                                    {
                                        courseUrl =
                                            Url.Action(
                                                "Learn",
                                                "Courses",
                                                new
                                                {
                                                    courseId =
                                                        course.CourseId,

                                                    lessonId =
                                                        course.ContinueLessonId.Value
                                                });
                                    }
                                    else
                                    {
                                        courseUrl =
                                            Url.Action(
                                                "Details",
                                                "Courses",
                                                new
                                                {
                                                    slug =
                                                        course.Slug
                                                });
                                    }


                                    var progressWidth =
                                        $"{course.Progress:0}%";


                                    string progressState;

                                    if (course.Progress >= 100)
                                    {
                                        progressState =
                                            "Xem lại khóa học";
                                    }
                                    else if (course.Progress > 0)
                                    {
                                        progressState =
                                            "Tiếp tục học";
                                    }
                                    else
                                    {
                                        progressState =
                                            "Học ngay";
                                    }


                                    <a href="@courseUrl"
                                       class="preview-course preview-course-link">

                                        <div class="preview-thumb">

                                            @GetCourseBadge(
                                                course.Title)

                                        </div>


                                        <div>

                                            <div class="preview-course-title">

                                                @course.Title

                                            </div>


                                            <div class="progress-track">

                                                <div class="progress-value"
                                                     style="width:@progressWidth">
                                                </div>

                                            </div>


                                            <div class="preview-meta">

                                                <span>

                                                    @course.CompletedLessonCount /
                                                    @course.TotalLessonCount bài

                                                </span>


                                                <span>

                                                    @course.Progress.ToString("0")%

                                                </span>

                                            </div>


                                            <div class="preview-meta">

                                                <span>
                                                    Tiến độ
                                                </span>


                                                <span class="preview-course-state">

                                                    @progressState →

                                                </span>

                                            </div>

                                        </div>

                                    </a>
                                }


                                <div class="preview-summary">

                                    <div class="summary-card">

                                        <div class="summary-number">

