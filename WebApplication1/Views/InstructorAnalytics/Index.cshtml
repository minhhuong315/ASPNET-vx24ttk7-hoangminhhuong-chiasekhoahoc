@model OnlineLearningPlatform.ViewModels.InstructorAnalyticsViewModel

@{
    ViewData["Title"] = "Phân tích khóa học";

    string overallRating =
        Model.AverageRating > 0
            ? Model.AverageRating.ToString("0.0")
            : "—";
}

<style>
    .analytics-page {
        min-height: 80vh;
        padding: 46px 0 78px;
        background: #f8fafc;
    }

    .analytics-container {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .page-header {
        margin-bottom: 23px;
    }

    .page-eyebrow {
        margin-bottom: 6px;
        color: #0d6efd;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .page-title {
        margin: 0 0 7px;
        color: #172033;
        font-size: 31px;
        font-weight: 800;
    }

    .page-description {
        margin: 0;
        color: #7d8798;
        font-size: 12px;
        line-height: 1.7;
    }

    .stats-grid {
        display: grid;
        grid-template-columns:
            repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .stat-card {
        padding: 17px;
        border: 1px solid #e1e7ee;
        border-radius: 12px;
        background: #ffffff;
    }

    .stat-label {
        color: #8a94a5;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .stat-value {
        margin-top: 6px;
        color: #273142;
        font-size: 23px;
        font-weight: 800;
    }

    .stat-note {
        margin-top: 4px;
        color: #98a2b3;
        font-size: 9px;
        line-height: 1.5;
    }

    .analytics-card {
        overflow: hidden;
        border: 1px solid #e1e7ee;
        border-radius: 14px;
        background: #ffffff;
    }

    .card-header {
        padding: 17px 19px;
        border-bottom: 1px solid #edf0f4;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .card-title {
        margin: 0;
        color: #344054;
        font-size: 14px;
        font-weight: 800;
    }

    .card-note {
        color: #98a2b3;
        font-size: 9px;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .analytics-table {
        width: 100%;
        min-width: 1040px;
        border-collapse: collapse;
    }

    .analytics-table th {
        padding: 11px 13px;
        border-bottom: 1px solid #edf0f4;
        background: #fbfcfd;
        color: #7d8798;
        font-size: 9px;
        font-weight: 800;
        text-align: left;
        text-transform: uppercase;
    }

    .analytics-table td {
        padding: 14px 13px;
        border-bottom: 1px solid #f0f2f5;
        color: #475467;
        font-size: 10px;
        vertical-align: middle;
    }

    .analytics-table tr:last-child td {
        border-bottom: none;
    }

    .course-name {
        max-width: 250px;
        color: #344054;
        font-size: 11px;
        font-weight: 800;
        line-height: 1.45;
    }

    .course-meta {
        margin-top: 3px;
        color: #98a2b3;
        font-size: 9px;
    }

    .status-badge {
        display: inline-flex;
        padding: 5px 8px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 800;
    }

    .status-badge.published {
        background: #edf8f1;
        color: #198754;
    }

    .status-badge.draft {
        background: #f3f4f6;
        color: #697386;
    }

    .progress-block {
        min-width: 150px;
    }

    .progress-top {
        margin-bottom: 5px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .progress-label {
        color: #7d8798;
        font-size: 9px;
    }

    .progress-percent {
        color: #344054;
        font-size: 9px;
        font-weight: 800;
    }

    .progress-track {
        height: 6px;
        border-radius: 10px;
        background: #edf0f4;
        overflow: hidden;
    }

    .progress-value {
        height: 100%;
        border-radius: 10px;
        background: #0d6efd;
    }

    .view-link {
        color: #0d6efd;
        font-size: 9px;
        font-weight: 800;
        text-decoration: none;
    }

    .empty-state {
        padding: 48px 20px;
        color: #8992a3;
        font-size: 10px;
        line-height: 1.7;
        text-align: center;
    }

    .empty-title {
        margin-bottom: 5px;
        color: #475467;
        font-size: 14px;
        font-weight: 800;
    }

    @@media (max-width: 900px) {
        .stats-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 560px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="analytics-page">
    <div class="analytics-container">

        <div class="page-header">

            <div class="page-eyebrow">
                Không gian giảng viên
            </div>

            <h1 class="page-title">
                Phân tích khóa học
            </h1>

            <p class="page-description">
                Theo dõi mức độ tham gia,
                tiến độ hoàn thành và đánh giá
                của các khóa học bạn phụ trách.
            </p>

        </div>


        <div class="stats-grid">

            <div class="stat-card">
                <div class="stat-label">
                    Khóa học
                </div>

                <div class="stat-value">
                    @Model.TotalCourses
                </div>

                <div class="stat-note">
                    @Model.PublishedCourses đã xuất bản
                    · @Model.DraftCourses bản nháp
                </div>
            </div>


            <div class="stat-card">
                <div class="stat-label">
                    Học viên
                </div>

                <div class="stat-value">
                    @Model.UniqueStudents
                </div>

                <div class="stat-note">
                    @Model.TotalEnrollments lượt đăng ký
                </div>
            </div>


            <div class="stat-card">
                <div class="stat-label">
                    Tiến độ trung bình
                </div>

                <div class="stat-value">
                    @(Model.AverageProgress.ToString("0.#"))%
                </div>

                <div class="stat-note">
                    @Model.CompletedEnrollments lượt đã hoàn thành
                    · @(Model.CompletionRate.ToString("0.#"))%
                </div>
            </div>


            <div class="stat-card">
                <div class="stat-label">
                    Đánh giá
                </div>

                <div class="stat-value">
                    @overallRating
                </div>

                <div class="stat-note">
                    @Model.TotalReviews review đã duyệt
                </div>
            </div>

        </div>


        <section class="analytics-card">

            <div class="card-header">

                <h2 class="card-title">
                    Hiệu quả theo từng khóa học
                </h2>

                <div class="card-note">
                    Dữ liệu tính trực tiếp từ tiến độ học tập
                </div>

            </div>


            @if (Model.Courses.Any())
            {
                <div class="table-wrap">

                    <table class="analytics-table">

                        <thead>
                            <tr>
                                <th>Khóa học</th>
                                <th>Trạng thái</th>
                                <th>Bài học</th>
                                <th>Học viên</th>
                                <th>Tiến độ TB</th>
                                <th>Hoàn thành</th>
                                <th>Đánh giá</th>
                                <th>Cập nhật</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var course in Model.Courses)
                            {
                                string ratingText =
                                    course.AverageRating > 0
                                        ? course.AverageRating
                                            .ToString("0.0")
                                        : "—";


                                <tr>

                                    <td>
                                        <div class="course-name">
                                            @course.Title
                                        </div>

                                        @if (course.IsFeatured)
                                        {
                                            <div class="course-meta">
                                                Khóa học nổi bật
                                            </div>
                                        }
                                    </td>


                                    <td>
                                        <span class="status-badge @(course.IsPublished ? "published" : "draft")">
                                            @(course.IsPublished
                                                ? "Đã xuất bản"
                                                : "Bản nháp")
                                        </span>
                                    </td>


                                    <td>
                                        @course.TotalLessons
                                    </td>


                                    <td>
                                        @course.EnrollmentCount
                                    </td>


                                    <td>

                                        <div class="progress-block">

                                            <div class="progress-top">

                                                <span class="progress-label">
                                                    Trung bình
                                                </span>

                                                <span class="progress-percent">
                                                    @(course.AverageProgress.ToString("0.#"))%
                                                </span>

                                            </div>

                                            <div class="progress-track">

                                                <div class="progress-value"
                                                     style="width: @(course.AverageProgress.ToString(System.Globalization.CultureInfo.InvariantCulture))%;">
                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <td>
                                        @course.CompletedStudents
                                        / @course.EnrollmentCount
                                    </td>


                                    <td>
                                        @ratingText
                                        <span class="course-meta">
                                            (@course.ReviewCount)
                                        </span>
                                    </td>


                                    <td>
                                        @(course.UpdatedAt
                                            .ToLocalTime()
                                            .ToString("dd/MM/yyyy"))
                                    </td>


                                    <td>
                                        @if (course.IsPublished)
                                        {
                                            <a asp-controller="Courses"
                                               asp-action="Details"
                                               asp-route-slug="@course.Slug"
                                               class="view-link">
                                                Xem →
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="InstructorCourses"
                                               asp-action="Manage"
                                               asp-route-id="@course.Id"
                                               class="view-link">
                                                Quản lý →
                                            </a>
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-title">
                        Chưa có dữ liệu phân tích
                    </div>

                    Hãy tạo khóa học trước
                    để EduLearn bắt đầu tổng hợp số liệu.

                </div>
            }

        </section>

    </div>
</div>
