@model OnlineLearningPlatform.Models.Course

@{
    ViewData["Title"] = Model.Title;

    var approvedReviews =
        Model.Reviews?.ToList()
        ?? new List<OnlineLearningPlatform.Models.Review>();

    var averageRating =
        approvedReviews.Any()
            ? approvedReviews.Average(r => r.Rating)
            : 0;

    var totalLessons =
        Model.Modules?.Sum(m => m.Lessons.Count) ?? 0;

    bool isEnrolled =
        ViewBag.IsEnrolled != null &&
        (bool)ViewBag.IsEnrolled;

    decimal enrollmentProgress = 0m;

    if (ViewBag.EnrollmentProgress != null)
    {
        enrollmentProgress =
            Math.Clamp(
                Convert.ToDecimal(
                    ViewBag.EnrollmentProgress),
                0m,
                100m);
    }

    bool isAuthenticated =
        User.Identity?.IsAuthenticated == true;

    bool isStudent =
        isAuthenticated &&
        User.IsInRole("Student");

    bool isWishlisted =
        ViewBag.IsWishlisted != null &&
        (bool)ViewBag.IsWishlisted;

    var currentUserReview =
        ViewBag.CurrentUserReview
            as OnlineLearningPlatform.Models.Review;

    bool isAdmin =
        isAuthenticated &&
        User.IsInRole("Admin");

    bool isInstructor =
        isAuthenticated &&
        User.IsInRole("Instructor");

    string? successMessage =
        TempData["SuccessMessage"]?.ToString();

    string? infoMessage =
        TempData["InfoMessage"]?.ToString();

    string? wishlistSuccessMessage =
        TempData["WishlistSuccess"]?.ToString();

    string? wishlistInfoMessage =
        TempData["WishlistInfo"]?.ToString();

    string? reviewSuccessMessage =
        TempData["ReviewSuccess"]?.ToString();

    string? reviewInfoMessage =
        TempData["ReviewInfo"]?.ToString();

    string? reviewErrorMessage =
        TempData["ReviewError"]?.ToString();

    string? toastMessage =
        successMessage ??
        wishlistSuccessMessage ??
        reviewSuccessMessage ??
        reviewErrorMessage ??
        infoMessage ??
        wishlistInfoMessage ??
        reviewInfoMessage;

    bool toastIsSuccess =
        !string.IsNullOrWhiteSpace(successMessage) ||
        !string.IsNullOrWhiteSpace(wishlistSuccessMessage) ||
        !string.IsNullOrWhiteSpace(reviewSuccessMessage);

    bool toastIsError =
        !string.IsNullOrWhiteSpace(reviewErrorMessage);

    string levelText =
        Model.Level switch
        {
            "Beginner" => "Cơ bản",
            "Intermediate" => "Trung cấp",
            "Advanced" => "Nâng cao",
            _ => Model.Level
        };

    decimal effectivePrice =
        Model.DiscountPrice.HasValue &&
        Model.DiscountPrice.Value < Model.Price
            ? Model.DiscountPrice.Value
            : Model.Price;

    bool hasDiscount =
        effectivePrice < Model.Price;

    var viCulture =
        System.Globalization.CultureInfo
            .GetCultureInfo("vi-VN");

    string sharedThumbnail =
        Url.Content(
            $"~/images/course-thumbnails/by-slug/{Model.Slug}.png");

    string placeholderThumbnail =
        Url.Content(
            "~/images/course-thumbnails/by-slug/course-placeholder.svg");

    string thumbnailUrl =
        string.IsNullOrWhiteSpace(
            Model.ThumbnailUrl)
            ? sharedThumbnail
            : Url.Content(
                Model.ThumbnailUrl);
}

<link rel="stylesheet"
      href="~/css/course-details.css"
      asp-append-version="true" />


<div class="details-page">

    <!-- =========================
         HERO
    ========================= -->

    <section class="course-hero">

        <div class="details-container">

            <div class="course-hero-grid">

                <!-- THÔNG TIN KHÓA HỌC -->

                <div>

                    <div class="breadcrumb-text">

                        <a asp-controller="Home"
                           asp-action="Index">
                            Trang chủ
                        </a>

                        /

                        <a asp-controller="Courses"
                           asp-action="Index">
                            Khóa học
                        </a>

                        / @Model.Title

                    </div>


                    <div class="course-category-badge">
                        @Model.Category.Name
                    </div>


                    <div class="details-main-title"
                         role="heading"
                         aria-level="1">
                        @Model.Title
                    </div>


                    <p class="details-short-description">
                        @Model.ShortDescription
                    </p>


                    <div class="course-meta">

                        <span>
                            Giảng viên:
                            <strong>
                                @Model.Instructor.FullName
                            </strong>
                        </span>

                        <span>
                            Cấp độ:
                            <strong>
                                @levelText
                            </strong>
                        </span>

                        <span>
                            @Model.ViewCount lượt xem
                        </span>


                        @if (approvedReviews.Any())
                        {
                            <span>
                                ★ @averageRating.ToString("0.0")
                                (@approvedReviews.Count đánh giá)
                            </span>
                        }
                        else
                        {
                            <span>☆ Chưa có đánh giá</span>
                        }

                    </div>

                </div>


                <!-- CARD BÊN PHẢI -->

                <div class="hero-card">

                    <div class="hero-thumbnail">

                        <img src="@thumbnailUrl"
                             alt="@Model.Title"
                             data-course-details-thumbnail
                             data-fallback="@sharedThumbnail"
                             data-placeholder="@placeholderThumbnail" />

                    </div>


                    <div class="course-price-row">

                        <div class="course-price">
                            @effectivePrice.ToString(
                                "N0",
                                viCulture)đ
                        </div>

                        @if (hasDiscount)
                        {
                            <div class="course-old-price">
                                @Model.Price.ToString(
                                    "N0",
                                    viCulture)đ
                            </div>
                        }

                    </div>


                    <!-- CHƯA ĐĂNG NHẬP -->

                    @if (!isAuthenticated)
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                           class="enroll-button">

                            Đăng nhập để đăng ký

                        </a>
                    }


                    <!-- STUDENT CHƯA ĐĂNG KÝ -->

                    @if (isStudent && !isEnrolled)
                    {
                        <form asp-controller="Courses"
                              asp-action="Enroll"
                              method="post">

                            <input type="hidden"
                                   name="courseId"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="enroll-button">

                                Đăng ký khóa học

                            </button>

                        </form>
                    }


                    <!-- STUDENT ĐÃ ĐĂNG KÝ -->

                    @if (isStudent && isEnrolled)
                    {
                        @if (enrollmentProgress >= 100)
                        {
                            <div class="enrolled-status">
                                ✓ Đã hoàn thành khóa học
                            </div>
                        }

                        @if (enrollmentProgress < 100)
                        {
                            <div class="enrolled-status">
                                ✓ Đã đăng ký khóa học
                            </div>
                        }


                        <div class="learning-progress">

                            <div class="progress-heading">

                                <span class="progress-label">
                                    Tiến độ học tập
                                </span>

                                <span class="progress-percent">
                                    @enrollmentProgress.ToString("0")%
                                </span>

                            </div>


                            <div class="progress-track">

                                <div class="progress-value"
                                     style="width: @enrollmentProgress.ToString("0")%;">
                                </div>

                            </div>


                            @if (enrollmentProgress >= 100)
                            {
                                <div class="progress-extra">
                                    Bạn đã hoàn thành khóa học này.
                                </div>
                            }

                            @if (enrollmentProgress > 0 &&
                                 enrollmentProgress < 100)
                            {
                                <div class="progress-extra">
                                    Tiếp tục quá trình học tập của bạn.
                                </div>
                            }

                            @if (enrollmentProgress == 0)
                            {
                                <div class="progress-extra">
                                    Bạn chưa bắt đầu bài học nào.
                                </div>
                            }

                        </div>


                        @if (enrollmentProgress >= 100)
                        {
                            <a asp-controller="Courses"
                               asp-action="Learn"
                               asp-route-courseId="@Model.Id"
                               class="learn-button">

                                Xem lại khóa học

                            </a>
                        }


                        @if (enrollmentProgress > 0 &&
                             enrollmentProgress < 100)
                        {
                            <a asp-controller="Courses"
                               asp-action="Learn"
                               asp-route-courseId="@Model.Id"
                               class="learn-button">

                                Tiếp tục học

                            </a>
                        }


                        @if (enrollmentProgress == 0)
                        {
                            <a asp-controller="Courses"
                               asp-action="Learn"
                               asp-route-courseId="@Model.Id"
                               class="learn-button">

                                Học ngay

                            </a>
                        }
                    }


                    <!-- YÊU THÍCH -->

                    @if (isStudent)
                    {
                        if (!isWishlisted)
                        {
                            <form asp-controller="Wishlist"
                                  asp-action="Add"
                                  method="post"
                                  class="wishlist-form">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="courseId"
                                       value="@Model.Id" />

                                <input type="hidden"
                                       name="slug"
                                       value="@Model.Slug" />

                                <button type="submit"
                                        class="wishlist-button">
                                    ♡ Thêm vào yêu thích
                                </button>

                            </form>
                        }
                        else
                        {
                            <form asp-controller="Wishlist"
                                  asp-action="Remove"
                                  method="post"
                                  class="wishlist-form">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="courseId"
                                       value="@Model.Id" />

                                <input type="hidden"
                                       name="slug"
                                       value="@Model.Slug" />

                                <input type="hidden"
                                       name="returnToDetails"
                                       value="true" />

                                <button type="submit"
                                        class="wishlist-button saved">
                                    ♥ Đã yêu thích · Bỏ lưu
                                </button>

                            </form>
                        }
                    }


                    <!-- ADMIN -->

                    @if (isAdmin)
                    {
                        <div class="role-note">
                            Bạn đang đăng nhập với quyền Quản trị viên.
                        </div>
                    }


                    <!-- INSTRUCTOR -->

                    @if (isInstructor)
                    {
                        <div class="role-note">
                            Bạn đang đăng nhập với quyền Giảng viên.
                        </div>
                    }

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         NỘI DUNG
    ========================= -->

    <section class="course-content"
             id="course-content">

        <div class="details-container">

            <div class="content-layout">

                <div>

                    <!-- GIỚI THIỆU -->

                    <div class="content-card">

                        <div class="details-section-title"
                             role="heading"
                             aria-level="2">
                            Giới thiệu khóa học
                        </div>

                        <div class="details-description-text">
                            @Model.Description
                        </div>

                    </div>


                    <!-- MODULE / LESSON -->

                    <div class="content-card curriculum-section">

                        <div class="details-section-title"
                             role="heading"
                             aria-level="2">
                            Nội dung khóa học
                        </div>

                        @if (Model.Modules != null &&
                             Model.Modules.Any())
                        {
                            var firstModule = true;

                            foreach (var module in
                                Model.Modules.OrderBy(m => m.DisplayOrder))
                            {
                                var chapterLessons = module.Lessons
                                    .OrderBy(l => l.DisplayOrder)
                                    .ToList();
                                var chapterMinutes = chapterLessons
                                    .Sum(l => l.Duration);

                                <details class="curriculum-module" open="@(firstModule ? "open" : null)">
                                    <summary class="curriculum-module__header">
                                        <span class="curriculum-module__title">
                                            @module.Title
                                        </span>

                                        <span class="curriculum-module__meta">
                                            <span>@chapterLessons.Count bài học</span>
                                            <span aria-hidden="true">·</span>
                                            <span>@chapterMinutes phút</span>
                                        </span>

                                        <span class="curriculum-module__chevron" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round"
                                                 focusable="false">
                                                <path d="m6 9 6 6 6-6" />
                                            </svg>
                                        </span>
                                    </summary>

                                    <div class="curriculum-lessons">
                                        @if (chapterLessons.Any())
                                        {
                                            foreach (var lesson in chapterLessons)
                                            {
                                                <div class="curriculum-lesson">
                                                    <div class="curriculum-lesson__info">
                                                        <span class="curriculum-lesson__icon"
                                                              aria-hidden="true">
                                                            @if (lesson.IsFree || isEnrolled)
                                                            {
                                                                <svg viewBox="0 0 24 24" fill="none"
                                                                     stroke="currentColor" stroke-width="1.8"
                                                                     stroke-linecap="round" stroke-linejoin="round"
                                                                     focusable="false">
                                                                    <circle cx="12" cy="12" r="9" />
                                                                    <path d="m10 8 6 4-6 4z" />
                                                                </svg>
                                                            }
                                                            else
                                                            {
                                                                <svg viewBox="0 0 24 24" fill="none"
                                                                     stroke="currentColor" stroke-width="1.8"
                                                                     stroke-linecap="round" stroke-linejoin="round"
                                                                     focusable="false">
                                                                    <rect x="5" y="10" width="14" height="11" rx="2" />
                                                                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                                                                </svg>
                                                            }
                                                        </span>

                                                        <div class="curriculum-lesson__copy">
                                                            <span class="curriculum-lesson__title">
                                                                @lesson.Title
                                                            </span>

                                                            @if (lesson.IsFree)
                                                            {
                                                                <span class="curriculum-lesson__badge">
                                                                    Xem thử miễn phí
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>

                                                    <div class="curriculum-lesson__actions">
                                                        <span class="curriculum-lesson__duration">
                                                            @lesson.Duration phút
                                                        </span>

                                                        @if (lesson.IsFree)
                                                        {
                                                            <a asp-controller="Courses"
                                                               asp-action="PreviewLesson"
                                                               asp-route-lessonId="@lesson.Id"
                                                               class="curriculum-lesson__preview">
                                                                Xem thử
                                                            </a>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="curriculum-lesson__empty">
                                                Chưa có bài học.
                                            </div>
                                        }
                                    </div>
                                </details>

                                firstModule = false;
                            }
                        }
                        else
                        {
                            <div class="empty-content">
                                Nội dung bài học đang được cập nhật.
                            </div>
                        }

                    </div>


                    <!-- ĐÁNH GIÁ -->

                    <div class="content-card"
                         id="reviews">

                        <div class="details-section-title"
                             role="heading"
                             aria-level="2">
                            Đánh giá khóa học
                        </div>


                        @if (isStudent &&
                             isEnrolled)
                        {
                            <div class="review-form-box">


                                <div class="review-form-title">

                                    @(currentUserReview == null
                                        ? "Chia sẻ đánh giá của bạn"
                                        : "Cập nhật đánh giá của bạn")

                                </div>


                                <p class="review-form-description">

                                    Mỗi học viên chỉ có một đánh giá
                                    cho mỗi khóa học.
                                    Bạn có thể cập nhật lại bất cứ lúc nào.

                                </p>


                                <form asp-controller="Reviews"
                                      asp-action="Upsert"
                                      method="post">

                                    @Html.AntiForgeryToken()


                                    <input type="hidden"
                                           name="courseId"
                                           value="@Model.Id" />


                                    <div class="review-form-group">

                                        <label class="review-label"
                                               for="rating">
                                            Số sao
                                        </label>

                                        <select id="rating"
                                                name="rating"
                                                class="review-select"
                                                required>

                                            @for (int rating = 5;
                                                  rating >= 1;
                                                  rating--)
                                            {
                                                if (currentUserReview?.Rating ==
                                                    rating)
                                                {
                                                    <option value="@rating"
                                                            selected>
                                                        @rating / 5 ★
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@rating">
                                                        @rating / 5 ★
                                                    </option>
                                                }
                                            }

                                        </select>

                                    </div>


                                    <div class="review-form-group">

                                        <label class="review-label"
                                               for="comment">
                                            Nhận xét
                                        </label>

                                        <textarea id="comment"
                                                  name="comment"
                                                  maxlength="1000"
                                                  class="review-textarea"
                                                  placeholder="Chia sẻ trải nghiệm học khóa này...">@currentUserReview?.Comment</textarea>

                                    </div>


                                    <div class="review-actions">

                                        <button type="submit"
                                                class="review-submit">

                                            @(currentUserReview == null
                                                ? "Gửi đánh giá"
                                                : "Cập nhật đánh giá")

                                        </button>

                                    </div>


                                </form>


                                @if (currentUserReview != null)
                                {
                                    <form asp-controller="Reviews"
                                          asp-action="Delete"
                                          method="post"
                                          class="mt-2">

                                        @Html.AntiForgeryToken()


                                        <input type="hidden"
                                               name="courseId"
                                               value="@Model.Id" />


                                        <button type="submit"
                                                class="review-delete"
                                                onclick="return confirm('Bạn chắc chắn muốn xóa đánh giá của mình?');">

                                            Xóa đánh giá

                                        </button>

                                    </form>
                                }


                            </div>
                        }
                        else if (isStudent &&
                                 !isEnrolled)
                        {
                            <div class="review-help">

                                Bạn cần đăng ký khóa học
                                trước khi có thể gửi đánh giá.

                            </div>
                        }


                        @if (approvedReviews.Any())
                        {
                            <div class="rating-summary">

                                <div class="rating-number">
                                    @averageRating.ToString("0.0")
                                </div>

                                <div>

                                    <div class="rating-stars">
                                        ★★★★★
                                    </div>

                                    <div class="text-muted small">
                                        @approvedReviews.Count đánh giá
                                    </div>

                                </div>

                            </div>


                            foreach (var review in
                                approvedReviews
                                    .OrderByDescending(r =>
                                        r.UpdatedAt))
                            {
                                <div class="review-item">

                                    <div class="review-user">

                                        @(string.IsNullOrWhiteSpace(
                                            review.User.FullName)
                                            ? "Học viên EduLearn"
                                            : review.User.FullName)

                                    </div>


                                    <div class="rating-stars">
                                        @review.Rating / 5 ★
                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(
                                        review.Comment))
                                    {
                                        <div class="review-comment">
                                            @review.Comment
                                        </div>
                                    }


                                    <div class="review-date">

                                        @(review.UpdatedAt
                                            .ToLocalTime()
                                            .ToString("dd/MM/yyyy HH:mm"))

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-content">
                                Khóa học chưa có đánh giá.
                            </div>
                        }

                    </div>

                </div>


                <!-- =========================
                     SIDEBAR
                ========================= -->

                <aside>

                    <div class="content-card">

                        <div class="details-section-title details-section-title--aside"
                             role="heading"
                             aria-level="2">
                            Thông tin khóa học
                        </div>


                        <div class="info-row">

                            <div class="info-label">
                                Danh mục
                            </div>

                            <div class="info-value">
                                @Model.Category.Name
                            </div>

                        </div>


                        <div class="info-row">

                            <div class="info-label">
                                Cấp độ
                            </div>

                            <div class="info-value">
                                @levelText
                            </div>

                        </div>


                        <div class="info-row">

                            <div class="info-label">
                                Ngôn ngữ
                            </div>

                            <div class="info-value">

                                @(Model.Language == "vi"
                                    ? "Tiếng Việt"
                                    : Model.Language)

                            </div>

                        </div>


                        <div class="info-row">

                            <div class="info-label">
                                Thời lượng
                            </div>

                            <div class="info-value">
                                @Model.Duration phút
                            </div>

                        </div>


                        <div class="info-row">

                            <div class="info-label">
                                Số bài học
                            </div>

                            <div class="info-value">
                                @totalLessons bài
                            </div>

                        </div>


                        <div class="info-row">

                            <div class="info-label">
                                Học viên
                            </div>

                            <div class="info-value">
                                @Model.EnrollmentCount học viên
                            </div>

                        </div>

                    </div>


                    <div class="content-card">

                        <div class="details-section-title details-section-title--aside"
                             role="heading"
                             aria-level="2">
                            Giảng viên
                        </div>


                        <div class="instructor-name">
                            @Model.Instructor.FullName
                        </div>


                        @if (!string.IsNullOrWhiteSpace(
                            Model.Instructor.Bio))
                        {
                            <div class="details-instructor-bio">
                                @Model.Instructor.Bio
                            </div>
                        }

                    </div>

                </aside>

            </div>

        </div>

    </section>

</div>


<!-- =========================
     POPUP THÔNG BÁO
========================= -->

@if (!string.IsNullOrWhiteSpace(toastMessage))
{
    <div class="toast-container toast-position">

        <div id="courseToast"
             class="toast edulearn-toast @(toastIsError ? "toast-error" : toastIsSuccess ? "toast-success" : "toast-info")"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">

            <div class="toast-body d-flex align-items-center gap-3">

                <div class="toast-icon @(toastIsError ? "toast-icon-error" : toastIsSuccess ? "toast-icon-success" : "toast-icon-info")">

                    @(toastIsError
                        ? "!"
                        : toastIsSuccess
                            ? "✓"
                            : "i")

                </div>


                <div class="flex-grow-1">

                    <div class="toast-title">

                        @(toastIsError
                            ? "Không thể thực hiện"
                            : toastIsSuccess
                                ? "Thành công"
                                : "Thông báo")

                    </div>

                    <div class="toast-message">
                        @toastMessage
                    </div>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="toast"
                        aria-label="Đóng">
                </button>

            </div>

        </div>

    </div>
}


@section Scripts {

    <script src="~/js/course-details.js"
            asp-append-version="true">
    </script>

}