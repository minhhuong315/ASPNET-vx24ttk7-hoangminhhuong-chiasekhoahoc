    }

    .toast-error {
        border-left: 5px solid #dc3545;
    }

    .toast-icon {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        flex-shrink: 0;
    }

    .toast-icon-success {
        background: #e7f7ed;
        color: #198754;
    }

    .toast-icon-info {
        background: #e5f8fc;
        color: #087990;
    }

    .toast-icon-error {
        background: #fff0f1;
        color: #b42332;
    }

    .toast-title {
        font-weight: 700;
        color: #202938;
    }

    .toast-message {
        color: #697386;
        font-size: 13px;
        margin-top: 2px;
    }

    /* =========================
           RESPONSIVE
        ========================= */

    @@media (max-width: 991px) {

        .course-hero-grid,
        .content-layout {
            grid-template-columns: 1fr;
        }

        .hero-card {
            max-width: 500px;
        }
    }

    @@media (max-width: 600px) {

        .lesson-row {
            align-items: flex-start;
            flex-direction: column;
        }

        .lesson-main {
            flex-wrap: wrap;
        }

        .lesson-side {
            width: 100%;
            justify-content: space-between;
        }

        .course-main-title {
            font-size: 30px;
        }

        .course-meta {
            flex-direction: column;
            gap: 7px;
        }

        .toast-position {
            left: 16px !important;
            bottom: 16px !important;
            right: 16px !important;
        }

        .edulearn-toast {
            width: auto;
            max-width: none;
        }
    }

</style>


<div class="details-page">

    <!-- =========================
         HERO
    ========================= -->

    <section class="course-hero">

        <div class="details-container">

            <div class="course-hero-grid">

                <!-- THÔNG TIN KHÓA HỌC -->

                <div>

                    <div class="breadcrumb-text">

                        <a asp-controller="Home"
                           asp-action="Index">
                            Trang chủ
                        </a>

                        /

                        <a asp-controller="Courses"
                           asp-action="Index">
                            Khóa học
                        </a>

                        / @Model.Title

                    </div>


                    <div class="course-category-badge">
                        @Model.Category.Name
                    </div>


                    <h1 class="course-main-title">
                        @Model.Title
                    </h1>


                    <p class="course-short-description">
                        @Model.ShortDescription
                    </p>


                    <div class="course-meta">

                        <span>
                            Giảng viên:
                            <strong>
                                @Model.Instructor.FullName
                            </strong>
                        </span>

                        <span>
                            Cấp độ:
                            <strong>
                                @Model.Level
                            </strong>
                        </span>

                        <span>
                            @Model.ViewCount lượt xem
                        </span>


                        @if (approvedReviews.Any())
                        {
                            <span>
                                ★ @averageRating.ToString("0.0")
                                (@approvedReviews.Count đánh giá)
                            </span>
                        }

                    </div>

                </div>


                <!-- CARD BÊN PHẢI -->

                <div class="hero-card">

                    <div class="hero-thumbnail">

                        <div class="hero-thumbnail-category">
                            @Model.Category.Name
                        </div>

                        <div class="hero-thumbnail-logo">
                            @(Model.Category.Icon ?? "IT")
                        </div>

                    </div>


                    <div class="course-price">
                        @Model.Price.ToString("N0") đ
                    </div>


                    <!-- CHƯA ĐĂNG NHẬP -->
                    @if (!isAuthenticated)
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                           class="enroll-button">

                            Đăng nhập để đăng ký

                        </a>
                    }


                    <!-- STUDENT CHƯA ĐĂNG KÝ -->
                    @if (isStudent && !isEnrolled)
                    {
                        <form asp-controller="Courses"
                              asp-action="Enroll"
                              method="post">

                            <input type="hidden"
                                   name="courseId"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="enroll-button">

                                Đăng ký khóa học

                            </button>

                        </form>
                    }


                    <!-- STUDENT ĐÃ ĐĂNG KÝ -->
                    @if (isStudent && isEnrolled)
                    {
                        @if (enrollmentProgress >= 100)
                        {
                            <div class="enrolled-status">
                                ✓ Đã hoàn thành khóa học
                            </div>
                        }

                        @if (enrollmentProgress < 100)
                        {
                            <div class="enrolled-status">
                                ✓ Đã đăng ký khóa học
                            </div>
                        }


                        <div class="learning-progress">

                            <div class="progress-heading">

                                <span class="progress-label">
                                    Tiến độ học tập
                                </span>

                                <span class="progress-percent">
                                    @enrollmentProgress.ToString("0")%
                                </span>

                            </div>


                            <div class="progress-track">

                                <div class="progress-value"
                                     style="width: @enrollmentProgress.ToString("0")%;">
                                </div>

                            </div>


                            @if (enrollmentProgress >= 100)
                            {
                                <div class="progress-extra">
                                    Bạn đã hoàn thành khóa học này.
                                </div>
                            }

                            @if (enrollmentProgress > 0 &&
                                 enrollmentProgress < 100)
                            {
                                <div class="progress-extra">
                                    Tiếp tục quá trình học tập của bạn.
                                </div>
                            }

                            @if (enrollmentProgress == 0)
                            {
                                <div class="progress-extra">
                                    Bạn chưa bắt đầu bài học nào.
                                </div>
                            }

                        </div>


                        @if (enrollmentProgress >= 100)
                        {
                            <a asp-controller="Courses"
                               asp-action="Learn"
                               asp-route-courseId="@Model.Id"
                               class="learn-button">

                                Xem lại khóa học

                            </a>
                        }


                        @if (enrollmentProgress > 0 &&
                             enrollmentProgress < 100)
                        {
                            <a asp-controller="Courses"
                               asp-action="Learn"
                               asp-route-courseId="@Model.Id"
                               class="learn-button">

                                Tiếp tục học

                            </a>
                        }


                        @if (enrollmentProgress == 0)
                        {
                            <a asp-controller="Courses"
                               asp-action="Learn"
                               asp-route-courseId="@Model.Id"
                               class="learn-button">

                                Học ngay

                            </a>
                        }
                    }


                    <!-- YÊU THÍCH -->
                    @if (isStudent)
                    {
                        if (!isWishlisted)
                        {
                            <form asp-controller="Wishlist"
                                  asp-action="Add"
                                  method="post"
                                  class="wishlist-form">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="courseId"
                                       value="@Model.Id" />

                                <input type="hidden"
                                       name="slug"
                                       value="@Model.Slug" />

                                <button type="submit"
                                        class="wishlist-button">
                                    ♡ Thêm vào yêu thích
                                </button>

                            </form>
                        }
                        else
                        {
                            <form asp-controller="Wishlist"
                                  asp-action="Remove"
                                  method="post"
                                  class="wishlist-form">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="courseId"
                                       value="@Model.Id" />

                                <input type="hidden"
                                       name="slug"
                                       value="@Model.Slug" />

                                <input type="hidden"
                                       name="returnToDetails"
                                       value="true" />

                                <button type="submit"
                                        class="wishlist-button saved">
                                    ♥ Đã yêu thích · Bỏ lưu
                                </button>

                            </form>
                        }
                    }


                    <!-- ADMIN -->
                    @if (isAdmin)
                    {
                        <div class="role-note">
                            Bạn đang đăng nhập với quyền Quản trị viên.
                        </div>
                    }


                    <!-- INSTRUCTOR -->
                    @if (isInstructor)
                    {
                        <div class="role-note">
                            Bạn đang đăng nhập với quyền Giảng viên.
                        </div>
                    }

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         NỘI DUNG
    ========================= -->

    <section class="course-content"
             id="course-content">

        <div class="details-container">

            <div class="content-layout">

                <div>

                    <!-- GIỚI THIỆU -->

                    <div class="content-card">

                        <h2 class="content-title">
                            Giới thiệu khóa học
                        </h2>

                        <div class="description-text">
                            @Model.Description
                        </div>

                    </div>


                    <!-- MODULE / LESSON -->

                    <div class="content-card">

                        <h2 class="content-title">
                            Nội dung khóa học
                        </h2>


                        @if (Model.Modules != null &&
                             Model.Modules.Any())
                        {
                            foreach (var module in
                                Model.Modules.OrderBy(
                                    m => m.DisplayOrder))
                            {
                                <div class="module-card">

                                    <div class="module-title">
                                        @module.Title
                                    </div>


                                    @if (module.Lessons.Any())
                                    {
                                        foreach (var lesson in
                                            module.Lessons.OrderBy(
                                                l => l.DisplayOrder))
                                        {
                                            <div class="lesson-row">

                                                <div class="lesson-main">

                                                    <span class="lesson-title-text">
                                                        @lesson.Title
                                                    </span>

                                                    @if (lesson.IsFree)
                                                    {
                                                        <span class="lesson-free-badge">
                                                            Xem thử miễn phí
                                                        </span>
                                                    }

                                                </div>


                                                <div class="lesson-side">

                                                    <span class="lesson-duration">
                                                        @lesson.Duration phút
                                                    </span>

                                                    @if (lesson.IsFree)
                                                    {
                                                        <a asp-controller="Courses"
                                                           asp-action="PreviewLesson"
                                                           asp-route-lessonId="@lesson.Id"
                                                           class="lesson-preview-link">

                                                            <svg viewBox="0 0 24 24"
                                                                 aria-hidden="true">
                                                                <path d="M10 8l6 4-6 4Z" />
                                                                <circle cx="12"
                                                                        cy="12"
                                                                        r="9" />
                                                            </svg>

                                                            Xem thử

                                                        </a>
                                                    }

                                                </div>

                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="lesson-row">
                                            Chưa có bài học.
                                        </div>
                                    }

                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-content">
                                Nội dung bài học đang được cập nhật.
                            </div>
                        }

                    </div>


                    <!-- ĐÁNH GIÁ -->

                    <div class="content-card"
                         id="reviews">

                        <h2 class="content-title">
                            Đánh giá khóa học
                        </h2>


                        @if (isStudent &&
                             isEnrolled)
                        {
                            <div class="review-form-box">


                                <div class="review-form-title">

                                    @(currentUserReview == null
                                        ? "Chia sẻ đánh giá của bạn"
                                        : "Cập nhật đánh giá của bạn")

                                </div>


                                <p class="review-form-description">

                                    Mỗi học viên chỉ có một đánh giá
                                    cho mỗi khóa học.
                                    Bạn có thể cập nhật lại bất cứ lúc nào.

                                </p>


                                <form asp-controller="Reviews"
                                      asp-action="Upsert"
                                      method="post">

                                    @Html.AntiForgeryToken()


                                    <input type="hidden"
                                           name="courseId"
                                           value="@Model.Id" />


                                    <div class="review-form-group">

                                        <label class="review-label"
                                               for="rating">
                                            Số sao
                                        </label>

                                        <select id="rating"
                                                name="rating"
                                                class="review-select"
                                                required>

                                            @for (int rating = 5;
                                                  rating >= 1;
                                                  rating--)
                                            {
                                                if (currentUserReview?.Rating ==
                                                    rating)
                                                {
                                                    <option value="@rating"
                                                            selected>
                                                        @rating / 5 ★
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@rating">
                                                        @rating / 5 ★
                                                    </option>
                                                }
                                            }

                                        </select>

                                    </div>


                                    <div class="review-form-group">

                                        <label class="review-label"
                                               for="comment">
                                            Nhận xét
                                        </label>

                                        <textarea id="comment"
                                                  name="comment"
                                                  maxlength="1000"
                                                  class="review-textarea"
                                                  placeholder="Chia sẻ trải nghiệm học khóa này...">@currentUserReview?.Comment</textarea>

                                    </div>


                                    <div class="review-actions">

                                        <button type="submit"
                                                class="review-submit">

                                            @(currentUserReview == null
                                                ? "Gửi đánh giá"
                                                : "Cập nhật đánh giá")

                                        </button>

                                    </div>


                                </form>


                                @if (currentUserReview != null)
                                {
                                    <form asp-controller="Reviews"
                                          asp-action="Delete"
                                          method="post"
                                          class="mt-2">

                                        @Html.AntiForgeryToken()


                                        <input type="hidden"
                                               name="courseId"
                                               value="@Model.Id" />


                                        <button type="submit"
                                                class="review-delete"
                                                onclick="return confirm('Bạn chắc chắn muốn xóa đánh giá của mình?');">

                                            Xóa đánh giá

                                        </button>

                                    </form>
                                }


                            </div>
                        }
                        else if (isStudent &&
                                 !isEnrolled)
                        {
                            <div class="review-help">

                                Bạn cần đăng ký khóa học
                                trước khi có thể gửi đánh giá.

                            </div>
                        }


                        @if (approvedReviews.Any())
                        {
                            <div class="rating-summary">

                                <div class="rating-number">
                                    @averageRating.ToString("0.0")
                                </div>

                                <div>

                                    <div class="rating-stars">
                                        ★★★★★
                                    </div>

                                    <div class="text-muted small">
                                        @approvedReviews.Count đánh giá
                                    </div>

                                </div>

                            </div>


                            foreach (var review in
                                approvedReviews
                                    .OrderByDescending(r =>
                                        r.UpdatedAt))
                            {
                                <div class="review-item">

                                    <div class="review-user">

                                        @(string.IsNullOrWhiteSpace(
                                            review.User.FullName)
                                            ? "Học viên EduLearn"
                                            : review.User.FullName)

                                    </div>


                                    <div class="rating-stars">
                                        @review.Rating / 5 ★
                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(
                                        review.Comment))
                                    {
                                        <div class="review-comment">
                                            @review.Comment
                                        </div>
                                    }


                                    <div class="review-date">

                                        @(review.UpdatedAt
                                            .ToLocalTime()
                                            .ToString("dd/MM/yyyy HH:mm"))

                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(
                                        review.InstructorReply))
                                    {
                                        <div class="instructor-reply">

                                            <div class="instructor-reply-heading">

                                                <div class="instructor-reply-title">
                                                    Phản hồi từ giảng viên
                                                </div>

                                                @if (review.InstructorReplyUpdatedAt.HasValue)
                                                {
                                                    <div class="instructor-reply-date">

                                                        @(review.InstructorReplyUpdatedAt.Value
                                                            .ToLocalTime()
                                                            .ToString("dd/MM/yyyy HH:mm"))

                                                    </div>
                                                }

                                            </div>

                                            <div class="instructor-reply-text">
                                                @review.InstructorReply
                                            </div>

                                        </div>
                                    }


                                    @if (canReplyToReviews)
                                    {
                                        <div class="instructor-reply-form">

                                            <form asp-controller="Reviews"
                                                  asp-action="Reply"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="reviewId"
                                                       value="@review.Id" />

                                                <label class="instructor-reply-label"
                                                       for="reply-@review.Id">

                                                    @(string.IsNullOrWhiteSpace(
                                                        review.InstructorReply)
                                                        ? "Phản hồi đánh giá"
                                                        : "Cập nhật phản hồi")

                                                </label>

                                                <textarea id="reply-@review.Id"
                                                          name="reply"
                                                          maxlength="1000"
                                                          class="instructor-reply-textarea"
                                                          placeholder="Nhập phản hồi của giảng viên..."
                                                          required>@review.InstructorReply</textarea>

                                                <div class="instructor-reply-actions">

                                                    <button type="submit"
                                                            class="instructor-reply-submit">

                                                        @(string.IsNullOrWhiteSpace(
                                                            review.InstructorReply)
                                                            ? "Gửi phản hồi"
                                                            : "Cập nhật phản hồi")

                                                    </button>

                                                </div>

                                            </form>


                                            @if (!string.IsNullOrWhiteSpace(
                                                review.InstructorReply))
                                            {
                                                <form asp-controller="Reviews"
                                                      asp-action="DeleteReply"
                                                      method="post"
                                                      class="mt-2">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="reviewId"
                                                           value="@review.Id" />

                                                    <button type="submit"
                                                            class="instructor-reply-delete"
                                                            onclick="return confirm('Bạn chắc chắn muốn xóa phản hồi này?');">
                                                        Xóa phản hồi
                                                    </button>

                                                </form>
                                            }

                                        </div>
                                    }

                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-content">
                                Khóa học chưa có đánh giá.
                            </div>
                        }

                    </div>

                </div>


                <!-- =========================
                     SIDEBAR
                ========================= -->

                <aside>

                    <div class="content-card">

                        <h3 class="content-title">
                            Thông tin khóa học
                        </h3>


                        <div class="info-row">

                            <div class="info-label">
                                Danh mục
                            </div>

                            <div class="info-value">
                                @Model.Category.Name
                            </div>

                        </div>


                        <div class="info-row">

                            <div class="info-label">
                                Cấp độ
                            </div>

                            <div class="info-value">
                                @Model.Level
                            </div>

                        </div>


                        <div class="info-row">

                            <div class="info-label">
                                Ngôn ngữ
                            </div>

                            <div class="info-value">

                                @(Model.Language == "vi"
                                    ? "Tiếng Việt"
                                    : Model.Language)

                            </div>

                        </div>


                        <div class="info-row">

                            <div class="info-label">
                                Thời lượng
                            </div>

                            <div class="info-value">
                                @Model.Duration phút
                            </div>

                        </div>


                        <div class="info-row">

                            <div class="info-label">
                                Số bài học
                            </div>

                            <div class="info-value">
                                @totalLessons bài
                            </div>

                        </div>


                        <div class="info-row">

                            <div class="info-label">
                                Học viên
                            </div>

                            <div class="info-value">
                                @Model.EnrollmentCount học viên
                            </div>

                        </div>

                    </div>


                    <div class="content-card">

                        <h3 class="content-title">
                            Giảng viên
                        </h3>


                        <div class="instructor-name">
                            @Model.Instructor.FullName
                        </div>


                        @if (!string.IsNullOrWhiteSpace(
                            Model.Instructor.Bio))
                        {
                            <div class="instructor-bio">
                                @Model.Instructor.Bio
                            </div>
                        }

                    </div>

                </aside>

            </div>

        </div>

    </section>

</div>


<!-- =========================
     POPUP THÔNG BÁO
========================= -->
@if (!string.IsNullOrWhiteSpace(toastMessage))
{
    <div class="toast-container toast-position">

        <div id="courseToast"
             class="toast edulearn-toast @(toastIsError ? "toast-error" : toastIsSuccess ? "toast-success" : "toast-info")"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">

            <div class="toast-body d-flex align-items-center gap-3">

                <div class="toast-icon @(toastIsError ? "toast-icon-error" : toastIsSuccess ? "toast-icon-success" : "toast-icon-info")">

                    @(toastIsError
                        ? "!"
                        : toastIsSuccess
                            ? "✓"
                            : "i")

                </div>


                <div class="flex-grow-1">

                    <div class="toast-title">

                        @(toastIsError
                            ? "Không thể thực hiện"
                            : toastIsSuccess
                                ? "Thành công"
                                : "Thông báo")

                    </div>

                    <div class="toast-message">
                        @toastMessage
                    </div>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="toast"
                        aria-label="Đóng">
                </button>

            </div>

        </div>

    </div>
}


@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const toastElement =
                    document.getElementById(
                        "courseToast");

                if (toastElement) {

                    const toast =
                        new bootstrap.Toast(
                            toastElement,
                            {
                                autohide: true,
                                delay: 3500
                            });

                    toast.show();
                }
            });

    </script>

}