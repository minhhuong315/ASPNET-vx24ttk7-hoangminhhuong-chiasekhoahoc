@model OnlineLearningPlatform.ViewModels.StudyHistoryViewModel

@{
    ViewData["Title"] = "Lịch sử học tập";

    var today =
        DateTime.Now.Date;

    var activityGroups =
        Model.Activities
            .GroupBy(a =>
                a.OccurredAt
                    .ToLocalTime()
                    .Date)
            .OrderByDescending(g =>
                g.Key)
            .ToList();
}

<style>
    .study-history-page {
        width: 100%;
        max-width: 1480px;
        margin: 0 auto;
        padding: 8px 0 32px;
    }

    .history-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
    }

    .history-eyebrow {
        margin-bottom: 6px;
        color: #0d6efd;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .history-title {
        margin: 0;
        color: #0f1d38;
        font-size: 32px !important;
        font-weight: 800;
        line-height: 1.15;
    }

    .history-subtitle {
        max-width: 720px;
        margin: 8px 0 0;
        color: #69768a;
        font-size: 14px;
        line-height: 1.6;
    }

    .history-back {
        min-height: 42px;
        padding: 0 16px;
        border: 1px solid #dce4ef;
        border-radius: 10px;
        background: #ffffff;
        color: #42526b;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
    }

    .history-back:hover {
        border-color: #b9c8dc;
        color: #0d6efd;
    }

    .history-back svg {
        width: 17px;
        height: 17px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .history-metrics {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 18px;
    }

    .history-metric {
        min-height: 112px;
        padding: 18px;
        border: 1px solid #e6edf6;
        border-radius: 14px;
        background: #ffffff;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 6px 18px rgba(31, 55, 90, .035);
    }

    .history-metric-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: #eef5ff;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 46px;
    }

    .history-metric-icon svg {
        width: 22px;
        height: 22px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .history-metric-value {
        color: #13213b;
        font-size: 28px;
        font-weight: 800;
        line-height: 1;
    }

    .history-metric-label {
        margin-top: 7px;
        color: #738095;
        font-size: 13px;
        font-weight: 700;
    }

    .history-grid {
        display: grid;
        grid-template-columns: minmax(0, 7fr) minmax(320px, 5fr);
        gap: 16px;
        align-items: start;
    }

    .history-panel {
        overflow: hidden;
        border: 1px solid #e6edf6;
        border-radius: 15px;
        background: #ffffff;
        box-shadow: 0 6px 18px rgba(31, 55, 90, .035);
    }

    .history-panel-header {
        min-height: 64px;
        padding: 0 18px;
        border-bottom: 1px solid #edf1f6;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .history-panel-title-wrap {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .history-panel-icon {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        background: #f1f6fd;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 40px;
    }

    .history-panel-icon svg {
        width: 19px;
        height: 19px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .history-panel-title {
        margin: 0;
        color: #17233a;
        font-size: 18px !important;
        font-weight: 800;
        line-height: 1.25 !important;
    }

    .history-panel-subtitle {
        margin-top: 3px;
        color: #8a96a8;
        font-size: 11px;
    }

    .timeline {
        padding: 16px 18px 20px;
    }

    .timeline-day + .timeline-day {
        margin-top: 22px;
    }

    .timeline-day-title {
        margin: 0 0 10px;
        color: #67758a;
        font-size: 14px !important;
        font-weight: 800;
        line-height: 1.3 !important;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .timeline-item {
        position: relative;
        display: grid;
        grid-template-columns: 42px minmax(0, 1fr) auto;
        gap: 12px;
        align-items: center;
        min-height: 74px;
        padding: 11px 12px;
        border: 1px solid #edf1f6;
        border-radius: 12px;
        color: inherit;
        text-decoration: none;
        transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
    }

    .timeline-item + .timeline-item {
        margin-top: 8px;
    }

    .timeline-item:hover {
        border-color: #cbdcf4;
        box-shadow: 0 7px 18px rgba(39, 76, 130, .07);
        transform: translateY(-1px);
    }

    .timeline-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        background: #f1f6fd;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .timeline-icon--completed {
        background: #edf9f1;
        color: #198754;
    }

    .timeline-icon--course {
        background: #f4f1ff;
        color: #7157c9;
    }

    .timeline-icon svg {
        width: 20px;
        height: 20px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .timeline-copy {
        min-width: 0;
    }

    .timeline-title {
        color: #28364d;
        font-size: 13px;
        font-weight: 800;
    }

    .timeline-description {
        margin-top: 4px;
        overflow: hidden;
        color: #748196;
        font-size: 12px;
        line-height: 1.45;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .timeline-time {
        color: #98a2b3;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .history-course-list {
        padding: 12px;
        display: grid;
        gap: 10px;
    }

    .history-course {
        padding: 14px;
        border: 1px solid #edf1f6;
        border-radius: 12px;
        background: #ffffff;
    }

    .history-course-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    .history-course-copy {
        min-width: 0;
    }

    .history-course-title {
        margin: 0;
        color: #24324a;
        font-size: 14px !important;
        font-weight: 800;
        line-height: 1.4 !important;
    }

    .history-course-category {
        margin-top: 5px;
        color: #8995a6;
        font-size: 11px;
    }

    .history-status {
        flex-shrink: 0;
        padding: 5px 8px;
        border-radius: 999px;
        background: #f3f5f8;
        color: #667085;
        font-size: 10px;
        font-weight: 800;
    }

    .history-status--in-progress {
        background: #eef5ff;
        color: #0d6efd;
    }

    .history-status--completed {
        background: #edf9f1;
        color: #198754;
    }

    .history-progress-row {
        margin-top: 13px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 38px;
        gap: 9px;
        align-items: center;
    }

    .history-progress-track {
        height: 7px;
        overflow: hidden;
        border-radius: 999px;
        background: #edf1f6;
    }

    .history-progress-bar {
        height: 100%;
        border-radius: inherit;
        background: #0d6efd;
    }

    .history-progress-value {
        color: #56657a;
        font-size: 11px;
        font-weight: 800;
        text-align: right;
    }

    .history-course-meta {
        margin-top: 11px;
        color: #8793a5;
        font-size: 11px;
        line-height: 1.5;
    }

    .history-course-action {
        width: 100%;
        min-height: 38px;
        margin-top: 12px;
        border-radius: 9px;
        background: #0d6efd;
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }

    .history-course-action:hover {
        background: #0b5ed7;
        color: #ffffff;
    }

    .history-course-action svg {
        width: 16px;
        height: 16px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .history-empty {
        padding: 44px 22px;
        text-align: center;
        color: #7b8798;
    }

    .history-empty-icon {
        width: 54px;
        height: 54px;
        margin: 0 auto 12px;
        border-radius: 15px;
        background: #f1f6fd;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .history-empty-icon svg {
        width: 25px;
        height: 25px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .history-empty-title {
        color: #35435a;
        font-size: 14px;
        font-weight: 800;
    }

    .history-empty-text {
        margin-top: 6px;
        font-size: 12px;
        line-height: 1.6;
    }

    @@media (max-width: 1050px) {
        .history-metrics {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .history-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .study-history-page {
            padding-top: 2px;
        }

        .history-heading {
            flex-direction: column;
        }

        .history-title {
            font-size: 27px !important;
        }

        .history-back {
            width: 100%;
            justify-content: center;
        }

        .history-metrics {
            grid-template-columns: 1fr;
        }

        .history-metric {
            min-height: 94px;
        }

        .timeline {
            padding: 12px;
        }

        .timeline-item {
            grid-template-columns: 40px minmax(0, 1fr);
        }

        .timeline-time {
            grid-column: 2;
        }
    }
</style>


<div class="study-history-page">

    <div class="history-heading">

        <div>

            <div class="history-eyebrow">
                Không gian học tập
            </div>

            <h1 class="history-title">
                Lịch sử học tập
            </h1>

            <p class="history-subtitle">
                Theo dõi các khóa học đã tham gia,
                tiến độ hiện tại và những hoạt động học tập gần đây của bạn.
            </p>

        </div>

        <a asp-controller="Courses"
           asp-action="MyCourses"
           class="history-back">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true">
                <path d="M15 18l-6-6 6-6" />
            </svg>

            Khóa học của tôi

        </a>

    </div>


    <div class="history-metrics">

        <div class="history-metric">

            <span class="history-metric-icon">
                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11a3 3 0 0 1 3 3v15a3 3 0 0 0-3-3H6.5A2.5 2.5 0 0 0 4 20.5Z" />
                    <path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H14v18a3 3 0 0 1 3-3h.5a2.5 2.5 0 0 1 2.5 2.5Z" />
                </svg>
            </span>

            <div>
                <div class="history-metric-value">
                    @Model.TotalCourses
                </div>
                <div class="history-metric-label">
                    Khóa học đã tham gia
                </div>
            </div>

        </div>


        <div class="history-metric">

            <span class="history-metric-icon">
                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M10 8l6 4-6 4Z" />
                </svg>
            </span>

            <div>
                <div class="history-metric-value">
                    @Model.InProgressCourses
                </div>
                <div class="history-metric-label">
                    Khóa học đang học
                </div>
            </div>

        </div>


        <div class="history-metric">

            <span class="history-metric-icon">
                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="m8 12 2.6 2.6L16.5 9" />
                </svg>
            </span>

            <div>
                <div class="history-metric-value">
                    @Model.CompletedCourses
                </div>
                <div class="history-metric-label">
                    Khóa học hoàn thành
                </div>
            </div>

        </div>


        <div class="history-metric">

            <span class="history-metric-icon">
                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M4 4h16v16H4Z" />
                    <path d="m8 12 2.3 2.3L16 8.7" />
                </svg>
            </span>

            <div>
                <div class="history-metric-value">
                    @Model.CompletedLessons
                </div>
                <div class="history-metric-label">
                    Bài học hoàn thành
                </div>
            </div>

        </div>

    </div>


    <div class="history-grid">

        <section class="history-panel">

            <div class="history-panel-header">

                <div class="history-panel-title-wrap">

                    <span class="history-panel-icon">
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 7v5l3 2" />
                        </svg>
                    </span>

                    <div>
                        <h2 class="history-panel-title">
                            Hoạt động gần đây
                        </h2>
                        <div class="history-panel-subtitle">
                            Tối đa 50 hoạt động mới nhất
                        </div>
                    </div>

                </div>

            </div>


            @if (activityGroups.Any())
            {
                <div class="timeline">

                    @foreach (var group in activityGroups)
                    {
                        string dayLabel =
                            group.Key == today
                                ? "Hôm nay"
                                : group.Key == today.AddDays(-1)
                                    ? "Hôm qua"
                                    : group.Key.ToString("dd/MM/yyyy");

                        <div class="timeline-day">

                            <h3 class="timeline-day-title">
                                @dayLabel
                            </h3>


                            @foreach (var activity in group
                                .OrderByDescending(a =>
                                    a.OccurredAt))
                            {
                                string iconClass =
                                    activity.Type == "LessonCompleted" ||
                                    activity.Type == "CourseCompleted"
                                        ? "timeline-icon timeline-icon--completed"
                                        : activity.Type == "CourseEnrolled"
                                            ? "timeline-icon timeline-icon--course"
                                            : "timeline-icon";

                                <a asp-controller="Courses"
                                   asp-action="Learn"
                                   asp-route-courseId="@activity.CourseId"
                                   asp-route-lessonId="@activity.LessonId"
                                   class="timeline-item">

                                    <span class="@iconClass">

                                        @if (activity.Type == "LessonCompleted" ||
                                             activity.Type == "CourseCompleted")
                                        {
                                            <svg viewBox="0 0 24 24"
                                                 aria-hidden="true">
                                                <circle cx="12"
                                                        cy="12"
                                                        r="9" />
                                                <path d="m8 12 2.6 2.6L16.5 9" />
                                            </svg>
                                        }
                                        else if (activity.Type == "CourseEnrolled")
                                        {
                                            <svg viewBox="0 0 24 24"
                                                 aria-hidden="true">
                                                <path d="M12 5v14" />
                                                <path d="M5 12h14" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24"
                                                 aria-hidden="true">
                                                <path d="M10 8l6 4-6 4Z" />
                                                <circle cx="12"
                                                        cy="12"
                                                        r="9" />
                                            </svg>
                                        }

                                    </span>

                                    <span class="timeline-copy">

                                        <span class="timeline-title">
                                            @activity.Title
                                        </span>

                                        <span class="timeline-description">
                                            @activity.Description
                                        </span>

                                    </span>

                                    <span class="timeline-time">
                                        @(activity.OccurredAt
                                            .ToLocalTime()
                                            .ToString("HH:mm"))
                                    </span>

                                </a>
                            }

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="history-empty">

                    <div class="history-empty-icon">
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <circle cx="12"
                                    cy="12"
                                    r="9" />
                            <path d="M12 7v5l3 2" />
                        </svg>
                    </div>

                    <div class="history-empty-title">
                        Chưa có hoạt động học tập
                    </div>

                    <div class="history-empty-text">
                        Khi bạn đăng ký hoặc học một khóa học,
                        hoạt động sẽ xuất hiện tại đây.
                    </div>

                </div>
            }

        </section>


        <section class="history-panel">

            <div class="history-panel-header">

                <div class="history-panel-title-wrap">

                    <span class="history-panel-icon">
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11a3 3 0 0 1 3 3v15a3 3 0 0 0-3-3H6.5A2.5 2.5 0 0 0 4 20.5Z" />
                            <path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H14v18a3 3 0 0 1 3-3h.5a2.5 2.5 0 0 1 2.5 2.5Z" />
                        </svg>
                    </span>

                    <div>
                        <h2 class="history-panel-title">
                            Tiến độ khóa học
                        </h2>
                        <div class="history-panel-subtitle">
                            Các khóa bạn đã đăng ký
                        </div>
                    </div>

                </div>

            </div>


            @if (Model.Courses.Any())
            {
                <div class="history-course-list">

                    @foreach (var course in Model.Courses)
                    {
                        int progressPercent =
                            Convert.ToInt32(
                                Math.Round(
                                    Math.Clamp(
                                        course.Progress,
                                        0m,
                                        100m),
                                    0,
                                    MidpointRounding.AwayFromZero));

                        <div class="history-course">

                            <div class="history-course-top">

                                <div class="history-course-copy">

                                    <h3 class="history-course-title">
                                        @course.CourseTitle
                                    </h3>

                                    <div class="history-course-category">
                                        @course.CategoryName
                                    </div>

                                </div>

                                <span class="history-status history-status--@course.StatusKey">
                                    @course.StatusLabel
                                </span>

                            </div>


                            <div class="history-progress-row">

                                <div class="history-progress-track">
                                    <div class="history-progress-bar"
                                         style="width: @(progressPercent)%;">
                                    </div>
                                </div>

                                <div class="history-progress-value">
                                    @progressPercent%
                                </div>

                            </div>


                            <div class="history-course-meta">

                                Đăng ký:
                                @(course.EnrolledAt
                                    .ToLocalTime()
                                    .ToString("dd/MM/yyyy"))

                                @if (course.LastAccessedAt.HasValue)
                                {
                                    <span>
                                        · Học gần nhất:
                                        @(course.LastAccessedAt.Value
                                            .ToLocalTime()
                                            .ToString("dd/MM/yyyy HH:mm"))
                                    </span>
                                }

                            </div>


                            <a asp-controller="Courses"
                               asp-action="Learn"
                               asp-route-courseId="@course.CourseId"
                               class="history-course-action">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <path d="M10 8l6 4-6 4Z" />
                                </svg>

                                @(course.Progress >= 100m
                                    ? "Xem lại khóa học"
                                    : course.Progress > 0m
                                        ? "Tiếp tục học"
                                        : "Bắt đầu học")

                            </a>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="history-empty">

                    <div class="history-empty-icon">
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11a3 3 0 0 1 3 3v15a3 3 0 0 0-3-3H6.5A2.5 2.5 0 0 0 4 20.5Z" />
                            <path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H14v18a3 3 0 0 1 3-3h.5a2.5 2.5 0 0 1 2.5 2.5Z" />
                        </svg>
                    </div>

                    <div class="history-empty-title">
                        Bạn chưa có khóa học
                    </div>

                    <div class="history-empty-text">
                        Hãy đăng ký một khóa học để bắt đầu hành trình học tập.
                    </div>

                </div>
            }

        </section>

    </div>

</div>
