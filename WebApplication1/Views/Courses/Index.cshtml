@model IEnumerable<OnlineLearningPlatform.Models.Course>

@{
    string pageTitle =
        ViewBag.PageTitle?.ToString()
        ?? "Tất cả khóa học";

    string pageDescription =
        ViewBag.PageDescription?.ToString()
        ?? "Khám phá các khóa học Công nghệ thông tin trên EduLearn.";

    string selectedLevel =
        ViewBag.Level?.ToString()
        ?? string.Empty;

    int? selectedCategoryId =
        ViewBag.CategoryId == null
            ? null
            : Convert.ToInt32(
                ViewBag.CategoryId);

    string searchValue =
        ViewBag.Search?.ToString()
        ?? string.Empty;

    string selectedPriceRange =
        ViewBag.PriceRange?.ToString()
        ?? string.Empty;

    decimal? minPrice =
        ViewBag.MinPrice == null
            ? null
            : Convert.ToDecimal(
                ViewBag.MinPrice);

    decimal? maxPrice =
        ViewBag.MaxPrice == null
            ? null
            : Convert.ToDecimal(
                ViewBag.MaxPrice);

    int? minRating =
        ViewBag.MinRating == null
            ? null
            : Convert.ToInt32(
                ViewBag.MinRating);

    string selectedSort =
        ViewBag.Sort?.ToString()
        ?? "popular";

    int currentPage =
        ViewBag.CurrentPage == null
            ? 1
            : Convert.ToInt32(
                ViewBag.CurrentPage);

    int totalPages =
        ViewBag.TotalPages == null
            ? 0
            : Convert.ToInt32(
                ViewBag.TotalPages);

    int totalItems =
        ViewBag.TotalItems == null
            ? Model.Count()
            : Convert.ToInt32(
                ViewBag.TotalItems);

    int pageSize =
        ViewBag.PageSize == null
            ? 9
            : Convert.ToInt32(
                ViewBag.PageSize);

    int firstItem =
        totalItems == 0
            ? 0
            : ((currentPage - 1) *
                pageSize) + 1;

    int lastItem =
        totalItems == 0
            ? 0
            : Math.Min(
                currentPage * pageSize,
                totalItems);

    int paginationStart =
        Math.Max(
            1,
            currentPage - 2);

    int paginationEnd =
        Math.Min(
            totalPages,
            paginationStart + 4);

    paginationStart =
        Math.Max(
            1,
            paginationEnd - 4);

    ViewData["Title"] =
        pageTitle;

    var categories =
        ViewBag.Categories
            as IEnumerable<
                OnlineLearningPlatform.Models.Category>;

    var selectedCategory =
        categories?
            .FirstOrDefault(c =>
                c.Id == selectedCategoryId);

    bool hasCustomPrice =
        string.IsNullOrWhiteSpace(
            selectedPriceRange) &&
        (minPrice.HasValue ||
         maxPrice.HasValue);

    bool hasFilter =
        selectedCategoryId.HasValue ||
        !string.IsNullOrWhiteSpace(
            selectedLevel) ||
        !string.IsNullOrWhiteSpace(
            searchValue) ||
        !string.IsNullOrWhiteSpace(
            selectedPriceRange) ||
        hasCustomPrice ||
        minRating.HasValue;

    int activeFilterCount =
        (selectedCategoryId.HasValue ? 1 : 0) +
        (!string.IsNullOrWhiteSpace(selectedLevel) ? 1 : 0) +
        (!string.IsNullOrWhiteSpace(searchValue) ? 1 : 0) +
        (!string.IsNullOrWhiteSpace(selectedPriceRange) || hasCustomPrice ? 1 : 0) +
        (minRating.HasValue ? 1 : 0);
}

@functions {
    string GetLevelText(string? level)
    {
        return level switch
        {
            "Beginner" => "Cơ bản",
            "Intermediate" => "Trung cấp",
            "Advanced" => "Nâng cao",
            _ => "Chưa xác định"
        };
    }

    string GetLevelClass(string? level)
    {
        return level switch
        {
            "Beginner" => "beginner",
            "Intermediate" => "intermediate",
            "Advanced" => "advanced",
            _ => "default"
        };
    }

    decimal GetEffectivePrice(
        OnlineLearningPlatform.Models.Course course)
    {
        return course.DiscountPrice.HasValue &&
               course.DiscountPrice.Value <
               course.Price
            ? course.DiscountPrice.Value
            : course.Price;
    }

    double GetAverageRating(
        OnlineLearningPlatform.Models.Course course)
    {
        var approvedReviews =
            course.Reviews?
                .Where(r =>
                    r.IsApproved)
                .ToList();

        if (approvedReviews == null ||
            approvedReviews.Count == 0)
        {
            return 0;
        }

        return approvedReviews
            .Average(r =>
                r.Rating);
    }

    string GetPriceRangeLabel(
        string? value)
    {
        return value switch
        {
            "free" => "Miễn phí",
            "under-1m" => "Dưới 1.000.000đ",
            "1m-2m" => "1.000.000đ – 2.000.000đ",
            "over-2m" => "Trên 2.000.000đ",
            _ => string.Empty
        };
    }

    string GetInitials(
        string? fullName)
    {
        if (string.IsNullOrWhiteSpace(
            fullName))
        {
            return "GV";
        }

        var words =
            fullName
                .Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries);

        if (words.Length == 1)
        {
            return words[0]
                .Substring(
                    0,
                    Math.Min(2, words[0].Length))
                .ToUpperInvariant();
        }

        return $"{words[0][0]}{words[^1][0]}"
            .ToUpperInvariant();
    }
}

<style>
    .course-catalog-page,
    .course-catalog-page * {
        box-sizing: border-box;
    }

    .course-catalog-page {
        min-height: calc(100vh - 150px);
        padding: 42px 0 72px;
        background: #f7f9fc;
    }

    .catalog-container {
        width: min(1240px, calc(100% - 40px));
        margin: 0 auto;
    }

    .catalog-header {
        margin-bottom: 24px;
    }

    .catalog-eyebrow {
        margin-bottom: 8px;
        color: #0d6efd;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .catalog-title {
        margin: 0 0 8px;
        color: #102044;
        font-size: 36px;
        font-weight: 800;
        line-height: 1.2;
    }

