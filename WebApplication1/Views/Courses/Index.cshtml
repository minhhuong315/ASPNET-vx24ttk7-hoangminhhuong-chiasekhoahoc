        background: #edf4ff;
        color: #0d6efd;
    }

    .catalog-check {
        position: relative;
        width: 15px;
        height: 15px;
        flex: 0 0 15px;
        border: 1.5px solid #cbd5e1;
        border-radius: 4px;
        background: #ffffff;
    }

