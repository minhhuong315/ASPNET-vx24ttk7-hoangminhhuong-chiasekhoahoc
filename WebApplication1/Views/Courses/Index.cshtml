@model IEnumerable<OnlineLearningPlatform.Models.Course>

@{
    ViewData["Title"] = "Khóa học";
    var categories =
        ViewBag.Categories as IEnumerable<OnlineLearningPlatform.Models.Category>;
}

<style>
    .courses-page {
        background: #f8fafc;
        min-height: 80vh;
        padding: 55px 0 75px;
    }

    .courses-container {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .courses-header {
        margin-bottom: 30px;
    }

    .courses-title {
        font-size: 34px;
        font-weight: 800;
        color: #172033;
        margin-bottom: 8px;
    }

    .courses-subtitle {
        color: #7a8494;
    }

    .courses-layout {
        display: grid;
        grid-template-columns: 240px 1fr;
        gap: 28px;
    }

    .filter-box {
        background: #ffffff;
        border: 1px solid #e8ebf0;
        border-radius: 16px;
        padding: 20px;
        height: fit-content;
    }

    .filter-title {
        font-weight: 700;
        margin-bottom: 15px;
        color: #273142;
    }

    .category-link {
        display: block;
        padding: 9px 11px;
        margin-bottom: 6px;
        border-radius: 9px;
        color: #5f6b7a;
        text-decoration: none;
        font-size: 14px;
    }

    .category-link:hover,
    .category-link.active {
        background: #edf4ff;
        color: #0d6efd;
    }

    .search-row {
        display: flex;
        gap: 10px;
        margin-bottom: 22px;
    }

    .search-input {
        flex: 1;
        min-height: 46px;
        border: 1px solid #dfe3ea;
        border-radius: 10px;
        padding: 0 14px;
    }

    .search-button {
        border: none;
        background: #0d6efd;
        color: #ffffff;
        border-radius: 10px;
        padding: 0 18px;
        font-weight: 700;
    }

    .course-list {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .course-card {
        background: #ffffff;
        border: 1px solid #e8ebf0;
        border-radius: 16px;
        overflow: hidden;
        transition: 0.2s ease;
    }

    .course-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 34px rgba(33, 52, 84, 0.10);
    }

    .course-thumbnail {
        height: 155px;
        background: linear-gradient(135deg, #0f55c9, #488dff);
        color: #ffffff;
        padding: 20px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .course-category {
        font-size: 12px;
        font-weight: 700;
        opacity: 0.9;
    }

    .course-logo {
        font-size: 30px;
        font-weight: 800;
    }

    .course-body {
        padding: 18px;
    }

    .course-level {
        display: inline-block;
        background: #edf4ff;
        color: #0d6efd;
        padding: 4px 8px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .course-name {
        font-size: 16px;
        line-height: 1.45;
        font-weight: 700;
        color: #202938;
        min-height: 46px;
        margin-bottom: 8px;
    }

    .course-description {
        color: #7a8494;
        font-size: 13px;
        line-height: 1.55;
        min-height: 60px;
    }

    .course-instructor {
        color: #8992a3;
        font-size: 12px;
        margin-top: 12px;
    }

    .course-footer {
        border-top: 1px solid #eef0f3;
        margin-top: 14px;
        padding-top: 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .course-price {
        font-weight: 800;
        color: #172033;
    }

    .course-detail {
        color: #0d6efd;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

    .empty-box {
        background: #ffffff;
        border: 1px solid #e8ebf0;
        border-radius: 16px;
        padding: 50px;
        text-align: center;
        color: #7a8494;
    }

    @@media (max-width: 991px) {
        .courses-layout {
            grid-template-columns: 1fr;
        }

        .course-list {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .course-list {
            grid-template-columns: 1fr;
        }

        .search-row {
            flex-direction: column;
        }

        .search-button {
            min-height: 46px;
        }
    }
</style>

<div class="courses-page">
    <div class="courses-container">

        <div class="courses-header">
            <h1 class="courses-title">
                Tất cả khóa học
            </h1>

            <p class="courses-subtitle">
                Khám phá các khóa học Công nghệ thông tin trên EduLearn.
            </p>
        </div>

        <div class="courses-layout">

            <!-- SIDEBAR -->
            <aside class="filter-box">

                <div class="filter-title">
                    Danh mục
                </div>

                <a asp-controller="Courses"
                   asp-action="Index"
                   asp-route-search="@ViewBag.Search"
                   class="category-link @(ViewBag.CategoryId == null ? "active" : "")">
                    Tất cả khóa học
                </a>

                @if (categories != null)
                {
                    foreach (var category in categories)
                    {
                        <a asp-controller="Courses"
                           asp-action="Index"
                           asp-route-categoryId="@category.Id"
                           asp-route-search="@ViewBag.Search"
                           class="category-link @(ViewBag.CategoryId != null && (int)ViewBag.CategoryId == category.Id ? "active" : "")">

                            @category.Name
                        </a>
                    }
                }

            </aside>

            <!-- MAIN -->
            <div>

                <form asp-controller="Courses"
                      asp-action="Index"
                      method="get"
                      class="search-row">

                    <input type="hidden"
                           name="categoryId"
                           value="@ViewBag.CategoryId" />

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="search-input"
                           placeholder="Tìm kiếm khóa học..." />

                    <button type="submit"
                            class="search-button">
                        Tìm kiếm
                    </button>

                </form>

                @if (Model.Any())
                {
                    <div class="course-list">

                        @foreach (var course in Model)
                        {
                            <div class="course-card">

                                <div class="course-thumbnail">

                                    <div class="course-category">
                                        @course.Category.Name
                                    </div>

                                    <div class="course-logo">
                                        @(course.Category.Icon ?? "IT")
                                    </div>

                                </div>

                                <div class="course-body">

                                    <span class="course-level">
                                        @course.Level
                                    </span>

                                    <div class="course-name">
                                        @course.Title
                                    </div>

                                    <div class="course-description">
                                        @course.ShortDescription
                                    </div>

                                    <div class="course-instructor">
                                        Giảng viên:
                                        @course.Instructor.FullName
                                    </div>

                                    <div class="course-footer">

                                        <span class="course-price">
                                            @course.Price.ToString("N0") đ
                                        </span>

                                        <a asp-controller="Courses"
   asp-action="Details"
   asp-route-slug="@course.Slug"
   class="course-detail">
    Xem chi tiết
</a>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="empty-box">
                        Không tìm thấy khóa học phù hợp.
                    </div>
                }

            </div>

        </div>

    </div>
</div>