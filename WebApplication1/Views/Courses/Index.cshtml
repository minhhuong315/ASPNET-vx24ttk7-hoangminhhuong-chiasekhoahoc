        margin-top: 17px;
        border-top: 1px solid #edf1f6;
    }

    .catalog-filter-title {
        margin-bottom: 10px;
        color: #1d2939;
        font-size: 12px;
        font-weight: 800;
    }

    .catalog-filter-options {
        display: grid;
        gap: 3px;
    }

    .catalog-filter-option {
