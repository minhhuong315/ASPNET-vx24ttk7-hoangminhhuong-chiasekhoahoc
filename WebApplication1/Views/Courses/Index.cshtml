    }

    .catalog-card {
        min-width: 0;
        overflow: hidden;
        border: 1px solid #e1e7ef;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 7px 22px rgba(31, 54, 88, .04);
