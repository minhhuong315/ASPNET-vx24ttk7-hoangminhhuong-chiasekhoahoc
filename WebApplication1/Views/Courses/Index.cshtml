@model IEnumerable<OnlineLearningPlatform.Models.Course>

@{
    string pageTitle =
        ViewBag.PageTitle?.ToString()
        ?? "Tất cả khóa học";

    string pageDescription =
        ViewBag.PageDescription?.ToString()
        ?? "Khám phá các khóa học Công nghệ thông tin trên EduLearn.";

    string selectedLevel =
        ViewBag.Level?.ToString()
        ?? string.Empty;

    int? selectedCategoryId =
        ViewBag.CategoryId == null
            ? null
            : Convert.ToInt32(
                ViewBag.CategoryId);

    string searchValue =
        ViewBag.Search?.ToString()
        ?? string.Empty;

    decimal? minPrice =
        ViewBag.MinPrice == null
            ? null
            : Convert.ToDecimal(
                ViewBag.MinPrice);

    decimal? maxPrice =
        ViewBag.MaxPrice == null
            ? null
            : Convert.ToDecimal(
                ViewBag.MaxPrice);

    int? minRating =
        ViewBag.MinRating == null
            ? null
            : Convert.ToInt32(
                ViewBag.MinRating);

    string selectedSort =
        ViewBag.Sort?.ToString()
        ?? "popular";

    int currentPage =
        ViewBag.CurrentPage == null
            ? 1
            : Convert.ToInt32(
                ViewBag.CurrentPage);

    int totalPages =
        ViewBag.TotalPages == null
            ? 0
            : Convert.ToInt32(
                ViewBag.TotalPages);

    int totalItems =
        ViewBag.TotalItems == null
            ? Model.Count()
            : Convert.ToInt32(
                ViewBag.TotalItems);

    int pageSize =
        ViewBag.PageSize == null
            ? 8
            : Convert.ToInt32(
                ViewBag.PageSize);

    int firstItem =
        totalItems == 0
            ? 0
            : ((currentPage - 1) *
                pageSize) + 1;

    int lastItem =
        totalItems == 0
            ? 0
            : Math.Min(
                currentPage * pageSize,
                totalItems);

    int paginationStart =
        Math.Max(
            1,
            currentPage - 2);

    int paginationEnd =
        Math.Min(
            totalPages,
            paginationStart + 4);

    paginationStart =
        Math.Max(
            1,
            paginationEnd - 4);

    ViewData["Title"] =
        pageTitle;

    var categories =
        ViewBag.Categories
            as IEnumerable<
                OnlineLearningPlatform.Models.Category>;

    bool hasFilter =
        selectedCategoryId.HasValue ||
        !string.IsNullOrWhiteSpace(
            selectedLevel) ||
        !string.IsNullOrWhiteSpace(
            searchValue) ||
        minPrice.HasValue ||
        maxPrice.HasValue ||
        minRating.HasValue;
}

@functions {
    string GetLevelText(string? level)
    {
        return level switch
        {
            "Beginner" => "Cơ bản",
            "Intermediate" => "Trung cấp",
            "Advanced" => "Nâng cao",
            _ => "Chưa xác định"
        };
    }

    string GetLevelClass(string? level)
    {
        return level switch
        {
            "Beginner" => "beginner",
            "Intermediate" => "intermediate",
            "Advanced" => "advanced",
            _ => "default"
        };
    }

    decimal GetEffectivePrice(
        OnlineLearningPlatform.Models.Course course)
    {
        return course.DiscountPrice.HasValue &&
               course.DiscountPrice.Value <
               course.Price
            ? course.DiscountPrice.Value
            : course.Price;
    }

    double GetAverageRating(
        OnlineLearningPlatform.Models.Course course)
    {
        var approvedReviews =
            course.Reviews?
                .Where(r =>
                    r.IsApproved)
                .ToList();

        if (approvedReviews == null ||
            approvedReviews.Count == 0)
        {
            return 0;
        }

        return approvedReviews
            .Average(r =>
                r.Rating);
    }
}

<script>
    document.body.classList.add("courses-index-page");
</script>

<link rel="stylesheet"
      href="~/css/courses-index.css"
      asp-append-version="true" />


<div class="courses-page">
    <div class="courses-container">

        <div class="courses-header">
            <div class="courses-eyebrow">
                Khám phá khóa học
            </div>

            <div class="courses-title"
                 role="heading"
                 aria-level="1">
                @pageTitle
            </div>

            <p class="courses-subtitle">
                @pageDescription
            </p>

            @if (!string.IsNullOrWhiteSpace(
                selectedLevel))
            {
                <div class="active-level">
                    <span class="active-level-dot"></span>
                    Cấp độ:
                    @GetLevelText(
                        ViewBag.NormalizedLevel?.ToString())
                </div>
            }
        </div>


        <div class="courses-filter-overlay"
             data-courses-filter-overlay
             hidden></div>

        <div class="courses-layout">

            <aside id="coursesFilterPanel"
                   class="filter-box"
                   aria-label="Bộ lọc khóa học">

                <div class="filter-mobile-head">
                    <div class="filter-mobile-title">
                        Bộ lọc
                    </div>

                    <button type="button"
                            class="filter-close"
                            data-courses-filter-close
                            aria-label="Đóng bộ lọc">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>

                <div class="filter-section">
                    <div class="filter-title">
                        Danh mục
                    </div>

                    <a asp-controller="Courses"
                       asp-action="Index"
                       asp-route-search="@searchValue"
                       asp-route-level="@selectedLevel"
                       asp-route-minPrice="@minPrice"
                       asp-route-maxPrice="@maxPrice"
                       asp-route-minRating="@minRating"
                       asp-route-sort="@selectedSort"
                       class="category-link @(selectedCategoryId == null ? "active" : "")">
                        Tất cả danh mục
                    </a>

                    @if (categories != null)
                    {
                        foreach (var category in categories)
                        {
                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@category.Id"
                               asp-route-search="@searchValue"
                               asp-route-level="@selectedLevel"
                               asp-route-minPrice="@minPrice"
                               asp-route-maxPrice="@maxPrice"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@selectedSort"
                               class="category-link @(selectedCategoryId == category.Id ? "active" : "")">
                                @category.Name
                            </a>
                        }
                    }
                </div>


                <div class="filter-section">
                    <div class="filter-title">
                        Trình độ
                    </div>

                    <a asp-controller="Courses"
                       asp-action="Index"
                       asp-route-categoryId="@selectedCategoryId"
                       asp-route-search="@searchValue"
                       asp-route-minPrice="@minPrice"
                       asp-route-maxPrice="@maxPrice"
                       asp-route-minRating="@minRating"
                       asp-route-sort="@selectedSort"
                       class="category-link @(string.IsNullOrWhiteSpace(selectedLevel) ? "active" : "")">
                        <span class="level-dot"></span>
                        Tất cả trình độ
                    </a>

                    <a asp-controller="Courses"
                       asp-action="Index"
                       asp-route-categoryId="@selectedCategoryId"
                       asp-route-search="@searchValue"
                       asp-route-level="beginner"
                       asp-route-minPrice="@minPrice"
                       asp-route-maxPrice="@maxPrice"
                       asp-route-minRating="@minRating"
                       asp-route-sort="@selectedSort"
                       class="category-link @(selectedLevel == "beginner" ? "active" : "")">
                        <span class="level-dot beginner"></span>
                        Cơ bản
                    </a>

                    <a asp-controller="Courses"
                       asp-action="Index"
                       asp-route-categoryId="@selectedCategoryId"
                       asp-route-search="@searchValue"
                       asp-route-level="intermediate"
                       asp-route-minPrice="@minPrice"
                       asp-route-maxPrice="@maxPrice"
                       asp-route-minRating="@minRating"
                       asp-route-sort="@selectedSort"
                       class="category-link @(selectedLevel == "intermediate" ? "active" : "")">
                        <span class="level-dot intermediate"></span>
                        Trung cấp
                    </a>

                    <a asp-controller="Courses"
                       asp-action="Index"
                       asp-route-categoryId="@selectedCategoryId"
                       asp-route-search="@searchValue"
                       asp-route-level="advanced"
                       asp-route-minPrice="@minPrice"
                       asp-route-maxPrice="@maxPrice"
                       asp-route-minRating="@minRating"
                       asp-route-sort="@selectedSort"
                       class="category-link @(selectedLevel == "advanced" ? "active" : "")">
                        <span class="level-dot advanced"></span>
                        Nâng cao
                    </a>
                </div>


                <div class="filter-section">
                    <div class="filter-title">
                        Khoảng giá
                    </div>

                    <form asp-controller="Courses"
                          asp-action="Index"
                          method="get"
                          class="sort-form">

                        <label for="coursesSort"
                               class="sort-label">
                            Sắp xếp theo
                        </label>

                        @if (selectedCategoryId.HasValue)
                        {
                            <input type="hidden"
                                   name="categoryId"
                                   value="@selectedCategoryId.Value" />
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            selectedLevel))
                        {
                            <input type="hidden"
                                   name="level"
                                   value="@selectedLevel" />
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            searchValue))
                        {
                            <input type="hidden"
                                   name="search"
                                   value="@searchValue" />
                        }

                        @if (minRating.HasValue)
                        {
                            <input type="hidden"
                                   name="minRating"
                                   value="@minRating.Value" />
                        }

                        <input type="hidden"
                               name="sort"
                               value="@selectedSort" />

                        <div class="price-grid">
                            <input type="number"
                                   min="0"
                                   step="10000"
                                   name="minPrice"
                                   value="@minPrice"
                                   class="filter-input"
                                   placeholder="Từ" />

                            <input type="number"
                                   min="0"
                                   step="10000"
                                   name="maxPrice"
                                   value="@maxPrice"
                                   class="filter-input"
                                   placeholder="Đến" />
                        </div>

                        <button type="submit"
                                class="filter-submit">
                            Áp dụng giá
                        </button>
                    </form>
                </div>


                <div class="filter-section">
                    <div class="filter-title">
                        Đánh giá
                    </div>

                    <div class="rating-options">
                        <a asp-controller="Courses"
                           asp-action="Index"
                           asp-route-categoryId="@selectedCategoryId"
                           asp-route-search="@searchValue"
                           asp-route-level="@selectedLevel"
                           asp-route-minPrice="@minPrice"
                           asp-route-maxPrice="@maxPrice"
                           asp-route-sort="@selectedSort"
                           class="rating-link @(!minRating.HasValue ? "active" : "")">
                            Tất cả đánh giá
                        </a>

                        @for (int rating = 5;
                              rating >= 3;
                              rating--)
                        {
                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-search="@searchValue"
                               asp-route-level="@selectedLevel"
                               asp-route-minPrice="@minPrice"
                               asp-route-maxPrice="@maxPrice"
                               asp-route-minRating="@rating"
                               asp-route-sort="@selectedSort"
                               class="rating-link @(minRating == rating ? "active" : "")">

                                <span class="stars">
                                    @for (int star = 1;
                                          star <= rating;
                                          star++)
                                    {
                                        <text>★</text>
                                    }
                                </span>

                                <span>
                                    từ @rating.0
                                </span>
                            </a>
                        }
                    </div>
                </div>

            </aside>


            <main class="main-panel">

                <button type="button"
                        class="courses-filter-toggle"
                        data-courses-filter-toggle
                        aria-controls="coursesFilterPanel"
                        aria-expanded="false">
                    <span class="courses-filter-toggle__icon"
                          aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M4 6h16M7 12h10M10 18h4" />
                        </svg>
                    </span>
                    Bộ lọc
                </button>

                <div class="toolbar">

                    <form asp-controller="Courses"
                          asp-action="Index"
                          method="get"
                          class="search-row">

                        @if (selectedCategoryId.HasValue)
                        {
                            <input type="hidden"
                                   name="categoryId"
                                   value="@selectedCategoryId.Value" />
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            selectedLevel))
                        {
                            <input type="hidden"
                                   name="level"
                                   value="@selectedLevel" />
                        }

                        @if (minPrice.HasValue)
                        {
                            <input type="hidden"
                                   name="minPrice"
                                   value="@minPrice.Value" />
                        }

                        @if (maxPrice.HasValue)
                        {
                            <input type="hidden"
                                   name="maxPrice"
                                   value="@maxPrice.Value" />
                        }

                        @if (minRating.HasValue)
                        {
                            <input type="hidden"
                                   name="minRating"
                                   value="@minRating.Value" />
                        }

                        <input type="hidden"
                               name="sort"
                               value="@selectedSort" />

                        <input type="text"
                               name="search"
                               value="@searchValue"
                               class="search-input"
                               placeholder="Tìm khóa học, chủ đề..."
                               aria-label="Tìm kiếm khóa học" />

                        <button type="submit"
                                class="search-button">
                            Tìm kiếm
                        </button>
                    </form>


                    <form asp-controller="Courses"
                          asp-action="Index"
                          method="get">

                        @if (selectedCategoryId.HasValue)
                        {
                            <input type="hidden"
                                   name="categoryId"
                                   value="@selectedCategoryId.Value" />
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            selectedLevel))
                        {
                            <input type="hidden"
                                   name="level"
                                   value="@selectedLevel" />
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            searchValue))
                        {
                            <input type="hidden"
                                   name="search"
                                   value="@searchValue" />
                        }

                        @if (minPrice.HasValue)
                        {
                            <input type="hidden"
                                   name="minPrice"
                                   value="@minPrice.Value" />
                        }

                        @if (maxPrice.HasValue)
                        {
                            <input type="hidden"
                                   name="maxPrice"
                                   value="@maxPrice.Value" />
                        }

                        @if (minRating.HasValue)
                        {
                            <input type="hidden"
                                   name="minRating"
                                   value="@minRating.Value" />
                        }

                        <select id="coursesSort"
                                name="sort"
                                class="sort-select"
                                aria-label="Sắp xếp khóa học"
                                onchange="this.form.submit()">

                            <option value="popular"
                                    selected="@(selectedSort == "popular" ? "selected" : null)">
                                Phổ biến
                            </option>

                            <option value="newest"
                                    selected="@(selectedSort == "newest" ? "selected" : null)">
                                Mới nhất
                            </option>

                            <option value="price-asc"
                                    selected="@(selectedSort == "price-asc" ? "selected" : null)">
                                Giá thấp → cao
                            </option>

                            <option value="price-desc"
                                    selected="@(selectedSort == "price-desc" ? "selected" : null)">
                                Giá cao → thấp
                            </option>

                            <option value="rating"
                                    selected="@(selectedSort == "rating" ? "selected" : null)">
                                Đánh giá cao
                            </option>
                        </select>
                    </form>

                </div>


                <div class="result-header">
                    <div class="result-count">
                        @totalItems khóa học phù hợp
                    </div>

                    @if (hasFilter)
                    {
                        <a asp-controller="Courses"
                           asp-action="Index"
                           asp-route-sort="@selectedSort"
                           class="clear-filter">
                            Xóa bộ lọc
                        </a>
                    }
                </div>


                @if (Model.Any())
                {
                    <div class="course-list">

                        @foreach (var course in Model)
                        {
                            string levelClass =
                                GetLevelClass(
                                    course.Level);

                            string levelText =
                                GetLevelText(
                                    course.Level);

                            decimal effectivePrice =
                                GetEffectivePrice(
                                    course);

                            bool hasDiscount =
                                effectivePrice <
                                course.Price;

                            string sharedThumbnail =
                                Url.Content(
                                    $"~/images/course-thumbnails/by-slug/{course.Slug}.png");

                            string placeholderThumbnail =
                                Url.Content(
                                    "~/images/course-thumbnails/by-slug/course-placeholder.svg");

                            string thumbnailUrl =
                                string.IsNullOrWhiteSpace(
                                    course.ThumbnailUrl)
                                    ? sharedThumbnail
                                    : Url.Content(
                                        course.ThumbnailUrl);

                            <article class="course-card">

                                <a asp-controller="Courses"
                                   asp-action="Details"
                                   asp-route-slug="@course.Slug"
                                   class="course-thumbnail-link"
                                   aria-label="Xem khóa học @course.Title">

                                    <span class="course-thumbnail">

                                        <img src="@thumbnailUrl"
                                             alt="@course.Title"
                                             loading="lazy"
                                             data-course-thumbnail
                                             data-fallback="@sharedThumbnail"
                                             data-placeholder="@placeholderThumbnail" />

                                    </span>

                                </a>


                                <div class="course-body">

                                    <div class="course-topline">

                                        <span class="course-category"
                                              title="@(course.Category?.Name ?? "Công nghệ thông tin")">
                                            @(course.Category?.Name
                                                ?? "Công nghệ thông tin")
                                        </span>

                                        <span class="course-level @levelClass">
                                            @levelText
                                        </span>

                                    </div>


                                    <div class="course-name"
                                         role="heading"
                                         aria-level="2">

                                        <a asp-controller="Courses"
                                           asp-action="Details"
                                           asp-route-slug="@course.Slug">
                                            @course.Title
                                        </a>

                                    </div>


                                    <div class="course-footer">

                                        <div class="course-price-wrap">

                                            <div class="course-price">
                                                @effectivePrice.ToString(
                                                    "N0",
                                                    System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))đ
                                            </div>

                                            @if (hasDiscount)
                                            {
                                                <div class="course-old-price">
                                                    @course.Price.ToString(
                                                        "N0",
                                                        System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))đ
                                                </div>
                                            }

                                        </div>


                                        <a asp-controller="Courses"
                                           asp-action="Details"
                                           asp-route-slug="@course.Slug"
                                           class="course-detail">
                                            Xem chi tiết
                                            <span aria-hidden="true">→</span>
                                        </a>

                                    </div>

                                </div>

                            </article>
                        }

                    </div>

                    @if (totalPages > 1)
                    {
                        <div class="pagination-wrap">
                            <div class="pagination-info">
                                Hiển thị @firstItem–@lastItem
                                trong @totalItems khóa học
                            </div>

                            <nav class="pagination-list"
                                 aria-label="Phân trang khóa học">

                                @if (currentPage > 1)
                                {
                                    <a asp-controller="Courses"
                                       asp-action="Index"
                                       asp-route-search="@searchValue"
                                       asp-route-categoryId="@selectedCategoryId"
                                       asp-route-level="@selectedLevel"
                                       asp-route-minPrice="@minPrice"
                                       asp-route-maxPrice="@maxPrice"
                                       asp-route-minRating="@minRating"
                                       asp-route-sort="@selectedSort"
                                       asp-route-page="@(currentPage - 1)"
                                       class="page-link-button">
                                        ← Trước
                                    </a>
                                }
                                else
                                {
                                    <span class="page-link-button disabled">
                                        ← Trước
                                    </span>
                                }

                                @for (int pageNumber = paginationStart;
                                      pageNumber <= paginationEnd;
                                      pageNumber++)
                                {
                                    <a asp-controller="Courses"
                                       asp-action="Index"
                                       asp-route-search="@searchValue"
                                       asp-route-categoryId="@selectedCategoryId"
                                       asp-route-level="@selectedLevel"
                                       asp-route-minPrice="@minPrice"
                                       asp-route-maxPrice="@maxPrice"
                                       asp-route-minRating="@minRating"
                                       asp-route-sort="@selectedSort"
                                       asp-route-page="@pageNumber"
                                       class="page-link-button @(pageNumber == currentPage ? "active" : "")"
                                       aria-current="@(pageNumber == currentPage ? "page" : null)">
                                        @pageNumber
                                    </a>
                                }

                                @if (currentPage < totalPages)
                                {
                                    <a asp-controller="Courses"
                                       asp-action="Index"
                                       asp-route-search="@searchValue"
                                       asp-route-categoryId="@selectedCategoryId"
                                       asp-route-level="@selectedLevel"
                                       asp-route-minPrice="@minPrice"
                                       asp-route-maxPrice="@maxPrice"
                                       asp-route-minRating="@minRating"
                                       asp-route-sort="@selectedSort"
                                       asp-route-page="@(currentPage + 1)"
                                       class="page-link-button">
                                        Sau →
                                    </a>
                                }
                                else
                                {
                                    <span class="page-link-button disabled">
                                        Sau →
                                    </span>
                                }

                            </nav>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-box">
                        <div class="empty-icon">
                            KH
                        </div>

                        <div class="empty-title">
                            Chưa có khóa học phù hợp
                        </div>

                        <div class="empty-description">
                            Hiện chưa có khóa học đáp ứng
                            bộ lọc bạn đã chọn.
                        </div>

                        <a asp-controller="Courses"
                           asp-action="Index"
                           class="empty-button">
                            Xem tất cả khóa học
                        </a>
                    </div>
                }

            </main>

        </div>

    </div>
</div>

<script src="~/js/courses-index.js"
        asp-append-version="true"
        defer></script>
