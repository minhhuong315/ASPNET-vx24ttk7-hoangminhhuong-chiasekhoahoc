        cursor: default;
    }

    @@media (max-width: 1120px) {
        .catalog-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 900px) {
        .course-catalog-page {
            padding-top: 28px;
        }

        .catalog-layout {
            grid-template-columns: 1fr;
        }

        .catalog-filter {
            position: static;
        }

        .catalog-filter-body {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0 20px;
        }

        .catalog-filter-section +
        .catalog-filter-section {
            margin-top: 0;
            border-top: 0;
        }

        .catalog-toolbar {
            grid-template-columns: 1fr;
        }

        .catalog-sort-form {
            justify-content: flex-end;
        }
    }

    @@media (max-width: 640px) {
        .catalog-container {
            width: min(100% - 24px, 1240px);
        }

        .catalog-title {
            font-size: 29px;
        }

        .catalog-filter-body {
            grid-template-columns: 1fr;
        }

        .catalog-filter-section +
        .catalog-filter-section {
            margin-top: 16px;
            border-top: 1px solid #edf1f6;
        }

        .catalog-search-form {
            grid-template-columns: 1fr;
        }

        .catalog-search-button {
            width: 100%;
        }

        .catalog-sort-form {
            align-items: stretch;
            justify-content: initial;
            flex-direction: column;
        }

        .catalog-sort-select {
            width: 100%;
        }

        .catalog-filter-summary {
            align-items: flex-start;
            flex-direction: column;
        }

        .catalog-grid {
            grid-template-columns: 1fr;
        }

        .catalog-pagination-wrap {
            align-items: flex-start;
            flex-direction: column;
        }

        .catalog-pagination {
            max-width: 100%;
            flex-wrap: wrap;
        }
    }
</style>

<div class="course-catalog-page">
    <div class="catalog-container">

        <header class="catalog-header">
            <div class="catalog-eyebrow">
                Khám phá khóa học
            </div>

            <h1 class="catalog-title">
                @pageTitle
            </h1>

            <p class="catalog-subtitle">
                @pageDescription
            </p>
        </header>

        <div class="catalog-layout">

            <aside class="catalog-filter">
                <div class="catalog-filter-head">
                    <div class="catalog-filter-heading">
                        <span>Bộ lọc</span>

                        @if (activeFilterCount > 0)
                        {
                            <span class="catalog-filter-count">
                                @activeFilterCount
                            </span>
                        }
                    </div>

                    @if (hasFilter)
                    {
                        <a asp-controller="Courses"
                           asp-action="Index"
                           class="catalog-clear-all">
                            Bỏ lọc ↻
                        </a>
                    }
                </div>

                <div class="catalog-filter-body">

                    <section class="catalog-filter-section">
                        <div class="catalog-filter-title">
                            Danh mục
                        </div>

                        <div class="catalog-filter-options">
                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-search="@searchValue"
                               asp-route-level="@selectedLevel"
                               asp-route-priceRange="@selectedPriceRange"
                               asp-route-minPrice="@(hasCustomPrice ? minPrice : null)"
                               asp-route-maxPrice="@(hasCustomPrice ? maxPrice : null)"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@selectedSort"
                               class="catalog-filter-option @(!selectedCategoryId.HasValue ? "active" : "")">
                                <span class="catalog-check"></span>
                                <span class="catalog-option-label">
                                    Tất cả danh mục
                                </span>
                            </a>

                            @if (categories != null)
                            {
                                @foreach (var category in categories)
                                {
                                    <a asp-controller="Courses"
                                       asp-action="Index"
                                       asp-route-categoryId="@category.Id"
                                       asp-route-search="@searchValue"
                                       asp-route-level="@selectedLevel"
                                       asp-route-priceRange="@selectedPriceRange"
                                       asp-route-minPrice="@(hasCustomPrice ? minPrice : null)"
                                       asp-route-maxPrice="@(hasCustomPrice ? maxPrice : null)"
                                       asp-route-minRating="@minRating"
                                       asp-route-sort="@selectedSort"
                                       class="catalog-filter-option @(selectedCategoryId == category.Id ? "active" : "")">
                                        <span class="catalog-check"></span>
                                        <span class="catalog-option-label">
                                            @category.Name
                                        </span>
                                    </a>
                                }
                            }
                        </div>
                    </section>

                    <section class="catalog-filter-section">
                        <div class="catalog-filter-title">
                            Trình độ
                        </div>

                        <div class="catalog-filter-options">
                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-search="@searchValue"
                               asp-route-priceRange="@selectedPriceRange"
                               asp-route-minPrice="@(hasCustomPrice ? minPrice : null)"
                               asp-route-maxPrice="@(hasCustomPrice ? maxPrice : null)"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@selectedSort"
                               class="catalog-filter-option @(string.IsNullOrWhiteSpace(selectedLevel) ? "active" : "")">
                                <span class="catalog-check"></span>
                                <span class="catalog-option-label">
                                    Tất cả trình độ
                                </span>
                            </a>

                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-search="@searchValue"
                               asp-route-level="beginner"
                               asp-route-priceRange="@selectedPriceRange"
                               asp-route-minPrice="@(hasCustomPrice ? minPrice : null)"
                               asp-route-maxPrice="@(hasCustomPrice ? maxPrice : null)"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@selectedSort"
                               class="catalog-filter-option @(selectedLevel == "beginner" ? "active" : "")">
                                <span class="catalog-check"></span>
                                <span class="catalog-option-label">
                                    Cơ bản
                                </span>
                            </a>

                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-search="@searchValue"
                               asp-route-level="intermediate"
                               asp-route-priceRange="@selectedPriceRange"
                               asp-route-minPrice="@(hasCustomPrice ? minPrice : null)"
                               asp-route-maxPrice="@(hasCustomPrice ? maxPrice : null)"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@selectedSort"
                               class="catalog-filter-option @(selectedLevel == "intermediate" ? "active" : "")">
                                <span class="catalog-check"></span>
                                <span class="catalog-option-label">
                                    Trung cấp
                                </span>
                            </a>

                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-search="@searchValue"
                               asp-route-level="advanced"
                               asp-route-priceRange="@selectedPriceRange"
                               asp-route-minPrice="@(hasCustomPrice ? minPrice : null)"
                               asp-route-maxPrice="@(hasCustomPrice ? maxPrice : null)"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@selectedSort"
                               class="catalog-filter-option @(selectedLevel == "advanced" ? "active" : "")">
                                <span class="catalog-check"></span>
                                <span class="catalog-option-label">
                                    Nâng cao
                                </span>
                            </a>
                        </div>
                    </section>

                    <section class="catalog-filter-section">
                        <div class="catalog-filter-title">
                            Khoảng giá
                        </div>

                        <div class="catalog-filter-options">
                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-search="@searchValue"
                               asp-route-level="@selectedLevel"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@selectedSort"
                               class="catalog-filter-option @(string.IsNullOrWhiteSpace(selectedPriceRange) && !hasCustomPrice ? "active" : "")">
                                <span class="catalog-check"></span>
                                <span class="catalog-option-label">
                                    Tất cả
                                </span>
                            </a>

                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-search="@searchValue"
                               asp-route-level="@selectedLevel"
                               asp-route-priceRange="free"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@selectedSort"
                               class="catalog-filter-option @(selectedPriceRange == "free" ? "active" : "")">
                                <span class="catalog-check"></span>
                                <span class="catalog-option-label">
                                    Miễn phí
                                </span>
                            </a>

                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-search="@searchValue"
                               asp-route-level="@selectedLevel"
                               asp-route-priceRange="under-1m"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@selectedSort"
                               class="catalog-filter-option @(selectedPriceRange == "under-1m" ? "active" : "")">
                                <span class="catalog-check"></span>
                                <span class="catalog-option-label">
                                    Dưới 1.000.000đ
                                </span>
                            </a>

                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-search="@searchValue"
                               asp-route-level="@selectedLevel"
                               asp-route-priceRange="1m-2m"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@selectedSort"
                               class="catalog-filter-option @(selectedPriceRange == "1m-2m" ? "active" : "")">
                                <span class="catalog-check"></span>
                                <span class="catalog-option-label">
                                    1.000.000đ – 2.000.000đ
                                </span>
                            </a>

                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-search="@searchValue"
                               asp-route-level="@selectedLevel"
                               asp-route-priceRange="over-2m"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@selectedSort"
                               class="catalog-filter-option @(selectedPriceRange == "over-2m" ? "active" : "")">
                                <span class="catalog-check"></span>
                                <span class="catalog-option-label">
                                    Trên 2.000.000đ
                                </span>
                            </a>
                        </div>
                    </section>

                    <section class="catalog-filter-section">
                        <div class="catalog-filter-title">
                            Đánh giá
                        </div>

                        <div class="catalog-filter-options">
                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-search="@searchValue"
                               asp-route-level="@selectedLevel"
                               asp-route-priceRange="@selectedPriceRange"
                               asp-route-minPrice="@(hasCustomPrice ? minPrice : null)"
                               asp-route-maxPrice="@(hasCustomPrice ? maxPrice : null)"
                               asp-route-sort="@selectedSort"
                               class="catalog-filter-option @(!minRating.HasValue ? "active" : "")">
                                <span class="catalog-check"></span>
                                <span class="catalog-option-label">
                                    Tất cả đánh giá
                                </span>
                            </a>

                            @for (int rating = 4;
                                  rating >= 2;
                                  rating--)
                            {
                                <a asp-controller="Courses"
                                   asp-action="Index"
                                   asp-route-categoryId="@selectedCategoryId"
                                   asp-route-search="@searchValue"
                                   asp-route-level="@selectedLevel"
                                   asp-route-priceRange="@selectedPriceRange"
                                   asp-route-minPrice="@(hasCustomPrice ? minPrice : null)"
                                   asp-route-maxPrice="@(hasCustomPrice ? maxPrice : null)"
                                   asp-route-minRating="@rating"
                                   asp-route-sort="@selectedSort"
                                   class="catalog-filter-option @(minRating == rating ? "active" : "")">
                                    <span class="catalog-check"></span>
                                    <span class="catalog-option-label">
                                        Từ @rating.0
                                        <span class="catalog-rating-star">★</span>
                                        trở lên
                                    </span>
                                </a>
                            }
                        </div>
                    </section>

                </div>
            </aside>

            <main class="catalog-main">

                <div class="catalog-toolbar">
                    <form asp-controller="Courses"
                          asp-action="Index"
                          method="get"
                          class="catalog-search-form">

                        @if (selectedCategoryId.HasValue)
                        {
                            <input type="hidden"
                                   name="categoryId"
                                   value="@selectedCategoryId.Value" />
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            selectedLevel))
                        {
                            <input type="hidden"
                                   name="level"
                                   value="@selectedLevel" />
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            selectedPriceRange))
                        {
                            <input type="hidden"
                                   name="priceRange"
                                   value="@selectedPriceRange" />
                        }
                        else if (hasCustomPrice)
                        {
                            @if (minPrice.HasValue)
                            {
                                <input type="hidden"
                                       name="minPrice"
                                       value="@minPrice.Value" />
                            }

                            @if (maxPrice.HasValue)
                            {
                                <input type="hidden"
                                       name="maxPrice"
                                       value="@maxPrice.Value" />
                            }
                        }

                        @if (minRating.HasValue)
                        {
                            <input type="hidden"
                                   name="minRating"
                                   value="@minRating.Value" />
                        }

                        <input type="hidden"
                               name="sort"
                               value="@selectedSort" />

                        <div class="catalog-search-wrap">
                            <span class="catalog-search-icon">
                                ⌕
                            </span>

                            <input type="text"
                                   name="search"
                                   value="@searchValue"
                                   class="catalog-search-input"
                                   placeholder="Tìm khóa học, chủ đề, công nghệ..." />
                        </div>

                        <button type="submit"
                                class="catalog-search-button">
                            Tìm kiếm
                        </button>
                    </form>

                    <form asp-controller="Courses"
                          asp-action="Index"
                          method="get"
                          class="catalog-sort-form">

                        @if (selectedCategoryId.HasValue)
                        {
                            <input type="hidden"
                                   name="categoryId"
                                   value="@selectedCategoryId.Value" />
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            selectedLevel))
                        {
                            <input type="hidden"
                                   name="level"
                                   value="@selectedLevel" />
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            searchValue))
                        {
                            <input type="hidden"
                                   name="search"
                                   value="@searchValue" />
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            selectedPriceRange))
                        {
                            <input type="hidden"
                                   name="priceRange"
                                   value="@selectedPriceRange" />
                        }
                        else if (hasCustomPrice)
                        {
                            @if (minPrice.HasValue)
                            {
                                <input type="hidden"
                                       name="minPrice"
                                       value="@minPrice.Value" />
                            }

                            @if (maxPrice.HasValue)
                            {
                                <input type="hidden"
                                       name="maxPrice"
                                       value="@maxPrice.Value" />
                            }
                        }

                        @if (minRating.HasValue)
                        {
                            <input type="hidden"
                                   name="minRating"
                                   value="@minRating.Value" />
                        }

                        <span class="catalog-sort-label">
                            Sắp xếp theo:
                        </span>

                        <select name="sort"
                                class="catalog-sort-select"
                                onchange="this.form.submit()">
                            <option value="popular"
                                    selected="@(selectedSort == "popular" ? "selected" : null)">
                                Phổ biến
                            </option>

                            <option value="newest"
                                    selected="@(selectedSort == "newest" ? "selected" : null)">
                                Mới nhất
                            </option>

                            <option value="price-asc"
                                    selected="@(selectedSort == "price-asc" ? "selected" : null)">
                                Giá thấp → cao
                            </option>

                            <option value="price-desc"
                                    selected="@(selectedSort == "price-desc" ? "selected" : null)">
                                Giá cao → thấp
                            </option>

                            <option value="rating"
                                    selected="@(selectedSort == "rating" ? "selected" : null)">
                                Đánh giá cao
                            </option>
                        </select>
                    </form>
                </div>

                <div class="catalog-filter-summary">
                    <div class="catalog-chips">

                        @if (!string.IsNullOrWhiteSpace(
                            searchValue))
                        {
                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-level="@selectedLevel"
                               asp-route-priceRange="@selectedPriceRange"
                               asp-route-minPrice="@(hasCustomPrice ? minPrice : null)"
                               asp-route-maxPrice="@(hasCustomPrice ? maxPrice : null)"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@selectedSort"
                               class="catalog-chip"
                               title="Bỏ từ khóa tìm kiếm">
                                <span>Từ khóa: @searchValue</span>
                                <span class="catalog-chip-x">×</span>
                            </a>
                        }

                        @if (selectedCategoryId.HasValue &&
                             selectedCategory != null)
                        {
                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-search="@searchValue"
                               asp-route-level="@selectedLevel"
                               asp-route-priceRange="@selectedPriceRange"
                               asp-route-minPrice="@(hasCustomPrice ? minPrice : null)"
                               asp-route-maxPrice="@(hasCustomPrice ? maxPrice : null)"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@selectedSort"
                               class="catalog-chip"
                               title="Bỏ lọc danh mục">
                                <span>@selectedCategory.Name</span>
                                <span class="catalog-chip-x">×</span>
                            </a>
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            selectedLevel))
                        {
                            string levelChipText =
                                selectedLevel switch
                                {
                                    "beginner" => "Cơ bản",
                                    "intermediate" => "Trung cấp",
                                    "advanced" => "Nâng cao",
                                    _ => selectedLevel
                                };

                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-search="@searchValue"
                               asp-route-priceRange="@selectedPriceRange"
                               asp-route-minPrice="@(hasCustomPrice ? minPrice : null)"
                               asp-route-maxPrice="@(hasCustomPrice ? maxPrice : null)"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@selectedSort"
                               class="catalog-chip"
                               title="Bỏ lọc trình độ">
                                <span>@levelChipText</span>
                                <span class="catalog-chip-x">×</span>
                            </a>
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            selectedPriceRange))
                        {
                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-search="@searchValue"
                               asp-route-level="@selectedLevel"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@selectedSort"
                               class="catalog-chip"
                               title="Bỏ lọc khoảng giá">
                                <span>@GetPriceRangeLabel(selectedPriceRange)</span>
                                <span class="catalog-chip-x">×</span>
                            </a>
                        }
                        else if (hasCustomPrice)
                        {
                            string customPriceLabel;

                            if (minPrice.HasValue &&
                                maxPrice.HasValue)
                            {
                                customPriceLabel =
                                    $"{minPrice.Value:N0}đ – {maxPrice.Value:N0}đ";
                            }
                            else if (minPrice.HasValue)
                            {
                                customPriceLabel =
                                    $"Từ {minPrice.Value:N0}đ";
                            }
                            else
                            {
                                customPriceLabel =
                                    $"Đến {maxPrice!.Value:N0}đ";
                            }

                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-search="@searchValue"
                               asp-route-level="@selectedLevel"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@selectedSort"
                               class="catalog-chip"
                               title="Bỏ lọc khoảng giá cũ">
                                <span>@customPriceLabel</span>
                                <span class="catalog-chip-x">×</span>
                            </a>
                        }

                        @if (minRating.HasValue)
                        {
                            <a asp-controller="Courses"
                               asp-action="Index"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-search="@searchValue"
                               asp-route-level="@selectedLevel"
                               asp-route-priceRange="@selectedPriceRange"
                               asp-route-minPrice="@(hasCustomPrice ? minPrice : null)"
                               asp-route-maxPrice="@(hasCustomPrice ? maxPrice : null)"
                               asp-route-sort="@selectedSort"
                               class="catalog-chip"
                               title="Bỏ lọc đánh giá">
                                <span>
                                    Từ @minRating.Value.0 ★
                                </span>
                                <span class="catalog-chip-x">×</span>
                            </a>
                        }
                    </div>

                    <div class="catalog-result-count">
                        Có <strong>@totalItems</strong>
                        khóa học phù hợp
                    </div>
                </div>

                @if (Model.Any())
                {
                    <div class="catalog-grid">
                        @foreach (var course in Model)
                        {
                            string levelClass =
                                GetLevelClass(
                                    course.Level);

                            string levelText =
                                GetLevelText(
                                    course.Level);

                            decimal effectivePrice =
                                GetEffectivePrice(
                                    course);

                            bool hasDiscount =
                                effectivePrice <
                                course.Price;

                            double averageRating =
                                GetAverageRating(
                                    course);

                            int reviewCount =
                                course.Reviews?
                                    .Count(r =>
                                        r.IsApproved)
                                ?? 0;

                            int enrollmentCount =
                                course.Enrollments?
                                    .Count
                                ?? 0;

                            string instructorName =
                                course.Instructor?.FullName
                                ?? "Giảng viên EduLearn";

                            <article class="catalog-card">
                                <a asp-controller="Courses"
                                   asp-action="Details"
                                   asp-route-slug="@course.Slug"
                                   class="catalog-card-media">

                                    @if (!string.IsNullOrWhiteSpace(
                                        course.ThumbnailUrl))
                                    {
                                        <img src="@course.ThumbnailUrl"
                                             alt="@course.Title" />
                                    }
                                    else
                                    {
                                        <div class="catalog-card-fallback @levelClass">
                                            <div class="catalog-fallback-icon">
                                                @(course.Category?.Icon
                                                    ?? "IT")
                                            </div>
                                        </div>
                                    }

                                    @if (course.IsFeatured)
                                    {
                                        <span class="catalog-featured-badge">
                                            🔥 Nổi bật
                                        </span>
                                    }
                                </a>

                                <div class="catalog-card-body">
                                    <div class="catalog-card-topline">
                                        <div class="catalog-course-category">
                                            @(course.Category?.Name
                                                ?? "Công nghệ thông tin")
                                        </div>

                                        <span class="catalog-course-level @levelClass">
                                            @levelText
                                        </span>
                                    </div>

                                    <h2 class="catalog-course-name">
                                        <a asp-controller="Courses"
                                           asp-action="Details"
                                           asp-route-slug="@course.Slug">
                                            @course.Title
                                        </a>
                                    </h2>

                                    <div class="catalog-course-description">
                                        @(string.IsNullOrWhiteSpace(
                                            course.ShortDescription)
                                            ? "Khám phá nội dung và lộ trình học tập của khóa học này."
                                            : course.ShortDescription)
                                    </div>

                                    <div class="catalog-instructor-row">
                                        <div class="catalog-instructor-avatar">
                                            @GetInitials(instructorName)
                                        </div>

                                        <div class="catalog-instructor-info">
                                            <div class="catalog-instructor-name">
                                                @instructorName
                                            </div>
                                            <div class="catalog-instructor-role">
                                                Giảng viên
                                            </div>
                                        </div>

                                        <div class="catalog-card-stats">
                                            <div class="catalog-rating">
                                                @if (reviewCount > 0)
                                                {
                                                    <span class="star">★</span>
                                                    <span>
                                                        @averageRating.ToString("0.0")
                                                        (@reviewCount)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>Chưa có đánh giá</span>
                                                }
                                            </div>

                                            <div class="catalog-students">
                                                @enrollmentCount học viên
                                            </div>
                                        </div>
                                    </div>

                                    <div class="catalog-card-footer">
                                        <div>
                                            @if (effectivePrice <= 0)
                                            {
                                                <div class="catalog-price free">
                                                    Miễn phí
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="catalog-price">
                                                    @effectivePrice.ToString("N0")đ
                                                </div>
                                            }

                                            @if (hasDiscount)
                                            {
                                                <div class="catalog-old-price">
                                                    @course.Price.ToString("N0")đ
                                                </div>
                                            }
                                        </div>

                                        <a asp-controller="Courses"
                                           asp-action="Details"
                                           asp-route-slug="@course.Slug"
                                           class="catalog-detail-button">
                                            Xem chi tiết →
                                        </a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>

                    @if (totalPages > 1)
                    {
                        <div class="catalog-pagination-wrap">
                            <div class="catalog-pagination-info">
                                Hiển thị @firstItem–@lastItem
                                trong @totalItems khóa học
                            </div>

                            <nav class="catalog-pagination"
                                 aria-label="Phân trang khóa học">

                                @if (currentPage > 1)
                                {
                                    <a asp-controller="Courses"
                                       asp-action="Index"
                                       asp-route-search="@searchValue"
                                       asp-route-categoryId="@selectedCategoryId"
                                       asp-route-level="@selectedLevel"
                                       asp-route-priceRange="@selectedPriceRange"
                                       asp-route-minPrice="@(hasCustomPrice ? minPrice : null)"
                                       asp-route-maxPrice="@(hasCustomPrice ? maxPrice : null)"
                                       asp-route-minRating="@minRating"
                                       asp-route-sort="@selectedSort"
                                       asp-route-page="@(currentPage - 1)"
                                       class="catalog-page-link">
                                        ←
                                    </a>
                                }
                                else
                                {
                                    <span class="catalog-page-disabled">
                                        ←
                                    </span>
                                }

                                @for (int pageNumber =
                                          paginationStart;
                                      pageNumber <=
                                          paginationEnd;
                                      pageNumber++)
                                {
                                    if (pageNumber ==
                                        currentPage)
                                    {
                                        <span class="catalog-page-current">
                                            @pageNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <a asp-controller="Courses"
                                           asp-action="Index"
                                           asp-route-search="@searchValue"
                                           asp-route-categoryId="@selectedCategoryId"
                                           asp-route-level="@selectedLevel"
                                           asp-route-priceRange="@selectedPriceRange"
                                           asp-route-minPrice="@(hasCustomPrice ? minPrice : null)"
                                           asp-route-maxPrice="@(hasCustomPrice ? maxPrice : null)"
                                           asp-route-minRating="@minRating"
                                           asp-route-sort="@selectedSort"
                                           asp-route-page="@pageNumber"
                                           class="catalog-page-link">
                                            @pageNumber
                                        </a>
                                    }
                                }

                                @if (currentPage < totalPages)
                                {
                                    <a asp-controller="Courses"
                                       asp-action="Index"
                                       asp-route-search="@searchValue"
                                       asp-route-categoryId="@selectedCategoryId"
                                       asp-route-level="@selectedLevel"
                                       asp-route-priceRange="@selectedPriceRange"
                                       asp-route-minPrice="@(hasCustomPrice ? minPrice : null)"
                                       asp-route-maxPrice="@(hasCustomPrice ? maxPrice : null)"
                                       asp-route-minRating="@minRating"
                                       asp-route-sort="@selectedSort"
                                       asp-route-page="@(currentPage + 1)"
                                       class="catalog-page-link">
                                        →
                                    </a>
                                }
                                else
                                {
                                    <span class="catalog-page-disabled">
                                        →
                                    </span>
                                }
                            </nav>
                        </div>
                    }
                }
                else
                {
                    <div class="catalog-empty">
                        <div class="catalog-empty-icon">
                            KH
                        </div>

                        <div class="catalog-empty-title">
                            Chưa có khóa học phù hợp
                        </div>

                        <p class="catalog-empty-text">
                            Hiện chưa có khóa học đáp ứng bộ lọc bạn đã chọn.
                            Hãy bỏ bớt điều kiện lọc hoặc xem lại toàn bộ khóa học.
                        </p>

                        <a asp-controller="Courses"
                           asp-action="Index"
                           class="catalog-empty-button">
                            Xem tất cả khóa học
                        </a>
                    </div>
                }

            </main>
        </div>
    </div>
</div>
