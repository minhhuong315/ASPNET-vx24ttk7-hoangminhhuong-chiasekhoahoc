@model OnlineLearningPlatform.Models.Course

@{
    ViewData["Title"] = "Học - " + Model.Title;

    var currentLesson =
        ViewBag.CurrentLesson
        as OnlineLearningPlatform.Models.Lesson;

    var completedLessonIds =
        ViewBag.CompletedLessonIds
        as List<int>
        ?? new List<int>();

    var unlockedLessonIds =
        ViewBag.UnlockedLessonIds
        as List<int>
        ?? new List<int>();

    decimal progress = 0m;

    if (ViewBag.EnrollmentProgress != null)
    {
        progress =
            Math.Clamp(
                Convert.ToDecimal(
                    ViewBag.EnrollmentProgress),
                0m,
                100m);
    }

    string? successMessage =
        TempData["LearningSuccessMessage"]
            ?.ToString();

    string? infoMessage =
        TempData["LearningInfoMessage"]
            ?.ToString();

    string? toastMessage =
        successMessage ?? infoMessage;

    bool toastIsSuccess =
        !string.IsNullOrWhiteSpace(
            successMessage);
}

<style>

    .learning-page {
        background: #f5f7fb;
        min-height: calc(100vh - 88px);
    }

    .learning-layout {
        display: grid;
        grid-template-columns: 340px 1fr;
        min-height: calc(100vh - 88px);
    }

    /* =========================
       SIDEBAR
    ========================= */

    .lesson-sidebar {
        background: #ffffff;
        border-right: 1px solid #e6eaf0;
    }

    .sidebar-header {
        padding: 24px;
        border-bottom: 1px solid #edf0f4;
    }

    .back-course {
        color: #0d6efd;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
    }

    .back-course:hover {
        color: #0b5ed7;
    }

    .sidebar-course-title {
        color: #172033;
        font-size: 18px;
        line-height: 1.45;
        font-weight: 800;
        margin-top: 12px;
    }

    .sidebar-progress {
        margin-top: 18px;
    }

    .progress-info {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        color: #667085;
        font-size: 12px;
        margin-bottom: 7px;
    }

    .progress-percent {
        color: #0d6efd;
        font-weight: 800;
    }

    .progress-track {
        height: 8px;
        background: #edf1f6;
        border-radius: 30px;
        overflow: hidden;
    }

    .progress-value {
        height: 100%;
        background: #0d6efd;
        border-radius: 30px;
        transition: width .3s ease;
    }

    /* =========================
       MODULE / LESSON
    ========================= */

    .modules-list {
        padding-bottom: 30px;
    }

    .module-block {
        border-bottom: 1px solid #edf0f4;
    }

    .module-heading {
        padding: 18px 20px 10px;
        color: #172033;
        font-size: 14px;
        font-weight: 800;
    }

    .lesson-link,
    .lesson-locked {
        min-height: 52px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 20px;
        font-size: 13px;
        border-left: 3px solid transparent;
    }

    .lesson-link {
        color: #5d6675;
        text-decoration: none;
        transition: .2s ease;
    }

    .lesson-link:hover {
        color: #0d6efd;
        background: #f7faff;
    }

    .lesson-link.active {
        background: #edf4ff;
        color: #0d6efd;
        border-left-color: #0d6efd;
        font-weight: 700;
    }

    .lesson-locked {
        color: #a8afba;
        cursor: not-allowed;
        background: #fbfcfd;
    }

    .lesson-status {
        width: 25px;
        height: 25px;
        flex-shrink: 0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dbe1e9;
        color: #99a2b1;
        font-size: 11px;
        font-weight: 700;
    }

    .lesson-status.completed {
        border-color: #b8e2c5;
        background: #eaf8ef;
        color: #198754;
    }

    .lesson-status.unlocked {
        border-color: #b9d3ff;
        background: #edf4ff;
        color: #0d6efd;
    }

    .lesson-status.locked {
        background: #f1f3f6;
        color: #a2a9b3;
        border-color: #e2e6ec;
    }

    .lesson-title-text {
        flex: 1;
        line-height: 1.4;
    }

    .lock-text {
        color: #a8afba;
        font-size: 10px;
        font-weight: 600;
    }

    /* =========================
       MAIN
    ========================= */

    .lesson-content {
        padding: 42px;
    }

    .lesson-container {
        max-width: 900px;
        margin: 0 auto;
    }

    .lesson-breadcrumb {
        color: #8992a3;
        font-size: 13px;
        margin-bottom: 14px;
    }

    .lesson-title {
        color: #172033;
        font-size: 34px;
        font-weight: 800;
        line-height: 1.3;
        margin-bottom: 12px;
    }

    .lesson-meta {
        color: #8992a3;
        font-size: 13px;
        margin-bottom: 28px;
    }

    .video-placeholder {
        width: 100%;
        aspect-ratio: 16 / 9;
        border-radius: 17px;
        background: #172033;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 25px;
        color: #ffffff;
    }

    .video-symbol {
        width: 76px;
        height: 76px;
        border-radius: 50%;
        background: rgba(255, 255, 255, .12);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        padding-left: 5px;
    }

    .lesson-card {
        background: #ffffff;
        border: 1px solid #e7ebf0;
        border-radius: 16px;
        padding: 28px;
        margin-bottom: 20px;
    }

    .lesson-card-title {
        color: #172033;
        font-size: 20px;
        font-weight: 800;
        margin-bottom: 15px;
    }

    .lesson-text {
        color: #5f6978;
        line-height: 1.8;
        white-space: pre-line;
    }

    .unlock-note {
        margin-top: 22px;
        padding: 13px 16px;
        border-radius: 10px;
        background: #f3f7ff;
        color: #607087;
        font-size: 12px;
        line-height: 1.6;
    }

    .lesson-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 25px;
    }

    .completed-label {
        min-height: 46px;
        padding: 0 18px;
        border: 1px solid #b8e2c5;
        background: #eaf8ef;
        color: #198754;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
    }

    .complete-button {
        min-height: 46px;
        border: none;
        border-radius: 10px;
        background: #0d6efd;
        color: #ffffff;
        padding: 0 22px;
        font-size: 13px;
        font-weight: 700;
    }

    .complete-button:hover {
        background: #0b5ed7;
    }

    /* =========================
       TOAST
    ========================= */

    .learning-toast-position {
        position: fixed !important;
        left: 32px !important;
        bottom: 32px !important;
        right: auto !important;
        top: auto !important;
        z-index: 3000 !important;
        padding: 0 !important;
    }

    .learning-toast {
        width: 340px;
        max-width: calc(100vw - 64px);
        border: none;
        border-radius: 14px;
        background: #ffffff;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(0,0,0,.16);
    }

    .learning-toast.success {
        border-left: 5px solid #198754;
    }

    .learning-toast.info {
        border-left: 5px solid #0d6efd;
    }

    .toast-symbol {
        width: 34px;
        height: 34px;
        flex-shrink: 0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .toast-symbol.success {
        background: #e7f7ed;
        color: #198754;
    }

    .toast-symbol.info {
        background: #edf4ff;
        color: #0d6efd;
    }

    .toast-title {
        color: #202938;
        font-weight: 700;
    }

    .toast-message {
        color: #697386;
        font-size: 13px;
        margin-top: 2px;
    }

    /* =========================
       RESPONSIVE
    ========================= */

    @@media (max-width: 850px) {

        .learning-layout {
            grid-template-columns: 1fr;
        }

        .lesson-sidebar {
            border-right: none;
            border-bottom: 1px solid #e6eaf0;
        }

        .lesson-content {
            padding: 28px 18px;
        }

    }

    @@media (max-width: 600px) {

        .lesson-title {
            font-size: 27px;
        }

        .learning-toast-position {
            left: 16px !important;
            bottom: 16px !important;
            right: 16px !important;
        }

        .learning-toast {
            width: auto;
            max-width: none;
        }

    }

</style>


<div class="learning-page">

    <div class="learning-layout">

        <!-- =========================
             SIDEBAR
        ========================= -->

        <aside class="lesson-sidebar">

            <div class="sidebar-header">

                <a asp-controller="Courses"
                   asp-action="Details"
                   asp-route-slug="@Model.Slug"
                   class="back-course">

                    ← Quay lại khóa học

                </a>


                <div class="sidebar-course-title">
                    @Model.Title
                </div>


                <div class="sidebar-progress">

                    <div class="progress-info">

                        <span>
                            Tiến độ khóa học
                        </span>

                        <span class="progress-percent">
                            @progress.ToString("0")%
                        </span>

                    </div>


                    <div class="progress-track">

                        <div class="progress-value"
                             style="width: @progress.ToString("0")%;">
                        </div>

                    </div>

                </div>

            </div>


            <div class="modules-list">

                @foreach (var module in
                    Model.Modules.OrderBy(
                        m => m.DisplayOrder))
                {
                    <div class="module-block">

                        <div class="module-heading">
                            @module.Title
                        </div>


                        @foreach (var lesson in
                            module.Lessons.OrderBy(
                                l => l.DisplayOrder))
                        {
                            bool isCompleted =
                                completedLessonIds.Contains(
                                    lesson.Id);

                            bool isUnlocked =
                                unlockedLessonIds.Contains(
                                    lesson.Id);

                            bool isCurrent =
                                currentLesson != null &&
                                currentLesson.Id ==
                                lesson.Id;


                            @if (isUnlocked)
                            {
                                <a asp-controller="Courses"
                                   asp-action="Learn"
                                   asp-route-courseId="@Model.Id"
                                   asp-route-lessonId="@lesson.Id"
                                   class="lesson-link @(isCurrent ? "active" : "")">

                                    @if (isCompleted)
                                    {
                                        <span class="lesson-status completed">
                                            ✓
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="lesson-status unlocked">
                                            @lesson.DisplayOrder
                                        </span>
                                    }

                                    <span class="lesson-title-text">
                                        @lesson.Title
                                    </span>

                                </a>
                            }
                            else
                            {
                                <div class="lesson-locked">

                                    <span class="lesson-status locked">
                                        🔒
                                    </span>

                                    <span class="lesson-title-text">
                                        @lesson.Title
                                    </span>

                                    <span class="lock-text">
                                        Khóa
                                    </span>

                                </div>
                            }
                        }

                    </div>
                }

            </div>

        </aside>


        <!-- =========================
             NỘI DUNG BÀI HỌC
        ========================= -->

        <main class="lesson-content">

            <div class="lesson-container">

                @if (currentLesson != null)
                {
                    bool currentCompleted =
                        completedLessonIds.Contains(
                            currentLesson.Id);


                    <div class="lesson-breadcrumb">
                        @currentLesson.Module.Title
                    </div>


                    <h1 class="lesson-title">
                        @currentLesson.Title
                    </h1>


                    <div class="lesson-meta">
                        Thời lượng:
                        @currentLesson.Duration phút
                    </div>


                    <div class="video-placeholder">

                        <div class="video-symbol">
                            ▶
                        </div>

                    </div>


                    <div class="lesson-card">

                        <div class="lesson-card-title">
                            Nội dung bài học
                        </div>

                        <div class="lesson-text">
                            @currentLesson.Content
                        </div>

                    </div>


                    @if (!currentCompleted &&
                         progress < 100)
                    {
                        <div class="unlock-note">
                            Hoàn thành bài học này để mở khóa bài tiếp theo.
                        </div>
                    }


                    <div class="lesson-actions">

                        @if (currentCompleted)
                        {
                            <div class="completed-label">
                                ✓ Đã hoàn thành bài học
                            </div>
                        }
                        else
                        {
                            <form asp-controller="Courses"
                                  asp-action="CompleteLesson"
                                  method="post">

                                <input type="hidden"
                                       name="lessonId"
                                       value="@currentLesson.Id" />

                                <button type="submit"
                                        class="complete-button">

                                    ✓ Hoàn thành bài học

                                </button>

                            </form>
                        }

                    </div>
                }

            </div>

        </main>

    </div>

</div>


<!-- =========================
     POPUP
========================= -->

@if (!string.IsNullOrWhiteSpace(
    toastMessage))
{
    <div class="toast-container learning-toast-position">

        <div id="learningToast"
             class="toast learning-toast @(toastIsSuccess ? "success" : "info")"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">

            <div class="toast-body d-flex align-items-center gap-3">

                <div class="toast-symbol @(toastIsSuccess ? "success" : "info")">

                    @(toastIsSuccess
                        ? "✓"
                        : "i")

                </div>


                <div class="flex-grow-1">

                    <div class="toast-title">

                        @(toastIsSuccess
                            ? "Thành công"
                            : "Thông báo")

                    </div>

                    <div class="toast-message">
                        @toastMessage
                    </div>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="toast"
                        aria-label="Đóng">
                </button>

            </div>

        </div>

    </div>
}


@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const toastElement =
                    document.getElementById(
                        "learningToast");

                if (toastElement) {

                    const toast =
                        new bootstrap.Toast(
                            toastElement,
                            {
                                autohide: true,
                                delay: 3500
                            });

                    toast.show();
                }
            });

    </script>

}